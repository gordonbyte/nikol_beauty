<style>
.custom-collection-banners {
    background-size: cover;
    background-position: bottom;
    padding-top: 80px;
    padding-bottom: 40px;
}

.custom-collection-banners__media img {
    width: 100%;
}

.custom-collection-banners__header {
    text-align: center;
}

.custom-collection-banners__title {
    color: var(--COLOR-TEXT);
    line-height: 110%;
    font-family: var(--FONT-STACK-HEADING);
    letter-spacing: -3px;
    font-weight: 500;
    margin: 0;
    text-transform: capitalize;
}

.custom-collection-banners__subtitle {
    color: var(--COLOR-TEXT);
    font-family: var(--FONT-STACK-BODY);
    font-size: var(--FONT-SIZE-BASE);
    margin: 0;
    padding-top: 20px;
    padding-bottom: 40px;
}

.custom-collection-banners__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 15px;
    list-style: none;
    margin: 0;
    padding: 0;
}

.custom-collection-banners__item {
    width: 32.3%;
}

.custom-collection-banners__item-title {
    color: var(--COLOR-TEXT);
    font-family: var(--FONT-STACK-HEADING);
    font-weight: 400;
    margin: 0;
    padding-bottom: 5px;
}

.custom-collection-banners__shop {
    color: var(--BTN-PRIMARY-BG-COLOR);
    font-size: var(--FONT-SIZE-BASE);
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    font-family: var(--FONT-STACK-HEADING);
    text-decoration: underline;
}

.custom-collection-banners__link {
    position: relative;
    display: block;
}

.custom-collection-banners__content {
    position: absolute;
    top: 30%;
    left: 21px;
}
.custom-collection-banners__list .custom-collection-banners__item:last-child .custom-collection-banners__content {
    top: 20%;
}
.custom-collection-banners__list .custom-collection-banners__item:last-child .custom-collection-banners__item-title {
    width: 50%;
}
@media only screen and (max-width: 600px) {
.custom-collection-banners {
    padding-top: 40px;
}

.custom-collection-banners__list {
    flex-wrap: wrap;
}

.custom-collection-banners__item {
    width: 100%;
}

.custom-collection-banners__item-title {
    line-height: 90%;
}

.custom-collection-banners__shop {
    font-size: var(--FONT-SIZE-BASE);
}

.custom-collection-banners__subtitle {
    font-size: var(--FONT-SIZE-BASE);
    line-height: 135%;
    padding-top: 15px;
    padding-bottom: 30px;
}

.custom-collection-banners__header {
    padding: 0 15px;
}


}
    </style>

{%- assign heading_id = 'CustomCollBanners-title-' | append: section.id -%}

<section
  class="custom-collection-banners"
  {% if section.settings.title != blank %}aria-labelledby="{{ heading_id }}"{% endif %}
  {% if section.settings.bg_image != blank %}
    style="background-image: url('{{ section.settings.bg_image | img_url: 'master' }}');"
  {% endif %}
>
  <div class="page-width">
    <div class="custom-collection-banners__header">
      {% if section.settings.title != blank %}
        <h2 id="{{ heading_id }}" class="custom-collection-banners__title heading-size-11">
          {{ section.settings.title }}
        </h2>
      {% endif %}

      {% if section.settings.subtitle != blank %}
        <p class="custom-collection-banners__subtitle">
          {{ section.settings.subtitle }}
        </p>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <ul class="custom-collection-banners__list" role="list">

        {% for block in section.blocks %}
          {%- capture box_inner -%}
            <div class="custom-collection-banners__media">
              {% if block.settings.image_desktop != blank %}
                <img
                  src="{{ block.settings.image_desktop | img_url: 'master' }}"
                  alt=""
                  loading="lazy"
                  class="cw-desktop">
              {% endif %}
              {% if block.settings.image_mobile != blank %}
                <img
                  src="{{ block.settings.image_mobile | img_url: 'master' }}"
                  alt=""
                  loading="lazy"
                  class="cw-mobile">
              {% endif %}
            </div>

            <div class="custom-collection-banners__content">
              {% if block.settings.title != blank %}
                <h3 class="custom-collection-banners__item-title heading-size-8">
                  {{ block.settings.title }}
                </h3>
              {% endif %}

              {% if block.settings.shop_text != blank %}
                <span class="custom-collection-banners__shop">
                  {{ block.settings.shop_text }}
                  <svg width="17" height="12" viewBox="0 0 17 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                    <path d="M0.779541 4.96159C0.348967 4.96159 -8.18591e-05 5.31064 -8.18968e-05 5.74121C-8.19344e-05 6.17178 0.348967 6.52083 0.779541 6.52083L0.779541 5.74121L0.779541 4.96159ZM16.3308 6.29249C16.6353 5.98803 16.6353 5.4944 16.3308 5.18994L11.3693 0.228446C11.0649 -0.0760165 10.5712 -0.0760165 10.2668 0.228445C9.96231 0.532907 9.96231 1.02654 10.2668 1.331L14.677 5.74121L10.2668 10.1514C9.96231 10.4559 9.96231 10.9495 10.2668 11.254C10.5712 11.5584 11.0649 11.5584 11.3693 11.254L16.3308 6.29249ZM0.779541 5.74121L0.779541 6.52083L15.7795 6.52084L15.7795 5.74121L15.7795 4.96159L0.779541 4.96159L0.779541 5.74121Z" fill="currentColor"/>
                  </svg>
                </span>
              {% endif %}
            </div>
          {%- endcapture -%}

          <li class="custom-collection-banners__item" {{ block.shopify_attributes }}>
            {% if block.settings.link != blank %}
              <a class="custom-collection-banners__link" href="{{ block.settings.link }}">
                {{ box_inner }}
              </a>
            {% else %}
              <div class="custom-collection-banners__link">
                {{ box_inner }}
              </div>
            {% endif %}
          </li>
        {% endfor %}

      </ul>
    {% endif %}

  </div>
</section>


{% schema %}
{
  "name": "[Custom] Coll. Banners",
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
     {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Shop by Collection"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Section Subtitle",
      "default": "Browse our collections and find your next favorite."
    }
  ],
  "blocks": [
    {
      "type": "collection_box",
      "name": "Collection Box",
      "settings": [
        {
          "type": "image_picker",
          "id": "image_desktop",
          "label": "Box Image Desktop"
        },
          {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Box Image Mobile"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Collection Name"
        },
        {
          "type": "text",
          "id": "shop_text",
          "label": "Shop Text",
          "default": "SHOP NOW"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "[Custom] Coll. Banners"
    }
  ]
}
{% endschema %}
