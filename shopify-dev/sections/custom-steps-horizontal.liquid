{%- style -%}
  #StepsHorizontal-{{ section.id }} {
    background-image: url({% if section.settings.bg_image != blank %}{{ section.settings.bg_image | image_url: width: 3000 }}{% else %}https://cdn.shopify.com/s/files/1/0690/6347/5504/files/steps-bg.jpg?v=1770984877{% endif %});
  }
{%- endstyle -%}

<style>
.custom-steps-horizontal {
  padding: 80px 20px;
  text-align: center;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}

.custom-steps-horizontal__header h2 {
  margin: 0;
  color: var(--COLOR-TEXT);
  font-family: var(--FONT-STACK-HEADING);
  font-size: 56px;
  font-weight: 500;
  line-height: 110%;
  letter-spacing: -1px;
}

.custom-steps-horizontal__header p {
  margin: 0;
  padding-top: 10px;
  padding-bottom: 40px;
  color: var(--COLOR-TEXT);
  font-family: Inter;
  font-size: 20px;
  font-weight: 400;
  line-height: 140%;
}

.custom-steps-horizontal__container {
  display: flex;
  width: 100%;
}

.custom-steps-horizontal__card {
  position: relative;
  width: 33%;
  margin: 0 auto;
  padding-top: 20px;
}

.custom-steps-horizontal__image {
  width: 100%;
}

.custom-steps-horizontal__image img {
  width: 100%;
  max-width: 390px;
  height: auto;
  object-fit: contain;
}

.custom-steps-horizontal__number {
  position: absolute;
  left: 50%;
  top: 285px;
  transform: translateX(-50%);
  width: 35px;
  height: 35px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #45413B;
  color: #fff;
  border: 2.23px solid #FCFAF8;
  font-family: 'Cormorant', sans-serif;
  font-size: 24px;
  font-weight: 600;
  line-height: 130%;
  padding-bottom: 7px;
  box-shadow: 0px 3.96px 29.71px 0px #34445E0D;
}

.custom-steps-horizontal__card:nth-child(3) .custom-steps-horizontal__number {
  padding-bottom: 13px;
}

.custom-steps-horizontal__card h3 {
  margin: 40px 0 12px;
  color: var(--COLOR-TEXT);
  font-family: 'Cormorant', sans-serif;
  font-size: 28px;
  line-height: 120%;
}

.custom-steps-horizontal__card p {
  padding: 0 10px;
  color: var(--COLOR-TEXT);
  font-family: Inter, sans-serif;
  font-size: var(--FONT-SIZE-BASE);
  font-weight: 400;
  line-height: 150%;
}

.custom-steps-horizontal__btn-wrap {
  margin-top: 40px;
}

.custom-steps-horizontal__btn-wrap a {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  max-width: 400px;
  height: 60px;
  margin: 0 auto;
  background: var(--BTN-PRIMARY-BG-COLOR);
  color: var(--BTN-PRIMARY-TEXT-COLOR);
  font-family: var(--BTN-FONT-STACK);
  font-size: var(--BTN-FONT-SIZE);
  font-weight: 700;
  line-height: 26px;
  letter-spacing: 0;
  text-decoration: none;
  cursor: pointer;
  gap: 5px;
  transition: background 0.3s ease;
}

.custom-steps-horizontal__btn-wrap a:focus-visible {
  background: var(--BTN-PRIMARY-BG-COLOR-BRIGHTER);
  color: var(--BTN-PRIMARY-TEXT-COLOR);
}

@media (hover: hover) {
  .custom-steps-horizontal__btn-wrap a:hover {
    background: var(--BTN-PRIMARY-BG-COLOR-BRIGHTER);
    color: var(--BTN-PRIMARY-TEXT-COLOR);
  }

  .custom-steps-horizontal__btn-wrap a svg {
    transition: transform 0.5s ease;
    transform: translateZ(0);
  }

  .custom-steps-horizontal__btn-wrap a:hover svg {
    transform: translate3d(5px, 0, 0);
  }
}

@media only screen and (max-width: 600px) {
  .custom-steps-horizontal {
    padding: 50px 0;
  }

  .custom-steps-horizontal__header h2 {
    font-size: 34px;
  }

  .custom-steps-horizontal__header p {
    padding-bottom: 20px;
    font-size: var(--FONT-SIZE-BASE);
  }

  .custom-steps-horizontal__container {
    flex-wrap: wrap;
  }

  .custom-steps-horizontal__card {
    width: 100%;
  }

  .custom-steps-horizontal__card h3 {
    font-size: 23px;
  }

  .custom-steps-horizontal__card p {
    font-size: var(--FONT-SIZE-BASE);
    line-height: 135%;
  }

  .custom-steps-horizontal__btn-wrap {
    margin-top: 20px;
  }

  .custom-steps-horizontal__btn-wrap a {
    height: 50px;
    font-size: var(--BTN-FONT-SIZE);
  }

  .custom-steps-horizontal__number {
    top: 250px;
  }
}

/* Scroll-in reveal: initial hidden states apply ONLY once JS adds anim-ready,
   so content stays visible without JS and under reduced motion. */
.custom-steps-horizontal.anim-ready .custom-steps-horizontal__header,
.custom-steps-horizontal.anim-ready .custom-steps-horizontal__card,
.custom-steps-horizontal.anim-ready .custom-steps-horizontal__btn-wrap {
  opacity: 0;
  transform: translateY(26px);
  transition: opacity 0.65s ease, transform 0.65s ease;
}

.custom-steps-horizontal.anim-ready .custom-steps-horizontal__card:nth-child(2) {
  transition-delay: 0.12s;
}

.custom-steps-horizontal.anim-ready .custom-steps-horizontal__card:nth-child(3) {
  transition-delay: 0.24s;
}

.custom-steps-horizontal.anim-ready .is-inview {
  opacity: 1;
  transform: none;
}

/* Hover life: the card's photo eases into a gentle zoom under the pointer,
   and the step number pops with it (keeping its translateX centering). */
@media (hover: hover) {
  .custom-steps-horizontal__image img,
  .custom-steps-horizontal__number {
    transition: transform 0.45s ease;
  }

  .custom-steps-horizontal__card:hover .custom-steps-horizontal__image img {
    transform: scale(1.03);
  }

  .custom-steps-horizontal__card:hover .custom-steps-horizontal__number {
    transform: translateX(-50%) scale(1.12);
  }
}
</style>

<section class="custom-steps-horizontal" id="StepsHorizontal-{{ section.id }}">
  <div class="page-width">

    <div class="custom-steps-horizontal__header">
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p>{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="custom-steps-horizontal__container">
      {%- for block in section.blocks -%}
        <div class="custom-steps-horizontal__card" {{ block.shopify_attributes }}>

          <div class="custom-steps-horizontal__image">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 780 | image_tag: widths: '300, 390, 600, 780', sizes: '390px', loading: 'lazy', alt: '' }}
            {%- endif -%}
          </div>

          <div class="custom-steps-horizontal__number">{{ forloop.index }}</div>

          {%- if block.settings.title != blank -%}
            <h3>{{ block.settings.title }}</h3>
          {%- endif -%}

          {%- if block.settings.description != blank -%}
            <p>{{ block.settings.description }}</p>
          {%- endif -%}

        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.button_text != blank and section.settings.button_link != blank -%}
      <div class="custom-steps-horizontal__btn-wrap">
        <a href="{{ section.settings.button_link }}">
          {{ section.settings.button_text }}
          <svg width="22" height="13" viewBox="0 0 22 13" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
            <path d="M0.843262 5.36644C0.377534 5.36644 0 5.74399 0 6.20972C0 6.67544 0.377534 7.05299 0.843262 7.05299H20.8433C21.309 7.05299 21.6866 6.67544 21.6866 6.20972C21.6866 5.74399 21.309 5.36644 20.8433 5.36644H0.843262ZM21.4395 6.806C21.7689 6.47668 21.7689 5.94275 21.4395 5.61343L16.073 0.24687C15.7437 -0.0824491 15.2097 -0.0824491 14.8804 0.24687C14.5511 0.576189 14.5511 1.11012 14.8804 1.43944L19.6507 6.20972L14.8804 10.98C14.5511 11.3093 14.5511 11.8432 14.8804 12.1726C15.2097 12.5019 15.7437 12.5019 16.073 12.1726L21.4395 6.806Z" fill="currentColor"/>
          </svg>
        </a>
      </div>
    {%- endif -%}

  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('StepsHorizontal-{{ section.id }}');
    if (!root) return;
    if (!('IntersectionObserver' in window)) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (window.theme && window.theme.settings && window.theme.settings.enableAnimations === false) return;

    var targets = root.querySelectorAll('.custom-steps-horizontal__header, .custom-steps-horizontal__card, .custom-steps-horizontal__btn-wrap');
    if (!targets.length) return;

    root.classList.add('anim-ready');

    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-inview');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.18 });

    targets.forEach(function (t) { observer.observe(t); });
  })();
</script>

{% schema %}
{
  "name": "[Custom] Steps Horizontal",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image",
      "info": "Falls back to the default steps background if left blank."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "How It Works In 3 Simple Steps"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Sub Heading",
      "default": "Three simple steps to get started."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop Now →"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Step Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Step Title",
          "default": "Step title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Step Description",
          "default": "Step description here"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "[Custom] Steps Horizontal",
      "blocks": [
        { "type": "step" },
        { "type": "step" },
        { "type": "step" }
      ]
    }
  ]
}
{% endschema %}
