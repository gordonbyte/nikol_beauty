<div 
  class="image-grid" 
  data-section-id="{{ section.id }}" 
  data-section-type="image-grid"
  >
  <div class="image-grid__inner">
    {%- for gridItem in section.blocks -%}
      <div class="image-grid__item">
        <figure class="image-grid__image">
          <img
            src="{{ gridItem.settings.image | image_url: width: 800 }}"
            srcset="{{ gridItem.settings.image | image_url: width: 400 }} 400w, {{ gridItem.settings.image | image_url: width: 600 }} 600w, {{ gridItem.settings.image | image_url: width: 800 }} 800w, {{ gridItem.settings.image | image_url: width: 1200 }} 1200w"
            sizes="(max-width: 749px) 100vw, 570px"
            width="{{ gridItem.settings.image.width }}"
            height="{{ gridItem.settings.image.height }}"
            alt="{{ gridItem.settings.image.alt | default: gridItem.settings.title | strip_html | escape }}"
            loading="lazy"
            />
        </figure>
        <a class="image-grid__overlay"{% if gridItem.settings.link != blank %} href="{{ gridItem.settings.link }}"{% endif %}>
          <h3 class="image-grid__title" style="color: {{ gridItem.settings.text_color  }}">
            {{ gridItem.settings.title }}
          </h3>
        </a>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Images Grid",
  "class": "section-images-grid",
  "settings": [
    {
      "type": "header",
      "content": "Testimonials"
    }
  ],
  "blocks": [
      {
        "type": "image",
        "name": "Grid Item",
        "settings": [
          {
            "type": "text",
            "id": "title",
            "label": "Title",
            "default": "Lorem ipsum"
          },
          {
            "type": "select",
            "id": "text_color",
            "label": "Text Color",
            "default": "black",
            "options": [
              { "value": "black", "label": "Black" },
              { "value": "white", "label": "White" }
            ]
          },
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          },
          {
            "type": "url",
            "id": "link",
            "label": "Link"
          }
        ]
      }
  ],
  "presets": [{
    "name": "Images Grid",
    "category": "Image"
  }]
}
{% endschema %}
