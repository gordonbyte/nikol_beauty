{%- style -%}
  #GuaranteeList-{{ section.id }} {
    --custom-guarantee-list-bg: {{ section.settings.background_color | default: '#F8F3EF' }};
    --custom-guarantee-list-border-top: {{ section.settings.border_top_thickness }}px solid {{ section.settings.border_top_color }};
    --custom-guarantee-list-border-bottom: {{ section.settings.border_bottom_thickness }}px solid {{ section.settings.border_bottom_color }};
    --custom-guarantee-list-text-color: {{ section.settings.text_color | default: 'var(--COLOR-TEXT)' }};
    --custom-guarantee-list-text-size: {{ section.settings.text_size }}px;
    --custom-guarantee-list-text-weight: {{ section.settings.text_weight }};
  }
{%- endstyle -%}

<style>
.custom-guarantee-list__bar {
  background: var(--custom-guarantee-list-bg);
  border-top: var(--custom-guarantee-list-border-top);
  border-bottom: var(--custom-guarantee-list-border-bottom);
  padding: 17px 0;
}

.custom-guarantee-list__desktop { display: block; }
.custom-guarantee-list__mobile { display: none; }

.custom-guarantee-list__items {
  display: flex;
  justify-content: space-between;
  align-items: center;
  list-style: none;
  margin: 0;
  padding: 0;
}

.custom-guarantee-list__box {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  width: 25%;
  font-family: 'Inter';
  font-size: var(--custom-guarantee-list-text-size);
  font-weight: var(--custom-guarantee-list-text-weight);
  color: var(--custom-guarantee-list-text-color);
  text-transform: capitalize;
}

.custom-guarantee-list__icon {
  width: auto;
  height: 24px;
  flex-shrink: 0;
  object-fit: contain;
}

.custom-guarantee-list__marquee { overflow: hidden; }

.custom-guarantee-list__track {
  display: flex;
  width: max-content;
  align-items: center;
  list-style: none;
  margin: 0;
  padding: 0;
  animation: custom-guarantee-list-scroll 20s linear infinite;
}

.custom-guarantee-list__track .custom-guarantee-list__box {
  width: auto;
  padding-right: 30px;
}

@keyframes custom-guarantee-list-scroll {
  from { transform: translateX(0); }
  to { transform: translateX(-50%); }
}

@media (prefers-reduced-motion: reduce) {
  .custom-guarantee-list__track {
    animation: none;
    width: 100%;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px 25px;
  }
  .custom-guarantee-list__track [aria-hidden="true"] { display: none; }
}

/* JS-toggled when the static items don't fit the bar (tablets etc.) */
.custom-guarantee-list.is-scrolling .custom-guarantee-list__desktop { display: none; }
.custom-guarantee-list.is-scrolling .custom-guarantee-list__mobile { display: block; }

/* off-screen measuring clone: natural single-line width of the item set */
.custom-guarantee-list__items--measure {
  position: absolute !important;
  left: -9999px;
  top: 0;
  visibility: hidden;
  pointer-events: none;
  width: max-content;
  justify-content: flex-start;
  gap: 40px;
}

.custom-guarantee-list__items--measure .custom-guarantee-list__box {
  width: auto;
  white-space: nowrap;
}

@media only screen and (max-width: 600px) {
  .custom-guarantee-list__desktop { display: none; }
  .custom-guarantee-list__mobile { display: block; }

  .custom-guarantee-list__track .custom-guarantee-list__icon { height: 22px; }
}
</style>

<div id="GuaranteeList-{{ section.id }}" class="custom-guarantee-list">

  <div class="custom-guarantee-list__bar custom-guarantee-list__desktop">
    <div class="page-width">
      <ul class="custom-guarantee-list__items">
        {%- for block in section.blocks -%}
          <li class="custom-guarantee-list__box" {{ block.shopify_attributes }}>
            {%- if block.settings.feature_icon != blank -%}
              {{ block.settings.feature_icon | image_url: width: 120 | image_tag: class: 'custom-guarantee-list__icon', alt: '', loading: 'lazy' }}
            {%- endif -%}
            <span class="custom-guarantee-list__text">{{ block.settings.feature_text }}</span>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>

  <div class="custom-guarantee-list__bar custom-guarantee-list__mobile">
    <div class="page-width">
      <div class="custom-guarantee-list__marquee">
        <ul class="custom-guarantee-list__track">
          {%- for block in section.blocks -%}
            <li class="custom-guarantee-list__box" {{ block.shopify_attributes }}>
              {%- if block.settings.feature_icon != blank -%}
                {{ block.settings.feature_icon | image_url: width: 120 | image_tag: class: 'custom-guarantee-list__icon', alt: '', loading: 'lazy' }}
              {%- endif -%}
              <span class="custom-guarantee-list__text">{{ block.settings.feature_text }}</span>
            </li>
          {%- endfor -%}
          {%- for block in section.blocks -%}
            <li class="custom-guarantee-list__box" aria-hidden="true">
              {%- if block.settings.feature_icon != blank -%}
                {{ block.settings.feature_icon | image_url: width: 120 | image_tag: class: 'custom-guarantee-list__icon', alt: '', loading: 'lazy' }}
              {%- endif -%}
              <span class="custom-guarantee-list__text">{{ block.settings.feature_text }}</span>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </div>

</div>

<script>
  (function () {
    var root = document.getElementById('GuaranteeList-{{ section.id }}');
    if (!root) return;
    var track = root.querySelector('.custom-guarantee-list__track');
    var items = root.querySelector('.custom-guarantee-list__items');

    /* Constant 50px/s regardless of item count or text length; the CSS 20s is the no-JS fallback. */
    function scaleDuration() {
      if (!track) return;
      var distance = track.scrollWidth / 2;
      if (distance > 0) track.style.animationDuration = (distance / 50) + 's';
    }

    /* Marquee kicks in whenever the static items genuinely don't fit the bar. */
    function fitCheck() {
      if (!items) return;
      if (window.innerWidth <= 600) {
        root.classList.remove('is-scrolling');
        return;
      }
      var clone = items.cloneNode(true);
      clone.classList.add('custom-guarantee-list__items--measure');
      clone.setAttribute('aria-hidden', 'true');
      root.appendChild(clone);
      var needed = clone.getBoundingClientRect().width;
      root.removeChild(clone);

      var containers = root.querySelectorAll('.custom-guarantee-list__bar .page-width');
      var visible = null;
      for (var i = 0; i < containers.length; i++) {
        if (containers[i].offsetParent !== null) { visible = containers[i]; break; }
      }
      if (!visible) return;
      var cs = getComputedStyle(visible);
      var available = visible.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);

      var overflowing = needed > available;
      if (root.classList.contains('is-scrolling') !== overflowing) {
        root.classList.toggle('is-scrolling', overflowing);
        if (overflowing) scaleDuration();
      }
    }

    function update() {
      fitCheck();
      scaleDuration();
    }

    if (document.readyState === 'complete') {
      update();
    } else {
      window.addEventListener('load', update);
    }

    var resizeTimer;
    window.addEventListener('resize', function () {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(update, 150);
    });
  })();
</script>

{% schema %}
{
  "name": "[Custom] Guarantee List",
  "settings": [
    {
      "type": "color_background",
      "id": "background_color",
      "label": "Section background",
      "info": "Solid color or gradient",
      "default": "#F8F3EF"
    },
    {
      "type": "header",
      "content": "Top border"
    },
    {
      "type": "range",
      "id": "border_top_thickness",
      "label": "Thickness",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "border_top_color",
      "label": "Color",
      "default": "#F7F2ED"
    },
    {
      "type": "header",
      "content": "Bottom border"
    },
    {
      "type": "range",
      "id": "border_bottom_thickness",
      "label": "Thickness",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "border_bottom_color",
      "label": "Color",
      "default": "#F7F2ED"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "info": "Leave empty to use the theme text color"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 10,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "select",
      "id": "text_weight",
      "label": "Text weight",
      "options": [
        { "value": "300", "label": "Light (300)" },
        { "value": "400", "label": "Regular (400)" },
        { "value": "500", "label": "Medium (500)" },
        { "value": "600", "label": "Semibold (600)" },
        { "value": "700", "label": "Bold (700)" }
      ],
      "default": "400"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Guarantee Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "feature_icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "feature_text",
          "label": "Text",
          "default": "Free Shipping & Returns"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "[Custom] Guarantee List",
      "category": "Product"
    }
  ]
}
{% endschema %}
