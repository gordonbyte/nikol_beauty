<path d="M12 10.6955C12 10.7317 12.009 10.7739 12.0271 10.8221C12.0452 10.8704 12.0663 10.9065 12.0904 10.9306L16.1566 15L12.0904 19.0513C12.0663 19.0875 12.0452 19.1266 12.0271 19.1689C12.009 19.2111 12 19.2502 12 19.2864C12 19.3346 12.009 19.3799 12.0271 19.4221C12.0452 19.4643 12.0663 19.5034 12.0904 19.5396L12.6145 20.046C12.6506 20.0822 12.6898 20.1093 12.7319 20.1274C12.7741 20.1455 12.8133 20.1545 12.8494 20.1545C12.8976 20.1545 12.9428 20.1455 12.9849 20.1274C13.0271 20.1093 13.0602 20.0822 13.0843 20.046L17.9096 15.2351C17.9337 15.199 17.9548 15.1598 17.9729 15.1176C17.991 15.0754 18 15.0362 18 15C18 14.9518 17.991 14.9066 17.9729 14.8644C17.9548 14.8222 17.9337 14.789 17.9096 14.7649L13.0843 9.93591C13.0602 9.9118 13.0271 9.8907 12.9849 9.87261C12.9428 9.85453 12.8976 9.84548 12.8494 9.84548C12.8133 9.84548 12.7741 9.85453 12.7319 9.87261C12.6898 9.8907 12.6506 9.9118 12.6145 9.93591L12.0904 10.4604C12.0663 10.4845 12.0452 10.5177 12.0271 10.5599C12.009 10.6021 12 10.6473 12 10.6955Z" fill="white"/>
</svg>
</div>
                    </div>
                      </div>

                    {%- endif -%}

                  {%- when 'pickup' -%}
                    <pickup-availability class="product__block product__pickup block-padding" data-store-availability-container="{{ current_variant.id }}" {{ block.shopify_attributes }} {{ block_style }}></pickup-availability>

                  {%- when 'rating_summary' -%}
                    {%- if block.settings.rating_text != blank or block.settings.review_count_text != blank or block.settings.summary_suffix != blank -%}
                      <div class="product__block block-padding" {{ block_style }} {{ block.shopify_attributes }}>
                        <div class="cw-bb-rating-box" {% if block.settings.anchor_id != blank %}id="{{ block.settings.anchor_id }}"{% endif %}>
                          {% if block.settings.link_url != blank %}<a href="{{ block.settings.link_url }}">{% endif %}
                            {%- if block.settings.rating_image != blank or block.settings.rating_image_url != blank -%}
                              <div class="cw-bb-rating-image">
                                {%- if block.settings.rating_image != blank -%}
                                  {{ block.settings.rating_image | image_url: width: 320 | image_tag: alt: block.settings.rating_image_alt, loading: 'lazy' }}
                                {%- else -%}
                                  <img src="{{ block.settings.rating_image_url }}" alt="{{ block.settings.rating_image_alt }}" loading="lazy">
                                {%- endif -%}
                              </div>
                            {%- endif -%}

                            <div class="cw-bb-rating-text">
                              {%- if block.settings.rating_text != blank -%}<strong>{{ block.settings.rating_text }}</strong>{%- endif -%}
                              {%- if block.settings.review_count_text != blank -%} stars | <strong>{{ block.settings.review_count_text }}</strong>{%- endif -%}
                              {%- if block.settings.summary_suffix != blank -%} {{ block.settings.summary_suffix }}{%- endif -%}
                            </div>
                          {% if block.settings.link_url != blank %}</a>{% endif %}
                        </div>
                      </div>
                    {%- endif -%}

                  {%- when 'payment_details' -%}
                    <div class="product__block block-padding" {{ block_style }} {{ block.shopify_attributes }}>
                      <div class="cw-bb-color-main-container">
                        {%- if block.settings.installment_text != blank or block.settings.payment_logo != blank or block.settings.learn_more_text != blank -%}
                          <div class="cw-bb-color-top-bar">
                            <div class="cw-bb-color-top-inner">
                              <div class="cw-bb-color-top-text">
                                {{ block.settings.installment_text }}
                                {%- if block.settings.payment_logo != blank or block.settings.payment_logo_url != blank -%}
                                  {%- if block.settings.payment_logo != blank -%}
                                    {{ block.settings.payment_logo | image_url: width: 180 | image_tag: class: 'cw-bb-color-shop-pay-img', alt: block.settings.payment_logo_alt, loading: 'lazy' }}
                                  {%- else -%}
                                    <img class="cw-bb-color-shop-pay-img" src="{{ block.settings.payment_logo_url }}" alt="{{ block.settings.payment_logo_alt }}" loading="lazy">
                                  {%- endif -%}
                                {%- endif -%}
                                {%- if block.settings.learn_more_text != blank -%}
                                  <a href="{{ block.settings.learn_more_url | default: '#' }}" class="cw-bb-color-learn-more">{{ block.settings.learn_more_text }}</a>
                                {%- endif -%}
                              </div>
                            </div>
                          </div>
                        {%- endif -%}

                        {%- if block.settings.description != blank -%}
                          <div class="cw-bb-color-description">
                            {{ block.settings.description }}
                          </div>
                        {%- endif -%}

                        {%- assign feature_1 = block.settings.feature_1 | strip -%}
                        {%- assign feature_2 = block.settings.feature_2 | strip -%}
                        {%- assign feature_3 = block.settings.feature_3 | strip -%}
                        {%- if feature_1 != blank or feature_2 != blank or feature_3 != blank -%}
                          <div class="cw-bb-color-features">
                            <ul class="cw-bb-color-feature-list">
                              {%- if feature_1 != blank -%}<li class="cw-bb-color-feature-item">{{ feature_1 }}</li>{%- endif -%}
                              {%- if feature_2 != blank -%}<li class="cw-bb-color-feature-item">{{ feature_2 }}</li>{%- endif -%}
                              {%- if feature_3 != blank -%}<li class="cw-bb-color-feature-item">{{ feature_3 }}</li>{%- endif -%}
                            </ul>
                          </div>
                        {%- endif -%}
                      </div>
                    </div>

                  {%- when 'color_picker' -%}
                    {%- liquid
                      assign option_name = block.settings.option_name | default: 'Color'
                      assign color_option = product.options_with_values | where: 'name', option_name | first
                    -%}
                    {%- if color_option -%}
                      <div class="product__block block-padding" {{ block_style }} {{ block.shopify_attributes }}>
                        <div class="cw-bb-color-chooser-title">
                          {{ block.settings.label | default: 'Choose Color:' }}
                          <span class="cw-bb-color-selected">
                            {{ color_option.selected_value }}
                          </span>
                        </div>

                        <div class="cw-bb-color-image-wrapper">
                          {%- for value in color_option.values -%}
                            {%- assign matching_swatch = blank -%}
                            {%- assign value_index = forloop.index -%}
                            {%- assign swatch_count = 0 -%}
                            {%- for swatch_block in section.blocks -%}
                              {%- if swatch_block.type == 'color_swatch_item' -%}
                                {%- assign swatch_count = swatch_count | plus: 1 -%}
                                {%- if swatch_block.settings.option_value == value -%}
                                  {%- assign matching_swatch = swatch_block -%}
                                  {%- break -%}
                                {%- elsif matching_swatch == blank and swatch_count == value_index -%}
                                  {%- assign matching_swatch = swatch_block -%}
                                {%- endif -%}
                              {%- endif -%}
                            {%- endfor -%}

                            {%- assign matching_swatch_has_image = false -%}
                            {%- if matching_swatch != blank -%}
                              {%- if matching_swatch.settings.image != blank or matching_swatch.settings.image_url != blank -%}
                                {%- assign matching_swatch_has_image = true -%}
                              {%- endif -%}
                            {%- endif -%}

                            {%- if matching_swatch_has_image -%}
                              <div class="cw-bb-color-swatch {% if value == color_option.selected_value %}is-active{% endif %}" data-value="{{ value }}">
                                {%- if matching_swatch.settings.image != blank -%}
                                  {{ matching_swatch.settings.image | image_url: width: 160 | image_tag: class: 'cw-color', alt: matching_swatch.settings.image_alt, loading: 'lazy' }}
                                {%- else -%}
                                  <img src="{{ matching_swatch.settings.image_url }}" alt="{{ matching_swatch.settings.image_alt }}" class="cw-color" loading="lazy">
                                {%- endif -%}
                              </div>
                            {%- endif -%}
                          {%- endfor -%}
                        </div>
                      </div>
                    {%- endif -%}

                  {%- when 'color_swatch_item' -%}
                    {% comment %} Rendered by the color picker block. {% endcomment %}

                  {%- when 'bundle_item' -%}
                    {%- liquid
                      assign product_title_downcase = product.title | downcase
                      assign show_bundle_item = false
                      if block.settings.show_for_product_titles == blank
                        assign show_bundle_item = true
                      else
                        assign allowed_titles = block.settings.show_for_product_titles | downcase | split: ','
                        for allowed_title in allowed_titles
                          assign normalized_allowed_title = allowed_title | strip
                          if normalized_allowed_title == product_title_downcase
                            assign show_bundle_item = true
                            break
                          endif
                        endfor
                      endif

                      assign prev_bundle_visible = false
                      if forloop.index0 > 0
                        assign prev_index = forloop.index0 | minus: 1
                        assign prev_block = section.blocks[prev_index]
                        if prev_block.type == 'bundle_item'
                          if prev_block.settings.show_for_product_titles == blank
                            assign prev_bundle_visible = true
                          else
                            assign prev_allowed_titles = prev_block.settings.show_for_product_titles | downcase | split: ','
                            for prev_allowed_title in prev_allowed_titles
                              assign normalized_prev_allowed_title = prev_allowed_title | strip
                              if normalized_prev_allowed_title == product_title_downcase
                                assign prev_bundle_visible = true
                                break
                              endif
                            endfor
                          endif
                        endif
                      endif

                      assign next_bundle_visible = false
                      if forloop.index < section.blocks.size
                        assign next_index = forloop.index0 | plus: 1
                        assign next_block = section.blocks[next_index]
                        if next_block.type == 'bundle_item'
                          if next_block.settings.show_for_product_titles == blank
                            assign next_bundle_visible = true
                          else
                            assign next_allowed_titles = next_block.settings.show_for_product_titles | downcase | split: ','
                            for next_allowed_title in next_allowed_titles
                              assign normalized_next_allowed_title = next_allowed_title | strip
                              if normalized_next_allowed_title == product_title_downcase
                                assign next_bundle_visible = true
                                break
                              endif
                            endfor
                          endif
                        endif
                      endif
                    -%}
                    {%- if show_bundle_item -%}
                      {%- unless prev_bundle_visible -%}
                        <div class="product__block block-padding" {{ block_style }} {{ block.shopify_attributes }}>
                          <div style="display:flex; flex-direction:column; margin-top:30px;">
                            {%- if block.settings.heading != blank -%}
                              <p><b>{{ block.settings.heading }}</b></p>
                            {%- endif -%}
                      {%- endunless -%}

                      <div style="display:flex; flex-direction:row; align-items:center; margin-bottom:12px;">
                        {%- if block.settings.item_url != blank -%}<a href="{{ block.settings.item_url }}">{%- endif -%}
                          {%- if block.settings.item_image != blank or block.settings.item_image_url != blank -%}
                            {%- if block.settings.item_image != blank -%}
                              {{ block.settings.item_image | image_url: width: 100 | image_tag: alt: block.settings.image_alt, loading: 'lazy', style: 'width:50px;height:50px;object-fit:contain;' }}
                            {%- else -%}
                              <img src="{{ block.settings.item_image_url }}" alt="{{ block.settings.image_alt }}" loading="lazy" style="width:50px;height:50px;object-fit:contain;">
                            {%- endif -%}
                          {%- endif -%}
                        {%- if block.settings.item_url != blank -%}</a>{%- endif -%}

                        <p style="margin-left:8px;">
                          {{ block.settings.item_title }}
                          {%- if block.settings.item_price != blank -%} {{ block.settings.item_price }}{%- endif -%}
                        </p>
                      </div>

                      {%- unless next_bundle_visible -%}
                          </div>
                        </div>
                      {%- endunless -%}
                    {%- endif -%}

                  {%- when 'testimonial_card' -%}
                    {%- if block.settings.quote != blank -%}
                      <div class="product__block block-padding" {{ block_style }} {{ block.shopify_attributes }}>
                        <div class="mp-review-box main-product-box">
                          {%- if block.settings.star_image != blank or block.settings.star_image_url != blank -%}
                            <div class="mp-review-stars">
                              {%- if block.settings.star_image != blank -%}
                                {{ block.settings.star_image | image_url: width: 320 | image_tag: alt: block.settings.star_image_alt, loading: 'lazy' }}
                              {%- else -%}
                                <img src="{{ block.settings.star_image_url }}" alt="{{ block.settings.star_image_alt }}" loading="lazy">
                              {%- endif -%}
                            </div>
                          {%- endif -%}

                          <div class="mp-review-text">
                            {{ block.settings.quote }}
                          </div>

                          {%- if block.settings.author_name != blank or block.settings.show_verified -%}
                            <div class="mp-author-box">
                              {%- if block.settings.author_name != blank -%}
                                <div class="mp-author-name">
                                  {{ block.settings.author_name }}
                                </div>
                              {%- endif -%}

                              {%- if block.settings.show_verified -%}
                                <div class="mp-verified">
                                  {%- if block.settings.verified_icon != blank or block.settings.verified_icon_url != blank -%}
                                    {%- if block.settings.verified_icon != blank -%}
                                      {{ block.settings.verified_icon | image_url: width: 48 | image_tag: alt: block.settings.verified_icon_alt, loading: 'lazy' }}
                                    {%- else -%}
                                      <img src="{{ block.settings.verified_icon_url }}" alt="{{ block.settings.verified_icon_alt }}" loading="lazy">
                                    {%- endif -%}
                                  {%- endif -%}
                                  <div class="mp-verified-text">
                                    {{ block.settings.verified_text }}
                                  </div>
                                </div>
                              {%- endif -%}
                            </div>
                          {%- endif -%}
                        </div>
                      </div>
                    {%- endif -%}

                  {%- when 'code' -%}
                    <div class="product__block product__custom-code block-padding" {{ block_style }} {{ block.shopify_attributes }}>
                      {{ block.settings.code }}
                    </div>

                  {%- when 'siblings' -%}
                    {%- render 'product-siblings' product: product, product_form_id: product_form_id, block: block, block_style: block_style, quick_add_product: false -%}

                  {%- when 'text' -%}
                    {% comment %} Text block for product {% endcomment %}
{%- if block.settings.title != blank or block.settings.text != blank -%}
  <div class="product__block product__text{% if block.settings.layout == "inline" %} product__text--inline{% endif %} block-padding" {{ block.shopify_attributes }} {{ block_style }}>
    {%- if block.settings.title != blank -%}
      <p class="product__heading strong">
        {{- block.settings.title -}}
      </p>
    {%- endif -%}

    {%- if block.settings.text != blank -%}
      <div class="product__subheading">
        {{- block.settings.text -}}
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

                  {%- when 'icon' -%}

                    {% comment %} Icon block for Product {% endcomment %}
{%- liquid
  assign prev_index = forloop.index0 | minus: 1
  assign next_index = forloop.index0 | plus: 1
  assign prev_block = section.blocks[prev_index]
  assign next_block = section.blocks[next_index]
  assign image = block.settings.image
  assign icon_color = block.settings.icon_color
  assign width = block.settings.width

  capture block_style
    echo 'style="'
    if icon_color != blank and icon_color != 'rgba(0,0,0,0)'
      echo '--text: ' | append: icon_color | append: ';'
    endif
    echo '--block-padding-bottom: ' | append: block.settings.padding_bottom | append: 'px;'
    echo '"'
  endcapture
-%}

{%- if forloop.index0 == 0 or prev_block.type != 'icon' -%}
  <div class="product__icon__row">
{%- endif -%}

<div class="product__block product__icon__container product__icon__container--{{ width }} block-padding"
  {{ block.shopify_attributes }}
  {{ block_style }}
>
  {%- liquid
    assign icon_size = block.settings.icon_size
    assign icon_color = block.settings.icon_color
    capture icon_style
      echo 'style="'
      echo '--icon-size: ' | append: icon_size | append: 'px;'
      if icon_color != blank and icon_color != 'rgba(0,0,0,0)'
        echo ' --text: ' | append: icon_color | append: ';'
      endif
      echo '"'
    endcapture
  -%}
  <div class="product__icon" data-aos="img-in" {{ icon_style }}>
    {%- liquid
      if image
        assign icon_width = icon_size
        assign icon_width_retina = icon_width | times: 2
        assign icon_sizes = icon_width | append: 'px'
        assign icon_widths = icon_width | append: ', ' | append: icon_width_retina

        render 'image' image: image, width: icon_width_retina, sizes: icon_sizes, widths: icon_widths, show_backfill: false
      else
        render 'animated-icon', filename: block.settings.icon_name
      endif
    -%}
  </div>

  {%- if block.settings.title != blank -%}
    {%- assign font_size_class = block.settings.text_size | prepend: 'body-size-' -%}
    <div class="product__icon__text {{ font_size_class }}" data-aos="fade" data-aos-duration="500">
      <p>{{ block.settings.title }}</p>
    </div>
  {%- endif -%}
</div>

{%- if forloop.index == section.blocks.size or next_block.type != 'icon' -%}
</div>
{%- endif -%}

                  {%- when 'sharing' -%}
                    <div class="product__block block-padding" {{ block.shopify_attributes }} {{ block_style }}>
                      {%- assign share_url = current_variant.url | prepend: request.origin -%}
                      {%- render 'share-button' share_url: share_url -%}
                    </div>

                  {%- when 'divider' -%}
                    {%- render 'divider' block: block, modifier: 'product__block product__block--divider' -%}

                  {%- when 'line-item' -%}
                    <div class="product__block{% if settings.show_lines %} product__block--lines{% endif %} select__fieldset block-padding" {{ block.shopify_attributes }} {{ block_style }}>
  {%- if block.settings.label != blank -%}
    {%- assign input_id = unique | append: '-' | append: block.id | append: '-' | append: forloop.index -%}
    {%- assign required = block.settings.required -%}
    {%- case block.settings.type -%}
      {%- when 'text' -%}
        <label for="{{ input_id }}" class="select__label">{{ block.settings.label | escape_once }}</label>

        <input
          type="text" class="properties__input"
          id="{{ input_id }}"
          form="{{ product_form_id }}"
          {% if required %} required {% endif %}
          name="properties[{{ block.settings.label | escape_once }}]">

      {%- when 'checkbox' -%}
        {%- if block.settings.unchecked_value != blank and block.settings.checked_value != blank -%}
          <div class="properties__checkbox checkbox">
            <input
              type="hidden"
              name="properties[{{ block.settings.label | escape_once }}]"
              form="{{ product_form_id }}"
              value="{{ block.settings.unchecked_value }}">

            <input
              type="checkbox"
              name="properties[{{ block.settings.label | escape_once }}]"
              id="{{ input_id }}"
              form="{{ product_form_id }}"
              value="{{ block.settings.checked_value }}">

            <label
              class="radio__fieldset__label"
              for="{{ input_id }}">{{ block.settings.label | escape_once }}</label>
          </div>
        {%- endif -%}

    {%- when 'dropdown' -%}
      {%- capture line_item_options -%}
        <ul id="{{ unique }}-select-{{ option.name | handle }}" class="select-popout__list" data-popout-list data-scroll-lock-scrollable>
          {%- assign has_selected = false -%}
          {%- assign selected_value = '' -%}

          {%- for i in (1..3) -%}
            {%- assign value = 'option_' | append: forloop.index -%}
            {%- assign value = block.settings[value] -%}

            {%- if value != blank -%}
              <li class="select-popout__item{% unless has_selected %} is-active{% endunless %}">
                <a class="select-popout__option"
                  href="#"
                  {% unless has_selected %}aria-current="true"{% endunless %}
                  data-value="{{ value | escape_once }}"
                  data-popout-option>
                  <span>
                    {{ value | escape_once }}
                  </span>
                </a>
              </li>

              {%- unless has_selected -%}
                {%- assign selected_value = value -%}
              {%- endunless -%}
              {%- assign has_selected = true -%}
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endcapture -%}

      {%- if has_selected -%}
        <span class="radio__legend">
          <span class="radio__legend__label">{{ block.settings.label | escape_once }}</span>
        </span>

        <popout-select class="select-popout">
          <button type="button"
            class="select-popout__toggle"
            aria-expanded="false"
            aria-controls="{{ unique }}-select-{{ option.name | handle }}"
            aria-labelledby="{{ unique }}-select-{{ option.name | handle }}-label"
            data-popout-toggle>
            <span data-popout-toggle-text>{{ selected_value }}</span>
            {%- render 'icon-nav-arrow-down' -%}
          </button>

          {{ line_item_options }}

          <input
            type="hidden"
            name="properties[{{ block.settings.label | escape_once }}]"
            id="{{ input_id }}"
            value="{{ selected_value | escape_once }}"
            form="{{ product_form_id }}"
            data-popout-input
            data-single-option-selector>
        </popout-select>
      {%- endif -%}
    {%- endcase -%}
  {%- endif -%}


                  {%- when 'features' -%}
                    {% comment %} Features block for Product {% endcomment %}

                    {%- liquid
                      assign block_id = block.id
                      assign text = block.settings.text
                      assign title = block.settings.title
                      assign prev_index = forloop.index0 | minus: 1
                      assign next_index = forloop.index0 | plus: 1
                      assign prev_block = section.blocks[prev_index]
                      assign next_block = section.blocks[next_index]
                      assign image = block.settings.icon_alt
                      assign bg_color = block.settings.bg_color
                      assign text_color = block.settings.color

                      comment
                        Always force dots style to be "line" except if "Circle" is chosen from the global settings
                      endcomment
                      assign dots_style = 'line'
                      if settings.dots_style == 'circle'
                        assign dots_style = 'circle'
                      endif

                      capture style
                        if bg_color != 'rgba(0,0,0,0)' and bg_color != blank
                          echo '--bg: ' | append: bg_color | append: ';'
                        endif

                        if text_color != 'rgba(0,0,0,0)' and text_color != blank
                          echo '--text: ' | append: text_color | append: ';'
                        endif
                      endcapture
                    -%}

                    {%- if forloop.index0 == 0 or prev_block.type != 'features' -%}
                      {%- assign slide_index = 0 -%}
                      <div class="product__block product__features block-padding"
                        {{ block_style }}
                        data-slider
                        data-slider-fullwidth
                        data-dots="{{ dots_style }}"
                        data-options='{"pageDots": true, "adaptiveHeight": true, "autoPlay": false, "prevNextButtons": false, "fade": false, "draggable": ">1"}'
                      >
                    {%- endif -%}

                    <div class="product__feature"
                      data-slide="{{ block_id }}"
                      data-slide-index="{{ slide_index }}"
                      data-block-id="{{ block_id }}"
                      {% if style != blank %}
                        style="{{ style }}"
                      {% endif %}
                      {{ block.shopify_attributes }}>

                      <div class="product__feature__content">
                        <div class="product__icon__container product__feature__heading">
                          {%- assign icon_size = block.settings.icon_size -%}
                          <div class="product__icon" style="--icon-size: {{ icon_size }}px;">
                            {%- liquid
                              if image
                                assign icon_width = icon_size
                                assign icon_width_retina = icon_width | times: 2
                                assign icon_sizes = icon_width | append: 'px'
                                assign icon_widths = icon_width | append: ', ' | append: icon_width_retina
                                render 'image' image: image, width: icon_width_retina, sizes: icon_sizes, widths: icon_widths, show_backfill: false
                              else
                                render 'animated-icon', filename: block.settings.icon_name
                              endif
                            -%}
                          </div>

                          {%- if title != blank -%}
                            {%- assign font_size_class = block.settings.text_size | prepend: 'body-size-' -%}
                            <div class="product__icon__text {{ font_size_class }}">
                              <p>{{ title }}</p>
                            </div>
                          {%- endif -%}
                        </div>

                        {%- if text != blank -%}
                          <div class="rte">
                            {{ text }}
                          </div>
                        {%- endif -%}
                      </div>
                    </div>

                    {%- if forloop.index == section.blocks.size or next_block.type != 'features' -%}
                      </div>
                    {%- endif -%}

                    {%- assign slide_index = slide_index | plus: 1 -%}

                  {%- when 'popup' -%}
                    {%- liquid
  assign link_text = block.settings.title
  assign popup_content = block.settings.page.content | default: block.settings.text
  assign image = block.settings.image
  assign icon_size = block.settings.icon_size
  assign icon_color = block.settings.icon_color

  capture block_style
    echo 'style="'
    echo '--block-padding-bottom: ' | append: block.settings.padding_bottom | append: 'px;'
    echo '"'
  endcapture

  capture icon_style
    echo 'style="'
    echo '--icon-size: ' | append: icon_size | append: 'px;'
    if icon_color != blank and icon_color != 'rgba(0,0,0,0)'
      echo '--text: ' | append: icon_color | append: ';'
    endif
    echo '"'
  endcapture
-%}

<product-modal class="product__block block-padding" {{ block_style }}>
  <div class="product__icon__container product__icon__container--full">
    <div class="product__icon" data-aos="img-in" {{ icon_style }}>
      {%- liquid
        if image
          assign icon_width = icon_size
          assign icon_width_retina = icon_width | times: 2
          assign icon_sizes = icon_width | append: 'px'
          assign icon_widths = icon_width | append: ', ' | append: icon_width_retina

          render 'image' image: image, width: icon_width_retina, sizes: icon_sizes, widths: icon_widths, show_backfill: false
        else
          render 'animated-icon', filename: block.settings.icon_name
        endif
      -%}
    </div>

    <a class="radio__legend__link text-link" href="{{ block.settings.page.url }}" data-popup-open {{ block.shopify_attributes }}>
      {{ link_text | escape }}
    </a>
  </div>

  <dialog class="product-modal" aria-hidden="true" inert data-scroll-lock-required>
    <form method="dialog">
      <button class="visually-hidden no-js" aria-label="{{ 'general.accessibility.close' | t }}"></button>
    </form>

    <div class="product-modal__outer">
      <div class="product-modal__content small" data-scroll-lock-scrollable>
        <button type="button" class="product-modal__close" data-popup-close autofocus aria-label="{{ 'general.accessibility.close' | t }}">
          {%- render 'icon-cancel' -%}
        </button>

        {{ popup_content }}
      </div>
    </div>
  </dialog>
</product-modal>

                  {%- when 'complementary-products' -%}
                    <div class="product__block product__complementary block-padding" {{ block.shopify_attributes }} {{ block_style }}>
                      <complementary-products class="complementary-products"
                        data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=10&intent=complementary" >
                        {%- if recommendations.performed and recommendations.products_count > 0 -%}
                          {%- assign complementary_products_title = 'products.general.complementary_products_title' | t -%}
                          {%- if complementary_products_title != blank -%}
                            <p class="complementary-products__title">{{ complementary_products_title }}</p>
                          {%- endif -%}

                          {%- for product in recommendations.products limit: block.settings.complementary_limit-%}
                            {%- render 'upsell-product', upsell_product: product -%}
                          {%- endfor -%}
                        {%- endif -%}
                      </complementary-products>
                    </div>

                  {%- when 'badges' -%}
                    <div class="product__block product__badges block-padding"
                      {{ block.shopify_attributes }}
                      {{ block_style }}>

                      {%- if badge != '' and block.settings.product_badges -%}
                        <span class="badge-box">{{ badge }}</span>
                      {%- endif -%}

                      {%- if preorder and sold_out == false and block.settings.product_badges-%}
                        <span class="preorder-box">{{ 'products.product.pre_order' | t }}</span>
                      {%- endif -%}

                      {%- if on_sale and sold_out == false and block.settings.sale_badge -%}
                        <span class="sale-box">{{ 'products.product.on_sale' | t }}</span>
                      {%- endif -%}
                    </div>

                {%- endcase -%}
              {%- endfor -%}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  {% unless product == empty %}
    <script type="application/json" data-product-json>
      {{ product | json }}
    </script>
    <script type="application/json" id="ModelJSON-{{ unique }}">
      {{ product.media | where: 'media_type', 'model' | json }}
    </script>
  {% endunless %}


  {% comment %} Google wants to know when to check your price again {% endcomment %}

  {%- liquid
    assign days_price_is_valid = 1
    assign seconds_in_a_day = 86400
    assign seconds_price_valid = days_price_is_valid | times: seconds_in_a_day

    if product.selected_or_first_available_variant.featured_media
      assign seo_media = product.selected_or_first_available_variant.featured_media
    else
      assign seo_media = product.featured_media
    endif
  -%}

  <script type="application/ld+json">
  {
    "@context": "http://schema.org/",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ request.origin | append: product.url | json }},
    {% if seo_media -%}
      "image": [
        {{ seo_media | image_url: width: 1920 | prepend: "https:" | json }}
      ],
    {%- endif %}
    "description": {{ product.description | strip_html | json }},
    {%- render 'product-jsonld-rating', product: product -%}
    {%- if current_variant.sku != blank -%}
      "sku": {{ current_variant.sku | json }},
    {%- endif -%}
    "brand": {
      "@type": "Organization",
      "name": {{ product.vendor | json }}
    },
    "offers": [
      {%- for variant in product.variants -%}
        {
          "@type" : "Offer",
          {%- if variant.sku != blank -%}
            "sku": {{ variant.sku | json }},
          {%- endif -%}
          {%- if variant.barcode.size == 12 -%}
            "gtin12": {{ variant.barcode }},
          {%- endif -%}
          {%- if variant.barcode.size == 13 -%}
            "gtin13": {{ variant.barcode }},
          {%- endif -%}
          {%- if variant.barcode.size == 14 -%}
            "gtin14": {{ variant.barcode }},
          {%- endif -%}
          "availability" : "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "price" : {{ variant.price | divided_by: 100.00 | json }},
          "priceCurrency" : {{ cart.currency.iso_code | json }},
          "priceValidUntil": "{{ 'now' | date: '%s' | plus: seconds_price_valid | date: '%Y-%m-%d' }}",
          "url" : {{ request.origin | append: variant.url | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
  </script>

  {%- if show_cart_bar -%}
    {% render 'cart-bar', product: product, form_blocks: section.blocks %}

  {%- endif -%}
</div>





<script>
  document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll(".complete-look-slider").forEach(function (sliderEl) {
      // Scope the nav buttons to this slider's own container so they don't
      // collide with other ".swiper-button-next/prev" elements on the page.
      var navScope = sliderEl.closest(".complete-look-slider-main") || sliderEl.parentElement;
      new Swiper(sliderEl, {
        slidesPerView: 1,
        spaceBetween: 16,
        navigation: {
          nextEl: navScope.querySelector(".swiper-button-next"),
          prevEl: navScope.querySelector(".swiper-button-prev")
        }
      });
    });
  });
</script>

<script>
document.addEventListener("DOMContentLoaded", function () {

  const thumbSwiper = new Swiper(".cw-new-popup-thumb-slider", {
    spaceBetween: 15,
    slidesPerView: 4,
    watchSlidesProgress: true,
    navigation: {
      nextEl: ".swiper-button-nextpt",
      prevEl: ".swiper-button-prevpt",
    },
  });

  new Swiper(".cw-new-popup-main-slider", {
    spaceBetween: 10,
    thumbs: { swiper: thumbSwiper },

  });

});
</script>

<script>
document.addEventListener("DOMContentLoaded", function () {

  const customSwatches = document.querySelectorAll(".cw-bb-color-swatch");
  const selectedText = document.querySelector(".cw-bb-color-selected");

  customSwatches.forEach(swatch => {

    swatch.addEventListener("click", function () {

      const value = this.dataset.value;

      /* Update custom UI */
      customSwatches.forEach(s => s.classList.remove("is-active"));
      this.classList.add("is-active");

      if (selectedText) {
        selectedText.textContent = value;
      }

      /* 🔥 FIND MATCHING SHOPIFY LABEL */
      const shopifyLabel = document.querySelector(
        `.radio__fieldset label[data-swatch="${value}"]`
      );

      if (shopifyLabel) {
        shopifyLabel.click(); // ✅ THIS IS THE KEY
      } else {
        console.warn("Shopify swatch not found for:", value);
      }

    });

  });

});
</script>

