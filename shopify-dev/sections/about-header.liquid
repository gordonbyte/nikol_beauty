<div class="about-header site-about-header-wrapper">
  <style>
    .about-header {
      background-color: {{ section.settings.bg_color | default: '#FCC9C6' }};
    }
  </style>
  <div class="about-header__inner">
    <div class="about-header__left">
      <figure class="about-header__image">  
        <img
          src="{{ section.settings.image | image_url }}"
          alt="{{ section.settings.image.alt | default: section.settings.title | default: shop.name | strip_html | escape }}"
          loading="eager"
          />
        </figure>
    </div>
    <div class="about-header__right">
      <h1 class="about-header__title">
        {{ section.settings.title }}
      </h1>

    	<div class="about-header__copy">
        {{ section.settings.copy }}
      </div>
    </div>
  </div>
</div>


{% schema %}
{
  "name": "About Header",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "richtext",
      "id": "copy",
      "label": "Copy",
      "default": "<p>Lorem ipsum</p>"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#FCC9C6"
    }
  ],
  "presets": [{
    "name": "About Header",
    "category": "Image"
  }]
}
{% endschema %}
