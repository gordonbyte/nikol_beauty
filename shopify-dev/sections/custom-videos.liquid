{%- style -%}
  #Videos-{{ section.id }} {
    --custom-videos-bg: {{ section.settings.background_color }};
  }
{%- endstyle -%}

<style>
.custom-videos {
  padding: 80px 0;
  background: var(--custom-videos-bg);
  overflow-x: clip;
}

.custom-videos__parent {
  max-width: 1000px;
  margin: 0 auto;
}

.custom-videos__header {
  text-align: center;
}

.custom-videos__title {
  margin: 0;
  color: var(--COLOR-TEXT);
  font-family: 'Cormorant';
  font-size: 56px;
  font-weight: 500;
  line-height: 110%;
  letter-spacing: -3px;
  text-transform: capitalize;
}

.custom-videos__subtitle {
  margin: 0;
  padding-top: 20px;
  padding-bottom: 40px;
  color: var(--COLOR-TEXT);
  font-family: 'Inter';
  font-size: 20px;
}

.custom-videos__video {
  width: 100%;
}

.custom-videos__tolstoy {
  position: relative;
  width: 100vw;
  max-width: 100vw;
  margin-left: calc(50% - 50vw);
}

/* Edge fades + floating circle arrows, matching custom-product-slider so the
   carousels read as one system. Tolstoy's own arrows stay in the DOM (hidden)
   and our buttons forward clicks to them — Tolstoy keeps doing the scrolling. */
@media only screen and (min-width: 1200px) {
  .custom-videos__tolstoy::before,
  .custom-videos__tolstoy::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    width: 260px;
    z-index: 2;
    pointer-events: none;
  }

  .custom-videos__tolstoy::before {
    left: 0;
    background: linear-gradient(to right, var(--custom-videos-bg) 30%, transparent);
  }

  .custom-videos__tolstoy::after {
    right: 0;
    background: linear-gradient(to left, var(--custom-videos-bg) 30%, transparent);
  }
}

.custom-videos__tolstoy [class*="arrow-button-container"] {
  opacity: 0 !important;
  pointer-events: none !important;
}

.custom-videos__nav {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 3;
  background: none;
  border: 0;
  padding: 0;
  line-height: 0;
  cursor: pointer;
}

.custom-videos__nav--prev {
  left: 40px;
}

.custom-videos__nav--next {
  right: 40px;
}

.custom-videos__nav svg {
  transition: transform 0.3s ease;
}

.custom-videos__nav svg rect {
  fill: #ffffff;
}

.custom-videos__nav svg path {
  fill: var(--custom-videos-bg);
}

@media (hover: hover) {
  .custom-videos__nav:hover svg {
    transform: scale(1.08);
  }
}

.custom-videos__nav:focus-visible {
  outline: 2px solid var(--COLOR-TEXT);
  outline-offset: 2px;
}

@media only screen and (max-width: 749px) {
  .custom-videos__nav--prev {
    left: 10px;
  }

  .custom-videos__nav--next {
    right: 10px;
  }

  .custom-videos__nav svg {
    width: 36px;
    height: 36px;
  }
}

.custom-videos__tolstoy .tolstoy-carousel-container,
.custom-videos__tolstoy .tolstoy-video-carousel-container,
.custom-videos__tolstoy .tolstoy-carousel-videos-container {
  width: 100% !important;
  max-width: 100% !important;
}

.custom-videos__tolstoy [class*="carouselContainer"] {
  width: 95% !important;
  max-width: 95% !important;
}

.custom-videos__btn-wrap {
  padding: 0;
  padding-top: 50px;
  text-align: center;
}

.custom-videos__btn-wrap a {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
  width: 100%;
  max-width: 400px;
  height: 60px;
  margin: 0 auto;
  background: var(--BTN-PRIMARY-BG-COLOR);
  color: var(--BTN-PRIMARY-TEXT-COLOR);
  font-family: var(--BTN-FONT-STACK);
  font-size: var(--BTN-FONT-SIZE);
  font-weight: 700;
  letter-spacing: 0;
  text-transform: uppercase;
  transition: background 0.3s ease;
}

.custom-videos__btn-wrap a:focus-visible {
  background: var(--BTN-PRIMARY-BG-COLOR-BRIGHTER);
  color: var(--BTN-PRIMARY-TEXT-COLOR);
}

@media (hover: hover) {
  .custom-videos__btn-wrap a:hover {
    background: var(--BTN-PRIMARY-BG-COLOR-BRIGHTER);
    color: var(--BTN-PRIMARY-TEXT-COLOR);
  }

  .custom-videos__btn-wrap a svg {
    transition: transform 0.5s ease;
    transform: translateZ(0);
  }

  .custom-videos__btn-wrap a:hover svg {
    transform: translate3d(5px, 0, 0);
  }
}

/* Scroll-in reveal: initial hidden states apply ONLY once JS adds anim-ready,
   so content stays visible without JS and under reduced motion. */
.custom-videos.anim-ready .custom-videos__header,
.custom-videos.anim-ready .custom-videos__slide,
.custom-videos.anim-ready .custom-videos__btn-wrap {
  opacity: 0;
  transform: translateY(26px);
  transition: opacity 0.65s ease, transform 0.65s ease;
}

.custom-videos.anim-ready .is-inview {
  opacity: 1;
  transform: none;
}

/* Tolstoy injects its tiles asynchronously and they pop in — hide the
   carousel until real content exists, then fade it up (is-loaded added by
   the script below). Rides anim-ready so all the animation guards apply. */
.custom-videos.anim-ready .custom-videos__tolstoy .tolstoy-carousel {
  opacity: 0;
  transform: translateY(18px);
  transition: opacity 0.8s ease, transform 0.8s ease;
}

.custom-videos.anim-ready .custom-videos__tolstoy .tolstoy-carousel.is-loaded {
  opacity: 1;
  transform: none;
}

@media only screen and (max-width: 600px) {
  .custom-videos {
    padding: 40px 15px;
  }

  .custom-videos__title {
    font-size: 34px;
  }

  .custom-videos__subtitle {
    font-size: var(--FONT-SIZE-BASE);
    line-height: 135%;
    padding-top: 15px;
    padding-bottom: 30px;
  }

  .custom-videos__btn-wrap {
    padding: 0 15px;
    padding-top: 30px;
  }

  .custom-videos__btn-wrap a {
    max-width: 100%;
    height: 50px;
    font-size: var(--BTN-FONT-SIZE);
  }
}
</style>

{%- if section.settings.enable_live_shopping_style -%}
