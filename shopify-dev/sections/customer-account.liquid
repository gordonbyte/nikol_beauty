<!-- /sections/customer-account.liquid -->

<section class="account">
  <div class="wrapper">
    <div class="grid grid--account">
      {%- capture links -%}
  <ul>
    {%- assign needs_completion = true -%}
    {%- for block in section.blocks -%}
      {%- case block.type -%}

        {%- when '@app' -%}
          {% render block %}

        {%- when 'link' -%}
          <li {{ block.shopify_attributes }}><a href="{{ block.settings.link }}" rel="noopener" target="_blank">{{ block.settings.title }}</a></li>

        {%- when 'email' -%}
          {% assign default_text = 'customer.account.contact_store' | t %}
          {% assign default_email = shop.email %}
          <li {{ block.shopify_attributes }}><a href="mailto:{{ block.settings.email | default: default_email }}" rel="noopener" target="_blank">{{ block.settings.title | default: default_text }}</a></li>

        {%- when 'account' -%}
          {%- assign needs_completion = false -%}
          <li {% if template == 'customers/account' %} class="is-current"{% endif %}><a href="{{ routes.account_url }}">{{ 'customer.orders.title' | t }}</a></li>
          <li {% if template contains 'addresses' %} class="is-current"{% endif %}><a href="{{ routes.account_addresses_url }}">{{ 'customer.account.view_addresses' | t }}</a></li>
          <li>{{ 'layout.customer.log_out' | t | customer_logout_link }}</li>

      {%- endcase -%}
    {%- endfor -%}

    {%- if needs_completion -%}
      <li {% if template == 'customers/account' %} class="is-current"{% endif %}><a href="{{ routes.account_url }}">{{ 'customer.orders.title' | t }}</a></li>
      <li {% if template contains 'addresses' %} class="is-current"{% endif %}><a href="{{ routes.account_addresses_url }}">{{ 'customer.account.view_addresses' | t }}</a></li>
      <li>{{ 'layout.customer.log_out' | t | customer_logout_link }}</li>
    {%- endif -%}
  </ul>
{%- endcapture -%}

<aside class="account-sidebar">
  <div class="desktop">
    <p class="account-sidebar__title strong">
      {{ 'customer.account.title' | t }}
    </p>

    {{ links }}
  </div>

  <div class="mobile">
    <collapsible-elements>
      <details data-collapsible open="true">
        <summary data-collapsible-trigger>
          <p class="account-sidebar__title strong">
            {{ 'customer.account.title' | t }}

            <span class="account-sidebar__state" aria-hidden="true">
              <span class="account-sidebar__state-closed">Tap to open</span>
              <span class="account-sidebar__state-open">Tap to close</span>
              <svg class="account-sidebar__chevron" width="16" height="16" viewBox="0 0 16 16" fill="none" focusable="false"><path d="M3 5.5L8 10.5L13 5.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </p>
        </summary>
        <div data-collapsible-body style="height: auto">
          <div data-collapsible-content>
            {{ links }}
          </div>
        </div>
      </details>
    </collapsible-elements>
  </div>
</aside>


      <div class="account-main">
        {%- if customer.first_name != blank -%}
          <p class="account-welcome">Welcome back, {{ customer.first_name }}</p>
        {%- endif -%}
        <h1 class="page__heading h2">{{ 'customer.orders.title' | t }}</h1>
        {% paginate customer.orders by 20 %}
          {% if customer.orders.size != 0 %}
            <table class="account-orders-table">
              <thead>
                <tr>
                  <th scope="col" class="order-number">{{ 'customer.orders.order_number' | t }}</th>
                  <th scope="col" class="date">{{ 'customer.orders.date' | t }}</th>
                  <th scope="col" class="payment-status">{{ 'customer.orders.payment_status' | t }}</th>
                  <th scope="col" class="fulfillment-status">{{ 'customer.orders.fulfillment_status' | t }}</th>
                  <th scope="col" class="total">{{ 'customer.orders.total' | t }}</th>
                </tr>
              </thead>
              <tbody>
                {% for order in customer.orders %}
                  <tr class="{% cycle 'odd', 'even' %} {% if order.cancelled %}cancelled_order{% endif %}">
                    <td class="order-number" data-label="{{ 'customer.orders.order_number' | t }}">
                      <span>{{ order.name | link_to: order.customer_url }}</span>
                    </td>
                    <td class="date" data-label="{{ 'customer.orders.date' | t }}"><span class="note">
                      <span>{{ order.created_at | date: format: 'full_date' }}</span>
                    </span></td>
                    <td class="payment-status" data-label="{{ 'customer.orders.payment_status' | t }}">
                      <span>{{ order.financial_status_label }}</span>
                      {% if order.cancelled %}
                        {% assign order_cancelled_at = order.cancelled_at | date: format: 'full_date_and_time' %}
                        <p class="small highlight">
                          {{ 'customer.order.cancelled' | t: date: order_cancelled_at }}
                          <br>
                          {{ 'customer.order.cancelled_reason' | t: reason: order.cancel_reason }}
                        </p>
                      {% endif %}
                    </td>
                    <td class="fulfillment-status" data-label="{{ 'customer.orders.fulfillment_status' | t }}">
                      <span>{{ order.fulfillment_status_label }}</span>
                    </td>
                    <td class="total" data-label="{{ 'customer.orders.total' | t }}">
                      <span class="total money">
                        {%- if order.total_price == 0 -%}
                          {{ 'general.money.free' | t }}
                        {%- else -%}
                          {{ order.total_price | money_with_currency }}
                        {%- endif -%}
                      </span>
                    </td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          {% else %}
            <div class="account-empty">
              <p>{{ 'customer.orders.none' | t }}</p>
              <a href="/collections/best-selling-products" class="btn btn--primary btn--solid"><span>Shop Our Best Sellers</span></a>
            </div>
          {% endif %}

          {% render 'pagination', paginate: paginate %}

        {% endpaginate %}
      </div>
    </div>
  </div>
</section>

{% schema %}
  {
    "name": "Account",
    "blocks": [
      {
        "type": "@app"
      },
      {
        "type": "account",
        "name": "Account links"
      },
      {
        "type": "email",
        "name": "Email link",
        "settings": [
          {
            "type": "text",
            "id": "title",
            "label": "Email title",
            "default": "Support"
          },
          {
            "type": "text",
            "id": "link",
            "label": "Link",
            "info": "Leave blank to use the store email address"
          }
        ]
      },
      {
        "type": "link",
        "name": "Link",
        "settings": [
          {
            "type": "text",
            "id": "title",
            "label": "Link title",
            "default": "Home"
          },
          {
            "type": "url",
            "id": "link",
            "label": "Link",
            "default": "/"
          }
        ]
      }
    ]
  }
{% endschema %}
