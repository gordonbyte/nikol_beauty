<div class="instagram-feed">
	<div class="instagram-feed__inner">
		<div class="instagram-feed__top">
			{%- if section.settings.title != blank -%}
				<h2 class="instagram-feed__title">
					{{ section.settings.title }}
				</h2>
			{%- endif -%}
			{%- if section.settings.handle != blank and section.settings.link != blank -%}
				<a
					class="instagram-feed__handle desktop-only"
					href="{{ section.settings.link }}"
				>
					{{ section.settings.handle }}
				</a>
			{%- endif -%}
		</div>
		<div id="insta-feed"></div>
		{%- if section.settings.handle != blank and section.settings.link != blank -%}
			<a
				class="instagram-feed__handle mobile-only"
				href="{{ section.settings.link }}"
			>
				{{ section.settings.handle }}
			</a>
		{%- endif -%}
	</div>
</div>

{% schema %}
{
  "name": "[Custom] Instagram Feed",
  "class": "instagram-feed-section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Shop the feed"
    },
    {
      "type": "text",
      "id": "handle",
      "label": "IG Handle"
    },
    {
      "type": "url",
      "id": "link",
      "label": "IG Link"
    }
  ],

  "presets": [{
    "name": "[Custom] Instagram Feed",
    "category": "Image"
  }]
}
{% endschema %}
