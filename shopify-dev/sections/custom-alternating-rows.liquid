<style>
.custom-alternating-rows {
    background-size: cover;
    background-repeat: no-repeat;
    background-position: center;
    padding: 90px 0;
    overflow: hidden;
}

.custom-alternating-rows__title {
    text-align: center;
    line-height: 110%;
    letter-spacing: -1px;
    font-weight: 500;
    text-wrap: pretty;
    max-width: 900px;
    margin: 0 auto;
    color: var(--COLOR-TEXT);
    font-family: var(--FONT-STACK-HEADING);
}

.custom-alternating-rows__subtitle {
    text-align: center;
    font-size: var(--FONT-SIZE-BASE);
    line-height: 140%;
    font-weight: 400;
    color: var(--COLOR-TEXT);
    margin: 0;
    padding-top: 20px;
    font-family: var(--FONT-STACK-BODY);
}

.custom-alternating-rows__rows {
    margin-top: 50px;
}

.custom-alternating-rows__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 25px;
    gap: 60px;
    background: var(--COLOR-BG);
    margin-bottom: 40px;
}

.custom-alternating-rows__media {
    width: 50%;
}

.custom-alternating-rows__body {
    width: 50%;
    padding-right: 60px;
}

.custom-alternating-rows__media img {
    width: 100%;
    max-width: 610px;
    height: auto;
    object-fit: contain;
}

/* Hover life: the row's photo eases into a gentle zoom under the pointer. */
@media (hover: hover) {
  .custom-alternating-rows__media img {
    transition: transform 0.45s ease;
  }

  .custom-alternating-rows__row:hover .custom-alternating-rows__media img {
    transform: scale(1.02);
  }
}

/* same treatment as .custom-icon-features__feature-text h3 / .custom-steps-horizontal__card h3 */
.custom-alternating-rows__row-title {
    margin: 0;
    color: var(--COLOR-TEXT);
    font-family: 'Cormorant', sans-serif;
    font-size: clamp(23px, 1.32vw + 15.1px, 32px);
    font-weight: 600;
    line-height: 120%;
    letter-spacing: 0;
    text-wrap: pretty;
}

@media only screen and (min-width: 1025px) {
.custom-alternating-rows__row-title {
    font-size: 41px;
}
}

.custom-alternating-rows__row-text {
    font-size: var(--FONT-SIZE-BASE);
    line-height: 140%;
    font-weight: 400;
    color: var(--COLOR-TEXT);
    margin: 0;
    padding-top: 20px;
    font-family: var(--FONT-STACK-BODY);
}

.custom-alternating-rows__review {
    display: flex;
    flex-direction: column;
    margin: 20px 0 0;
}

.custom-alternating-rows__stars {
    margin-left: 0;
}

.custom-alternating-rows__stars-img {
    display: inline-block;
    position: relative;
    line-height: 0;
}

.custom-alternating-rows__stars-fill {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    overflow: hidden;
}

.custom-alternating-rows__stars svg {
    width: 95px;
    height: auto;
}

.custom-alternating-rows__sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
}

.custom-alternating-rows__quote {
    font-size: var(--FONT-SIZE-BASE);
    line-height: 150%;
    font-weight: 400;
    color: var(--COLOR-TEXT);
    margin: 0;
    padding-left: 0;
    border-left: 0;
    font-family: var(--FONT-STACK-BODY);
}

@media only screen and (max-width: 1024px) {
.custom-alternating-rows__review {
    display: none;
}
}

.custom-alternating-rows__author {
    display: flex;
    align-items: center;
    gap: 5px;
    margin-top: 10px;
}

.custom-alternating-rows__author-name {
    font-size: var(--FONT-SIZE-BASE);
    line-height: 150%;
    font-weight: 400;
    font-style: normal;
    color: var(--COLOR-TEXT);
    font-family: var(--FONT-STACK-BODY);
}

.custom-alternating-rows__verified {
    display: flex;
    align-items: center;
    gap: 4px;
}

.custom-alternating-rows__verified img {
    max-width: 14px;
    object-fit: contain;
}

.custom-alternating-rows__verified-text {
    font-size: var(--FONT-SIZE-BASE);
    line-height: 150%;
    font-weight: 400;
    color: var(--COLOR-TEXT);
    font-family: var(--FONT-STACK-BODY);
}

.custom-alternating-rows__cta-link {
    display: flex;
    background: var(--BTN-PRIMARY-BG-COLOR);
    text-decoration: none;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 400px;
    height: 60px;
    margin: 0 auto;
    font-size: var(--BTN-FONT-SIZE);
    line-height: 26px;
    letter-spacing: 0;
    font-weight: 700;
    color: var(--BTN-PRIMARY-TEXT-COLOR);
    font-family: var(--BTN-FONT-STACK);
    cursor: pointer;
    gap: 5px;
    transition: background 0.3s ease;
}

.custom-alternating-rows__cta-link:focus-visible {
    background: var(--BTN-PRIMARY-BG-COLOR-BRIGHTER);
    color: var(--BTN-PRIMARY-TEXT-COLOR);
}

@media (hover: hover) {
  .custom-alternating-rows__cta-link:hover {
    background: var(--BTN-PRIMARY-BG-COLOR-BRIGHTER);
    color: var(--BTN-PRIMARY-TEXT-COLOR);
  }

  .custom-alternating-rows__cta-link svg {
    transition: transform 0.5s ease;
    transform: translateZ(0);
  }

  .custom-alternating-rows__cta-link:hover svg {
    transform: translate3d(5px, 0, 0);
  }
}

.custom-alternating-rows__row--reverse {
    flex-direction: row-reverse;
}

.custom-alternating-rows__row--reverse .custom-alternating-rows__body {
    padding-right: 0;
    padding-left: 60px;
}

/* tablet band: the 60px text gutter is dropped so the copy uses the full half column */
@media only screen and (min-width: 601px) and (max-width: 1024px) {
.custom-alternating-rows__row .custom-alternating-rows__body,
.custom-alternating-rows__row--reverse .custom-alternating-rows__body {
    padding-left: 0;
    padding-right: 0;
}
}

@media only screen and (max-width: 600px) {
.custom-alternating-rows {
    padding: 50px 0;
}

.custom-alternating-rows__subtitle {
    font-size: var(--FONT-SIZE-BASE);
    padding-top: 15px;
}

.custom-alternating-rows__row {
    padding: 15px;
    flex-wrap: wrap;
    gap: 20px;
    margin-bottom: 25px;
}

.custom-alternating-rows__media {
    width: 100%;
}

.custom-alternating-rows__media img {
    max-width: 100%;
}

.custom-alternating-rows__body {
    width: 100%;
    padding: 0;
}

.custom-alternating-rows__row-text {
    padding-top: 10px;
    font-size: var(--FONT-SIZE-BASE);
}

.custom-alternating-rows__row--reverse .custom-alternating-rows__body {
    padding-left: 0;
}

.custom-alternating-rows__review {
    padding-left: 15px;
    margin-top: 15px;
}

.custom-alternating-rows__quote {
    font-size: var(--FONT-SIZE-BASE);
}

.custom-alternating-rows__stars svg {
    width: 85px;
}

.custom-alternating-rows__cta-link {
    font-size: var(--BTN-FONT-SIZE);
}

.custom-alternating-rows__author-name {
    font-size: var(--FONT-SIZE-BASE);
}

.custom-alternating-rows__verified-text {
    font-size: var(--FONT-SIZE-BASE);
}

.custom-alternating-rows__verified img {
    max-width: 12px;
}
}

/* Scroll-in reveal: initial hidden states apply ONLY once JS adds anim-ready,
   so content stays visible without JS and under reduced motion. Reveals ride
   the row element, never the media img (which carries the hover zoom). */
.custom-alternating-rows.anim-ready .custom-alternating-rows__title,
.custom-alternating-rows.anim-ready .custom-alternating-rows__subtitle,
.custom-alternating-rows.anim-ready .custom-alternating-rows__row,
.custom-alternating-rows.anim-ready .custom-alternating-rows__cta {
  opacity: 0;
  transform: translateY(26px);
  transition: opacity 0.65s ease, transform 0.65s ease;
}

.custom-alternating-rows.anim-ready .is-inview {
  opacity: 1;
  transform: none;
}
</style>

{%- assign heading_id = 'CustomAltRows-title-' | append: section.id -%}
{%- liquid
  # Coming-soon product template: with "Use Coming Soon Page metaobject" on,
  # content comes from the product's custom.coming_soon metaobject (no
  # fallback, section hidden without an entry). Off = section settings render.
  assign cs_mode = false
  if template.suffix == 'coming-soon' and product and section.settings.use_metaobject
    assign cs_mode = true
    assign cs = product.metafields.custom.coming_soon.value
  endif

  assign ar_title = section.settings.title
  assign ar_desc = section.settings.description
  if cs_mode
    assign ar_title = cs.switched_title
    assign ar_desc = cs.switched_text
  endif
-%}
{%- if cs_mode and ar_title == blank -%}
  {%- comment -%} no per-product content — section hidden {%- endcomment -%}
{%- else -%}
<section
  id="AltRows-{{ section.id }}"
  class="custom-alternating-rows"
  {% if ar_title != blank %}aria-labelledby="{{ heading_id }}"{% endif %}
  {% if section.settings.bg_image %}style="background-image: url({{ section.settings.bg_image | image_url: width: 2000 }});"{% endif %}
>
  <div class="page-width">

    <div class="custom-alternating-rows__inner">

      {% if ar_title != blank %}
        <h2 id="{{ heading_id }}" class="custom-alternating-rows__title heading-size-11">
          {% render 'custom-no-orphan', text: ar_title %}
        </h2>
      {% endif %}

      {% if ar_desc != blank %}
        <p class="custom-alternating-rows__subtitle">
          {{ ar_desc }}
        </p>
      {% endif %}

      {% if cs_mode %}
        <div class="custom-alternating-rows__rows">
          {% assign cs_rows = cs.switched_rows.value %}{% for item in cs_rows %}
            {% liquid
              assign r_image = item.image
              assign r_title = item.title
              assign r_text = item.text
              assign row_is_even = forloop.index | modulo: 2
            %}
            {% if r_title != blank or r_text != blank %}
              <div class="custom-alternating-rows__row{% if row_is_even == 0 %} custom-alternating-rows__row--reverse{% endif %}">
                {% if r_image != blank %}
                  <div class="custom-alternating-rows__media">
                    <img
                      src="{{ r_image | image_url: width: 900 }}"
                      srcset="{{ r_image | image_url: width: 400 }} 400w, {{ r_image | image_url: width: 600 }} 600w, {{ r_image | image_url: width: 900 }} 900w"
                      sizes="(max-width: 749px) 100vw, 50vw"
                      alt="{{ r_title | strip_html | escape }}"
                      loading="lazy"
                    >
                  </div>
                {% endif %}
                <div class="custom-alternating-rows__body">
                  {% if r_title != blank %}
                    <h3 class="custom-alternating-rows__row-title">{% render 'custom-no-orphan', text: r_title %}</h3>
                  {% endif %}
                  {% if r_text != blank %}
                    <p class="custom-alternating-rows__row-text">{{ r_text }}</p>
                  {% endif %}
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      {% elsif section.blocks.size > 0 %}
        <div class="custom-alternating-rows__rows">

          {% for block in section.blocks %}
            <div
              class="custom-alternating-rows__row{% if block.settings.image_position == 'right' %} custom-alternating-rows__row--reverse{% endif %}"
              {{ block.shopify_attributes }}
            >

              {% if block.settings.image %}
                <div class="custom-alternating-rows__media">
                  <img
                    src="{{ block.settings.image | image_url: width: 900 }}"
                    srcset="{{ block.settings.image | image_url: width: 400 }} 400w, {{ block.settings.image | image_url: width: 600 }} 600w, {{ block.settings.image | image_url: width: 900 }} 900w, {{ block.settings.image | image_url: width: 1200 }} 1200w"
                    sizes="(max-width: 749px) 100vw, 50vw"
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.height }}"
                    alt="{{ block.settings.image_alt | default: block.settings.title | strip_html | escape }}"
                    loading="lazy"
                  >
                </div>
              {% endif %}

              <div class="custom-alternating-rows__body">

                {% if block.settings.title != blank %}
                  <h3 class="custom-alternating-rows__row-title">
                    {% render 'custom-no-orphan', text: block.settings.title %}
                  </h3>
                {% endif %}

                {% if block.settings.text != blank %}
                  <p class="custom-alternating-rows__row-text">
                    {{ block.settings.text }}
                  </p>
                {% endif %}

                {% if block.settings.show_review %}
                  <figure class="custom-alternating-rows__review">

                    {% liquid
                      assign star_rating = block.settings.star_rating | default: 5 | times: 1.0 | at_most: 5.0 | at_least: 0.0
                      assign star_percent = star_rating | divided_by: 5.0 | times: 100.0 | round: 1
                    %}
                    {% if star_rating > 0 %}
                      <div class="custom-alternating-rows__stars">
                        <span class="custom-alternating-rows__stars-img">
                          <svg xmlns="http://www.w3.org/2000/svg" width="190" height="36" viewBox="0 0 190 36" fill="#DDD6CF" aria-hidden="true" focusable="false">
                            <defs>
                              <path id="AltRowsStar-{{ block.id }}" d="M 0 -18 L 4.04 -5.56 L 17.12 -5.56 L 6.53 2.12 L 10.58 14.56 L 0 6.88 L -10.58 14.56 L -6.53 2.12 L -17.12 -5.56 L -4.04 -5.56 Z"/>
                            </defs>
                            <use href="#AltRowsStar-{{ block.id }}" transform="translate(19 19.7)"/>
                            <use href="#AltRowsStar-{{ block.id }}" transform="translate(57 19.7)"/>
                            <use href="#AltRowsStar-{{ block.id }}" transform="translate(95 19.7)"/>
                            <use href="#AltRowsStar-{{ block.id }}" transform="translate(133 19.7)"/>
                            <use href="#AltRowsStar-{{ block.id }}" transform="translate(171 19.7)"/>
                          </svg>
                          <span class="custom-alternating-rows__stars-fill" style="width: {{ star_percent }}%">
                            <svg xmlns="http://www.w3.org/2000/svg" width="190" height="36" viewBox="0 0 190 36" fill="#FB6D00" aria-hidden="true" focusable="false">
                              <use href="#AltRowsStar-{{ block.id }}" transform="translate(19 19.7)"/>
                              <use href="#AltRowsStar-{{ block.id }}" transform="translate(57 19.7)"/>
                              <use href="#AltRowsStar-{{ block.id }}" transform="translate(95 19.7)"/>
                              <use href="#AltRowsStar-{{ block.id }}" transform="translate(133 19.7)"/>
                              <use href="#AltRowsStar-{{ block.id }}" transform="translate(171 19.7)"/>
                            </svg>
                          </span>
                        </span>
                        <span class="custom-alternating-rows__sr-only">Rated {{ star_rating }} out of 5 stars</span>
                      </div>
                    {% endif %}

                    {% if block.settings.review_text != blank %}
                      <blockquote class="custom-alternating-rows__quote">
                        {{ block.settings.review_text }}
                      </blockquote>
                    {% endif %}

                    {% if block.settings.author != blank or block.settings.verified_text != blank %}
                      <figcaption class="custom-alternating-rows__author">
                        {% if block.settings.author != blank %}
                          <cite class="custom-alternating-rows__author-name">
                            {{ block.settings.author }}
                          </cite>
                        {% endif %}

                        {% if block.settings.verified_text != blank %}
                          <span class="custom-alternating-rows__verified">
                            {% if block.settings.verified_icon %}
                              <img
                                src="{{ block.settings.verified_icon | image_url: width: 48 }}"
                                alt=""
                                loading="lazy"
                              >
                            {% endif %}
                            <span class="custom-alternating-rows__verified-text">
                              {{ block.settings.verified_text }}
                            </span>
                          </span>
                        {% endif %}
                      </figcaption>
                    {% endif %}

                  </figure>
                {% endif %}

              </div>
            </div>
          {% endfor %}

        </div>
      {% endif %}

      {% if section.settings.button_text != blank and section.settings.button_link != blank %}
        <div class="custom-alternating-rows__cta">
          <a class="custom-alternating-rows__cta-link" href="{{ section.settings.button_link }}">
            {{ section.settings.button_text }}
            <svg width="22" height="13" viewBox="0 0 22 13" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
              <path d="M0.843262 5.36644C0.377534 5.36644 0 5.74399 0 6.20972C0 6.67544 0.377534 7.05299 0.843262 7.05299H20.8433C21.309 7.05299 21.6866 6.67544 21.6866 6.20972C21.6866 5.74399 21.309 5.36644 20.8433 5.36644H0.843262ZM21.4395 6.806C21.7689 6.47668 21.7689 5.94275 21.4395 5.61343L16.073 0.24687C15.7437 -0.0824491 15.2097 -0.0824491 14.8804 0.24687C14.5511 0.576189 14.5511 1.11012 14.8804 1.43944L19.6507 6.20972L14.8804 10.98C14.5511 11.3093 14.5511 11.8432 14.8804 12.1726C15.2097 12.5019 15.7437 12.5019 16.073 12.1726L21.4395 6.806Z" fill="currentColor"/>
            </svg>
          </a>
        </div>
      {% endif %}

    </div>
  </div>
</section>
{%- endif -%}

<script>
  (function () {
    var root = document.getElementById('AltRows-{{ section.id }}');
    if (!root) return;
    if (!('IntersectionObserver' in window)) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (window.theme && window.theme.settings && window.theme.settings.enableAnimations === false) return;

    var targets = root.querySelectorAll('.custom-alternating-rows__title, .custom-alternating-rows__subtitle, .custom-alternating-rows__row, .custom-alternating-rows__cta');
    if (!targets.length) return;

    root.classList.add('anim-ready');

    /* Items entering together stagger 90ms apart in DOM order; the batch
       resets between bursts so later scroll reveals start immediately. */
    var batch = 0;
    var lastHit = 0;
    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting) return;
        var el = entry.target;
        var now = performance.now();
        if (now - lastHit > 400) batch = 0;
        lastHit = now;
        el.style.transitionDelay = Math.min(batch * 90, 540) + 'ms';
        batch++;
        el.classList.add('is-inview');
        el.addEventListener('transitionend', function clear() {
          el.style.transitionDelay = '';
          el.removeEventListener('transitionend', clear);
        });
        observer.unobserve(el);
      });
    }, { threshold: 0.12 });

    targets.forEach(function (t) { observer.observe(t); });
  })();
</script>

{% schema %}
{
  "name": "[Custom] Alternating Rows",
  "settings": [
    {
      "type": "checkbox",
      "id": "use_metaobject",
      "label": "Use Coming Soon Page metaobject",
      "info": "Coming-soon product template only: pull this section's content from the product's Coming Soon Page metaobject (custom.coming_soon) instead of the settings below. Leave off to show the settings below.",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Main Title"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Main Description"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "GET YOURS NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "content_box",
      "name": "Content Box",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text (accessibility)",
          "info": "Describe the image for screen readers and SEO. If left blank, the Box Title is used."
        },
        {
          "type": "select",
          "id": "image_position",
          "label": "Image Position",
          "default": "left",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "right", "label": "Right" }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Box Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Box Description"
        },
        {
          "type": "checkbox",
          "id": "show_review",
          "label": "Show Review Box",
          "default": false
        },
        {
          "type": "range",
          "id": "star_rating",
          "label": "Star rating",
          "info": "Controls how much of the stars are filled. 0 hides the stars.",
          "min": 0,
          "max": 5,
          "step": 0.1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "review_text",
          "label": "Review Text"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author Name"
        },
        {
          "type": "image_picker",
          "id": "verified_icon",
          "label": "Verified Tick Icon"
        },
        {
          "type": "text",
          "id": "verified_text",
          "label": "Verified Text",
          "default": "Verified Buyer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "[Custom] Alternating Rows"
    }
  ]
}
{% endschema %}
