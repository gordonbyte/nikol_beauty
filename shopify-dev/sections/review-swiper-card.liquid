<div class="review-cards review-cards-wrapper" data-autoplay-speed="{{ section.settings.autoplay_speed | default: 10 }}">
  <div class="wrapper">
  
    <h2 class="review-section-title">{{ section.settings.title | default: "Customers Love for Nikol Beauty" }}</h2>
    
    <div class="swiper-container">
      <div class="swiper-wrapper">
        {%- for block in section.blocks -%}
          {% assign product = all_products[block.settings.product] %}
          <div class="swiper-slide">
            <div class="review-wrapper">
            
              <a href="{{ product.url }}" class="review-product-card">
                <div class="product-image">
<img
  src="{{ product.featured_image | image_url: width: 300 }}"
  srcset="{{ product.featured_image | image_url: width: 150 }} 150w, {{ product.featured_image | image_url: width: 300 }} 300w, {{ product.featured_image | image_url: width: 450 }} 450w"
  sizes="145px"
  alt="{{ product.featured_image.alt | escape }}"
  loading="lazy"
  decoding="async"
>
                </div>
                <div class="product-title">{{ product.title }}</div>
                <div class="product-price">{{ product.price | money }}</div>
              </a>
              <div class="review-product-text">
                {% comment %} {{ product.metafields.reviews.rating.value }} {% endcomment %}
                {% if product.metafields.custom.product_review %}
                  {% assign review_content = product.metafields.custom.product_review  %}
                  {{ review_content | metafield_tag | replace: '<h6', '<p class="review-author"' | replace: '</h6>', '</p>' }}
                {% else %}
                  No review available.
                {% endif %}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
      <div class="swiper-pagination"></div>
    </div>

    <button type="button" class="review-autoplay-toggle" data-review-autoplay-toggle aria-label="Pause review rotation">
      <svg class="review-autoplay-toggle__pause" width="14" height="14" viewBox="0 0 14 14" fill="currentColor" aria-hidden="true" focusable="false"><rect x="2" y="1" width="3.5" height="12" rx="1"/><rect x="8.5" y="1" width="3.5" height="12" rx="1"/></svg>
      <svg class="review-autoplay-toggle__play" width="14" height="14" viewBox="0 0 14 14" fill="currentColor" aria-hidden="true" focusable="false"><path d="M3 1.5v11a1 1 0 0 0 1.52.86l8.5-5.5a1 1 0 0 0 0-1.72l-8.5-5.5A1 1 0 0 0 3 1.5z"/></svg>
    </button>
  </div>
</div>

{% schema %}
  {
    "name": "Review Swiper Cards",
    "settings": [
      {
        "type": "text",
        "id": "title",
        "label": "Heading",
        "default": "Customers Love for Nikol Beauty"
      },
      {
        "type": "range",
        "id": "autoplay_speed",
        "label": "Auto-rotate speed",
        "min": 3,
        "max": 20,
        "step": 1,
        "unit": "s",
        "default": 10
      }
    ],
    "blocks": [
    {
      "type": "review-card-product",
      "name": "Product Card",
      "settings": [
        {
          "type": "product",
          "label": "Product",
          "id": "product"
        }
      ]
    }
    ],
  "presets": [{
    "name": "Review Swiper",
    "category": "Product"
  }]
  }
{% endschema %}
