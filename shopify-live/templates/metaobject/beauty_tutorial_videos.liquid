  }
  
  /* Lower children too */
  header *,
  .header *,
  .header__wrapper *,
  nav *,
  .site-header * {
    z-index: inherit !important;
  }
  
  /* Modal/Dialog styles - MAXIMUM z-index for Channelize modals */
  body > div[class*="channelize"],
  body > div[id*="channelize"],
  body > [role="dialog"],
  div[role="dialog"],
  [class*="channelize"][style*="position: fixed"],
  [id*="channelize"][style*="position: fixed"] {
    z-index: 2147483647 !important;
    position: fixed !important;
  }
  
  /* Backdrop/overlay styles */
  body > div[class*="backdrop"],
  body > div[class*="overlay"],
  [class*="backdrop"][style*="position: fixed"],
  [class*="overlay"][style*="position: fixed"] {
    z-index: 2147483646 !important;
    position: fixed !important;
  }
  
