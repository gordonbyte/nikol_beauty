<section class="video-detail page-width{% if use_tolstoy %} tolstoy-mode{% endif %}">
  
  {% comment %} Section 1: Video + Featured Bundle + Video Info {% endcomment %}
  <div class="hero-section">
    <div class="hero-container">
      {% comment %} Check if bundle or bundle description exists {% endcomment %}
      {% assign has_bundle = false %}
      {% if metaobject.featured_bundle %}
        {% assign has_bundle = true %}
      {% endif %}
      {% if metaobject.featured_bundle_description and metaobject.featured_bundle_description != blank %}
        {% assign has_bundle = true %}
      {% endif %}
      
      <div class="hero-grid{% unless has_bundle %} no-bundle{% endunless %}">
        <!-- Left: Main Video -->
        <div class="hero-video">
          {% if metaobject.video_url %}
            {% assign video_id = metaobject.video_url | split: 'v=' | last %}
            <div class="video-container">
              <iframe 
                src="https://www.youtube.com/embed/{{ video_id }}"
                title="{{ metaobject.title }}"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                allowfullscreen>
              </iframe>
            </div>
          {% endif %}
        </div>
        
        <!-- Right: Featured Bundle with Subtitle and Description -->
        {% if has_bundle %}
        <div class="hero-product">
          <h3 class="hero-subtitle">FEATURED BUNDLE</h3>
          
          {% if metaobject.featured_bundle %}
            {% assign featured_bundle = metaobject.featured_bundle.value %}
            
            <div class="hero-product-card">
              {% if featured_bundle.featured_image %}
                <div class="hero-product-image">
                  <a href="{{ featured_bundle.url }}">
                    <img src="{{ featured_bundle.featured_image | img_url: '200x300' }}" alt="{{ featured_bundle.title }}">
                  </a>
                </div>
              {% endif %}
              
              <div class="hero-product-info">
                <h4 class="hero-product-name">
                  <a href="{{ featured_bundle.url }}">{{ featured_bundle.title | upcase }}</a>
                </h4>
                <p class="hero-product-price">{{ featured_bundle.price | money }}</p>
                
                {% assign bundle_variants_count = featured_bundle.variants.size %}
                {% if bundle_variants_count > 1 %}
                  <a href="{{ featured_bundle.url }}" class="btn-view-product">
                    <svg class="btn-view-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
                    </svg>
                    View product
                  </a>
                {% else %}
                  <form action="/cart/add" method="post" enctype="multipart/form-data" style="display: inline;">
                    <input type="hidden" name="id" value="{{ featured_bundle.variants.first.id }}">
                    <button type="submit" class="btn-view-product">
                      <svg class="btn-view-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12L8.1 13h7.45c.75 0 1.41-.41 1.75-1.03L21.7 4H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"/>
                      </svg>
                      Add to cart
                    </button>
                  </form>
                {% endif %}
              </div>
            </div>
            
            <div class="hero-product-description">
              {% if metaobject.featured_bundle_description %}
                <p>{{ metaobject.featured_bundle_description | strip_html }}</p>
              {% elsif featured_bundle.description %}
                <p>{{ featured_bundle.description | strip_html }}</p>
              {% else %}
                <p>Discover this amazing bundle from our collection.</p>
              {% endif %}
            </div>
          {% else %}
            <div class="hero-product-placeholder">
              <div class="placeholder-image"></div>
              <div class="placeholder-info">
                <h4 class="hero-product-name">Bundle Name</h4>
                <p class="placeholder-price">$00.00</p>
                <a href="#" class="btn-view-product">
                  <svg class="btn-view-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
                  </svg>
                  View product
                </a>
              </div>
            </div>
            <div class="placeholder-description">
              <p>Bundle description will appear here. This is a placeholder text to show the layout.</p>
            </div>
          {% endif %}
        </div>
        {% endif %}
      </div>
      
      {% comment %} Video Title and Description inside hero section {% endcomment %}
      <div class="video-info-section">
        <h1 class="video-title">{{ metaobject.title | default: "Video Title" }}</h1>
        <div class="video-description">
          {% if metaobject.description %}
            <p>{{ metaobject.description | newline_to_br }}</p>
          {% else %}
            <p>This is where the video description will appear. It provides context and details about the video content.</p>
          {% endif %}
        </div>
      </div>
    </div>
  </div>

  {% comment %} Section 3: Featured Products Grid (2 columns with product + video) {% endcomment %}
  <div class="featured-products-section">
    <h2 class="section-title">FEATURED PRODUCTS</h2>
    
    <div class="featured-grid">
      {% if metaobject.products and metaobject.products.value %}
        {% for product in metaobject.products.value %}
          {% comment %} Reset playlist_id for each product iteration {% endcomment %}
          {% assign playlist_id = '' %}
          
          {% comment %} Detect if this is a variant or a product {% endcomment %}
          {% if product.product %}
            {% comment %} This is a variant - use product.product to access the parent product {% endcomment %}
            {% assign product_obj = product.product %}
            {% assign product_url = product.product.url %}
            {% assign product_price = product.price %}
            {% assign product_metafields = product.product.metafields %}
            {% assign is_variant = true %}
            {% assign variant_obj = product %}
          {% else %}
            {% comment %} This is a product - use directly {% endcomment %}
            {% assign product_obj = product %}
            {% assign product_url = product.url %}
            {% assign product_price = product.price %}
            {% assign product_metafields = product.metafields %}
            {% assign is_variant = false %}
          {% endif %}
          
          <div class="featured-item">
            <div class="featured-item-row">
              <div class="featured-item-product">
                <div class="product-image">
                  {% comment %} For variants, try to use variant image first, then fallback to product image {% endcomment %}
                  {% if is_variant and variant_obj.image %}
                    <a href="{{ product_url }}">
                      <img src="{{ variant_obj.image | img_url: '200x200' }}" alt="{{ product_obj.title }}" data-product-index="{{ forloop.index }}" class="product-variant-image">
                    </a>
                  {% elsif product_obj.featured_image %}
                    <a href="{{ product_url }}">
                      <img src="{{ product_obj.featured_image | img_url: '200x200' }}" alt="{{ product_obj.title }}" data-product-index="{{ forloop.index }}" class="product-variant-image">
                    </a>
                  {% else %}
                    <img src="https://via.placeholder.com/200x200" alt="{{ product_obj.title }}" data-product-index="{{ forloop.index }}" class="product-variant-image">
                  {% endif %}
                </div>
                <div class="product-details">
                  <h3 class="product-name">
                    <a href="{{ product_url }}">{{ product_obj.title | upcase }}</a>
                  </h3>
                  
                  {% comment %} Check if product has multiple variants {% endcomment %}
                  {% assign variants_count = product_obj.variants.size %}
                  {% comment %} Only show price if product has single variant (price is shown in dropdown for multiple variants) {% endcomment %}
                  {% if variants_count <= 1 %}
                    <p class="product-price" data-product-index="{{ forloop.index }}">{{ product_price | money }}</p>
                  {% endif %}
                  
                  {% if variants_count > 1 %}
                    {% comment %} Product has multiple variants - show dropdown {% endcomment %}
                    <form action="/cart/add" method="post" enctype="multipart/form-data" class="add-to-cart-form" data-add-to-cart-form>
                      <div class="variant-selector">
                        <select name="id" id="variant-select-{{ forloop.index }}" data-product-index="{{ forloop.index }}" required>
                          {% for variant in product_obj.variants %}
                            {% if variant.image %}
                              {% assign variant_image_url = variant.image | img_url: '200x200' %}
                            {% elsif product_obj.featured_image %}
                              {% assign variant_image_url = product_obj.featured_image | img_url: '200x200' %}
                            {% else %}
                              {% assign variant_image_url = '' %}
                            {% endif %}
                            <option value="{{ variant.id }}" data-price-formatted="{{ variant.price | money }}" data-image-url="{{ variant_image_url }}" {% if is_variant and variant_obj.id == variant.id %}selected{% endif %} {% if variant.available == false %}disabled{% endif %}>
                              {{ variant.title }} - {{ variant.price | money }}{% unless variant.available %} (Sold out){% endunless %}
                            </option>
                          {% endfor %}
                        </select>
                      </div>
                      <button type="submit" class="btn-add-to-cart" data-add-to-cart-button>ADD TO CART</button>
                    </form>
                  {% else %}
                    {% comment %} Product has only one variant - direct add to cart {% endcomment %}
                    <form action="/cart/add" method="post" enctype="multipart/form-data" class="add-to-cart-form" data-add-to-cart-form>
                      <input type="hidden" name="id" value="{{ product_obj.variants.first.id }}">
                      <button type="submit" class="btn-add-to-cart" data-add-to-cart-button>ADD TO CART</button>
                    </form>
                  {% endif %}
                </div>
              </div>
              <div class="featured-item-video">
                {% if use_tolstoy %}
                {% comment %} Tolstoy mode: the episode's one widget, filtered to this product —
                  the app embed's script scans for .tolstoy-carousel[data-publish-id] and
                  data-product-id makes each instance fetch only this product's clips. {% endcomment %}
                {%- comment -%}
                  data-priority="high" makes Tolstoy's loader initialize this
                  cell at page load instead of ~200px before it scrolls into
                  view — below-fold cells otherwise start initializing exactly
                  when the shopper first sees them, which is the window where
                  clicks hit their init race.
                {%- endcomment -%}
                <div class="tolstoy-carousel" data-priority="high" data-publish-id="{{ tolstoy_publish_id }}" data-product-id="{{ product_obj.id }}"></div>
                {% else %}
                {% comment %} Determine playlist ID based on video category {% endcomment %}

                {% if metaobject.category == 'fierceaging' %}
                  {% comment %} For fierceaging videos: get video identifier and lookup in JSON {% endcomment %}
                  {% comment %} Try direct property access first (metaobject fields are often direct properties) {% endcomment %}
                  {% assign video_identifier = metaobject.video_identifier %}
                  
                  {% comment %} If direct access is empty, try metafields access {% endcomment %}
                  {% if video_identifier == blank %}
                    {% assign video_identifier = metaobject.metafields.custom.video_identifier %}
                  {% endif %}
                  
                  {% comment %} Try with .value {% endcomment %}
                  {% if video_identifier == blank %}
                    {% assign video_identifier = metaobject.metafields.custom.video_identifier.value %}
                  {% endif %}
                  
                  {% comment %} Try alternative access methods {% endcomment %}
                  {% if video_identifier == blank %}
                    {% assign video_identifier = metaobject.metafields['custom']['video_identifier'] %}
                  {% endif %}
                  
                  {% if video_identifier == blank %}
                    {% assign video_identifier = metaobject.metafields['custom']['video_identifier'].value %}
                  {% endif %}
                  
                  {% assign playlists_metafield = product_metafields.custom.fierceaging_playlists.value %}
                  
                  {% comment %} Try without .value if .value is empty {% endcomment %}
                  {% if playlists_metafield == blank %}
                    {% assign playlists_metafield = product_metafields.custom.fierceaging_playlists %}
                  {% endif %}
                  
                  {% if playlists_metafield %}
                    {% assign playlists_json = playlists_metafield %}
                    
                    {% comment %} Reset playlist_id to ensure clean state {% endcomment %}
                    {% assign playlist_id = '' %}
                    
                    {% comment %} Dynamic lookup: Try to access JSON dynamically using the video_identifier {% endcomment %}
                    {% if video_identifier != blank %}
                      {% assign video_identifier_clean = video_identifier | strip %}
                      
                      {% comment %} Try direct access with original case {% endcomment %}
                      {% assign playlist_id = playlists_json[video_identifier_clean] %}
                      
                      {% comment %} Try capitalized version {% endcomment %}
                      {% if playlist_id == blank %}
                        {% assign video_identifier_capitalized = video_identifier_clean | capitalize %}
                        {% assign playlist_id = playlists_json[video_identifier_capitalized] %}
                      {% endif %}
                      
                      {% comment %} Try lowercase version {% endcomment %}
                      {% if playlist_id == blank %}
                        {% assign video_identifier_lower = video_identifier_clean | downcase %}
                        {% assign video_identifier_lower_capitalized = video_identifier_lower | capitalize %}
                        {% assign playlist_id = playlists_json[video_identifier_lower_capitalized] %}
                      {% endif %}
                      
                      {% comment %} Try uppercase version {% endcomment %}
                      {% if playlist_id == blank %}
                        {% assign video_identifier_upper = video_identifier_clean | upcase %}
                        {% assign playlist_id = playlists_json[video_identifier_upper] %}
                      {% endif %}
                      
                      {% comment %} If still blank, try string-based extraction from JSON {% endcomment %}
                      {% if playlist_id == blank %}
                        {% assign json_string = playlists_json | json %}
                        {% assign search_key = '"' | append: video_identifier_clean | append: '"' %}
                        {% assign search_key_capitalized = '"' | append: video_identifier_capitalized | append: '"' %}
                        
                        {% if json_string contains search_key %}
                          {% comment %} Extract value after the key {% endcomment %}
                          {% assign key_with_colon = search_key | append: ':' %}
                          {% assign after_key = json_string | split: key_with_colon | last %}
                          {% assign value_part = after_key | split: '"' | first %}
                          {% if value_part != blank %}
                            {% assign playlist_id = value_part %}
                          {% endif %}
                        {% elsif json_string contains search_key_capitalized %}
                          {% assign key_with_colon = search_key_capitalized | append: ':' %}
                          {% assign after_key = json_string | split: key_with_colon | last %}
                          {% assign value_part = after_key | split: '"' | first %}
                          {% if value_part != blank %}
                            {% assign playlist_id = value_part %}
                          {% endif %}
                        {% endif %}
                      {% endif %}
                    {% endif %}
                    
                    {% comment %} Final fallback: ONLY use if video_identifier is truly blank or empty {% endcomment %}
                    {% if playlist_id == blank and (video_identifier == blank or video_identifier == '') %}
                      {% assign json_string = playlists_json | json %}
                      {% comment %} Extract first available playlist_id from JSON {% endcomment %}
                      {% if json_string contains '":"' %}
                        {% assign first_value = json_string | split: '":"' | last | split: '"' | first %}
                        {% if first_value != blank %}
                          {% assign playlist_id = first_value %}
                        {% endif %}
                      {% endif %}
                    {% endif %}
                  {% endif %}
                {% else %}
                  {% comment %} For tutorials videos: use the standard shoppable_playlist metafield {% endcomment %}
                  {% assign playlist_id = product_metafields.custom.shoppable_playlist %}
                {% endif %}
                
                {% comment %} DIAGNOSTIC: Log playlist_id resolution {% endcomment %}
                {% if playlist_id != blank %}
                  {% assign playlist_id_clean = playlist_id | strip %}
                  <channelize-shoppable-videos-playlist
                    playlist_id="{{ playlist_id_clean }}"
                    size="lg"
                    navigation_type="QUICK_OPEN"
                    data-product-index="{{ forloop.index }}"
                    data-category="{{ metaobject.category }}"
                    data-video-identifier="{{ video_identifier }}"
                    data-debug="true">
                  </channelize-shoppable-videos-playlist>
                  {% comment %} DIAGNOSTIC COMMENT - Remove after fixing: playlist_id={{ playlist_id_clean }}, product={{ product_obj.title }}, category={{ metaobject.category }}, video_identifier={{ video_identifier }} {% endcomment %}
                {% else %}
                  <div class="video-thumbnail" data-debug="no-playlist-id" data-product-index="{{ forloop.index }}" data-category="{{ metaobject.category }}">
                    <img src="https://via.placeholder.com/300x200?text=No+Video" alt="No Video">
                    {% comment %} DIAGNOSTIC COMMENT - Remove after fixing: NO PLAYLIST_ID - product={{ product_obj.title }}, category={{ metaobject.category }}, video_identifier={{ video_identifier }}, playlists_metafield={{ playlists_metafield | json | slice: 0, 100 }}, product_metafields={{ product_metafields | json | slice: 0, 100 }} {% endcomment %}
                  </div>
                {% endif %}
                {% endif %}
              </div>
            </div>
          </div>
        {% endfor %}
      {% else %}
        <!-- Placeholder items if no products -->
        {% for i in (1..4) %}
          <div class="featured-item">
            <div class="featured-item-row">
              <div class="featured-item-product">
                <div class="product-image">
                  <img src="https://via.placeholder.com/200x200" alt="Product {{ i }}">
                </div>
                <div class="product-details">
                  <h3 class="product-name">PRODUCT NAME {{ i }}</h3>
                  <p class="product-price">$00.00</p>
                  <button type="button" class="btn-add-to-cart" disabled>ADD TO CART</button>
                </div>
              </div>
              {% unless use_tolstoy %}
              <div class="featured-item-video">
                <channelize-shoppable-videos-playlist
                  playlist_id="7863bba4-b4f3-11f0-97e5-f3ee3e2246b5"
                  size="lg"
                  navigation_type="QUICK_OPEN">
                </channelize-shoppable-videos-playlist>
              </div>
              {% endunless %}
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
  
</section>

{% if use_tolstoy %}
<script>
  // Tolstoy's carousel manager only assigns a poster frame to the first carousel
  // on the page (it assumes one per page); the other cells render grey and none
  // of them autoplay. Each cell fetches its own one-product widget config from
  // the same public CDN endpoint the widget uses, fills in the missing poster,
  // and autoplays the SD rendition muted while the cell is in the viewport
  // (paused off-screen; skipped entirely under prefers-reduced-motion).
  (function () {
    var embedScript = document.querySelector('script[src*="gotolstoy.com"][data-app-key]');
    var appKey = embedScript && embedScript.getAttribute('data-app-key');
    if (!appKey || !window.fetch) return;
    var cacheVersion = embedScript.getAttribute('data-cache-version') || '';
    var publishId = {{ tolstoy_publish_id | json }};
    var reducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function whenVideoReady(cell, callback) {
      var tries = 0;
      var timer = setInterval(function () {
        var video = cell.querySelector('video');
        if (video) {
          clearInterval(timer);
          callback(video);
        } else if (++tries > 60) {
          clearInterval(timer);
        }
      }, 500);
    }

    function setupCell(cell, poster, src) {
      whenVideoReady(cell, function (video) {
        if (poster && !video.poster) video.poster = poster;
        if (reducedMotion || !src || !('IntersectionObserver' in window)) return;
        var observer = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              video.muted = true;
              video.loop = true;
              video.setAttribute('playsinline', '');
              if (!video.src) video.src = src;
              var p = video.play();
              if (p && p.catch) p.catch(function () {});
            } else if (!video.paused) {
              video.pause();
            }
          });
        }, { threshold: 0.35 });
        observer.observe(cell);
      });
    }

    // Bridge Tolstoy's add-to-cart into Broadcast's cart UI. Tolstoy posts to
    // the real Shopify cart itself but leaves theme UI integration to the
    // merchant. On a successful add: refresh the header count, rebuild the
    // drawer contents, close the Tolstoy player, and open the theme's cart
    // drawer. Primary hook = their subscribe API's ONLY cart event,
    // 'tolstoy_add_to_cart' (fires on tap, before the add lands — their
    // widget rejects 'tolstoy_add_to_cart_success' as an invalid external
    // event, so the desktop path only ever worked via the fetch fallback and
    // mobile's feed player was missed entirely); a short cart poll confirms
    // the add landed before touching the UI. Fallback = watching window.fetch
    // for /cart/add (their cart call uses bare fetch). Debounced so multiple
    // paths handle one add once.
    if (!window.__tolstoyCartBridge) {
      window.__tolstoyCartBridge = true;
      var origFetch = window.fetch.bind(window);
      var lastHandled = 0;

      var closeTolstoyPlayer = function () {
        try {
          if (window.tolstoyWidget && typeof window.tolstoyWidget.closePlayer === 'function') {
            window.tolstoyWidget.closePlayer();
          }
        } catch (e) {}
        // The mobile fullscreen feed modal doesn't always honor closePlayer —
        // click the still-visible modal's own close button as a fallback.
        setTimeout(function () {
          document.querySelectorAll('.tolstoy-modal').forEach(function (m) {
            var r = m.getBoundingClientRect();
            if (r.width > 0 && r.height > 0) {
              var btn = m.querySelector('.minimize-tolstoy-modal');
              if (btn) btn.click();
            }
          });
        }, 600);
      };

      var onTolstoyCartAdd = function () {
        var now = Date.now();
        if (now - lastHandled < 1500) return;
        lastHandled = now;
        origFetch('/cart.js').then(function (r) { return r.json(); }).then(function (cart) {
          document.dispatchEvent(new CustomEvent('theme:cart:change', { bubbles: true, detail: { cartCount: cart.item_count } }));
        }).catch(function () {});
        var items = document.querySelector('cart-items');
        if (items && typeof items.getCart === 'function') items.getCart();
        closeTolstoyPlayer();
        setTimeout(function () {
          document.dispatchEvent(new CustomEvent('theme:product:added', { bubbles: true }));
        }, 400);
      };

      // Tap detected — wait for the cart count to actually change (the add
      // request lands after the event), then run the UI updates. Bows out if
      // the fetch fallback already handled this add.
      var onTolstoyCartIntent = function () {
        var stampAtStart = lastHandled;
        origFetch('/cart.js').then(function (r) { return r.json(); }).then(function (cart) {
          var baseline = cart.item_count;
          var tries = 0;
          var timer = setInterval(function () {
            tries++;
            if (lastHandled !== stampAtStart) { clearInterval(timer); return; }
            origFetch('/cart.js').then(function (r2) { return r2.json(); }).then(function (c2) {
              if (lastHandled !== stampAtStart) { clearInterval(timer); return; }
              if (c2.item_count !== baseline) {
                clearInterval(timer);
                onTolstoyCartAdd();
              } else if (tries >= 12) {
                clearInterval(timer);
              }
            }).catch(function () {});
          }, 500);
        }).catch(function () {});
      };

      var wireTries = 0;
      var wireTimer = setInterval(function () {
        if (window.tolstoyWidget && typeof window.tolstoyWidget.subscribe === 'function') {
          clearInterval(wireTimer);
          try { window.tolstoyWidget.subscribe('tolstoy_add_to_cart', onTolstoyCartIntent); } catch (e) {}
        } else if (++wireTries > 60) {
          clearInterval(wireTimer);
        }
      }, 500);

      window.fetch = function () {
        var result = origFetch.apply(null, arguments);
        try {
          var arg = arguments[0];
          var url = typeof arg === 'string' ? arg : (arg && arg.url) || '';
          if (url.indexOf('/cart/add') !== -1) {
            result.then(function (res) {
              if (res && res.ok) onTolstoyCartAdd();
            }).catch(function () {});
          }
        } catch (e) {}
        return result;
      };
    }

    // Clicks pass straight through to Tolstoy — no shield, no retries (all
    // custom click intervention removed 2026-09-01 per Randell; the known
    // early-click init race is Tolstoy's to fix, tracked on their ticket).
    // Only kept behavior: an open theme cart drawer closes when a video is
    // clicked — the video takes focus.
    document.addEventListener('click', function (e) {
      var trigger = e.target.closest && e.target.closest('.featured-item-video .tolstoy-play-button-container, .featured-item-video .tolstoy-carousel video');
      if (!trigger) return;
      try {
        var drawer = document.querySelector('cart-drawer');
        if (drawer && (drawer.cartDrawerIsOpen || drawer.classList.contains('is-open'))) {
          if (typeof drawer.closeCartDrawer === 'function') drawer.closeCartDrawer();
          else document.dispatchEvent(new CustomEvent('theme:quick-add:open', { bubbles: true }));
        }
      } catch (err) {}
    }, true);

    // Firefox overlays its native picture-in-picture toggle on any hovered
    // playing video; on these muted preview loops it's misleading (it pops out
    // the silent loop, never the player). Tolstoy injects the videos later, so
    // mark them as they appear.
    var disablePreviewPiP = function () {
      document.querySelectorAll('.featured-item-video .tolstoy-carousel video:not([disablepictureinpicture])').forEach(function (v) {
        v.disablePictureInPicture = true;
        v.setAttribute('disablepictureinpicture', '');
      });
    };
    disablePreviewPiP();
    new MutationObserver(disablePreviewPiP).observe(document.body, { childList: true, subtree: true });

    // Console readiness log: one "[tolstoy-status]" table when every tile is
    // ready to play. "Ready" = Tolstoy marked the tile loaded and its preview
    // video element exists. Preview DATA buffers only when a tile scrolls into
    // view (Tolstoy behavior), so buffering is reported but not waited on; and
    // Tolstoy exposes no signal for "a click will open the player" (their
    // ticket), so that can't be logged.
    (function () {
      var t0 = performance.now();
      var readyAt = {};
      var timer = setInterval(function () {
        var cells = document.querySelectorAll('.featured-item-video .tolstoy-carousel');
        if (!cells.length) return;
        var rows = [];
        var allReady = true;
        var playable = 0;
        var noVideo = 0;
        cells.forEach(function (c, i) {
          var v = c.querySelector('video');
          var status = c.getAttribute('data-status') || '(none)';
          // 'notFound' is terminal: Tolstoy has no clip for that product on
          // this widget, so no video is coming for the tile.
          var ready = (status === 'loaded' && !!v) || status === 'notFound';
          if (status === 'loaded' && v) playable++;
          if (status === 'notFound') noVideo++;
          if (ready && readyAt[i] === undefined) readyAt[i] = Math.round(performance.now() - t0);
          if (!ready) allReady = false;
          rows.push({
            tile: i + 1,
            product: c.getAttribute('data-product-id') || '',
            tolstoy: status,
            preview: v ? (v.readyState >= 2 ? 'buffered' : 'buffers on scroll') : (status === 'notFound' ? 'no clip for product' : 'no video yet'),
            readyAtMs: readyAt[i] !== undefined ? readyAt[i] : '—',
          });
        });
        if (allReady) {
          clearInterval(timer);
          console.log('[tolstoy-status] all ' + rows.length + ' tiles resolved at ' + Math.round(performance.now() - t0) + 'ms — ' + playable + ' ready to play' + (noVideo ? ', ' + noVideo + ' with no clip for the product (notFound)' : ''));
          console.table(rows);
        } else if (performance.now() - t0 > 60000) {
          clearInterval(timer);
          console.log('[tolstoy-status] timed out after 60s — not all videos ready:');
          console.table(rows);
        }
      }, 250);
    })();

    // Clicking the dim overlay (outside the video) closes the player, like a
    // standard modal backdrop. Prefer Tolstoy's own close button (cleaner
    // teardown); fall back to the closePlayer API.
    document.addEventListener('click', function (e) {
      var modal = e.target.closest && e.target.closest('.tolstoy-modal');
      if (!modal || !/SmallModal/.test(modal.className)) return;
      if (e.target.closest('iframe') || e.target.tagName === 'IFRAME') return;
      if (e.target.closest('.minimize-tolstoy-modal')) return;
      var closeBtn = modal.querySelector('.minimize-tolstoy-modal');
      if (closeBtn) {
        closeBtn.click();
        return;
      }
      try {
        if (window.tolstoyWidget && typeof window.tolstoyWidget.closePlayer === 'function') {
          window.tolstoyWidget.closePlayer();
        }
      } catch (err) {}
    }, true);

    document.querySelectorAll('.featured-item-video .tolstoy-carousel[data-product-id]').forEach(function (cell) {
      var pid = cell.getAttribute('data-product-id');
      if (!pid) return;
      var url = 'https://cf-apilb.gotolstoy.com/player-widget/config/getWidgetConfig?appKey=' + encodeURIComponent(appKey)
        + '&publishId=' + encodeURIComponent(publishId)
        + '&productId=' + encodeURIComponent(pid)
        + (cacheVersion ? '&v=' + encodeURIComponent(cacheVersion) : '');
      fetch(url)
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (cfg) {
          var steps = cfg && cfg.carouselEmbed && cfg.carouselEmbed.carouselSteps;
          var asset = steps && steps[0] && steps[0].stockAsset;
          if (!asset) return;
          var sources = asset.shopifySources || {};
          setupCell(cell, asset.shopifyPosterUrl, sources.sd || asset.videoUrl);
        })
        .catch(function () {});
    });
  })();
</script>
{% endif %}

