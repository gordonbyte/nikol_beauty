  /* AGGRESSIVE: Lower ALL site elements z-index by default to prepare for modals */
  header,
  .header,
  .header__wrapper,
  .header__desktop,
  .header__mobile,
  nav,
  .site-header,
  footer,
  .footer,
  .announcement-bar,
