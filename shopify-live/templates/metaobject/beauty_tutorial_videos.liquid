
{% layout 'theme' %}

{% comment %}
  Tolstoy gate: when this episode's metaobject has a Tolstoy publish ID in its
  shoppable_playlist field, each product's video cell renders a Tolstoy carousel
  (the episode's one widget, filtered per product via data-product-id) and the
  page skips all Channelize widgets/scripts. Clearing the field reverts the page
  to the Channelize path untouched below. Channelize playlist UUIDs contain
  dashes, Tolstoy publish IDs never do — the dash check keeps any legacy UUID in
  this field from being mistaken for a Tolstoy ID.
{% endcomment %}
{% assign tolstoy_publish_id = metaobject.shoppable_playlist | strip %}
{% if tolstoy_publish_id == blank %}
  {% assign tolstoy_publish_id = metaobject.shoppable_playlist.value | strip %}
{% endif %}
{% if tolstoy_publish_id contains '-' %}
  {% assign tolstoy_publish_id = '' %}
{% endif %}
{% assign use_tolstoy = false %}
{% if tolstoy_publish_id != blank %}
  {% assign use_tolstoy = true %}
{% endif %}

<style>
