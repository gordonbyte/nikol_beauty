  /* Channelize Widget Custom Styles - Anchor the floating widget */
  .featured-item-video {
    position: relative;
    min-height: 220px;
    background: transparent;
    border-radius: 8px;
    overflow: hidden;
    isolation: auto;
  }
  
  /* Remove stacking context when modal is open - important to let modal escape */
  body.channelize-modal-open .featured-item-video,
  body.channelize-modal-open .featured-item,
  body.channelize-modal-open .featured-item-row,
  body.channelize-modal-open .featured-grid,
  body.channelize-modal-open .featured-products-section {
    position: static !important;
    overflow: visible !important;
    isolation: auto !important;
    z-index: auto !important;
  }
  
  .featured-item-video channelize-shoppable-videos-playlist {
    position: relative !important;
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    min-height: 300px;
    border-radius: 8px;
    overflow: hidden;
    padding: 0 !important;
  }
  
  /* Desktop specific styles */
  @media (min-width: 769px) {
    .featured-item-video channelize-shoppable-videos-playlist {
      max-width: 100% !important;
      margin: 0 !important;
    }
  }
  
  /* Hide close button (X) ONLY in the embedded video cards (not in the modal) */
  .featured-item-video channelize-shoppable-videos-playlist [class*="close"]:not(.ch-live-broadcast__modal--open *),
  .featured-item-video channelize-shoppable-videos-playlist [aria-label*="close"]:not(.ch-live-broadcast__modal--open *),
  .featured-item-video channelize-shoppable-videos-playlist button[class*="close"]:not(.ch-live-broadcast__modal--open *) {
    display: none !important;
    visibility: hidden !important;
    opacity: 0 !important;
  }
  
  /* Ensure close button is visible when modal is open */
  .ch-live-broadcast__modal--open [class*="close"],
  .ch-live-broadcast__modal--open [aria-label*="close"],
  .ch-live-broadcast__modal--open button[class*="close"],
  body > .ch-live-broadcast__modal [class*="close"] {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    visibility: visible !important;
    opacity: 1 !important;
  }
  
  /* Center the X icon inside the close button */
  .ch-live-broadcast__modal--open [class*="close"] svg,
  .ch-live-broadcast__modal--open button[class*="close"] svg,
  body > .ch-live-broadcast__modal [class*="close"] svg {
    display: block !important;
    margin: auto !important;
  }
  
  /* Target inner elements to ensure they fill the space - DESKTOP ONLY */
  @media (min-width: 769px) {
    .featured-item-video channelize-shoppable-videos-playlist > *,
    .featured-item-video channelize-shoppable-videos-playlist iframe,
    .featured-item-video channelize-shoppable-videos-playlist > div {
      width: 100% !important;
      max-width: 100% !important;
      margin: 0 !important;
      padding: 0 !important;
    }
  }
  
  /* Override the floating behavior - target ALL Channelize playlists */
  body channelize-shoppable-videos-playlist[playlist_id] {
    position: relative !important;
    bottom: auto !important;
    right: auto !important;
    left: auto !important;
    top: auto !important;
    transform: none !important;
    z-index: 1 !important;
    padding: 0 !important;
  }
  
  /* Desktop: no margin */
  @media (min-width: 769px) {
    body channelize-shoppable-videos-playlist[playlist_id] {
      margin: 0 !important;
    }
  }
  
  /* Mobile: apply padding to video widget */
  @media (max-width: 768px) {
    body .featured-item-video channelize-shoppable-videos-playlist[playlist_id] {
      padding: 15px !important;
      box-sizing: border-box !important;
    }
