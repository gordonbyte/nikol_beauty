<script>
  
  // Check if video URL exists
  const videoUrl = '{{ metaobject.video_url }}';
  if (videoUrl) {
    // Check if it's a YouTube URL
    if (videoUrl.includes('youtube.com') || videoUrl.includes('youtu.be')) {
      let videoId = '';
      if (videoUrl.includes('youtube.com/watch?v=')) {
        videoId = videoUrl.split('v=')[1].split('&')[0];
      } else if (videoUrl.includes('youtu.be/')) {
        videoId = videoUrl.split('youtu.be/')[1];
      }
      
      if (videoId) {
        const embedUrl = `https://www.youtube.com/embed/${videoId}?rel=0`;
      }
    }
  }
  
  // Check related products
  const relatedProducts = {{ metaobject.related_products | json }};
  
  // Update price and image when variant is selected
  function initVariantPriceUpdates() {
    const variantSelects = document.querySelectorAll('select[id^="variant-select-"]');
    
    variantSelects.forEach(select => {
      select.addEventListener('change', function() {
        const selectedOption = this.options[this.selectedIndex];
        const formattedPrice = selectedOption.getAttribute('data-price-formatted');
        const imageUrl = selectedOption.getAttribute('data-image-url');
        const productIndex = this.getAttribute('data-product-index');
        
        if (formattedPrice && productIndex) {
          const priceElement = document.querySelector(`.product-price[data-product-index="${productIndex}"]`);
          if (priceElement) {
            priceElement.textContent = formattedPrice;
          }
        }
        
        if (imageUrl && productIndex) {
          const imageElement = document.querySelector(`.product-variant-image[data-product-index="${productIndex}"]`);
          if (imageElement) {
            imageElement.src = imageUrl;
          }
        }
      });
    });
  }
  
  // Initialize variant price updates when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initVariantPriceUpdates);
  } else {
    initVariantPriceUpdates();
  }
  
  // Handle AJAX add to cart for featured products
  function initAjaxAddToCart() {
    const addToCartForms = document.querySelectorAll('[data-add-to-cart-form]');
    
    addToCartForms.forEach(form => {
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        
        const button = form.querySelector('[data-add-to-cart-button]');
        
        // Check if button is already disabled
        if (button && button.hasAttribute('disabled')) {
          return;
        }
        
        // Validate form
        if (!form.checkValidity()) {
          form.reportValidity();
          return;
        }
        
        // Dispatch theme:cart:add event which the CartItems component listens to
        // The CartItems component will handle the AJAX request and button state
        document.dispatchEvent(new CustomEvent('theme:cart:add', {
          detail: {
            button: button
          },
          bubbles: true
        }));
      });
    });
  }
  
  // Initialize AJAX add to cart when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAjaxAddToCart);
  } else {
    initAjaxAddToCart();
  }
  
  // Anchor Channelize floating widget into the designated containers
  function anchorChannelizeWidget() {
    const containers = document.querySelectorAll('.featured-item-video');
    const isMobile = window.innerWidth <= 768;
    
    containers.forEach((container, index) => {
      const widget = container.querySelector('channelize-shoppable-videos-playlist');
      if (widget) {
        // Force the widget to stay in its container
        widget.style.position = 'relative';
        widget.style.bottom = 'auto';
        widget.style.right = 'auto';
        widget.style.left = 'auto';
        widget.style.top = 'auto';
        widget.style.transform = 'none';
        widget.style.zIndex = '1';
        
         if (isMobile) {
           // Mobile: Force centering with narrower width for portrait videos
           widget.style.width = '100%';
           widget.style.maxWidth = '200px';
           widget.style.minHeight = '350px';
           widget.style.margin = '0 auto';
           widget.style.marginBottom = '0';
           widget.style.marginTop = '0';
           widget.style.padding = '35px';
           widget.style.display = 'block';
           
           // Add margin-top to container
           const container = widget.closest('.featured-item-video');
           if (container) {
             container.style.marginTop = '30px';
             container.style.marginBottom = '0';
           }
         } else {
          // Desktop: Keep original behavior
          widget.style.width = '100%';
          widget.style.maxWidth = '100%';
          widget.style.margin = '0';
        }
        
        widget.style.height = '100%';
        widget.style.minHeight = '300px';
        widget.style.padding = '0';
        
        // Also target any inner divs, iframes or other elements
        const innerElements = widget.querySelectorAll('*');
        innerElements.forEach(el => {
          if (el.tagName === 'DIV' || el.tagName === 'IFRAME') {
            el.style.width = '100%';
            el.style.maxWidth = '100%';
            el.style.padding = '0';
            
            if (isMobile) {
              el.style.marginLeft = 'auto';
              el.style.marginRight = 'auto';
            } else {
              el.style.margin = '0';
            }
          }
        });
        
        // Target Channelize-specific internal elements for centering in mobile
        if (isMobile) {
          const floatingVideo = widget.querySelector('.ch-live-broadcast__widgets__floating-video');
          if (floatingVideo) {
            floatingVideo.style.position = 'relative';
            floatingVideo.style.left = 'auto';
            floatingVideo.style.right = 'auto';
            floatingVideo.style.transform = 'none';
            floatingVideo.style.margin = '0 auto';
            floatingVideo.style.display = 'block';
            floatingVideo.style.width = '100%';
            floatingVideo.style.maxWidth = '100%';
            floatingVideo.style.height = '100%';
            floatingVideo.style.background = 'transparent';
          }
          
          // Also target portrait variant
          const portraitVideo = widget.querySelector('.ch-live-broadcast__widgets__floating-video--portrait');
          if (portraitVideo) {
            portraitVideo.style.width = '100%';
            portraitVideo.style.maxWidth = '100%';
            portraitVideo.style.height = '100%';
          }
          
          const lightContainer = widget.querySelector('.ch-live-broadcast__light');
          if (lightContainer) {
            lightContainer.style.position = 'relative';
            lightContainer.style.left = 'auto';
            lightContainer.style.right = 'auto';
            lightContainer.style.transform = 'none';
            lightContainer.style.margin = '0 auto';
            lightContainer.style.display = 'block';
            lightContainer.style.width = '100%';
            lightContainer.style.maxWidth = '100%';
            lightContainer.style.background = 'transparent';
          }
          
          // Make video elements fill width to remove black bars
          const videoElements = widget.querySelectorAll('video, canvas, iframe');
          videoElements.forEach(video => {
            video.style.width = '100%';
            video.style.height = 'auto';
            video.style.maxWidth = '100%';
            video.style.objectFit = 'cover';
          });
        }
      }
    });
    
    // Also check for any floating widgets that might be created outside
    const floatingWidgets = document.querySelectorAll('body > channelize-shoppable-videos-playlist');
    floatingWidgets.forEach((widget) => {
      // Hide or remove floating instances if they appear outside containers
      if (!widget.closest('.featured-item-video')) {
        widget.style.display = 'none';
      }
    });
  }
  
  // Observer specifically for Channelize internal elements on mobile
  function observeChannelizeInternals() {
    const isMobile = window.innerWidth <= 768;
    if (!isMobile) return;
    
    const widgets = document.querySelectorAll('channelize-shoppable-videos-playlist');
    
    widgets.forEach((widget, index) => {
      const observer = new MutationObserver((mutations) => {
        mutations.forEach((mutation) => {
          mutation.addedNodes.forEach((node) => {
            if (node.nodeType === 1) {
              // Check if the added node or its children contain Channelize internal elements
              if (node.classList && (
                  node.classList.contains('ch-live-broadcast__widgets__floating-video') ||
                  node.classList.contains('ch-live-broadcast__light')
              )) {
                setTimeout(anchorChannelizeWidget, 50);
              }
              
              // Also check descendants
              const floatingVideo = node.querySelector && node.querySelector('.ch-live-broadcast__widgets__floating-video');
              const lightContainer = node.querySelector && node.querySelector('.ch-live-broadcast__light');
              
              if (floatingVideo || lightContainer) {
                setTimeout(anchorChannelizeWidget, 50);
              }
            }
          });
        });
      });
      
      observer.observe(widget, {
        childList: true,
        subtree: true,
        attributes: true,
        attributeFilter: ['style', 'class']
      });
    });
  }
  
  // NEW STRATEGY: Don't move modal, just eliminate stacking contexts
  function ensureModalZIndex() {
    // Find ALL fixed position elements in the entire page
    const allElements = document.querySelectorAll('*');
    let modalFound = false;
    
    allElements.forEach(el => {
      const style = window.getComputedStyle(el);
      
      // Only look at fixed position elements
      if (style.position !== 'fixed') return;
      
      // Check if visible
      const isVisible = style.display !== 'none' && style.visibility !== 'hidden' && style.opacity !== '0';
      
      // Check if it's related to Channelize
      const isChannelizeRelated = 
        el.className.toLowerCase().includes('channelize') ||
        el.className.toLowerCase().includes('ch-live-broadcast') ||
        el.id.toLowerCase().includes('channelize');
      
      if (!isChannelizeRelated) return;
      
      // Check if modal has the "open" class (Channelize uses --open class)
      const hasOpenClass = el.className.includes('--open');
      
      if (isVisible && hasOpenClass) {
        modalFound = true;
        
        // Force MAXIMUM z-index but DON'T MOVE IT
        el.style.setProperty('z-index', '2147483647', 'important');
        el.style.setProperty('position', 'fixed', 'important');
        
        // CRITICAL: Eliminate stacking context from ALL parent containers
        let parent = el.parentElement;
        while (parent && parent !== document.body) {
          parent.style.setProperty('position', 'static', 'important');
          parent.style.setProperty('overflow', 'visible', 'important');
          parent.style.setProperty('z-index', 'auto', 'important');
          parent.style.setProperty('transform', 'none', 'important');
          parent.style.setProperty('perspective', 'none', 'important');
          parent.style.setProperty('will-change', 'auto', 'important');
          parent.style.setProperty('isolation', 'auto', 'important');
          parent = parent.parentElement;
        }
      }
    });
    
    if (!modalFound) {
      // Restore container styles when modal closes
      const containers = document.querySelectorAll('.featured-item-video, .featured-item, .featured-item-row, .featured-grid');
      containers.forEach(container => {
        container.style.removeProperty('position');
        container.style.removeProperty('overflow');
        container.style.removeProperty('z-index');
        container.style.removeProperty('transform');
        container.style.removeProperty('perspective');
        container.style.removeProperty('will-change');
        container.style.removeProperty('isolation');
      });
    }
  }
  
  // MutationObserver to detect when modals are added or modified in the DOM
  const modalObserver = new MutationObserver((mutations) => {
    let needsCheck = false;
    
    mutations.forEach((mutation) => {
      // Check if nodes were added
      if (mutation.addedNodes.length) {
        mutation.addedNodes.forEach(node => {
          if (node.nodeType === 1) { // Element node
            const style = window.getComputedStyle(node);
            if (style.position === 'fixed') {
              needsCheck = true;
            }
          }
        });
      }
      
      // Check if attributes changed (like style or class)
      if (mutation.type === 'attributes' && mutation.target.nodeType === 1) {
        const style = window.getComputedStyle(mutation.target);
        if (style.position === 'fixed' || 
            mutation.target.getAttribute('role') === 'dialog' ||
            mutation.target.className.toLowerCase().includes('modal') ||
            mutation.target.className.toLowerCase().includes('channelize')) {
          needsCheck = true;
        }
      }
    });
    
    if (needsCheck) {
      setTimeout(ensureModalZIndex, 50);
      setTimeout(ensureModalZIndex, 200);
    }
  });
  
  // Observe the entire body for modal additions and changes
  modalObserver.observe(document.body, {
    childList: true,
    subtree: true,
    attributes: true,
    attributeFilter: ['style', 'class', 'role', 'aria-hidden']
  });
  
  // Use setInterval as a fallback to check for modals (less frequently to avoid performance issues)
  setInterval(ensureModalZIndex, 1000);
  
  // Listen for clicks on video widgets to catch modal opening
  document.addEventListener('click', function(e) {
    const videoWidget = e.target.closest('.featured-item-video');
    if (videoWidget) {
      setTimeout(ensureModalZIndex, 100);
      setTimeout(ensureModalZIndex, 300);
      setTimeout(ensureModalZIndex, 600);
      setTimeout(ensureModalZIndex, 1000);
    }
    
    // Also listen for close button clicks (X button)
    const isCloseButton = e.target.closest('[aria-label*="close"]') || 
                         e.target.closest('[class*="close"]') ||
                         e.target.closest('button[type="button"]');
    
    if (isCloseButton) {
      setTimeout(ensureModalZIndex, 100);
      setTimeout(ensureModalZIndex, 300);
      setTimeout(ensureModalZIndex, 600);
    }
  }, true);
  
  // Run immediately and after delay to catch dynamically loaded content
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      anchorChannelizeWidget();
      observeChannelizeInternals();
      ensureModalZIndex();
      setTimeout(anchorChannelizeWidget, 1000);
      setTimeout(anchorChannelizeWidget, 2000);
      setTimeout(observeChannelizeInternals, 1000);
      setTimeout(ensureModalZIndex, 1000);
      setTimeout(ensureModalZIndex, 2000);
    });
  } else {
    anchorChannelizeWidget();
    observeChannelizeInternals();
    ensureModalZIndex();
    setTimeout(anchorChannelizeWidget, 1000);
    setTimeout(anchorChannelizeWidget, 2000);
    setTimeout(observeChannelizeInternals, 1000);
    setTimeout(ensureModalZIndex, 1000);
    setTimeout(ensureModalZIndex, 2000);
  }
  
  // Re-anchor on window resize (with debounce)
  let resizeTimer;
  window.addEventListener('resize', function() {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => {
      anchorChannelizeWidget();
      observeChannelizeInternals();
    }, 250);
  });
  
  // Close Channelize modals when returning to page via browser back/forward navigation
  function closeChannelizeModals() {
    // Find all open modals by looking for elements with the --open class
    const openModals = document.querySelectorAll('[class*="ch-live-broadcast__modal--open"], [class*="modal--open"]');
    
    openModals.forEach(modal => {
      // Try to find and click the close button using multiple selector strategies
      let closeButton = modal.querySelector('[class*="close"]');
      if (!closeButton) {
        closeButton = modal.querySelector('[aria-label*="close" i]');
      }
      if (!closeButton) {
        closeButton = modal.querySelector('button[class*="close"]');
      }
      if (!closeButton) {
        // Try to find any button that might be a close button
        const buttons = modal.querySelectorAll('button');
        closeButton = Array.from(buttons).find(btn => {
          const ariaLabel = btn.getAttribute('aria-label') || '';
          const className = btn.className || '';
          return ariaLabel.toLowerCase().includes('close') || className.toLowerCase().includes('close');
        });
      }
      
      if (closeButton) {
        closeButton.click();
      } else {
        // If no close button found, remove the open class and hide the modal
        modal.classList.remove('ch-live-broadcast__modal--open', 'modal--open');
        modal.style.display = 'none';
        modal.style.visibility = 'hidden';
        modal.setAttribute('aria-hidden', 'true');
      }
    });
    
    // Also check for modals in body that might be fixed position overlays
    const bodyModals = document.querySelectorAll('body > div[class*="channelize"], body > div[class*="modal"]');
    bodyModals.forEach(modal => {
      const style = window.getComputedStyle(modal);
      if (style.position === 'fixed' && style.display !== 'none') {
        // Try to find and click the close button using multiple selector strategies
        let closeButton = modal.querySelector('[class*="close"]');
        if (!closeButton) {
          closeButton = modal.querySelector('[aria-label*="close" i]');
        }
        if (!closeButton) {
          closeButton = modal.querySelector('button[class*="close"]');
        }
        if (!closeButton) {
          // Try to find any button that might be a close button
          const buttons = modal.querySelectorAll('button');
          closeButton = Array.from(buttons).find(btn => {
            const ariaLabel = btn.getAttribute('aria-label') || '';
            const className = btn.className || '';
            return ariaLabel.toLowerCase().includes('close') || className.toLowerCase().includes('close');
          });
        }
        
        if (closeButton) {
          closeButton.click();
        } else {
          modal.style.display = 'none';
          modal.style.visibility = 'hidden';
          modal.setAttribute('aria-hidden', 'true');
        }
      }
    });
    
    // Remove the modal-open class from body if it exists
    document.body.classList.remove('channelize-modal-open', 'modal-open');
    
    // Restore container styles
    const containers = document.querySelectorAll('.featured-item-video, .featured-item, .featured-item-row, .featured-grid');
    containers.forEach(container => {
      container.style.removeProperty('position');
      container.style.removeProperty('overflow');
      container.style.removeProperty('z-index');
      container.style.removeProperty('transform');
      container.style.removeProperty('perspective');
      container.style.removeProperty('will-change');
      container.style.removeProperty('isolation');
    });
  }
  
  // Handle browser back/forward navigation
  window.addEventListener('popstate', function(event) {
    // Close modals when navigating back/forward
    setTimeout(closeChannelizeModals, 100);
    setTimeout(closeChannelizeModals, 300);
  });
  
  // Handle page show event (fires when page is shown, including from back/forward cache)
  window.addEventListener('pageshow', function(event) {
    // If page was loaded from cache (back/forward navigation), close any open modals
    if (event.persisted) {
      setTimeout(closeChannelizeModals, 100);
      setTimeout(closeChannelizeModals, 300);
      setTimeout(closeChannelizeModals, 600);
    }
    
    // Also close modals on regular page show (in case they were left open)
    setTimeout(closeChannelizeModals, 100);
  });
  
  // Close modals on initial page load if they're somehow already open
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      setTimeout(closeChannelizeModals, 500);
      setTimeout(closeChannelizeModals, 1000);
    });
  } else {
    setTimeout(closeChannelizeModals, 500);
    setTimeout(closeChannelizeModals, 1000);
  }
</script>
