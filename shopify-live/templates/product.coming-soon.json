    "custom_faq_QtK7h3": {
      "type": "custom-faq",
      "blocks": {
        "faq_gA3VtR": {
          "type": "faq",
          "settings": {
            "question": "Which BB Crème shade should I choose: Fair, Light, Light/Medium or Tan?",
            "answer": "Fair suits the lightest complexions, Light is for fair-to-light skin, Light/Medium is for light-to-medium skin with a little more warmth, and Tan is for medium to deeper tones. Because BB Crème is a lightweight blur with low-to-medium coverage, it blends toward your natural tone, so if you sit between two shades choose the lighter one for everyday wear. Still unsure? Email hello@nikolbeauty.com with a natural-light photo and the shades you wear in other brands and we will help you pick before you order."
          }
        },
        "faq_49QHp8": {
          "type": "faq",
          "settings": {
            "question": "How much coverage does BB Crème give?",
            "answer": "BB Crème gives low-to-medium coverage with a soft, semi-matte finish designed to blur and even out mature skin rather than mask it. Your skin still looks like skin, with redness and small discolorations softened. For extra help on age spots or under-eye darkness, layer a Nikol Beauty color corrector or Creamy Concealer only where you need it instead of adding more BB Crème."
          }
        },
        "faq_7ntjTx": {
          "type": "faq",
          "settings": {
            "question": "Is BB Crème suitable for dry or combination skin?",
            "answer": "Yes. It is enriched with shea butter and emollient oils, plus Kakadu Plum, one of the richest natural sources of Vitamin C, so it stays comfortable and hydrating throughout the day. If your skin is very dry, apply your moisturizer first and let it absorb for a few minutes before applying BB Crème."
          }
        },
        "faq_nUpBQY": {
          "type": "faq",
          "settings": {
            "question": "Do I need a moisturizer or primer underneath?",
            "answer": "Start with your usual skincare and give it a few minutes to set. A primer is optional: our Fiercely Smooth Face Primer smooths texture and helps BB Crème last longer, but BB Crème also works beautifully on its own over moisturizer."
          }
        },
        "faq_9DX3k7": {
          "type": "faq",
          "settings": {
            "question": "Will BB Crème settle into fine lines?",
            "answer": "Use a small amount and build in thin layers, pressing it in with the Foundation Buffing Brush or your fingertips rather than dragging. Let your skincare and primer absorb first, then set only the areas that need it, such as around the nose and mouth, with a light dusting of Nikita Banana Brightening Powder. Less product means less to settle into lines."
          }
        },
        "faq_9W4BQQ": {
          "type": "faq",
          "settings": {
            "question": "Nothing is coming out of the pump on my new bottle. What should I do?",
            "answer": "BB Crème uses an airless pump, and the product can lose contact with the pump if air gets trapped during shipping. Shake the bottle well, turn it so the pump faces downward, and pump gently several times until the product begins to flow. If it still will not dispense, email hello@nikolbeauty.com with a photo of the bottle and the batch number embossed near the base, and our Customer Care team will make it right."
          }
        },
        "faq_r6GhFp": {
          "type": "faq",
          "settings": {
            "question": "Can I build it up over redness and age spots?",
            "answer": "You can add a second thin layer where needed, but for stronger correction pair it with a color corrector applied underneath: No Redness for redness, or Just Peachy and Simply Apricot for darkness. Then apply BB Crème over the top for an even, natural finish."
          }
        },
        "faq_qmicbe": {
          "type": "faq",
          "settings": {
            "question": "How long does one bottle last?",
            "answer": "A little goes a long way, so with daily use most customers find a bottle lasts for months. Store it upright at room temperature, away from heat and direct sunlight, to keep the formula fresh."
          }
        },
        "faq_8yGXxe": {
          "type": "faq",
          "settings": {
            "question": "How is BB Crème different from the Serum Foundation?",
            "answer": "BB Crème is a lightweight complexion blur with a semi-matte finish and low-to-medium coverage, ideal for an effortless everyday look. Serum Foundation is a skincare-infused liquid with a radiant, silk-smooth finish and buildable light-to-medium coverage, applied with a dropper. Choose BB Crème for a quick, natural finish and Serum Foundation when you want more luminosity."
          }
        }
      },
