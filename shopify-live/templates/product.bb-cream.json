    "cw_faq_QtK7h3": {
      "type": "cw-faq",
      "blocks": {
        "faq_gA3VtR": {
          "type": "faq",
          "settings": {
            "question": "Is this BB Creme really made for mature skin?",
            "answer": "Yes. It was developed by licensed esthetician Nikol Johnson-Sanchez specifically for women 40+ whose skin has changed. The formula is designed to wear evenly on skin that creases more easily, feels drier, or reacts poorly to heavier makeup."
          }
        },
        "faq_49QHp8": {
          "type": "faq",
          "settings": {
            "question": "Will this settle into fine lines or pores?",
            "answer": "No. The texture is designed to stay flexible on the skin instead of drying down stiff. It holds together throughout the day rather than collecting in expression lines, pores, or around the nose and mouth."
          }
        },
        "faq_7ntjTx": {
          "type": "faq",
          "settings": {
            "question": "How much coverage does it give?",
            "answer": "Light to light-medium. It evens tone and softens redness without covering freckles or natural texture. You can build slightly in areas you want more coverage, but it’s meant to still look like skin."
          }
        },
        "faq_nUpBQY": {
          "type": "faq",
          "settings": {
            "question": "Will it feel heavy or tight after a few hours?",
            "answer": "No. The formula includes hydrating and skin-softening ingredients to help avoid that tight, dry feeling that often shows up later in the day with traditional base products."
          }
        },
        "faq_9DX3k7": {
          "type": "faq",
          "settings": {
            "question": "Is this safe for sensitive skin?",
            "answer": "Yes. It’s made without sulfates or parabens and uses ingredients selected to sit calmly on mature, sensitive skin. Many customers with easily irritated skin use it comfortably for everyday wear."
          }
        },
        "faq_9W4BQQ": {
          "type": "faq",
          "settings": {
            "question": "Do I need special tools to apply it?",
            "answer": "No. You can apply it with your fingers, a brush, or a sponge. It spreads easily without tugging, so there’s no need for precision tools or complicated techniques."
          }
        },
        "faq_r6GhFp": {
          "type": "faq",
          "settings": {
            "question": "How do I choose the right shade?",
            "answer": "Shades are labeled by depth and undertone (warm or cool) to make choosing easier. If you’re unsure, our quick quiz can help guide you based on your skin tone and preferences."
          }
        },
        "faq_qmicbe": {
          "type": "faq",
          "settings": {
            "question": "Can I wear this every day?",
            "answer": "Yes. It’s designed for daily use when you want your skin to look even and put together without spending time layering, fixing, or reapplying."
          }
        },
        "faq_8yGXxe": {
          "type": "faq",
          "settings": {
            "question": "What if my product arrives damaged?",
            "answer": "If your order arrives damaged, contact our support team within 48 hours of delivery with photos and your invoice so we can assist."
          }
        }
      },
