{%- comment -%}
  ============================================================
  Custom robots.txt for Nikol Beauty
  ============================================================
  Behavior:
    1. Inherits Shopify's default robots rules.
    2. REMOVES the disallow rules for /account, /policies/, /*/policies/
       so Google can crawl those URLs and see a 'noindex' meta tag.
       Fixes Search Console: "Indexed, though blocked by robots.txt"
    3. Keeps all other Shopify defaults (cart, checkout, search, etc.)
    4. Appends explicit AI crawler allow rules.

  Apply at:  Online Store → Themes → … → Edit code → templates/robots.txt.liquid
  ============================================================
{%- endcomment -%}

{%- for group in robots.default_groups -%}
  {{- group.user_agent }}

  {%- for rule in group.rules -%}
    {%- assign skip_rule = false -%}
    {%- if rule.directive == 'Disallow' -%}
      {%- if rule.value == '/account' -%}{%- assign skip_rule = true -%}{%- endif -%}
      {%- if rule.value == '/policies/' -%}{%- assign skip_rule = true -%}{%- endif -%}
      {%- if rule.value == '/*/policies/' -%}{%- assign skip_rule = true -%}{%- endif -%}
    {%- endif -%}
    {%- unless skip_rule -%}
      {{ rule }}
    {%- endunless -%}
  {%- endfor -%}

  {%- if group.sitemap != blank %}
    {{ group.sitemap }}
  {%- endif %}

{% endfor -%}

