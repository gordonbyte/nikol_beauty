{%- style -%}
  #Faq-{{ section.id }} {
    --custom-faq-bg: {{ section.settings.background_color }};
    --custom-faq-border: {{ section.settings.border_color }};
  }
{%- endstyle -%}

<style>
.custom-faq {
  background: var(--custom-faq-bg);
  color: var(--COLOR-TEXT);
  padding: 80px 0;
}

.custom-faq__header {
  text-align: center;
  margin-bottom: 50px;
}

.custom-faq__title {
  margin: 0;
  font-size: clamp(34px, 3.24vw + 14.6px, 56px);
  font-weight: 500;
  line-height: 110%;
  letter-spacing: -0.02em;
  font-family: 'Cormorant';
  text-wrap: pretty;
}

.custom-faq__subtitle {
  margin: 0;
  font-size: clamp(var(--FONT-SIZE-BASE), 0.47vw + 15.2px, 20px);
  line-height: 140%;
  letter-spacing: -0.02em;
  font-weight: 400;
  padding-top: 15px;
  text-wrap: pretty;
}

.custom-faq__list {
  max-width: 700px;
  margin: 0 auto;
}

.custom-faq__item {
  border-bottom: 1px solid var(--custom-faq-border);
}

.custom-faq__question {
  margin: 0;
  font-weight: 400;
}

.custom-faq__trigger {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  width: 100%;
  padding: 20px 0;
  background: transparent;
  border: 0;
  cursor: pointer;
  text-align: left;
  text-transform: capitalize;
  color: inherit;
  font: inherit;
}

.custom-faq__trigger:focus-visible {
  outline: 2px solid var(--COLOR-TEXT);
  outline-offset: 3px;
}

.custom-faq__q-text {
  font-size: clamp(22px, 0.59vw + 18.5px, 26px);
  line-height: 110%;
  letter-spacing: -0.02em;
  font-weight: 500;
  font-family: 'Cormorant';
}

.custom-faq__icon {
  flex-shrink: 0;
  line-height: 0;
}

.custom-faq__icon img {
  width: 18px;
  display: none;
}

.custom-faq__item:not(.is-open) .custom-faq__icon-plus {
  display: block;
}

.custom-faq__item.is-open .custom-faq__icon-minus {
  display: block;
}

.custom-faq__answer {
  padding-bottom: 0;
  font-size: var(--FONT-SIZE-BASE);
  line-height: 150%;
  font-weight: 400;
}

/* bottom spacing lives inside the collapsing content (padding on the answer
   would survive the 0fr collapse and leave a 20px gap under closed items) */
.custom-faq__answer::after {
  content: "";
  display: block;
  height: 20px;
}

/* Animated open/close: grid-rows 0fr -> 1fr; collapsed answers are
   visibility-hidden so they leave the tab order and screen-reader tree. */
.custom-faq__collapse {
  display: grid;
  grid-template-rows: 0fr;
  overflow: hidden;
}

.custom-faq__item.is-open .custom-faq__collapse {
  grid-template-rows: 1fr;
}

.custom-faq__collapse .custom-faq__answer {
  min-height: 0;
  overflow: hidden;
  visibility: hidden;
}

.custom-faq__item.is-open .custom-faq__answer {
  visibility: visible;
}

.custom-faq.anim-ready .custom-faq__collapse {
  transition: grid-template-rows 0.4s ease;
}

.custom-faq.anim-ready .custom-faq__collapse .custom-faq__answer {
  transition: visibility 0s 0.4s;
}

.custom-faq.anim-ready .custom-faq__item.is-open .custom-faq__answer {
  transition: visibility 0s 0s;
}

.custom-faq__icon {
  transition: transform 0.3s ease;
}

@media (hover: hover) {
  .custom-faq__trigger:hover .custom-faq__icon {
    transform: scale(1.2);
  }
}

/* Scroll-in reveal: initial hidden states apply ONLY once JS adds anim-ready,
   so content stays visible without JS and under reduced motion. */
.custom-faq.anim-ready .custom-faq__title,
.custom-faq.anim-ready .custom-faq__subtitle,
.custom-faq.anim-ready .custom-faq__item {
  opacity: 0;
  transform: translateY(22px);
  transition: opacity 0.6s ease, transform 0.6s ease;
}

.custom-faq.anim-ready.is-inview .custom-faq__title,
.custom-faq.anim-ready.is-inview .custom-faq__subtitle,
.custom-faq.anim-ready.is-inview .custom-faq__item {
  opacity: 1;
  transform: none;
}

@media only screen and (max-width: 600px) {
  .custom-faq {
    padding: 40px 0;
  }

  .custom-faq__title {
    font-size: 34px;
  }

  .custom-faq__header {
    margin-bottom: 20px;
  }

  .custom-faq__trigger {
    gap: 20px;
  }

  .custom-faq__q-text {
    font-size: 22px;
  }

  .custom-faq__answer {
    font-size: var(--FONT-SIZE-BASE);
    padding-right: 20px;
  }
}
</style>

{%- liquid
  # Coming-soon product template: with "Use Coming Soon Page metaobject" on,
  # content comes from the product's custom.coming_soon metaobject (no
  # fallback, section hidden without an entry). Off = section settings render.
  assign cs_mode = false
  assign cs_faq_count = 0
  if template.suffix == 'coming-soon' and product and section.settings.use_metaobject
    assign cs_mode = true
    assign cs = product.metafields.custom.coming_soon.value
    assign cs_faqs = cs.faqs.value
    if cs_faqs
      assign cs_faq_count = cs_faqs.size
    endif
  endif

  assign faq_subtitle = section.settings.subtitle
  if cs_mode
    assign faq_subtitle = cs.faq_subtitle
  endif
-%}
{%- if cs_mode and cs_faq_count < 1 -%}
  {%- comment -%} no per-product FAQs — section hidden {%- endcomment -%}
{%- else -%}
<section class="custom-faq" id="Faq-{{ section.id }}" aria-labelledby="custom-faq-title-{{ section.id }}">
  <div class="page-width">

    {%- if section.settings.title != blank or faq_subtitle != blank -%}
      <div class="custom-faq__header">
        {%- if section.settings.title != blank -%}
          <h2 class="custom-faq__title" id="custom-faq-title-{{ section.id }}">{% render 'custom-no-orphan', text: section.settings.title %}</h2>
        {%- endif -%}
        {%- if faq_subtitle != blank -%}
          <p class="custom-faq__subtitle">{% render 'custom-no-orphan', text: faq_subtitle %}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="custom-faq__list">
      {%- if cs_mode -%}
      {% for item in cs_faqs %}
        {%- assign panel_id = 'custom-faq-panel-' | append: section.id | append: '-' | append: forloop.index -%}
        {%- assign trigger_id = 'custom-faq-trigger-' | append: section.id | append: '-' | append: forloop.index -%}
        <div class="custom-faq__item">
          <h3 class="custom-faq__question">
            <button
              type="button"
              class="custom-faq__trigger"
              id="{{ trigger_id }}"
              aria-expanded="false"
              aria-controls="{{ panel_id }}"
            >
              <span class="custom-faq__q-text">{{ item.question }}</span>

              <span class="custom-faq__icon" aria-hidden="true">
                {% if section.settings.plus_icon != blank %}
                  <img class="custom-faq__icon-plus" src="{{ section.settings.plus_icon | img_url: 'master' }}" alt="" width="18" height="18" loading="lazy">
                {% endif %}
                {% if section.settings.minus_icon != blank %}
                  <img class="custom-faq__icon-minus" src="{{ section.settings.minus_icon | img_url: 'master' }}" alt="" width="18" height="18" loading="lazy">
                {% endif %}
              </span>
            </button>
          </h3>

          <div class="custom-faq__collapse">
            <div
              class="custom-faq__answer"
              id="{{ panel_id }}"
              role="region"
              aria-labelledby="{{ trigger_id }}"
            >
              {{ item.answer | newline_to_br }}
            </div>
          </div>
        </div>
      {% endfor %}
      {%- else -%}
      {% for block in section.blocks %}
        {%- assign panel_id = 'custom-faq-panel-' | append: section.id | append: '-' | append: forloop.index -%}
        {%- assign trigger_id = 'custom-faq-trigger-' | append: section.id | append: '-' | append: forloop.index -%}
        <div class="custom-faq__item" {{ block.shopify_attributes }}>
          <h3 class="custom-faq__question">
            <button
              type="button"
              class="custom-faq__trigger"
              id="{{ trigger_id }}"
              aria-expanded="false"
              aria-controls="{{ panel_id }}"
            >
              <span class="custom-faq__q-text">{{ block.settings.question }}</span>

              <span class="custom-faq__icon" aria-hidden="true">
                {% if section.settings.plus_icon != blank %}
                  <img
                    class="custom-faq__icon-plus"
                    src="{{ section.settings.plus_icon | img_url: 'master' }}"
                    alt=""
                    width="18"
                    height="18"
                    loading="lazy"
                  >
                {% endif %}

                {% if section.settings.minus_icon != blank %}
                  <img
                    class="custom-faq__icon-minus"
                    src="{{ section.settings.minus_icon | img_url: 'master' }}"
                    alt=""
                    width="18"
                    height="18"
                    loading="lazy"
                  >
                {% endif %}
              </span>
            </button>
          </h3>

          <div class="custom-faq__collapse">
            <div
              class="custom-faq__answer"
              id="{{ panel_id }}"
              role="region"
              aria-labelledby="{{ trigger_id }}"
            >
              {{ block.settings.answer }}
            </div>
          </div>
        </div>
      {% endfor %}
      {%- endif -%}
    </div>
  </div>
</section>
{%- endif -%}

<script>
document.addEventListener("DOMContentLoaded", function () {
  var root = document.getElementById("Faq-{{ section.id }}");
  if (!root) return;
  var items = root.querySelectorAll(".custom-faq__item");

  items.forEach(function (item) {
    var trigger = item.querySelector(".custom-faq__trigger");
    var panel = item.querySelector(".custom-faq__answer");
    if (!trigger || !panel) return;

    trigger.addEventListener("click", function () {
      var willOpen = !item.classList.contains("is-open");

      items.forEach(function (other) {
        if (other === item) return;
        other.classList.remove("is-open");
        var otherTrigger = other.querySelector(".custom-faq__trigger");
        if (otherTrigger) otherTrigger.setAttribute("aria-expanded", "false");
      });

      item.classList.toggle("is-open", willOpen);
      trigger.setAttribute("aria-expanded", willOpen ? "true" : "false");
    });
  });
});
</script>

<script>
  (function () {
    var root = document.getElementById('Faq-{{ section.id }}');
    if (!root) return;
    if (!('IntersectionObserver' in window)) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (window.theme && window.theme.settings && window.theme.settings.enableAnimations === false) return;

    var targets = root.querySelectorAll('.custom-faq__title, .custom-faq__subtitle, .custom-faq__item');
    if (!targets.length) return;

    targets.forEach(function (el, i) {
      el.style.transitionDelay = Math.min(i * 0.12, 0.96) + 's';
    });

    root.classList.add('anim-ready');

    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          root.classList.add('is-inview');
          observer.disconnect();
        }
      });
    }, { threshold: 0.15 });

    observer.observe(root);
  })();
</script>

{% schema %}
{
  "name": "[Custom] FAQ",
  "settings": [
    {
      "type": "checkbox",
      "id": "use_metaobject",
      "label": "Use Coming Soon Page metaobject",
      "info": "Coming-soon product template only: pull this section's content from the product's Coming Soon Page metaobject (custom.coming_soon) instead of the settings below. Leave off to show the settings below.",
      "default": false
    },
    {
      "type": "text",
      "id": "title",
      "label": "Main Title",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Everything you need to know."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#F7F2ED"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Divider color",
      "default": "#CEC9C5"
    },
    {
      "type": "header",
      "content": "Icons"
    },
    {
      "type": "image_picker",
      "id": "plus_icon",
      "label": "Plus Icon Image"
    },
    {
      "type": "image_picker",
      "id": "minus_icon",
      "label": "Minus Icon Image"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Your question here"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "Your answer here"
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "[Custom] FAQ",
      "blocks": [
        { "type": "faq" },
        { "type": "faq" },
        { "type": "faq" }
      ]
    }
  ]
}
{% endschema %}
