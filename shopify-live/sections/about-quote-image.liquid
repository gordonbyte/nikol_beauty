<div class="about-quote-image site-about-quote-image-wrapper">
  <div class="about-quote-image__inner">
    <div class="about-quote-image__left">
      <div class="about-quote-image__copy">
        {{ section.settings.quote }}
      </div>
    </div>
    <div class="about-quote-image__right">
      <div class="about-quote-image__copy">
        <figure class="about-header__image">  
          <img 
            src="{{ section.settings.image | image_url }}"
            alt="{{ section.settings.image | default: shop.name }}"
            loading="eager"
            />
          </figure>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "About Quote + Image",
  "settings": [
    {
      "type": "richtext",
      "id": "quote",
      "label": "Quote"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ],
  "presets": [{
    "name": "About Quote + Image",
    "category": "Image"
  }]
}
{% endschema %}
