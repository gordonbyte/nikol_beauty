<div 
  class="meet-nikol" 
  data-section-id="{{ section.id }}" 
  data-section-type="meet-nikol"
  >
  <div class="meet-nikol__inner">
    <div class="meet-nikol__left">
      <figure class="meet-nikol__image">
        <img
          src="{{ section.settings.image | image_url: width: 800 }}"
          srcset="{{ section.settings.image | image_url: width: 400 }} 400w, {{ section.settings.image | image_url: width: 600 }} 600w, {{ section.settings.image | image_url: width: 800 }} 800w"
          sizes="(min-width: 1145px) 533px, (min-width: 750px) calc(50vw - 40px), calc(100vw - 32px)"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          alt="{{ section.settings.image.alt | default: shop.name }}"
          loading="lazy"
          >
      </figure>
    </div>
    <div class="meet-nikol__right" style="background-image: url({{ 'meet-nikol-bg.png' | asset_url }}); background-color: {{ section.settings.bg_color | default: '#FCC9C6' }}">
      <div class="meet-nikol__text">
        <h2 class="meet-nikol__title">
          {{ section.settings.title }}  
        </h2>
        <div class="meet-nikol__copy">
          {{ section.settings.copy }}
        </div>
        {%- if section.settings.cta_text != blank -%}
          <a href="{{ section.settings.cta_link }}" class="link">
            {{ section.settings.cta_text }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Meet Nikol",
  "class": "section-meet-nikol",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Meet Nikol"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Panel background color",
      "default": "#FCC9C6"
    },
    {
      "type": "richtext",
      "id": "copy",
      "label": "Copy",
      "default": "<p>Lorem ipsum dolor sit amet...</p>"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Text",
      "default": "Read More About Nikol"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Link",
      "default": "/"
    }
  ],
  "presets": [{
    "name": "Meet Nikol",
    "category": "Image"
  }]
}
{% endschema %}
