
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.css"/>
<script src="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.js"></script>

<style>
.cw-collect-bestseller-tab-panel {
    display: none;
}

.cw-collect-bestseller-tab-panel.active {
    display: block;
}
section.cw-collect-bestseller-section {
    background: #F7F2ED66;
    padding: 80px 0px;
}

.cw-collect-bestseller-header {
    text-align: center;
}

.cw-collect-bestseller-title {
    color: #2A2724;
    font-size: 56px;
    line-height: 110%;
    font-family: 'Cormorant';
    letter-spacing: -3px;
    font-weight: 500;
        text-transform: capitalize;
}

.cw-collect-bestseller-subtitle {
    color: #2A2724;
    font-family: 'Inter';
    font-size: 20px;
    padding-top: 20px;
    padding-bottom: 50px;
}

.cw-collect-bestseller-tabs {
    display: flex;
    justify-content: center;
    gap: 40px;
    margin-bottom: 70px;
}

.cw-collect-bestseller-tab {
    text-align: center;
    cursor: pointer;
    opacity: 0.8;
}

.cw-collect-bestseller-tab .cw-collect-bestseller-tab-img img {
    max-width: 90px;
    object-fit: contain;
}

.cw-collect-bestseller-tab .cw-collect-bestseller-tab-title {
    color: #2A2724;
    font-size: 16px;
    padding-top: 5px;
}

.cw-collect-bestseller-tab.active {
    opacity: 1;
}

.cw-collect-bestseller-swiper {
    padding: 0 280px !important;
}
.cw-collect-bestseller-tab-panel {
    position: relative;
}

.cw-collect-bestseller-arrow.cw-collect-bestseller-prev {
    position: absolute;
    top: 50%;
    z-index: 1;
    cursor: pointer;
    left: 10%;
}

.cw-collect-bestseller-arrow.cw-collect-bestseller-next {
    position: absolute;
    top: 50%;
    z-index: 1;
    cursor: pointer;
    right: 10%;
}

span.review-count {color: #2A2724;font-size: 14px;font-weight: 400;font-family: 'Inter';}

.custom-rating-widget.cw-product-card-rating {
    padding-bottom: 10px;
}

.cw-collect-bestseller-img a {
    display: block;
}

.cw-collect-bestseller-img a img {
    width: 100%;
}

.cw-collect-bestseller-product-title {
    color: #2A2724;
    font-size: 26px;
    line-height: 120%;
    font-family: 'Cormorant';
    font-weight: 500;
    padding-bottom: 10px;
}

.cw-collect-bestseller-product-price {
    color: #2A2724;
    font-family: 'Inter';
    font-weight: 400;
    font-size: 18px;
}

.cw-banner-button.cw-collect-bestseller-btn-wrap {
    padding: 0;
    padding-top: 50px;
    text-align: center;
}

.cw-banner-button.cw-collect-bestseller-btn-wrap a {
    margin: 0 auto;
}

.cw-collect-bestseller-section .swiper-backface-hidden .swiper-slide {
    max-width: 300px;
}

@media only screen and (max-width: 600px) {
.cw-collect-bestseller-tabs-overflow {
    overflow: auto;
            padding: 0 15px;
}

.cw-collect-bestseller-swiper {
    padding: 0 0px !important;
}

.cw-collect-bestseller-tabs {
    overflow: auto;
   width: 570px;
        justify-content: flex-start;
        gap: 15px;
        margin-bottom: 15px;
}
section.cw-collect-bestseller-section {
    padding: 40px 0px;
}

.cw-collect-bestseller-title {
    font-size: 34px;
}
.cw-collect-bestseller-title {
    padding-bottom: 0px;
}
.cw-collect-bestseller-subtitle {
    font-size: 16px;
    line-height: 135%;
    padding-top: 15px;
    padding-bottom: 30px;
}

.cw-collect-bestseller-tab .cw-collect-bestseller-tab-img img {
    max-width: 75px;
}

.cw-collect-bestseller-tab .cw-collect-bestseller-tab-title {
    font-size: 13px;
    padding-top: 3px;
}

.cw-banner-button.cw-collect-bestseller-btn-wrap {
    padding: 0 15px;
    padding-top: 30px;
}

.cw-collect-bestseller-content {
    padding-left: 15px;
}

.cw-collect-bestseller-product-title {
    font-size: 22px;
    padding-bottom: 8px;
}

.custom-rating-widget.cw-product-card-rating {
    padding-bottom: 5px;
}

.cw-collect-bestseller-product-price {
    font-size: 16px;
}

.cw-collect-bestseller-arrow.cw-collect-bestseller-next {
    right: 3%;
}

.cw-collect-bestseller-arrow.cw-collect-bestseller-next svg {
    width: 30px;
}

.cw-collect-bestseller-arrow.cw-collect-bestseller-prev {
    left: 3%;
}

.cw-collect-bestseller-arrow.cw-collect-bestseller-prev svg {
    width: 30px;
}
section.cw-collect-bestseller-section .cw-collect-bestseller-header {
    padding: 0 15px;
}
}

    </style>

<section class="cw-collect-bestseller-section">
  <div class="cw-collect-bestseller-page-width">

  
    <div class="cw-collect-bestseller-header">
      {% if section.settings.title != blank %}
        <div class="cw-collect-bestseller-title">
          {{ section.settings.title }}
        </div>
      {% endif %}

      {% if section.settings.subtitle != blank %}
        <div class="cw-collect-bestseller-subtitle">
          {{ section.settings.subtitle }}
        </div>
      {% endif %}
    </div>

     
  
    <div class="cw-collect-bestseller-content">

      {% for block in section.blocks %}
        {% assign tab_collection = block.settings.collection %}

        <div
          class="cw-collect-bestseller-tab-panel {% if forloop.first %}active{% endif %}"
          data-content="tab-{{ block.id }}"
        >

          {% if tab_collection != blank %}
            <div class="swiper cw-collect-bestseller-swiper">
              <div class="swiper-wrapper">

                {% for product in tab_collection.products limit: section.settings.products_limit %}
                  <div class="swiper-slide cw-collect-bestseller-item">

                  
                    <div class="cw-collect-bestseller-img">
                      <a href="{{ product.url }}">
                        <img src="{{ product.featured_image | img_url: '400x' }}" alt="{{ product.title }}">
                      </a>
                    </div>

              {%- if product.metafields.judgeme.badge -%}
                <div class="custom-rating-widget cw-product-card-rating">
                <span class="custom-star">
<svg width="74" height="14" viewBox="0 0 74 14" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M7 0L8.64397 5.35983L14 5.34752L9.66 8.64777L11.3262 14L7 10.6798L2.67376 14L4.34 8.64777L0 5.34752L5.35603 5.35983L7 0Z" fill="#FB6D00"/>
<path d="M21.8921 0L23.5361 5.35983L28.8921 5.34752L24.5521 8.64777L26.2183 14L21.8921 10.6798L17.5659 14L19.2321 8.64777L14.8921 5.34752L20.2481 5.35983L21.8921 0Z" fill="#FB6D00"/>
<path d="M36.7842 0L38.4282 5.35983L43.7842 5.34752L39.4442 8.64777L41.1104 14L36.7842 10.6798L32.4579 14L34.1242 8.64777L29.7842 5.34752L35.1402 5.35983L36.7842 0Z" fill="#FB6D00"/>
<path d="M51.6763 0L53.3202 5.35983L58.6763 5.34752L54.3363 8.64777L56.0025 14L51.6763 10.6798L47.35 14L49.0163 8.64777L44.6763 5.34752L50.0323 5.35983L51.6763 0Z" fill="#FB6D00"/>
<path d="M66.5684 0L68.2123 5.35983L73.5684 5.34752L69.2284 8.64777L70.8946 14L66.5684 10.6798L62.2421 14L63.9084 8.64777L59.5684 5.34752L64.9244 5.35983L66.5684 0Z" fill="#FB6D00"/>
</svg>
</span>

<span class="review-count">{{ product.metafields.judgeme.badge | split: "data-number-of-reviews='" | last | split: "'" | first | default: "0" }}</span>
</div>
            
            {%- endif -%}
                 
                   

                 
                    <div class="cw-collect-bestseller-product-title">
                      {{ product.title }}
                    </div>

                   
                    <div class="cw-collect-bestseller-product-price">
                      {{ product.price | money }}
                    </div>

                  </div>
                {% endfor %}

              </div>

              <div class="cw-collect-bestseller-arrow cw-collect-bestseller-prev">
                <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
<rect width="48" height="48" rx="24" fill="#45413B"/>
<path d="M28.8 30.8872C28.8 30.8294 28.7855 30.7618 28.7566 30.6847C28.7277 30.6075 28.6939 30.5496 28.6554 30.511L22.1493 24.0001L28.6554 17.518C28.6939 17.4601 28.7277 17.3974 28.7566 17.3299C28.7855 17.2624 28.8 17.1997 28.8 17.1418C28.8 17.0647 28.7855 16.9923 28.7566 16.9248C28.7277 16.8573 28.6939 16.7946 28.6554 16.7367L27.8168 15.9264C27.759 15.8686 27.6963 15.8252 27.6289 15.7962C27.5614 15.7673 27.4987 15.7528 27.4409 15.7528C27.3638 15.7528 27.2915 15.7673 27.224 15.7962C27.1566 15.8252 27.1036 15.8686 27.065 15.9264L19.3445 23.6239C19.306 23.6817 19.2722 23.7444 19.2433 23.812C19.2144 23.8795 19.2 23.9422 19.2 24.0001C19.2 24.0772 19.2144 24.1496 19.2433 24.2171C19.2722 24.2846 19.306 24.3377 19.3445 24.3762L27.065 32.1026C27.1036 32.1412 27.1566 32.175 27.224 32.2039C27.2915 32.2328 27.3638 32.2473 27.4409 32.2473C27.4987 32.2473 27.5614 32.2328 27.6289 32.2039C27.6963 32.175 27.759 32.1412 27.8168 32.1026L28.6554 31.2634C28.6939 31.2248 28.7277 31.1718 28.7566 31.1043C28.7855 31.0367 28.8 30.9644 28.8 30.8872Z" fill="white"/>
</svg>

              </div>
              <div class="cw-collect-bestseller-arrow cw-collect-bestseller-next">
                <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
<rect width="48" height="48" rx="24" fill="#45413B"/>
<path d="M19.2 17.1129C19.2 17.1708 19.2145 17.2383 19.2434 17.3155C19.2723 17.3926 19.3061 17.4505 19.3446 17.4891L25.8507 24.0001L19.3446 30.4821C19.3061 30.54 19.2723 30.6027 19.2434 30.6702C19.2145 30.7377 19.2 30.8004 19.2 30.8583C19.2 30.9355 19.2145 31.0078 19.2434 31.0753C19.2723 31.1429 19.3061 31.2056 19.3446 31.2634L20.1832 32.0737C20.241 32.1316 20.3037 32.175 20.3711 32.2039C20.4386 32.2328 20.5013 32.2473 20.5591 32.2473C20.6362 32.2473 20.7085 32.2328 20.776 32.2039C20.8434 32.175 20.8964 32.1316 20.935 32.0737L28.6555 24.3763C28.694 24.3184 28.7278 24.2557 28.7567 24.1882C28.7856 24.1206 28.8 24.0579 28.8 24.0001C28.8 23.9229 28.7856 23.8506 28.7567 23.783C28.7278 23.7155 28.694 23.6625 28.6555 23.6239L20.935 15.8975C20.8964 15.8589 20.8434 15.8252 20.776 15.7962C20.7085 15.7673 20.6362 15.7528 20.5591 15.7528C20.5013 15.7528 20.4386 15.7673 20.3711 15.7962C20.3037 15.8252 20.241 15.8589 20.1832 15.8975L19.3446 16.7367C19.3061 16.7753 19.2723 16.8283 19.2434 16.8959C19.2145 16.9634 19.2 17.0357 19.2 17.1129Z" fill="white"/>
</svg>

              </div>
            </div>
          {% endif %}
 <div class="cw-banner-button cw-collect-bestseller-btn-wrap">
          <a href="{{ block.settings.button_link }}">
            {{ block.settings.button_label }} <svg width="22" height="13" viewBox="0 0 22 13" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M0.843262 5.36644C0.377534 5.36644 -1.22974e-05 5.74399 -1.23382e-05 6.20972C-1.23789e-05 6.67544 0.377534 7.05299 0.843262 7.05299L0.843262 6.20972L0.843262 5.36644ZM21.4395 6.806C21.7689 6.47668 21.7689 5.94275 21.4395 5.61343L16.073 0.24687C15.7437 -0.0824491 15.2097 -0.0824491 14.8804 0.24687C14.5511 0.576189 14.5511 1.11012 14.8804 1.43944L19.6507 6.20972L14.8804 10.98C14.5511 11.3093 14.5511 11.8432 14.8804 12.1726C15.2097 12.5019 15.7437 12.5019 16.073 12.1726L21.4395 6.806ZM0.843262 6.20972L0.843262 7.05299L20.8433 7.05299L20.8433 6.20972L20.8433 5.36644L0.843262 5.36644L0.843262 6.20972Z" fill="white"></path>
</svg>


          </a>
        </div>
        </div>
       
      {% endfor %}

    </div>

    
    

  </div>
</section>

<script>


  const bestSellerSwipers = document.querySelectorAll('.cw-collect-bestseller-swiper');

  bestSellerSwipers.forEach((slider) => {
    new Swiper(slider, {
      slidesPerView: 1.2,
      spaceBetween: 40,
      loop: true,
      speed: 600,

      navigation: {
        nextEl: slider.querySelector('.cw-collect-bestseller-next'),
        prevEl: slider.querySelector('.cw-collect-bestseller-prev'),
      },

      breakpoints: {
        0: {
          slidesPerView: 1.2,
          spaceBetween: 40,
          centeredSlides: false
        },
        768: {
          slidesPerView: 3,
          centeredSlides: true
        },
        1024: {
          slidesPerView: 3,
           centeredSlides: true
        }
      }
    });
  });


</script>


{% schema %}
{
  "name": "[Custom] Product Slider",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Products you may also like"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Section Subtitle",
      "default": "Our most-loved makeup for mature skin, designed to look natural and feel comfortable."
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Products Per Tab",
      "min": 4,
      "max": 20,
      "step": 1,
      "default": 10
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "View All"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "collection_tab",
      "name": "Collection Tab",
      "settings": [
        {
      "type": "image_picker",
      "id": "tab_image",
      "label": "Tab Image"
    },
        {
          "type": "text",
          "id": "tab_label",
          "label": "Tab Label",
          "default": "Lips"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        },
        {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "View All"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "[Custom] Product Slider",
      "blocks": [
        { "type": "collection_tab" },
        { "type": "collection_tab" },
        { "type": "collection_tab" }
      ]
    }
  ]
}
{% endschema %}
