<div id="contact" class="about-contact site-about-contact-wrapper">
  <div class="about-contact__inner">
    <div class="about-contact__left">
      <figure class="about-contact__image">  
        <img
          src="{{ section.settings.image | image_url }}"
          alt="{{ section.settings.image.alt | default: section.settings.title | default: shop.name | strip_html | escape }}"
          loading="eager"
          />
        </figure>
    </div>
    <div class="about-contact__right" style="background-color: {{ section.settings.bg_color | default: '#FCC9C6' }}">
      <h2 class="about-contact__title">
        {{ section.settings.title }}
      </h2>

    	<div class="about-contact__copy">
        {{ section.settings.copy }} 
      </div>

      {%- form 'contact', id: 'contact-us-page', class: 'about-contact__form' -%}
        {%- if form.posted_successfully? -%}
          <p class="form-success">
            {{ 'contact.form.post_success' | t }}
          </p>
        {%- endif -%}

        {{ form.errors | default_errors }}

        <div class="about-contact__row">
          <div class="custom-form__block">
            <label for="AboutContact-first-{{ section.id }}" class="visually-hidden">First name</label>
            <input type="text" class="contactFormText field" id="AboutContact-first-{{ section.id }}" name="contact[first_name]" placeholder="FIRST NAME*" autocomplete="given-name" autocapitalize="words" value="" required/>
          </div>
          <div class="custom-form__block">
            <label for="AboutContact-last-{{ section.id }}" class="visually-hidden">Last name</label>
            <input type="text" class="contactFormText field" id="AboutContact-last-{{ section.id }}" name="contact[last_name]" placeholder="LAST NAME*" autocomplete="family-name" autocapitalize="words" value="" required/>
          </div>
        </div>

        <div class="about-contact__row">
          <div class="custom-form__block">
            <label for="AboutContact-email-{{ section.id }}" class="visually-hidden">Email address</label>
            <input type="email" class="contactFormEmail field" id="AboutContact-email-{{ section.id }}" name="contact[email]" placeholder="EMAIL ADDRESS*" autocomplete="email" autocorrect="off" autocapitalize="off" required/>
          </div>
        </div>

        <div class="about-contact__row">
          <div class="custom-form__block">
            <label for="AboutContact-message-{{ section.id }}" class="visually-hidden">Message</label>
            <textarea rows="3" id="AboutContact-message-{{ section.id }}" class="contactFormMessage field" name="contact[body]" placeholder="MESSAGE*" required></textarea>
          </div>
        </div>

        <div class="about-contact__row">
          <div class="about-contact__submit">
            <button type="submit" class="link">
              Send Now
            </button>
          </div>
        </div>
      {%- endform -%}

    </div>
  </div>
</div>

{% schema %}
{
  "name": "About Contact",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "richtext",
      "id": "copy",
      "label": "Copy",
      "default": "<p>Fill Out The Form Below and we will get in touch within 48 hours.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Panel background color",
      "default": "#FCC9C6"
    }
  ],
  "presets": [{
    "name": "About Contact",
    "category": "Image"
  }]
}
{% endschema %}
