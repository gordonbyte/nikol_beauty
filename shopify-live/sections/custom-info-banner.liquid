{%- assign media_blocks = section.blocks | where: 'type', 'media' -%}
{%- assign blog_media = blank -%}
{%- assign first_image = blank -%}
{%- assign image_count = 0 -%}
{%- assign content_count = 0 -%}
{%- for b in section.blocks -%}
  {%- if b.type == 'media' -%}
    {%- if b.settings.media_type == 'blog' -%}
      {%- if blog_media == blank -%}{%- assign blog_media = b -%}{%- endif -%}
    {%- else -%}
      {%- assign image_count = image_count | plus: 1 -%}
      {%- if first_image == blank -%}{%- assign first_image = b -%}{%- endif -%}
    {%- endif -%}
  {%- else -%}
    {%- assign content_count = content_count | plus: 1 -%}
  {%- endif -%}
{%- endfor -%}
{%- assign content_rows = content_count | at_least: 1 -%}
{%- assign use_slider = false -%}
{%- if blog_media != blank or image_count > 1 -%}
  {%- assign use_slider = true -%}
{%- endif -%}
{%- assign primary_media = media_blocks.first -%}
{%- assign media_position = primary_media.settings.media_position -%}
{%- assign media_padding = primary_media.settings.media_padding | default: 0 -%}
{%- assign media_width = primary_media.settings.media_width | default: 50 -%}
{%- assign content_width = 100 | minus: media_width -%}

{%- if use_slider -%}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"/>
  <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
{%- endif -%}

<style>
.banner-bottom-main {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 100px;
    row-gap: 0;
    align-items: start;
}

/* Media absolutely fills its half so it never stretches the content rows
   (content blocks keep their natural heights — no gaps). */
.banner-bottom-media {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: calc(50% - 50px);
}

.banner-bottom-content {
    grid-column: 2;
    min-width: 0;
}

.banner-bottom-main.media-right .banner-bottom-media {
    left: auto;
    right: 0;
}

.banner-bottom-main.media-right .banner-bottom-content {
    grid-column: 1;
}

.banner-bottom-media > .banner-bottom-left-image,
.banner-bottom-media > .info-banner-swiper {
    height: 100%;
}

.banner-bottom-left-image {
    height: 100%;
}

.banner-bottom-left-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.info-banner-img-desktop {
    display: block;
}

.info-banner-img-mobile {
    display: none;
}

.info-banner-star-box {
    display: flex;
    align-items: center;
    gap: 8px;
}

.info-banner-star-img {
    display: flex;
}

.info-banner-star-img img {
    max-width: 95px;
    object-fit: contain;
}

.info-banner-star-text {
    color: var(--COLOR-TEXT);
    font-size: var(--FONT-SIZE-BASE);
    font-weight: 400;
}

.info-banner-star-text strong {
    font-weight: 700;
}

.info-banner-title {
    margin: 0;
    color: var(--COLOR-TEXT);
    font-size: 62px;
    line-height: 110%;
    font-family: 'Cormorant';
    letter-spacing: -3px;
    text-transform: capitalize;
    font-weight: 500;
}

.info-banner-description {
    color: var(--COLOR-TEXT);
    font-weight: 400;
    font-size: 20px;
    line-height: 140%;
}

.info-banner-price {
    font-size: 24px;
    line-height: 135%;
    font-weight: 400;
    color: var(--COLOR-TEXT);
    font-family: Inter, sans-serif;
}

.info-banner-button a {
    display: flex;
    align-items: center;
    background: var(--BTN-PRIMARY-BG-COLOR);
    justify-content: center;
    width: 100%;
    max-width: 400px;
    height: 60px;
    color: var(--BTN-PRIMARY-TEXT-COLOR);
    font-family: var(--BTN-FONT-STACK);
    text-transform: uppercase;
    font-size: var(--BTN-FONT-SIZE);
    letter-spacing: 0;
    gap: 5px;
    font-weight: 700;
}

/* Slider (image carousel + blog feed) */
.info-banner-swiper {
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    position: relative;
    padding-bottom: 34px;
}

.info-banner-swiper .swiper-wrapper,
.info-banner-swiper .swiper-slide {
    height: 100%;
}

.info-banner-swiper .swiper-pagination-bullet {
    background: var(--COLOR-TEXT);
    opacity: 0.35;
}

.info-banner-swiper .swiper-pagination-bullet-active {
    background: var(--BTN-PRIMARY-BG-COLOR);
    opacity: 1;
}

/* Blog feed cards (content overlays the image; fills the column height) */
.info-banner-blog-card {
    position: relative;
    overflow: hidden;
    height: 100%;
}

.info-banner-blog-image {
    position: relative;
    display: block;
    line-height: 0;
    height: 100%;
}

.info-banner-blog-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.info-banner-blog-overlay {
    position: absolute;
    inset: 0;
    background: #000;
    pointer-events: none;
}

.info-banner-blog-body {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 24px;
    z-index: 1;
    text-align: left;
}

.info-banner-blog-meta {
    font-size: var(--FONT-SIZE-BASE);
    color: #fff;
    font-family: 'Inter', sans-serif;
    padding-bottom: 8px;
}

.info-banner-blog-title {
    margin: 0;
    display: block;
    font-size: 28px;
    line-height: 120%;
    font-family: 'Cormorant', sans-serif;
    color: #fff;
    padding-bottom: 12px;
    text-decoration: none;
}

.info-banner-blog-title a {
    color: inherit;
    text-decoration: none;
}

.info-banner-blog-link {
    color: #fff;
    font-weight: 700;
    font-family: 'Inter', sans-serif;
    text-decoration: none;
}

.info-banner-blog-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 360px;
    height: 100%;
    box-sizing: border-box;
    padding: 24px;
    background: #F7F2ED;
    color: var(--COLOR-TEXT);
    font-family: 'Inter', sans-serif;
    font-size: var(--FONT-SIZE-BASE);
}

/* Icon Note (icon + short caption, e.g. "Takes 1 minute") */
.info-banner-note {
    display: flex;
    align-items: center;
    gap: 8px;
}

.info-banner-note--left {
    justify-content: flex-start;
}

.info-banner-note--center {
    justify-content: center;
}

.info-banner-note--right {
    justify-content: flex-end;
}

.info-banner-note-icon {
    max-width: 25px;
    object-fit: contain;
}

.info-banner-note-text {
    color: var(--COLOR-TEXT);
    font-size: var(--FONT-SIZE-BASE);
    font-family: 'Inter';
}


@media only screen and (max-width: 600px) {
.banner-bottom {
    padding: 0 !important;
}

/* Single column: every block stacks in its placed (block) order */
.banner-bottom-main {
    grid-template-columns: 1fr !important;
    column-gap: 0;
}

.banner-bottom-media,
.banner-bottom-content,
.banner-bottom-main.media-right .banner-bottom-media,
.banner-bottom-main.media-right .banner-bottom-content {
    grid-column: 1 !important;
    grid-row: auto !important;
}

.banner-bottom-media {
    position: static;
    width: auto;
}

.banner-bottom-content {
    text-align: center;
    padding: 0 15px;
}

.info-banner-img-desktop {
    display: none;
}

.info-banner-img-mobile {
    display: block;
}

.info-banner-star-box {
    gap: 5px;
    justify-content: center;
}

.info-banner-star-img img {
    max-width: 78px;
}

.info-banner-star-text {
    font-size: var(--FONT-SIZE-BASE);
}

.info-banner-title {
    font-size: 34px;
    letter-spacing: -2px;
}

.info-banner-description {
    font-size: var(--FONT-SIZE-BASE);
    line-height: 135%;
    max-width: 350px;
    margin: 0px auto;
}

.info-banner-price {
    font-size: 20px;
}

.info-banner-button a {
    max-width: 100%;
    height: 50px;
    font-size: var(--BTN-FONT-SIZE);
}

/* Reset desktop fill-heights on mobile */
.banner-bottom-media > .banner-bottom-left-image,
.banner-bottom-media > .info-banner-swiper,
.info-banner-swiper,
.info-banner-swiper .swiper-wrapper,
.info-banner-swiper .swiper-slide,
.banner-bottom-left-image,
.info-banner-blog-card,
.info-banner-blog-image {
    height: auto;
}

.banner-bottom-left-image img {
    height: auto;
    object-fit: cover;
}

.info-banner-blog-image img {
    height: auto;
    aspect-ratio: 1 / 1;
}

.info-banner-blog-title {
    font-size: 22px;
}

.info-banner-note-icon {
    max-width: 20px;
}

.info-banner-note-text {
    font-size: var(--FONT-SIZE-BASE);
}
}

    </style>

<style>
{%- comment -%} Adjustable media / content split (desktop only; mobile always stacks full-width). Set on the first Media block. {%- endcomment -%}
@media only screen and (min-width: 601px) {
  #InfoBanner-{{ section.id }} .banner-bottom-main {
    grid-template-columns: {% if media_position == 'right' %}{{ content_width }}fr {{ media_width }}fr{% else %}{{ media_width }}fr {{ content_width }}fr{% endif %};
  }
  #InfoBanner-{{ section.id }} .banner-bottom-media {
    width: calc((100% - 100px) * {{ media_width | divided_by: 100.0 }});
  }
}
</style>

<section id="InfoBanner-{{ section.id }}" class="banner-bottom" style="background-image: url({{ section.settings.bg_image | img_url: 'master' }});{% if section.settings.bg_color != blank %} background-color: {{ section.settings.bg_color }};{% endif %} padding: {{ media_padding }}px; box-sizing: border-box;">
  <div class="page-width">
  <div class="banner-bottom-main {% if media_position == 'right' %}media-right{% endif %}">
    {%- assign media_rendered = false -%}
    {%- for block in section.blocks -%}
      {%- case block.type -%}

        {%- when 'media' -%}
          {%- unless media_rendered -%}
            <div class="banner-bottom-media">
              {%- if blog_media != blank -%}
                {%- assign blog_obj = blogs[blog_media.settings.blog] -%}
                {%- if blog_obj != blank and blog_obj.articles.size > 0 -%}
                  <div class="info-banner-blog-swiper info-banner-swiper swiper" {{ blog_media.shopify_attributes }}>
                    <div class="swiper-wrapper">
                      {%- for article in blog_obj.articles limit: blog_media.settings.blog_limit -%}
                        <div class="swiper-slide">
                          <div class="info-banner-blog-card">
                            {%- if article.image -%}
                              <a href="{{ article.url }}" class="info-banner-blog-image">
                                <img src="{{ article.image | img_url: 'master' }}" alt="{{ article.title | escape }}" loading="lazy">
                                <span class="info-banner-blog-overlay" style="opacity: {{ blog_media.settings.blog_overlay | times: 0.01 }};"></span>
                              </a>
                            {%- endif -%}
                            <div class="info-banner-blog-body">
                              <div class="info-banner-blog-meta">{{ article.content | strip_html | size | divided_by: 200 }} min read</div>
                              <h3 class="info-banner-blog-title"><a href="{{ article.url }}">{{ article.title }}</a></h3>
                              <a href="{{ article.url }}" class="info-banner-blog-link">Read more &rarr;</a>
                            </div>
                          </div>
                        </div>
                      {%- endfor -%}
                    </div>
                    <div class="swiper-pagination"></div>
                  </div>
                {%- else -%}
                  <div class="info-banner-blog-placeholder" {{ blog_media.shopify_attributes }}>
                    <span>Assign a blog in this Media block to display posts here.</span>
                  </div>
                {%- endif -%}

              {%- elsif image_count > 1 -%}
                <div class="info-banner-media-swiper info-banner-swiper swiper">
                  <div class="swiper-wrapper">
                    {%- for b in media_blocks -%}
                      {%- unless b.settings.media_type == 'blog' -%}
                        {%- assign mobile_img = b.settings.image_mobile | default: b.settings.image_desktop -%}
                        <div class="swiper-slide" {{ b.shopify_attributes }}>
                          <div class="banner-bottom-left-image">
                            {%- if b.settings.image_desktop -%}<img src="{{ b.settings.image_desktop | img_url: 'master' }}" alt="" class="info-banner-img-desktop">{%- endif -%}
                            {%- if mobile_img -%}<img src="{{ mobile_img | img_url: 'master' }}" alt="" class="info-banner-img-mobile">{%- endif -%}
                          </div>
                        </div>
                      {%- endunless -%}
                    {%- endfor -%}
                  </div>
                  <div class="swiper-pagination"></div>
                </div>

              {%- elsif image_count == 1 -%}
                {%- assign mobile_img = first_image.settings.image_mobile | default: first_image.settings.image_desktop -%}
                <div class="banner-bottom-left-image" {{ first_image.shopify_attributes }}>
                  {%- if first_image.settings.image_desktop -%}<img src="{{ first_image.settings.image_desktop | img_url: 'master' }}" alt="" class="info-banner-img-desktop">{%- endif -%}
                  {%- if mobile_img -%}<img src="{{ mobile_img | img_url: 'master' }}" alt="" class="info-banner-img-mobile">{%- endif -%}
                </div>
              {%- endif -%}
            </div>
            {%- assign media_rendered = true -%}
          {%- endunless -%}

        {%- when 'rating' -%}
          <div class="banner-bottom-content" {{ block.shopify_attributes }} style="padding-top: {{ block.settings.padding_top | default: 5 }}px; padding-bottom: {{ block.settings.padding_bottom | default: 5 }}px;">
            {%- if block.settings.star_image or block.settings.star_text != blank -%}
              <div class="info-banner-star-box">
                {%- if block.settings.star_image -%}
                  <div class="info-banner-star-img">
                    <img src="{{ block.settings.star_image | img_url: 'master' }}" alt="">
                  </div>
                {%- endif -%}
                {%- if block.settings.star_text != blank -%}
                  <div class="info-banner-star-text">{{ block.settings.star_text }}</div>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>

        {%- when 'heading' -%}
          <div class="banner-bottom-content" {{ block.shopify_attributes }} style="padding-top: {{ block.settings.padding_top | default: 5 }}px; padding-bottom: {{ block.settings.padding_bottom | default: 5 }}px;">
            {%- if block.settings.heading != blank -%}
              <h2 class="info-banner-title">{{ block.settings.heading }}</h2>
            {%- endif -%}
          </div>

        {%- when 'price' -%}
          <div class="banner-bottom-content" {{ block.shopify_attributes }} style="padding-top: {{ block.settings.padding_top | default: 5 }}px; padding-bottom: {{ block.settings.padding_bottom | default: 5 }}px;">
            {%- if product -%}
              <div class="info-banner-price">{{ product.price | money }}</div>
            {%- endif -%}
          </div>

        {%- when 'text' -%}
          <div class="banner-bottom-content" {{ block.shopify_attributes }} style="padding-top: {{ block.settings.padding_top | default: 5 }}px; padding-bottom: {{ block.settings.padding_bottom | default: 5 }}px;">
            {%- if block.settings.text != blank -%}
              <div class="info-banner-description">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>

        {%- when 'button' -%}
          <div class="banner-bottom-content" {{ block.shopify_attributes }} style="padding-top: {{ block.settings.padding_top | default: 5 }}px; padding-bottom: {{ block.settings.padding_bottom | default: 5 }}px;">
            {%- if block.settings.button_text != blank -%}
              <div class="info-banner-button">
                <a href="{% if block.settings.button_link != blank %}{{ block.settings.button_link }}{% elsif product %}{{ product.url }}{% endif %}">
                  {{ block.settings.button_text }}
                </a>
              </div>
            {%- endif -%}
          </div>

        {%- when 'icon_note' -%}
          <div class="banner-bottom-content" {{ block.shopify_attributes }} style="padding-top: {{ block.settings.padding_top | default: 5 }}px; padding-bottom: {{ block.settings.padding_bottom | default: 5 }}px;">
            {%- if block.settings.icon != blank or block.settings.text != blank -%}
              <div class="info-banner-note info-banner-note--{{ block.settings.alignment | default: 'left' }}">
                {%- if block.settings.icon != blank -%}
                  <img class="info-banner-note-icon" src="{{ block.settings.icon | img_url: 'master' }}" alt="">
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <span class="info-banner-note-text">{{ block.settings.text }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>

      {%- endcase -%}
    {%- endfor -%}
  </div>
  </div>
</section>

{%- if use_slider -%}
<script>
document.addEventListener("DOMContentLoaded", function () {
  document.querySelectorAll("#InfoBanner-{{ section.id }} .info-banner-swiper").forEach(function (el) {
    new Swiper(el, {
      slidesPerView: 1,
      loop: true,
      pagination: { el: el.querySelector(".swiper-pagination"), clickable: true }
    });
  });
});
</script>
{%- endif -%}

{% schema %}
{
  "name": "[Custom] Info Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "info": "Used when no background image is set (shows behind/around the media)."
    }
  ],
  "blocks": [
    {
      "type": "media",
      "name": "Media",
      "settings": [
        {
          "type": "select",
          "id": "media_type",
          "label": "Media type",
          "default": "image",
          "options": [
            { "value": "image", "label": "Image" },
            { "value": "blog", "label": "Blog slider" }
          ]
        },
        {
          "type": "paragraph",
          "content": "This block fills the media side. Set to Image and add 2+ Media blocks for an image slider; or set one Media block to Blog slider. If any Media block is set to Blog, the blog slider takes over the media side. On mobile, the media stacks in the position you place this block among the others."
        },
        {
          "type": "header",
          "content": "Layout"
        },
        {
          "type": "select",
          "id": "media_position",
          "label": "Media Position (desktop)",
          "default": "left",
          "info": "Uses the first Media block's value. On mobile, order follows the block order instead.",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "right", "label": "Right" }
          ]
        },
        {
          "type": "range",
          "id": "media_padding",
          "label": "Padding Around Media",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "px",
          "default": 0
        },
        {
          "type": "range",
          "id": "media_width",
          "label": "Media Width (desktop)",
          "info": "Share of the banner the media takes; the content fills the rest. Mobile always stacks full-width.",
