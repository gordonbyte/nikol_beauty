{%- assign media_blocks = section.blocks | where: 'type', 'media' -%}
{%- assign blog_media = blank -%}
{%- assign first_image = blank -%}
{%- assign image_count = 0 -%}
{%- assign content_count = 0 -%}
{%- for b in section.blocks -%}
  {%- if b.type == 'media' -%}
    {%- if b.settings.media_type == 'blog' -%}
      {%- if blog_media == blank -%}{%- assign blog_media = b -%}{%- endif -%}
    {%- else -%}
      {%- assign image_count = image_count | plus: 1 -%}
      {%- if first_image == blank -%}{%- assign first_image = b -%}{%- endif -%}
    {%- endif -%}
  {%- else -%}
    {%- assign content_count = content_count | plus: 1 -%}
  {%- endif -%}
{%- endfor -%}
{%- assign content_rows = content_count | at_least: 1 -%}
{%- assign use_slider = false -%}
{%- if blog_media != blank or image_count > 1 -%}
  {%- assign use_slider = true -%}
{%- endif -%}
{%- assign primary_media = media_blocks.first -%}
{%- assign media_position = primary_media.settings.media_position -%}
{%- assign media_padding = primary_media.settings.media_padding | default: 0 -%}
{%- assign media_width = primary_media.settings.media_width | default: 50 -%}
{%- assign content_width = 100 | minus: media_width -%}
{%- assign media_fit = primary_media.settings.media_fit | default: 'cover' -%}
{%- assign media_fit_position = primary_media.settings.media_fit_position | default: 'center' -%}

<style>
.custom-info-banner__sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
}

.custom-info-banner__main {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 100px;
    row-gap: 0;
    align-items: start;
}

/* Media absolutely fills its half so it never stretches the content rows
   (content blocks keep their natural heights — no gaps). */
.custom-info-banner__media {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: calc(50% - 50px);
}

.custom-info-banner__content {
    grid-column: 2;
    min-width: 0;
}

.custom-info-banner__main.custom-info-banner__main--media-right .custom-info-banner__media {
    left: auto;
    right: 0;
}

.custom-info-banner__main.custom-info-banner__main--media-right .custom-info-banner__content {
    grid-column: 1;
}

.custom-info-banner__media > .custom-info-banner__image,
.custom-info-banner__media > .custom-info-banner__swiper {
    height: 100%;
}

.custom-info-banner__image {
    height: 100%;
}

.custom-info-banner__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.custom-info-banner__img-desktop {
    display: block;
}

.custom-info-banner__img-mobile {
    display: none;
}

.custom-info-banner__star-box {
    display: flex;
    align-items: center;
    gap: 8px;
}

.custom-info-banner__star-img {
    display: inline-block;
    position: relative;
    line-height: 0;
}

.custom-info-banner__star-fill {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    overflow: hidden;
}

.custom-info-banner__star-img svg {
    width: 95px;
    height: auto;
}

.custom-info-banner__star-text {
    color: var(--COLOR-TEXT);
    font-size: var(--FONT-SIZE-BASE);
    font-weight: 400;
}

.custom-info-banner__star-text strong {
    font-weight: 700;
}

.custom-info-banner__title {
    margin: 0;
    color: var(--COLOR-TEXT);
    font-size: 62px;
    line-height: 110%;
    font-family: 'Cormorant';
    letter-spacing: -3px;
    text-transform: capitalize;
    font-weight: 500;
}

.custom-info-banner__description {
    color: var(--COLOR-TEXT);
    font-weight: 400;
    font-size: clamp(var(--FONT-SIZE-BASE), 0.47vw + 15.2px, 20px);
    line-height: 140%;
}

.custom-info-banner__price {
    font-size: 24px;
    line-height: 135%;
    font-weight: 400;
    color: var(--COLOR-TEXT);
    font-family: Inter, sans-serif;
}

.custom-info-banner__button a {
    display: flex;
    align-items: center;
    background: var(--BTN-PRIMARY-BG-COLOR);
    justify-content: center;
    width: 100%;
    max-width: 400px;
    height: 60px;
    color: var(--BTN-PRIMARY-TEXT-COLOR);
    font-family: var(--BTN-FONT-STACK);
    text-transform: uppercase;
    font-size: var(--BTN-FONT-SIZE);
    letter-spacing: 0;
    gap: 5px;
    font-weight: 700;
    transition: background 0.3s ease;
}

.custom-info-banner__button a:focus-visible {
    background: var(--BTN-PRIMARY-BG-COLOR-BRIGHTER);
    color: var(--BTN-PRIMARY-TEXT-COLOR);
}

@media (hover: hover) {
  .custom-info-banner__button a:hover {
    background: var(--BTN-PRIMARY-BG-COLOR-BRIGHTER);
    color: var(--BTN-PRIMARY-TEXT-COLOR);
  }

  .custom-info-banner__button a svg {
    transition: transform 0.5s ease;
    transform: translateZ(0);
  }

  .custom-info-banner__button a:hover svg {
    transform: translate3d(5px, 0, 0);
  }
}

/* Scroll-in reveal: initial hidden states apply ONLY once JS adds anim-ready,
   so content stays visible without JS and under reduced motion. */
.custom-info-banner.anim-ready .custom-info-banner__media,
.custom-info-banner.anim-ready .custom-info-banner__content {
    opacity: 0;
    transform: translateY(22px);
    transition: opacity 0.6s ease, transform 0.6s ease;
}

.custom-info-banner.anim-ready .custom-info-banner__image img {
    transform: scale(1.05);
    transition: transform 1.1s ease 0.1s;
}

.custom-info-banner.anim-ready.is-inview .custom-info-banner__media,
.custom-info-banner.anim-ready.is-inview .custom-info-banner__content {
    opacity: 1;
    transform: none;
}

.custom-info-banner.anim-ready.is-inview .custom-info-banner__image img {
    transform: scale(1);
}

/* Slider (image carousel + blog feed) */
.custom-info-banner__swiper {
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    position: relative;
    padding-bottom: 34px;
}

.custom-info-banner__swiper .swiper-wrapper,
.custom-info-banner__swiper .swiper-slide {
    height: 100%;
}

.custom-info-banner__swiper .swiper-pagination-bullet {
    background: var(--COLOR-TEXT);
    opacity: 0.35;
}

.custom-info-banner__swiper .swiper-pagination-bullet-active {
    background: var(--BTN-PRIMARY-BG-COLOR);
    opacity: 1;
}

/* Blog feed cards (content overlays the image; fills the column height) */
.custom-info-banner__blog-card {
    position: relative;
    overflow: hidden;
    height: 100%;
}

.custom-info-banner__blog-image {
    position: relative;
    display: block;
    line-height: 0;
    height: 100%;
}

.custom-info-banner__blog-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.custom-info-banner__blog-overlay {
    position: absolute;
    inset: 0;
    background: #000;
    pointer-events: none;
}

.custom-info-banner__blog-body {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 24px;
    z-index: 1;
    text-align: left;
}

.custom-info-banner__blog-meta {
    font-size: var(--FONT-SIZE-BASE);
    color: #fff;
    font-family: 'Inter', sans-serif;
    padding-bottom: 8px;
}

.custom-info-banner__blog-title {
    margin: 0;
    display: block;
    font-size: 28px;
    line-height: 120%;
    font-family: 'Cormorant', sans-serif;
    color: #fff;
    padding-bottom: 12px;
    text-decoration: none;
}

.custom-info-banner__blog-title a {
    color: inherit;
    text-decoration: none;
}

.custom-info-banner__blog-link {
    color: #fff;
    font-weight: 700;
    font-family: 'Inter', sans-serif;
    text-decoration: none;
}

.custom-info-banner__blog-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 360px;
    height: 100%;
    box-sizing: border-box;
    padding: 24px;
    background: #F7F2ED;
    color: var(--COLOR-TEXT);
    font-family: 'Inter', sans-serif;
    font-size: var(--FONT-SIZE-BASE);
}

/* Icon Note (icon + short caption, e.g. "Takes 1 minute") */
.custom-info-banner__note {
    display: flex;
    align-items: center;
    gap: 8px;
}

.custom-info-banner__note--left {
    justify-content: flex-start;
}

.custom-info-banner__note--center {
    justify-content: center;
}

.custom-info-banner__note--right {
    justify-content: flex-end;
}

.custom-info-banner__note-icon {
    width: 25px;
    height: auto;
    flex-shrink: 0;
}

.custom-info-banner__note-text {
    color: var(--COLOR-TEXT);
    font-size: var(--FONT-SIZE-BASE);
    font-family: 'Inter';
}


/* Phone type sizes match .custom-videos__title / .custom-videos__subtitle */
@media only screen and (max-width: 600px) {
.custom-info-banner__title {
    font-size: 34px;
}

.custom-info-banner__description {
    line-height: 135%;
}
}

@media only screen and (max-width: 1024px) {
.custom-info-banner {
    padding: 0 !important;
}

/* Single column: every block stacks in its placed (block) order */
.custom-info-banner__main {
    grid-template-columns: 1fr !important;
    column-gap: 0;
}

.custom-info-banner__media,
.custom-info-banner__content,
.custom-info-banner__main.custom-info-banner__main--media-right .custom-info-banner__media,
.custom-info-banner__main.custom-info-banner__main--media-right .custom-info-banner__content {
    grid-column: 1 !important;
    grid-row: auto !important;
}

.custom-info-banner__media {
    position: static;
    width: auto;
}

.custom-info-banner__content {
    text-align: center;
    padding: 0 15px;
}

.custom-info-banner__img-desktop {
    display: none;
}

.custom-info-banner__img-mobile {
    display: block;
}

.custom-info-banner__star-box {
    flex-direction: column;
    align-items: center;
    gap: 5px;
    justify-content: center;
}

.custom-info-banner__star-img svg {
    width: 78px;
}

.custom-info-banner__star-text {
    font-size: var(--FONT-SIZE-BASE);
}


.custom-info-banner__price {
    font-size: 20px;
}

.custom-info-banner__button a {
    max-width: 100%;
    height: 50px;
    font-size: var(--BTN-FONT-SIZE);
}

/* Reset desktop fill-heights on mobile */
.custom-info-banner__media > .custom-info-banner__image,
.custom-info-banner__media > .custom-info-banner__swiper,
.custom-info-banner__swiper,
.custom-info-banner__swiper .swiper-wrapper,
.custom-info-banner__swiper .swiper-slide,
.custom-info-banner__image,
.custom-info-banner__blog-card,
.custom-info-banner__blog-image {
    height: auto;
}

.custom-info-banner__image img {
    height: auto;
    object-fit: cover;
}

.custom-info-banner__blog-image img {
    height: auto;
    aspect-ratio: 1 / 1;
}

.custom-info-banner__blog-title {
    font-size: 22px;
}

.custom-info-banner__note-icon {
    width: 20px;
}

.custom-info-banner__note-text {
    font-size: var(--FONT-SIZE-BASE);
}
}

    </style>

<style>
{%- comment -%} Adjustable media / content split (desktop >1024px only; mobile and tablet stack full-width). Set on the first Media block. {%- endcomment -%}
@media only screen and (min-width: 1025px) {
  #InfoBanner-{{ section.id }} .custom-info-banner__main {
    grid-template-columns: {% if media_position == 'right' %}{{ content_width }}fr {{ media_width }}fr{% else %}{{ media_width }}fr {{ content_width }}fr{% endif %};
  }
  #InfoBanner-{{ section.id }} .custom-info-banner__media {
    width: calc((100% - 100px) * {{ media_width | divided_by: 100.0 }});
  }

{% if media_fit == 'natural' %}
  {%- comment -%} Natural: media joins the grid flow so the image's own height can
     grow the banner (the default absolute positioning pins it to the content height). {%- endcomment -%}
  #InfoBanner-{{ section.id }} .custom-info-banner__media {
    position: static;
    width: auto;
  }
  #InfoBanner-{{ section.id }} .custom-info-banner__media > .custom-info-banner__image,
  #InfoBanner-{{ section.id }} .custom-info-banner__image {
    height: auto;
  }
  #InfoBanner-{{ section.id }} .custom-info-banner__image img {
    height: auto;
  }
{% else %}
  #InfoBanner-{{ section.id }} .custom-info-banner__image img {
    object-fit: {{ media_fit }};
    object-position: {{ media_fit_position }};
  }
{% endif %}
}
</style>

<section id="InfoBanner-{{ section.id }}" class="custom-info-banner" style="{% if section.settings.bg_image %}background-image: url({{ section.settings.bg_image | img_url: '2000x' }});{% endif %}{% if section.settings.bg_color != blank %} background-color: {{ section.settings.bg_color }};{% endif %} padding: {{ media_padding }}px; box-sizing: border-box;">
  <div class="page-width">
  <div class="custom-info-banner__main {% if media_position == 'right' %}custom-info-banner__main--media-right{% endif %}">
    {%- assign media_rendered = false -%}
    {%- for block in section.blocks -%}
      {%- case block.type -%}

        {%- when 'media' -%}
          {%- unless media_rendered -%}
            <div class="custom-info-banner__media">
              {%- if blog_media != blank -%}
                {%- assign blog_obj = blogs[blog_media.settings.blog] -%}
                {%- if blog_obj != blank and blog_obj.articles.size > 0 -%}
                  <div class="custom-info-banner__blog-swiper custom-info-banner__swiper swiper" {{ blog_media.shopify_attributes }}>
                    <div class="swiper-wrapper">
                      {%- for article in blog_obj.articles limit: blog_media.settings.blog_limit -%}
                        <div class="swiper-slide">
                          <div class="custom-info-banner__blog-card">
                            {%- if article.image -%}
                              <a href="{{ article.url }}" class="custom-info-banner__blog-image" aria-hidden="true" tabindex="-1">
                                <img src="{{ article.image | img_url: '900x' }}" alt="" loading="lazy">
                                <span class="custom-info-banner__blog-overlay" style="opacity: {{ blog_media.settings.blog_overlay | times: 0.01 }};"></span>
                              </a>
                            {%- endif -%}
                            <div class="custom-info-banner__blog-body">
                              <div class="custom-info-banner__blog-meta">{{ article.content | strip_html | size | divided_by: 1100 | at_least: 1 }} min read</div>
                              <h3 class="custom-info-banner__blog-title"><a href="{{ article.url }}">{{ article.title }}</a></h3>
                              <a href="{{ article.url }}" class="custom-info-banner__blog-link">Read more<span class="custom-info-banner__sr-only"> about {{ article.title | escape }}</span> <span aria-hidden="true">&rarr;</span></a>
                            </div>
                          </div>
                        </div>
                      {%- endfor -%}
                    </div>
                    <div class="swiper-pagination"></div>
                  </div>
                {%- else -%}
                  <div class="custom-info-banner__blog-placeholder" {{ blog_media.shopify_attributes }}>
                    <span>Assign a blog in this Media block to display posts here.</span>
                  </div>
                {%- endif -%}

              {%- elsif image_count > 1 -%}
                <div class="custom-info-banner__media-swiper custom-info-banner__swiper swiper">
                  <div class="swiper-wrapper">
                    {%- for b in media_blocks -%}
                      {%- unless b.settings.media_type == 'blog' -%}
                        <div class="swiper-slide" {{ b.shopify_attributes }}>
                          <div class="custom-info-banner__image">
                            {%- if b.settings.image_desktop and b.settings.image_mobile -%}
                              <img src="{{ b.settings.image_desktop | img_url: '1400x' }}" srcset="{{ b.settings.image_desktop | img_url: '700x' }} 700w, {{ b.settings.image_desktop | img_url: '1000x' }} 1000w, {{ b.settings.image_desktop | img_url: '1400x' }} 1400w" sizes="(min-width: 1025px) 50vw, 1px" alt="{{ b.settings.image_alt | escape }}" loading="lazy" class="custom-info-banner__img-desktop">
                              <img src="{{ b.settings.image_mobile | img_url: '1000x' }}" srcset="{{ b.settings.image_mobile | img_url: '500x' }} 500w, {{ b.settings.image_mobile | img_url: '750x' }} 750w, {{ b.settings.image_mobile | img_url: '1000x' }} 1000w" sizes="(min-width: 1025px) 1px, 100vw" alt="{{ b.settings.image_alt | escape }}" loading="lazy" class="custom-info-banner__img-mobile">
                            {%- elsif b.settings.image_desktop -%}
                              <img src="{{ b.settings.image_desktop | img_url: '900x' }}" srcset="{{ b.settings.image_desktop | img_url: '600x' }} 600w, {{ b.settings.image_desktop | img_url: '750x' }} 750w, {{ b.settings.image_desktop | img_url: '900x' }} 900w, {{ b.settings.image_desktop | img_url: '1400x' }} 1400w" sizes="(min-width: 1025px) 50vw, 100vw" alt="{{ b.settings.image_alt | escape }}" loading="lazy">
                            {%- elsif b.settings.image_mobile -%}
                              <img src="{{ b.settings.image_mobile | img_url: '900x' }}" srcset="{{ b.settings.image_mobile | img_url: '600x' }} 600w, {{ b.settings.image_mobile | img_url: '750x' }} 750w, {{ b.settings.image_mobile | img_url: '900x' }} 900w, {{ b.settings.image_mobile | img_url: '1400x' }} 1400w" sizes="(min-width: 1025px) 50vw, 100vw" alt="{{ b.settings.image_alt | escape }}" loading="lazy">
                            {%- endif -%}
                          </div>
                        </div>
                      {%- endunless -%}
                    {%- endfor -%}
                  </div>
                  <div class="swiper-pagination"></div>
                </div>

              {%- elsif image_count == 1 -%}
                <div class="custom-info-banner__image" {{ first_image.shopify_attributes }}>
                  {%- if first_image.settings.image_desktop and first_image.settings.image_mobile -%}
                    <img src="{{ first_image.settings.image_desktop | img_url: '1400x' }}" srcset="{{ first_image.settings.image_desktop | img_url: '700x' }} 700w, {{ first_image.settings.image_desktop | img_url: '1000x' }} 1000w, {{ first_image.settings.image_desktop | img_url: '1400x' }} 1400w" sizes="(min-width: 1025px) 50vw, 1px" alt="{{ first_image.settings.image_alt | escape }}" loading="lazy" class="custom-info-banner__img-desktop">
                    <img src="{{ first_image.settings.image_mobile | img_url: '1000x' }}" srcset="{{ first_image.settings.image_mobile | img_url: '500x' }} 500w, {{ first_image.settings.image_mobile | img_url: '750x' }} 750w, {{ first_image.settings.image_mobile | img_url: '1000x' }} 1000w" sizes="(min-width: 1025px) 1px, 100vw" alt="{{ first_image.settings.image_alt | escape }}" loading="lazy" class="custom-info-banner__img-mobile">
                  {%- elsif first_image.settings.image_desktop -%}
                    <img src="{{ first_image.settings.image_desktop | img_url: '900x' }}" srcset="{{ first_image.settings.image_desktop | img_url: '600x' }} 600w, {{ first_image.settings.image_desktop | img_url: '750x' }} 750w, {{ first_image.settings.image_desktop | img_url: '900x' }} 900w, {{ first_image.settings.image_desktop | img_url: '1400x' }} 1400w" sizes="(min-width: 1025px) 50vw, 100vw" alt="{{ first_image.settings.image_alt | escape }}" loading="lazy">
                  {%- elsif first_image.settings.image_mobile -%}
                    <img src="{{ first_image.settings.image_mobile | img_url: '900x' }}" srcset="{{ first_image.settings.image_mobile | img_url: '600x' }} 600w, {{ first_image.settings.image_mobile | img_url: '750x' }} 750w, {{ first_image.settings.image_mobile | img_url: '900x' }} 900w, {{ first_image.settings.image_mobile | img_url: '1400x' }} 1400w" sizes="(min-width: 1025px) 50vw, 100vw" alt="{{ first_image.settings.image_alt | escape }}" loading="lazy">
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
            {%- assign media_rendered = true -%}
          {%- endunless -%}

        {%- when 'rating' -%}
          <div class="custom-info-banner__content" {{ block.shopify_attributes }} style="padding-top: {{ block.settings.padding_top | default: 5 }}px; padding-bottom: {{ block.settings.padding_bottom | default: 5 }}px;">
            {%- liquid
              assign star_rating = block.settings.star_rating | default: 5 | times: 1.0 | at_most: 5.0 | at_least: 0.0
              assign star_percent = star_rating | divided_by: 5.0 | times: 100.0 | round: 1
            -%}
            {%- if star_rating > 0 or block.settings.star_text != blank -%}
              <div class="custom-info-banner__star-box">
                {%- if star_rating > 0 -%}
                  <div class="custom-info-banner__star-img">
                    <svg xmlns="http://www.w3.org/2000/svg" width="190" height="36" viewBox="0 0 190 36" fill="#DDD6CF" aria-hidden="true" focusable="false">
                      <defs>
                        <path id="BannerStar-{{ section.id }}-{{ block.id }}" d="M 0 -18 L 4.04 -5.56 L 17.12 -5.56 L 6.53 2.12 L 10.58 14.56 L 0 6.88 L -10.58 14.56 L -6.53 2.12 L -17.12 -5.56 L -4.04 -5.56 Z"/>
                      </defs>
                      <use href="#BannerStar-{{ section.id }}-{{ block.id }}" transform="translate(19 19.7)"/>
                      <use href="#BannerStar-{{ section.id }}-{{ block.id }}" transform="translate(57 19.7)"/>
                      <use href="#BannerStar-{{ section.id }}-{{ block.id }}" transform="translate(95 19.7)"/>
                      <use href="#BannerStar-{{ section.id }}-{{ block.id }}" transform="translate(133 19.7)"/>
                      <use href="#BannerStar-{{ section.id }}-{{ block.id }}" transform="translate(171 19.7)"/>
                    </svg>
                    <span class="custom-info-banner__star-fill" style="width: {{ star_percent }}%">
                      <svg xmlns="http://www.w3.org/2000/svg" width="190" height="36" viewBox="0 0 190 36" fill="#FB6D00" aria-hidden="true" focusable="false">
                        <use href="#BannerStar-{{ section.id }}-{{ block.id }}" transform="translate(19 19.7)"/>
                        <use href="#BannerStar-{{ section.id }}-{{ block.id }}" transform="translate(57 19.7)"/>
                        <use href="#BannerStar-{{ section.id }}-{{ block.id }}" transform="translate(95 19.7)"/>
                        <use href="#BannerStar-{{ section.id }}-{{ block.id }}" transform="translate(133 19.7)"/>
                        <use href="#BannerStar-{{ section.id }}-{{ block.id }}" transform="translate(171 19.7)"/>
                      </svg>
                    </span>
                    <span class="custom-info-banner__sr-only">Rated {{ star_rating }} out of 5 stars</span>
                  </div>
                {%- endif -%}
                {%- if block.settings.star_text != blank -%}
                  <div class="custom-info-banner__star-text">{{ block.settings.star_text }}</div>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>

        {%- when 'heading' -%}
          <div class="custom-info-banner__content" {{ block.shopify_attributes }} style="padding-top: {{ block.settings.padding_top | default: 5 }}px; padding-bottom: {{ block.settings.padding_bottom | default: 5 }}px;">
            {%- if block.settings.heading != blank -%}
              <h2 class="custom-info-banner__title">{{ block.settings.heading }}</h2>
            {%- endif -%}
          </div>

        {%- when 'price' -%}
          <div class="custom-info-banner__content" {{ block.shopify_attributes }} style="padding-top: {{ block.settings.padding_top | default: 5 }}px; padding-bottom: {{ block.settings.padding_bottom | default: 5 }}px;">
            {%- if product -%}
              <div class="custom-info-banner__price">{{ product.price | money }}</div>
            {%- endif -%}
          </div>

        {%- when 'text' -%}
          <div class="custom-info-banner__content" {{ block.shopify_attributes }} style="padding-top: {{ block.settings.padding_top | default: 5 }}px; padding-bottom: {{ block.settings.padding_bottom | default: 5 }}px;">
            {%- if block.settings.text != blank -%}
              <div class="custom-info-banner__description">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>

        {%- when 'button' -%}
          <div class="custom-info-banner__content" {{ block.shopify_attributes }} style="padding-top: {{ block.settings.padding_top | default: 5 }}px; padding-bottom: {{ block.settings.padding_bottom | default: 5 }}px;">
            {%- if block.settings.button_text != blank -%}
              <div class="custom-info-banner__button">
                <a href="{% if block.settings.button_link != blank %}{{ block.settings.button_link }}{% elsif product %}{{ product.url }}{% endif %}">
                  {{ block.settings.button_text }}
                  <svg width="22" height="13" viewBox="0 0 22 13" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                    <path d="M0.843262 5.36644C0.377534 5.36644 -1.22974e-05 5.74399 -1.23382e-05 6.20972C-1.23789e-05 6.67544 0.377534 7.05299 0.843262 7.05299L0.843262 6.20972L0.843262 5.36644ZM21.4395 6.806C21.7689 6.47668 21.7689 5.94275 21.4395 5.61343L16.073 0.24687C15.7437 -0.0824491 15.2097 -0.0824491 14.8804 0.24687C14.5511 0.576189 14.5511 1.11012 14.8804 1.43944L19.6507 6.20972L14.8804 10.98C14.5511 11.3093 14.5511 11.8432 14.8804 12.1726C15.2097 12.5019 15.7437 12.5019 16.073 12.1726L21.4395 6.806ZM0.843262 6.20972L0.843262 7.05299L20.8433 7.05299L20.8433 6.20972L20.8433 5.36644L0.843262 5.36644L0.843262 6.20972Z" fill="currentColor"/>
                  </svg>
                </a>
              </div>
            {%- endif -%}
          </div>

        {%- when 'icon_note' -%}
          <div class="custom-info-banner__content" {{ block.shopify_attributes }} style="padding-top: {{ block.settings.padding_top | default: 5 }}px; padding-bottom: {{ block.settings.padding_bottom | default: 5 }}px;">
            {%- if block.settings.show_icon or block.settings.text != blank -%}
              <div class="custom-info-banner__note custom-info-banner__note--{{ block.settings.alignment | default: 'left' }}">
                {%- if block.settings.show_icon -%}
                  <svg class="custom-info-banner__note-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 45 45" fill="none" aria-hidden="true" focusable="false"><circle cx="22.5" cy="22.5" r="20" stroke="#2A2724" stroke-width="3"/><path d="M22.5 11 V22.5 L31.5 31" stroke="#2A2724" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <span class="custom-info-banner__note-text">{{ block.settings.text }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>

      {%- endcase -%}
    {%- endfor -%}
  </div>
  </div>
</section>

{%- if use_slider -%}
<script>
document.addEventListener("DOMContentLoaded", function () {
  document.querySelectorAll("#InfoBanner-{{ section.id }} .custom-info-banner__swiper").forEach(function (el) {
    new Swiper(el, {
      slidesPerView: 1,
      loop: true,
      pagination: { el: el.querySelector(".swiper-pagination"), clickable: true }
    });
  });
});
</script>
{%- endif -%}

<script>
  (function () {
    var root = document.getElementById('InfoBanner-{{ section.id }}');
    if (!root) return;
    if (!('IntersectionObserver' in window)) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (window.theme && window.theme.settings && window.theme.settings.enableAnimations === false) return;

    var contents = root.querySelectorAll('.custom-info-banner__content');
    contents.forEach(function (el, i) {
      el.style.transitionDelay = (0.12 + i * 0.12) + 's';
    });

    root.classList.add('anim-ready');

    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          root.classList.add('is-inview');
          observer.disconnect();
        }
      });
    }, { threshold: 0.15 });

    observer.observe(root);
  })();
</script>

