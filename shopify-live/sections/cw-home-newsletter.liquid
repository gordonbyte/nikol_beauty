<style>
section.cw-home-form-section {
    padding: 70px 0px;
}

.cw-home-form-parent {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.cw-home-form-title {
    color: #fff;
    font-size: 56px;
    line-height: 110%;
    font-family: 'Cormorant';
    letter-spacing: -3px;
    text-transform: capitalize;
    font-weight: 500;
}

.cw-home-form-right {width: 50%;}

.cw-home-form-left {
    width: 50%;
}

.cw-home-form-input-wrap input.cw-home-form-input {
    width: 100%;
    opacity: 1;
    height: 60px;
    color: #ffffff;
    outline: none;
    border: 1px solid #FFFFFF;
}

.cw-home-form-button-wrap {
    padding: 15px 0px;
}

.cw-home-form-button-wrap button {
    display: flex;
    align-items: center;
    background: #D34270;
    justify-content: center;
    width: 100%;
    height: 60px;
    color: #fff;
    font-family: 'Cormorant';
    text-transform: uppercase;
    font-size: 22px;
    letter-spacing: 0;
    gap: 5px;
    font-weight: 700;
}

.cw-home-form-note {
    color: #fff;
    font-size: 14px;
    font-family: 'Inter';
    display: flex;
    align-items: center;
    gap: 10px;
}
::placeholder
{
color: #fff !important;
}
@media only screen and (max-width: 600px) {
section.cw-home-form-section {
    padding: 50px 0px;
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
}

.cw-home-form-parent {
    flex-wrap: wrap;
}

.cw-home-form-left {
    width: 100%;
}

.cw-home-form-right {
    width: 100%;
}

.cw-home-form-title {
    font-size: 34px;
    letter-spacing: -2px;
    padding-bottom: 15px;
}

.cw-home-form-title br {
    display: none;
}

.cw-home-form-input-wrap input.cw-home-form-input {
    height: 50px;
}

.cw-home-form-button-wrap button {
    height: 50px;
    font-size: 18px;
}
}
    </style>

<section class="cw-home-form-section" style="background-image: url({{ section.settings.bg_image | img_url: 'master' }});">
  <div class="page-width">
    <div class="cw-home-form-parent">

  
      <div class="cw-home-form-left">
        {% if section.settings.title != blank %}
          <div class="cw-home-form-title">
            {{ section.settings.title }}
          </div>
        {% endif %}
      </div>

     
      <div class="cw-home-form-right">
        <form method="post" action="/contact#contact_form" accept-charset="UTF-8" class="cw-home-form-form">
          <input type="hidden" name="form_type" value="customer">
          <input type="hidden" name="utf8" value="✓">

          <div class="cw-home-form-input-wrap">
            <input 
              type="email" 
              name="contact[email]" 
              class="cw-home-form-input" 
              placeholder="{{ section.settings.placeholder_text }}" 
              required
            >
          </div>

          <div class="cw-home-form-button-wrap">
            <button type="submit" class="cw-home-form-button">
              {{ section.settings.button_text }} 
     <svg width="22" height="13" viewBox="0 0 22 13" fill="none" xmlns="http://www.w3.org/2000/svg">
