</svg>
  {{ section.settings.note_text }}
            </div>
          {% endif %}
        </form>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "CW Home Newsletter",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Left Title",
      "default": "Let's Get This Beauty Started."
    },
    {
      "type": "text",
      "id": "placeholder_text",
      "label": "Input Placeholder",
      "default": "Email Address..."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "SUBSCRIBE NOW"
    },
    {
      "type": "text",
      "id": "note_text",
      "label": "Bottom Note Text",
      "default": "Your information is safe and secure with us"
    }
  ],
  "presets": [
    {
      "name": "CW Home Newsletter"
    }
  ]
}
{% endschema %}
