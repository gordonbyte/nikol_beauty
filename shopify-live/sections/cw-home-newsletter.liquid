</svg>

            </button>
          </div>

          {% if section.settings.note_text != blank %}
            <div class="cw-home-form-note">
             <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M12 7.16683C11.7267 7.16683 11.5 6.94016 11.5 6.66683V5.3335C11.5 3.2335 10.9067 1.8335 8 1.8335C5.09333 1.8335 4.5 3.2335 4.5 5.3335V6.66683C4.5 6.94016 4.27333 7.16683 4 7.16683C3.72667 7.16683 3.5 6.94016 3.5 6.66683V5.3335C3.5 3.40016 3.96667 0.833496 8 0.833496C12.0333 0.833496 12.5 3.40016 12.5 5.3335V6.66683C12.5 6.94016 12.2733 7.16683 12 7.16683Z" fill="white"/>
