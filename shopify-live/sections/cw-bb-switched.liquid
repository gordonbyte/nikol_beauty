<style>
section.cw-bb-switched-section {
    background-size: cover;
    background-repeat: no-repeat;
    background-position: center;
    padding: 90px 0;
}

.cw-bb-switched-title {
    text-align: center;
    font-size: 56px;
    line-height: 110%;
    letter-spacing: -1px;
    font-weight: 500;
    max-width: 900px;
    margin: 0 auto;
    color: #2A2724;
    font-family: 'Cormorant',sans-serif;
}

.cw-bb-switched-description {
    text-align: center;
    font-size: 20px;
    line-height: 140%;
    font-weight: 400;
    color: #2A2724;
    padding-top: 20px;
    font-family: 'Inter',sans-serif;
}

.cw-bb-switched-box-wrapper {
    margin-top: 50px;
}

.cw-bb-switched-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 25px;
    gap: 60px;
    background: #fff;
    margin-bottom: 40px;
}

.cw-bb-switched-image {
    width: 50%;
}

.cw-bb-switched-content {
    width: 50%;
    padding-right: 60px;
}

.cw-bb-switched-image img {
    max-width: 610px;
    object-fit: contain;
}

.cw-bb-switched-box-title {
    font-size: 44px;
    line-height: 110%;
    letter-spacing: -1px;
    font-weight: 500;
    color: #2A2724;
    font-family: 'Cormorant', sans-serif;
}

.cw-bb-switched-box-description {
    font-size: 20px;
    line-height: 140%;
    font-weight: 400;
    color: #2A2724;
    padding-top: 20px;
    font-family: 'Inter', sans-serif;
}

.cw-bb-switched-review-box {
    margin-top: 20px;
}

.cw-bb-switched-review-stars img {
    max-width: 95px;
    object-fit: contain;
}

.cw-bb-switched-review-text {
    font-size: 16px;
    line-height: 150%;
    font-weight: 400;
    color: #2A2724;
    padding-top: 5px;
    font-family: 'Inter', sans-serif;
}

.cw-bb-switched-author-box {
    display: flex;
    align-items: center;
    gap: 5px;
    margin-top: 10px;
}

.cw-bb-switched-verified {
    display: flex;
    align-items: center;
    gap: 4px;
}

.cw-bb-switched-verified img {
    max-width: 14px;
    object-fit: contain;
}

.cw-bb-switched-button-wrap a {
    display: flex;
    background: #D34270;
    text-decoration: none;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 400px;
    height: 60px;
    margin: 0 auto;
    font-size: 22px;
    line-height: 26px;
    letter-spacing: 0;
    font-weight: 700;
    color: #FFFFFF;
    font-family: 'Cormorant', sans-serif;
    cursor: pointer;
}

.cw-bb-switched-box.cw-bb-switched-reverse {
    flex-direction: row-reverse;
}

.cw-bb-switched-box.cw-bb-switched-reverse .cw-bb-switched-content {
    padding-right: 0;
    padding-left: 60px;
}
.cw-bb-switched-author-name {
    font-size: 16px;
    line-height: 150%;
    font-weight: 400;
    color: #2A2724;
    font-family: 'Inter',sans-serif;
}

.cw-bb-switched-verified-text {
    font-size: 14px;
    line-height: 150%;
    font-weight: 400;
    color: #2A2724;
    font-family: 'Inter', sans-serif;
}
@media only screen and (max-width: 600px) {
section.cw-bb-switched-section {
    padding: 50px 0;
}

.cw-bb-switched-title {
    font-size: 33px;
}

.cw-bb-switched-description {
    font-size: 16px;
    padding-top: 15px;
}

.cw-bb-switched-box {padding: 15px;flex-wrap: wrap;gap: 20px;margin-bottom: 25px;}

.cw-bb-switched-image {
    width: 100%;
}

.cw-bb-switched-image img {
    max-width: 100%;
}

.cw-bb-switched-box-title {
    font-size: 26px;
}

.cw-bb-switched-content {
    width: 100%;
    padding: 0;
}

.cw-bb-switched-box-description {
    padding-top: 10px;
    font-size: 16px;
}

.cw-bb-switched-box.cw-bb-switched-reverse .cw-bb-switched-content {
    padding-left: 0;
}

.cw-bb-switched-review-box {
    padding-left: 15px;
    margin-top: 15px;
}

.cw-bb-switched-review-text {
    font-size: 14px;
}

.cw-bb-switched-review-stars img {
    max-width: 85px;
}

.cw-bb-switched-button-wrap a {
    font-size: 18px;
}
.cw-bb-switched-author-name {
    font-size: 14px;
}

.cw-bb-switched-verified-text {
    font-size: 12px;
}
.cw-bb-switched-verified img {
    max-width: 12px;
}
}
</style>

<section
  class="cw-bb-switched-section"
  style="background-image: url({{ section.settings.bg_image | img_url: 'master' }});"
>
  <div class="page-width">

    <div class="cw-bb-switched-main-container">

      <!-- TOP TITLE -->
      <div class="cw-bb-switched-title">
        {{ section.settings.title }}
      </div>

      <!-- TOP DESCRIPTION -->
      <div class="cw-bb-switched-description">
        {{ section.settings.description }}
      </div>

      <!-- REPEATER BOXES -->
      <div class="cw-bb-switched-box-wrapper">

        {% for block in section.blocks %}
          <div
            class="cw-bb-switched-box {% if block.settings.image_position == 'right' %}cw-bb-switched-reverse{% endif %}"
            {{ block.shopify_attributes }}
          >

            <!-- IMAGE SIDE -->
            <div class="cw-bb-switched-image">
              {% if block.settings.image %}
                <img
                  src="{{ block.settings.image | img_url: 'master' }}"
                  alt=""
                  loading="lazy"
                >
              {% endif %}
            </div>

            <!-- CONTENT SIDE -->
            <div class="cw-bb-switched-content">

              <div class="cw-bb-switched-box-title">
                {{ block.settings.title }}
              </div>

              <div class="cw-bb-switched-box-description">
                {{ block.settings.text }}
              </div>

              {% if block.settings.show_review %}
                <div class="cw-bb-switched-review-box">

                  <div class="cw-bb-switched-review-stars">
                    {% if block.settings.stars %}
                      <img
                        src="{{ block.settings.stars | img_url: 'master' }}"
                        alt=""
                        loading="lazy"
                      >
                    {% endif %}
                  </div>

                  <div class="cw-bb-switched-review-text">
                    {{ block.settings.review_text }}
                  </div>

                  <div class="cw-bb-switched-author-box">

                    <div class="cw-bb-switched-author-name">
                      {{ block.settings.author }}
                    </div>

                    <div class="cw-bb-switched-verified">
                      {% if block.settings.verified_icon %}
                        <img
                          src="{{ block.settings.verified_icon | img_url: 'master' }}"
                          alt=""
                          loading="lazy"
                        >
                      {% endif %}
                      <div class="cw-bb-switched-verified-text">
                        {{ block.settings.verified_text }}
                      </div>
                    </div>

                  </div>
                </div>
              {% endif %}

            </div>
          </div>
        {% endfor %}

      </div>

      <!-- CTA BUTTON -->
      <div class="cw-bb-switched-button-wrap">
        <a href="{{ section.settings.button_link }}">
          {{ section.settings.button_text }}
        </a>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "CW BB Switched",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Main Title"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Main Description"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "GET YOURS NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "content_box",
      "name": "Content Box",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "image_position",
          "label": "Image Position",
          "default": "left",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "right", "label": "Right" }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Box Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Box Description"
        },
        {
          "type": "checkbox",
          "id": "show_review",
          "label": "Show Review Box",
          "default": false
        },
        {
          "type": "image_picker",
          "id": "stars",
          "label": "Stars Image"
        },
        {
          "type": "textarea",
          "id": "review_text",
          "label": "Review Text"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author Name"
        },
        {
          "type": "image_picker",
          "id": "verified_icon",
          "label": "Verified Tick Icon"
        },
        {
          "type": "text",
          "id": "verified_text",
          "label": "Verified Text",
          "default": "Verified Buyer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "CW BB Switched"
    }
  ]
}
{% endschema %}
