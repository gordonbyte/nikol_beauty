<style>
section.cw-makeup-developed-section {
    background-size: cover;
    background-position: bottom;
    padding: 40px 0px;
}

.cw-makeup-developed-image img {
    width: 100%;
}

.cw-makeup-developed-parent {
    display: flex;
    align-items: center;
    gap: 120px;
}

.cw-makeup-developed-left {
    width: 50%;
}

.cw-makeup-developed-right {
    width: 50%;
}

.cw-makeup-developed-title {
    color: #2A2724;
    font-size: 62px;
    line-height: 110%;
    font-family: 'Cormorant';
    letter-spacing: -3px;
    text-transform: capitalize;
}

.cw-makeup-developed-subtitle {
    color: #2A2724;
    font-family: 'Inter';
    font-size: 20px;
    line-height: 140%;
    font-weight: 400;
    padding-top: 20px;
    padding-bottom: 10px;
}

.cw-makeup-developed-description p {
    color: #2A2724;
    font-weight: 400;
    font-family: 'Inter';
    font-size: 18px;
    line-height: 150%;
    width: 100%;
}

.cw-makeup-developed-description {
    display: flex;
    flex-wrap: wrap;
}

.cw-makeup-developed-description p strong {
    font-weight: 700;
}

@media only screen and (max-width: 600px) {
.cw-makeup-developed-parent {
    flex-wrap: wrap;
    gap: 30px;
}

.cw-makeup-developed-left {
    width: 100%;
    text-align: center;
}

.cw-makeup-developed-right {
    width: 100%;
    order: -1;
}

.cw-makeup-developed-title {
    font-size: 34px;
}

.cw-makeup-developed-subtitle {
    font-size: 16px;
    line-height: 135%;
    padding-top: 10px;
    padding-bottom: 5px;
}

.cw-makeup-developed-description p {
    font-size: 16px;
    line-height: 135%;
}

section.cw-makeup-developed-section {
    background-size: contain;
}
section.cw-makeup-developed-section.mkd-new .cw-makeup-developed-right {
    order: 1;
}
}

  </style>

<section
  class="cw-makeup-developed-section mkd-new"
  {% if section.settings.bg_image != blank %}
    style="background-image:url({{ section.settings.bg_image | img_url: 'master' }});"
  {% endif %}
>
  <div class="page-width cw-makeup-developed-page-width">

    <div class="cw-makeup-developed-parent">

 
      <div class="cw-makeup-developed-left">

        {% if section.settings.title != blank %}
          <div class="cw-makeup-developed-title">
            {{ section.settings.title }}
          </div>
        {% endif %}

        {% if section.settings.subtitle != blank %}
          <div class="cw-makeup-developed-subtitle">
            {{ section.settings.subtitle }}
          </div>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="cw-makeup-developed-description">
            {{ section.settings.description }}
          </div>
        {% endif %}

      </div>


      <div class="cw-makeup-developed-right">

        {% if section.settings.right_image != blank %}
          <div class="cw-makeup-developed-image">
            <img
              src="{{ section.settings.right_image | img_url: 'master' }}"
              alt="{{ section.settings.title }}"
            >
          </div>
        {% endif %}

      </div>

    </div>

  </div>
</section>


{% schema %}
{
  "name": "CW Makeup Developed",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Makeup Developed By Licensed Esthetician"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Most makeup was created for young skin. That's why it often settles into lines, looks heavy, or just doesn't sit right as skin changes."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Our founder, <strong>Nikol Johnson-Sanchez</strong>, started running into the same issues herself after years working as a licensed esthetician and makeup artist. She realized the problem wasn't technique, it was that the formulas simply weren't made for mature skin.</p><p>So she created Nikol. Makeup designed to feel lightweight, blend easily, and actually match your skin tone and undertone.</p>"
    },
    {
      "type": "image_picker",
      "id": "right_image",
      "label": "Right Side Image"
    }
  ],
  "presets": [
    {
      "name": "CW Makeup Developed"
    }
  ]
}
{% endschema %}
