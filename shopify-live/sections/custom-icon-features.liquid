<style>



.ingredients-content {
  width: 50%;
  padding-left: 200px;
}
.ingredients-container {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 100px;
}

    .ingredients-content h2 {
        font-size: 56px;
        line-height: 110%;
        letter-spacing: -1px;
        font-weight: 500;
        color: #2A2724;
        margin: 0;
    }

.feature h4 {
    font-size: 32px;
    line-height: 120%;
    font-weight: 500;
    color: #2A2724;
}
.feature p {
    font-size: 18px;
    line-height: 150%;
    font-weight: 400;
    color: #2A2724;
    font-family: 'Inter', sans-serif;
    margin: 0;
}

.ingredients-visual {width: 50%;}

.image-box img {
    width: 100%;
    max-width: 100%;
    object-fit: contain;
}

.icon-box {
    display: flex;
    gap: 40px;
    align-items: center;
    margin-bottom: 35px;
    max-width: 600px;
}

.icon-box img {
    max-width: 130px;
    object-fit: contain;
}

section.ingredients-section {
    background: #FCFAF8;
}

.subtitle {
    font-size: 20px;
    line-height: 140%;
    font-weight: 400;
    margin: 0;
    padding-top: 20px;
    padding-bottom: 40px;
}

.image-box {
    width: 50%;
}

.cw-button-wrap a {
    display: flex;
    align-items: center;
    width: 100%;
    max-width: 400px;
    height: 60px;
    background: #D34270;
    justify-content: center;
    font-size: 22px;
    line-height: 26px;
    letter-spacing: 0;
    font-weight: 700;
    color: #FFFFFF;
    font-family: 'Cormorant',sans-serif;
    cursor: pointer;
}

@media only screen and (max-width: 1600px) {
.ingredients-content {
    padding-left: 80px;
}
.ingredients-content h2 {
    font-size: 52px;
}

}

@media only screen and (max-width: 600px) {
  section.ingredients-section {
    padding-bottom: 50px;
}
.ingredients-container {
    flex-wrap: wrap;
    flex-direction: column-reverse;
    gap: 20px;
}

.ingredients-content {
    width: 100%;
    padding: 0 15px;
}

.image-box {
    width: 100%;
}

.image-box img {
    max-width: 100%;
    height: 450px;
        object-fit: cover;
}

.ingredients-content h2 {
    font-size: 33px;
    text-align: center;
}

.subtitle {
    font-size: 16px;
    text-align: center;
    padding-top: 0;
}

.icon-box img {
    max-width: 100px;
}
.icon-box {
    gap: 15px;
}
.feature h4 {
    font-size: 23px;
}

.feature p {
    font-size: 16px;
}

.cw-button-wrap a {
    font-size: 18px;
}
}
</style>

<section class="ingredients-section">
  <div class="ingredients-container">

    <!-- LEFT CONTENT -->
    <div class="ingredients-content">

      {% if section.settings.heading != blank %}
        <h2>{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <p class="subtitle">
          {{ section.settings.subheading }}
        </p>
      {% endif %}

      {% for block in section.blocks %}
        <div class="feature" {{ block.shopify_attributes }}>
          <div class="icon-box">

            {% if block.settings.icon != blank %}
              <img 
                class="ingredients-img"
                src="{{ block.settings.icon | img_url: 'master' }}"
                alt="{{ block.settings.title | escape }}"
                loading="lazy"
              >
            {% endif %}

            <div>
              {% if block.settings.title != blank %}
                <h4>{{ block.settings.title }}</h4>
              {% endif %}

              {% if block.settings.text != blank %}
                <p>{{ block.settings.text }}</p>
              {% endif %}
            </div>

          </div>
        </div>
      {% endfor %}

      {% if section.settings.button_text != blank %}
        <div class="cw-button-wrap">
          <a href="{{ section.settings.button_link }}" class="cta-btn">
            {{ section.settings.button_text }}
          </a>
        </div>
      {% endif %}

    </div>

    <!-- RIGHT IMAGE -->
    <div class="image-box">
      {% if section.settings.main_image != blank %}
        <img 
          class="ingredients-img"
          src="{{ section.settings.main_image | img_url: 'master' }}"
          alt="Ingredients Image"
          loading="lazy"
        >
      {% endif %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "[Custom] Icon Features",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Made With Skin-Safe<br>Ingredients You Can Trust</p>"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Sub Heading",
      "default": "Formulated to feel comfortable on mature and sensitive skin."
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Right Side Image"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "GET YOURS NOW →"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Feature Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Feature Title",
          "default": "Feature title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Feature Description",
          "default": "Feature description here."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "[Custom] Icon Features",
      "blocks": [
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" }
      ]
    }
  ]
}
{% endschema %}
