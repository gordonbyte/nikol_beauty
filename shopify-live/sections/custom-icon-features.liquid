{%- style -%}
  #IconFeatures-{{ section.id }} {
    --custom-icon-features-bg: {{ section.settings.background_color }};
  }
{%- endstyle -%}

<style>
.custom-icon-features {
  background: var(--custom-icon-features-bg);
  overflow: hidden;
}

.custom-icon-features__container {
  display: flex;
  align-items: center;
  gap: 100px;
  width: 100%;
}

.custom-icon-features__content {
  width: 50%;
  padding-left: 200px;
}

.custom-icon-features__heading {
  margin: 0;
  color: var(--COLOR-TEXT);
  font-size: 56px;
  font-weight: 500;
  line-height: 110%;
  letter-spacing: -1px;
}

.custom-icon-features__subtitle {
  margin: 0;
  padding-top: 20px;
  padding-bottom: 40px;
  font-size: 20px;
  font-weight: 400;
  line-height: 140%;
}

.custom-icon-features__feature-inner {
  display: flex;
  align-items: center;
  gap: 40px;
  max-width: 600px;
  margin-bottom: 35px;
}

.custom-icon-features__feature-icon img {
  max-width: 130px;
  height: auto;
  object-fit: contain;
}

.custom-icon-features__feature-text h3 {
  color: var(--COLOR-TEXT);
  font-size: 32px;
  font-weight: 500;
  line-height: 120%;
}

.custom-icon-features__feature-text p {
  margin: 0;
  color: var(--COLOR-TEXT);
  font-family: 'Inter', sans-serif;
  font-size: var(--FONT-SIZE-BASE);
  font-weight: 400;
  line-height: 150%;
}

.custom-icon-features__image {
  width: 50%;
  overflow: hidden;
  align-self: stretch;
}

.custom-icon-features__image img {
  display: block;
  width: 100%;
  max-width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Hover life: the portrait eases into a gentle zoom under the pointer. */
@media (hover: hover) {
  .custom-icon-features__image img {
    transition: transform 0.45s ease;
  }

  .custom-icon-features__image:hover img {
    transform: scale(1.02);
  }
}

/* Scroll-in reveal: initial hidden states apply ONLY once JS adds anim-ready,
   so content stays visible without JS and under reduced motion. The image
   reveal lives on the wrapper so it never collides with the img hover zoom. */
.custom-icon-features.anim-ready .custom-icon-features__heading,
.custom-icon-features.anim-ready .custom-icon-features__subtitle,
.custom-icon-features.anim-ready .custom-icon-features__feature,
.custom-icon-features.anim-ready .custom-icon-features__button,
.custom-icon-features.anim-ready .custom-icon-features__image {
  opacity: 0;
  transform: translateY(26px);
  transition: opacity 0.65s ease, transform 0.65s ease;
}

.custom-icon-features.anim-ready .is-inview {
  opacity: 1;
  transform: none;
}

.custom-icon-features__button a {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  max-width: 400px;
  height: 60px;
  background: var(--BTN-PRIMARY-BG-COLOR);
  color: var(--BTN-PRIMARY-TEXT-COLOR);
  font-family: var(--BTN-FONT-STACK);
  font-size: var(--BTN-FONT-SIZE);
  font-weight: 700;
  line-height: 26px;
  letter-spacing: 0;
  cursor: pointer;
  gap: 5px;
  transition: background 0.3s ease;
}

.custom-icon-features__button a:focus-visible {
  background: var(--BTN-PRIMARY-BG-COLOR-BRIGHTER);
  color: var(--BTN-PRIMARY-TEXT-COLOR);
}

@media (hover: hover) {
  .custom-icon-features__button a:hover {
    background: var(--BTN-PRIMARY-BG-COLOR-BRIGHTER);
    color: var(--BTN-PRIMARY-TEXT-COLOR);
  }

  .custom-icon-features__button a svg {
    transition: transform 0.5s ease;
    transform: translateZ(0);
  }

  .custom-icon-features__button a:hover svg {
    transform: translate3d(5px, 0, 0);
  }
}

@media only screen and (max-width: 1600px) {
  .custom-icon-features__content {
    padding-left: 80px;
  }
  .custom-icon-features__heading {
    font-size: 52px;
  }
}

@media only screen and (max-width: 600px) {
  .custom-icon-features {
    padding-bottom: 50px;
  }
  .custom-icon-features__container {
    flex-wrap: wrap;
    flex-direction: column-reverse;
    gap: 20px;
  }
  .custom-icon-features__content {
    width: 100%;
    padding: 0 15px;
  }
  .custom-icon-features__image {
    width: 100%;
  }
  .custom-icon-features__image img {
    max-width: 100%;
    height: 450px;
    object-fit: cover;
  }
  .custom-icon-features__heading {
    font-size: 33px;
    text-align: center;
  }
  .custom-icon-features__subtitle {
    padding-top: 0;
    font-size: var(--FONT-SIZE-BASE);
    text-align: center;
  }
  .custom-icon-features__feature-icon img {
    max-width: 100px;
  }
  .custom-icon-features__feature-inner {
    gap: 15px;
  }
  .custom-icon-features__feature-text h3 {
    font-size: 23px;
  }
  .custom-icon-features__feature-text p {
    font-size: var(--FONT-SIZE-BASE);
  }
  .custom-icon-features__button a {
    font-size: var(--BTN-FONT-SIZE);
  }
}
</style>

<section class="custom-icon-features" id="IconFeatures-{{ section.id }}">
  <div class="custom-icon-features__container">

    <div class="custom-icon-features__content">

      {%- if section.settings.heading != blank -%}
        {%- assign heading_html = section.settings.heading | replace: '<p>', '' | replace: '</p>', '' -%}
        <h2 class="custom-icon-features__heading">{{ heading_html }}</h2>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="custom-icon-features__subtitle">{{ section.settings.subheading }}</p>
      {%- endif -%}

      {%- for block in section.blocks -%}
        <div class="custom-icon-features__feature" {{ block.shopify_attributes }}>
          <div class="custom-icon-features__feature-inner">
            {%- if block.settings.icon != blank -%}
              <span class="custom-icon-features__feature-icon">
                {{ block.settings.icon | image_url: width: 260 | image_tag: alt: '', loading: 'lazy' }}
              </span>
            {%- endif -%}
            <div class="custom-icon-features__feature-text">
              {%- if block.settings.title != blank -%}
                <h3>{{ block.settings.title }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p>{{ block.settings.text }}</p>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endfor -%}

      {%- if section.settings.button_text != blank and section.settings.button_link != blank -%}
        <div class="custom-icon-features__button">
          <a href="{{ section.settings.button_link }}">
            {{ section.settings.button_text }}
            <svg width="22" height="13" viewBox="0 0 22 13" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
              <path d="M0.843262 5.36644C0.377534 5.36644 0 5.74399 0 6.20972C0 6.67544 0.377534 7.05299 0.843262 7.05299H20.8433C21.309 7.05299 21.6866 6.67544 21.6866 6.20972C21.6866 5.74399 21.309 5.36644 20.8433 5.36644H0.843262ZM21.4395 6.806C21.7689 6.47668 21.7689 5.94275 21.4395 5.61343L16.073 0.24687C15.7437 -0.0824491 15.2097 -0.0824491 14.8804 0.24687C14.5511 0.576189 14.5511 1.11012 14.8804 1.43944L19.6507 6.20972L14.8804 10.98C14.5511 11.3093 14.5511 11.8432 14.8804 12.1726C15.2097 12.5019 15.7437 12.5019 16.073 12.1726L21.4395 6.806Z" fill="currentColor"/>
            </svg>
          </a>
        </div>
      {%- endif -%}

    </div>

    <div class="custom-icon-features__image">
      {%- if section.settings.main_image != blank -%}
        {{ section.settings.main_image | image_url: width: 1000 | image_tag: widths: '300, 500, 700, 900, 1100', sizes: '(min-width: 601px) 50vw, 100vw', loading: 'lazy' }}
      {%- endif -%}
    </div>

  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('IconFeatures-{{ section.id }}');
    if (!root) return;
    if (!('IntersectionObserver' in window)) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (window.theme && window.theme.settings && window.theme.settings.enableAnimations === false) return;

    var targets = root.querySelectorAll('.custom-icon-features__heading, .custom-icon-features__subtitle, .custom-icon-features__feature, .custom-icon-features__button, .custom-icon-features__image');
    if (!targets.length) return;

    root.classList.add('anim-ready');

    /* Items entering together stagger 90ms apart in DOM order; the batch
       resets between bursts so later reveals start immediately. */
    var batch = 0;
    var lastHit = 0;
    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting) return;
        var el = entry.target;
        var now = performance.now();
        if (now - lastHit > 400) batch = 0;
        lastHit = now;
        el.style.transitionDelay = Math.min(batch * 90, 540) + 'ms';
        batch++;
        el.classList.add('is-inview');
        el.addEventListener('transitionend', function clear() {
          el.style.transitionDelay = '';
          el.removeEventListener('transitionend', clear);
        });
        observer.unobserve(el);
      });
    }, { threshold: 0.15 });

    targets.forEach(function (t) { observer.observe(t); });
  })();
</script>

{% schema %}
{
  "name": "[Custom] Icon Features",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Made With Skin-Safe<br>Ingredients You Can Trust</p>"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Sub Heading",
      "default": "Formulated to feel comfortable on mature and sensitive skin."
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Right Side Image"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "GET YOURS NOW →"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#FCFAF8"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Feature Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Feature Title",
          "default": "Feature title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Feature Description",
          "default": "Feature description here."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "[Custom] Icon Features",
      "blocks": [
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" }
      ]
    }
  ]
}
{% endschema %}
