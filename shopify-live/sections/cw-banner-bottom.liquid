<style>
.banner-bottom-left-image img {
    width: 100%;
    height: 700px;
    object-fit: cover;
}

.banner-bottom-main {
    display: flex;
    align-items: center;
    gap: 100px;
    padding-top: 0px;
    margin-bottom: -6px;
}

.banner-bottom-left {
    width: 50%;
}

.banner-bottom-right {
    width: 50%;
    max-width: 490px;
}


@media only screen and (max-width: 600px) {
.banner-bottom-main {
    flex-wrap: wrap;
    padding-top: 0px;
    margin-bottom: 0px;
    gap: 0px;
}

.banner-bottom-right {
    width: 100%;
    max-width: 100%;
    padding: 15px;
    order: -1;
    text-align: center;
}

.banner-bottom-left {
    width: 100%;
}

.cw-banner-description {
    font-size: 16px;
    line-height: 135%;
}
.banner-bottom-left-image img {
    height: auto;
    object-fit: cover;
}
.banner-bottom-left {
    order: -1;
}
}

    </style>

<section class="banner-bottom" style="background-image: url({{ section.settings.bg_image | img_url: 'master' }});">
  <div class="banner-bottom-main">

   
    <div class="banner-bottom-left">
   
        <div class="banner-bottom-left-image">
          <img src="{{ section.settings.left_image_desktop | img_url: 'master' }}" alt="" class="cw-desktop">
          <img src="{{ section.settings.left_image_mobile | img_url: 'master' }}" alt="" class="cw-mobile">
        </div>
    
    </div>

   
    <div class="banner-bottom-right">

   
      {% if section.settings.star_image or section.settings.star_text != blank %}
        <div class="cw-banner-star-box">
          {% if section.settings.star_image %}
            <div class="cw-banner-star-img">
              <img src="{{ section.settings.star_image | img_url: 'master' }}" alt="">
            </div>
          {% endif %}

          {% if section.settings.star_text != blank %}
            <div class="cw-banner-star-text">
              {{ section.settings.star_text }}
            </div>
          {% endif %}
        </div>
      {% endif %}

   
      {% if section.settings.title != blank %}
        <div class="cw-banner-title">
          {{ section.settings.title }}
        </div>
      {% endif %}


      {% if section.settings.description != blank %}
        <div class="cw-banner-description">
          {{ section.settings.description }}
        </div>
      {% endif %}

     
      {% if section.settings.button_text != blank %}
        <div class="cw-banner-button">
          <a href="{{ section.settings.button_link }}">
            {{ section.settings.button_text }}
            <svg width="22" height="13" viewBox="0 0 22 13" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M0.843262 5.36644C0.377534 5.36644 0 5.74399 0 6.20972C0 6.67544 0.377534 7.05299 0.843262 7.05299H20.8433C21.309 7.05299 21.6866 6.67544 21.6866 6.20972C21.6866 5.74399 21.309 5.36644 20.8433 5.36644H0.843262ZM21.4395 6.806C21.7689 6.47668 21.7689 5.94275 21.4395 5.61343L16.073 0.24687C15.7437 -0.0824491 15.2097 -0.0824491 14.8804 0.24687C14.5511 0.576189 14.5511 1.11012 14.8804 1.43944L19.6507 6.20972L14.8804 10.98C14.5511 11.3093 14.5511 11.8432 14.8804 12.1726C15.2097 12.5019 15.7437 12.5019 16.073 12.1726L21.4395 6.806Z" fill="white"/>
            </svg>
          </a>
        </div>
      {% endif %}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Banner Bottom",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "image_picker",
      "id": "left_image_desktop",
      "label": "Left Image Desktop"
    },
     {
      "type": "image_picker",
      "id": "left_image_mobile",
      "label": "Left Image Mobile"
    },
    {
      "type": "image_picker",
      "id": "star_image",
      "label": "Star Image"
    },
    {
      "type": "textarea",
      "id": "star_text",
      "label": "Star Text"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Banner Bottom"
    }
  ]
}
{% endschema %}
