{% assign videos = shop.metaobjects['beauty_tutorial_videos'] %}

{% comment %} Read metafields from the current page {% endcomment %}
{% assign fierceaging_video_url = page.metafields.custom.fierceaging_series_video %}
{% assign fierceaging_featured_product = page.metafields.custom.fierceaging_series_featured_product %}
{% assign fierceaging_featured_product_description = page.metafields.custom.fierceaging_series_featured_product_description %}
{% assign makeup_tutorials_video_url = page.metafields.custom.makeup_tutorials_video %}
{% assign makeup_tutorials_featured_product = page.metafields.custom.makeup_tutorials_featured_product %}
{% assign makeup_tutorials_featured_product_description = page.metafields.custom.makeup_tutorials_featured_product_description %}



{% comment %} Extract YouTube video IDs using the same simple approach as beauty_tutorial_videos.liquid {% endcomment %}
{% assign fierceaging_video_id = fierceaging_video_url | split: 'v=' | last %}
{% assign makeup_tutorials_video_id = makeup_tutorials_video_url | split: 'v=' | last %}



{% comment %} Get product information from metafields {% endcomment %}
{% assign fierceaging_product = fierceaging_featured_product.value %}
{% assign makeup_product = makeup_tutorials_featured_product.value %}


<section class="video-gallery-section">
  {% comment %}
  <!-- Tab Navigation -->
  <div class="video-gallery-tabs">
    <div class="video-gallery-tabs-container">
      <div class="video-gallery-tab-navigation">
        <button class="video-gallery-tab-button" data-tab="makeup-tutorials">
          MAKEUP TUTORIALS
        </button>
        <button class="video-gallery-tab-button active" data-tab="fierceaging-series">
          #FIERCEAGING SERIES
        </button>
      </div>
    </div>
  </div>
  {% endcomment %}

  <!-- Tab Content -->
  <div class="video-gallery-tab-content">
    <!-- Makeup Tutorials Tab -->
    <div class="video-gallery-tab-panel" id="makeup-tutorials">
      <!-- Hero Section -->
      <div class="video-gallery-hero-section">
        <div class="video-gallery-container">
          <div class="video-gallery-hero-content">
            <div class="video-gallery-hero-text">
              <h1 class="video-gallery-hero-title">{{ section.settings.makeup_title | default: "Discover Nikol's Favorite Products in Action" }}</h1>
              <p class="video-gallery-hero-description">
                {{ section.settings.makeup_description | default: "Join Nikol as she shares real makeup tips, tutorials, and honest reviews—because beauty doesn't stop at 50, it just gets better." }}
              </p>
            </div>
            <div class="video-gallery-hero-image">
            
                <div class="video-gallery-placeholder-image">
                  <img src="https://cdn.shopify.com/s/files/1/0690/6347/5504/files/ff0702c8a19189bf469459f0bc045d95ba3f13b6.png?v=1753989319" 
                       alt="Nikol Beauty Expert" >
                </div>

            </div>
          </div>
        </div>
      </div>

      {% comment %}
      <!-- Spotlight Section -->
      <div class="video-gallery-spotlight-section">
        <div class="video-gallery-container">
          <div class="video-gallery-spotlight-header">
            <h2 class="video-gallery-spotlight-title">Spotlight by Nikol</h2>
            <p class="video-gallery-spotlight-subtitle">One bold video that empowers, uplifts, and proves beauty only gets better with age.</p>
          </div>
          
          <div class="video-gallery-spotlight-content">
            <div class="video-gallery-spotlight-video">
              <div class="video-gallery-video-thumbnail-large">
                {% if makeup_tutorials_video_id != blank %}
                  <iframe 
                    width="100%" 
                    height="400" 
                    src="https://www.youtube.com/embed/{{ makeup_tutorials_video_id }}" 
                    title="Makeup Tutorials Featured Video"
                    frameborder="0" 
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                    allowfullscreen>
                  </iframe>
                {% else %}
                  <div class="video-gallery-placeholder-video">
                    <p>Video URL not configured in metafields</p>
                  </div>
                {% endif %}
              </div>
            </div>
            
            <div class="video-gallery-spotlight-product">
              <h4 class="video-gallery-featured-product-title">FEATURED PRODUCT</h4>
              <div class="video-gallery-product-card">
                {% if makeup_product %}
                  <div class="video-gallery-product-image">
                    <a href="{{ makeup_product.url }}" title="{{ makeup_product.title }}">
                      <img src="{{ makeup_product.featured_image | img_url: '200x300' }}" alt="{{ makeup_product.title }}">
                    </a>
                  </div>
                  <div class="video-gallery-product-info">
                    <h5 class="video-gallery-product-name">
                      <a href="{{ makeup_product.url }}" title="{{ makeup_product.title }}">{{ makeup_product.title | upcase }}</a>
                    </h5>
                    <p class="video-gallery-product-price">{{ makeup_product.price | money }}</p>
                    {% assign makeup_variants_count = makeup_product.variants.size %}
                    {% comment %} Check if product has variants or is a bundle {% endcomment %}
                  

                    {% if makeup_variants_count > 1 %}
                      {% assign has_variants = true %}
                    {% else %}
                      {% assign has_variants = false %}
                    {% endif %}


                    {% if has_variants %}
                      {% comment %} Show "View product" button for products with variants or bundles {% endcomment %}
                      <a href="{{ makeup_product.url }}" class="video-gallery-view-product-btn">
                        <svg class="video-gallery-view-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                          <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
                        </svg>
                        View product
                      </a>
                      <p class="video-gallery-product-options">Available in {{ makeup_product.variants.size }} variants</p>
                    {% else %}
                      {% comment %} Show "Add to cart" button for simple products {% endcomment %}
                      <form action="/cart/add" method="post" enctype="multipart/form-data">
                        <input type="hidden" name="id" value="{{ makeup_product.variants.first.id }}">
                        <button type="submit" class="video-gallery-add-to-cart-btn">
                          <svg class="video-gallery-cart-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12L8.1 13h7.45c.75 0 1.41-.41 1.75-1.03L21.7 4H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"/>
                          </svg>
                          Add to cart
                        </button>
                      </form>
                    {% endif %}
                  </div>
                {% else %}
                  <div class="video-gallery-product-image">
                    <img src="https://via.placeholder.com/200x300" alt="Featured Product">
                  </div>
                  <div class="video-gallery-product-info">
                    <h5 class="video-gallery-product-name">FEATURED PRODUCT</h5>
                    <p class="video-gallery-product-price">$19.00</p>
                    <p class="video-gallery-product-options">Available in multiple colors</p>
                    <a href="#" class="video-gallery-view-product-btn">
                      <svg class="video-gallery-view-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
                      </svg>
                      View product
                    </a>
                  </div>
                {% endif %}
              </div>
              
              <div class="video-gallery-video-description">
                
                <p class="video-gallery-video-desc-text">{{ makeup_tutorials_featured_product_description | default: "Discover Nikol's favorite makeup techniques and products that work for mature skin." }}</p>
              </div>
            </div>
          </div>
          
          <div class="video-gallery-spotlight-quote">
            <p>"Makeup isn't about hiding—it's about honoring who you are, right now."</p>
            <cite>- Nikol</cite>
          </div>
        </div>
      </div>
      {% endcomment %}

      <!-- Videos Grid Section -->
      <div class="video-gallery-videos-grid-section">
        <div class="video-gallery-container">
          <div class="video-gallery-videos-grid" id="makeup-tutorials-videos-grid">
            <!-- Video Grid Content -->
            
                        {% if videos %}
                {% comment %} Count total videos for tutorials category {% endcomment %}
                {% assign tutorials_count = 0 %}
                {% for video in videos.values %}
                  {% if video.category == 'tutorials' %}
                    {% assign tutorials_count = tutorials_count | plus: 1 %}
                  {% endif %}
                {% endfor %}

                {% comment %} Display all videos {% endcomment %}
                {% for video in videos.values %}
                  {% comment %} Filter videos by category "tutorials" {% endcomment %}
                  {% if video.category == 'tutorials' %}
                      {% comment %} Extract YouTube video ID from URL {% endcomment %}
                      {% assign video_url = video.video_url %}
                      {% assign youtube_id = '' %}
                      
                      {% comment %} Extract YouTube ID using a more reliable method {% endcomment %}
                      {% if video_url contains 'youtube.com/watch?v=' %}
                        {% assign url_parts = video_url | split: 'v=' %}
                        {% assign youtube_id = url_parts[1] | split: '&' | first %}
                      {% elsif video_url contains 'youtu.be/' %}
                        {% assign url_parts = video_url | split: 'youtu.be/' %}
                        {% assign youtube_id = url_parts[1] | split: '?' | first %}
                      {% endif %}
                      
                      {% comment %} Fallback extraction method {% endcomment %}
                      {% if youtube_id == blank %}
                        {% assign video_id_part = video_url | split: 'v=' | last %}
                        {% assign youtube_id = video_id_part | split: '&' | first %}
                      {% endif %}
                      
                      {% comment %} Create thumbnail URL {% endcomment %}
                      {% assign thumbnail_url = 'https://img.youtube.com/vi/' | append: youtube_id | append: '/0.jpg' %}
                      
                      {% comment %} Create the video page URL when "Publish entries as web pages" is active {% endcomment %}
                      {% assign video_page_url = '/pages/beauty-tutorial-videos/' | append: video.handle %}
                      
                      {% comment %} If handle is empty, create a fallback URL using the title {% endcomment %}
                      {% if video.handle == blank %}
                        {% assign fallback_handle = video.title | handleize %}
                        {% assign video_page_url = '/pages/beauty-tutorial-videos/' | append: fallback_handle %}
                      {% endif %}
                      
                      {% comment %} Choose between video page URL or YouTube URL based on settings {% endcomment %}
                      {% assign link_url = video_page_url %}
                      {% if section.settings.use_youtube_links %}
                        {% assign link_url = video.video_url %}
                      {% endif %}
                      
                      <a href="{{ link_url }}" class="video-gallery-video-card" data-video-url="{{ video.video_url }}" {% if section.settings.use_youtube_links %}target="_blank"{% endif %}>
                        <div class="video-gallery-video-thumbnail">
                          <img src="{{ thumbnail_url }}" alt="{{ video.title }}" loading="lazy">
                          <div class="video-gallery-video-overlay">
                            <svg class="video-gallery-play-icon" width="48" height="48" viewBox="0 0 24 24" fill="white">
                              <path d="M8 5v14l11-7z"/>
                            </svg>
                          </div>
                        </div>
                        <div class="video-gallery-video-info">
                          <h3 class="video-gallery-video-title">{{ video.title }}</h3>
                        </div>
                      </a>
                  {% endif %}
                {% endfor %}
                
                {% comment %} Store remaining videos data for JavaScript {% endcomment %}
                <script>
                  window.tutorialsVideos = [];
                  {% comment %} All videos are displayed initially, so no remaining videos {% endcomment %}
                  {% assign remaining_count = 0 %}
                  {% for video in videos.values %}
                    {% if video.category == 'tutorials' %}
                      {% assign remaining_count = remaining_count | plus: 1 %}
                      {% if false %}
                        {% assign video_url = video.video_url %}
                        {% assign youtube_id = '' %}
                        {% if video_url contains 'youtube.com/watch?v=' %}
                          {% assign url_parts = video_url | split: 'v=' %}
                          {% assign youtube_id = url_parts[1] | split: '&' | first %}
                        {% elsif video_url contains 'youtu.be/' %}
                          {% assign url_parts = video_url | split: 'youtu.be/' %}
                          {% assign youtube_id = url_parts[1] | split: '?' | first %}
                        {% endif %}
                        {% if youtube_id == blank %}
                          {% assign video_id_part = video_url | split: 'v=' | last %}
                          {% assign youtube_id = video_id_part | split: '&' | first %}
                        {% endif %}
                        {% assign thumbnail_url = 'https://img.youtube.com/vi/' | append: youtube_id | append: '/0.jpg' %}
                        {% assign video_page_url = '/pages/beauty-tutorial-videos/' | append: video.handle %}
                        {% if video.handle == blank %}
                          {% assign fallback_handle = video.title | handleize %}
                          {% assign video_page_url = '/pages/beauty-tutorial-videos/' | append: fallback_handle %}
                        {% endif %}
                        {% assign link_url = video_page_url %}
                        {% if section.settings.use_youtube_links %}
                          {% assign link_url = video.video_url %}
                        {% endif %}
                        
                        window.tutorialsVideos.push({
                          title: '{{ video.title }}',
                          videoUrl: '{{ video.video_url }}',
                          thumbnailUrl: '{{ thumbnail_url }}',
                          linkUrl: '{{ link_url }}',
                          useYouTubeLinks: {{ section.settings.use_youtube_links }}
                        });
                      {% endif %}
                    {% endif %}
                  {% endfor %}
                  window.tutorialsTotalCount = {{ tutorials_count }};
                  window.tutorialsDisplayedCount = {{ tutorials_count }};
                </script>
            {% endif %}

            {% for i in (0..5) %}
             
            {% endfor %}




          </div>
             <!-- Show More Button -->
              <div class="video-gallery-show-more-container">
                <button class="video-gallery-show-more-btn" id="tutorials-show-more-btn" data-tab="tutorials">
                  SHOW MORE
                </button>
              </div>
        </div>
      </div>
    </div>

    <!-- Fierceaging Series Tab -->
    <div class="video-gallery-tab-panel active" id="fierceaging-series">
      <!-- Hero Section -->
      <div class="video-gallery-hero-section">
        <div class="video-gallery-container">
          <div class="video-gallery-hero-content">
            <div class="video-gallery-hero-text">
              <h1 class="video-gallery-hero-title">{{ section.settings.fierceaging_title | default: "#FIERCEAGING Series" }}</h1>
              <p class="video-gallery-hero-description">
                {{ section.settings.fierceaging_description | default: "Embrace aging with confidence and style. Discover tips, tricks, and inspiration for looking and feeling your best at every age." }}
              </p>
            </div>
            <div class="video-gallery-hero-image">
            
                <div class="video-gallery-placeholder-image">
                  <img src="https://cdn.shopify.com/s/files/1/0690/6347/5504/files/ff0702c8a19189bf469459f0bc045d95ba3f13b6.png?v=1753989319" 
                       alt="Nikol Beauty Expert" >
                </div>

            </div>
          </div>
        </div>
      </div>

