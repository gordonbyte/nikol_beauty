                  {% endif %}
                {% endfor %}
                
                {% comment %} Store remaining videos data for JavaScript {% endcomment %}
                <script>
                  window.fierceagingVideos = [];
                  {% comment %} All videos are displayed initially, so no remaining videos {% endcomment %}
                  {% assign remaining_count = 0 %}
                  {% for video in videos.values %}
                    {% if video.category == 'fierceaging' %}
                      {% assign remaining_count = remaining_count | plus: 1 %}
                      {% if false %}
                        {% assign video_url = video.video_url %}
                        {% assign youtube_id = '' %}
                        {% if video_url contains 'youtube.com/watch?v=' %}
                          {% assign url_parts = video_url | split: 'v=' %}
                          {% assign youtube_id = url_parts[1] | split: '&' | first %}
                        {% elsif video_url contains 'youtu.be/' %}
                          {% assign url_parts = video_url | split: 'youtu.be/' %}
                          {% assign youtube_id = url_parts[1] | split: '?' | first %}
                        {% endif %}
                        {% if youtube_id == blank %}
                          {% assign video_id_part = video_url | split: 'v=' | last %}
                          {% assign youtube_id = video_id_part | split: '&' | first %}
                        {% endif %}
                        {% assign thumbnail_url = 'https://img.youtube.com/vi/' | append: youtube_id | append: '/0.jpg' %}
                        {% assign video_page_url = '/pages/beauty-tutorial-videos/' | append: video.handle %}
                        {% if video.handle == blank %}
                          {% assign fallback_handle = video.title | handleize %}
                          {% assign video_page_url = '/pages/beauty-tutorial-videos/' | append: fallback_handle %}
                        {% endif %}
                        {% assign link_url = video_page_url %}
                        {% if section.settings.use_youtube_links %}
                          {% assign link_url = video.video_url %}
                        {% endif %}
                        
                        window.fierceagingVideos.push({
                          title: '{{ video.title }}',
                          videoUrl: '{{ video.video_url }}',
                          thumbnailUrl: '{{ thumbnail_url }}',
                          linkUrl: '{{ link_url }}',
                          useYouTubeLinks: {{ section.settings.use_youtube_links }}
                        });
                      {% endif %}
                    {% endif %}
                  {% endfor %}
                  window.fierceagingTotalCount = {{ fierceaging_count }};
                  window.fierceagingDisplayedCount = {{ fierceaging_count }};
                </script>
            {% endif %}
              
             
              
             
          </div>
        </div>
      </div>

               <!-- Show More Button -->
              <div class="video-gallery-show-more-container">
                <button class="video-gallery-show-more-btn" id="fierceaging-show-more-btn" data-tab="fierceaging">
