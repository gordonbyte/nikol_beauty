<style>
section.cw-main-collections-section {
    background-size: cover;
    background-position: bottom;
    padding-top: 80px;
    padding-bottom: 40px;
}

.cw-main-collections-image img {
    width: 100%;
}

.cw-main-collections-header {
    text-align: center;
}

.cw-main-collections-heading {
    color: #2A2724;
    font-size: 56px;
    line-height: 110%;
    font-family: 'Cormorant';
    letter-spacing: -3px;
    font-weight: 500;
    text-transform: capitalize;
}

.cw-main-collections-subheading {
    color: #2A2724;
    font-family: 'Inter';
    font-size: 20px;
    padding-top: 20px;
    padding-bottom: 40px;
}

.cw-main-collections-parent {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 15px;
}

.cw-main-collections-box {
    width: 32.3%;
}

.cw-main-collections-title {
    color: #2A2724;
    font-size: 36px;
    font-family: 'Cormorant';
    font-weight: 400;
    padding-bottom: 5px;
}

.cw-main-collections-shop {
    color: #D34270;
    font-size: var(--FONT-SIZE-BASE);
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    font-family: 'Cormorant';
    text-decoration: underline;
}

.cw-main-collections-box a {
    position: relative;
}

.cw-main-collections-content {
    position: absolute;
    top: 30%;
    left: 21px;
}
.cw-main-collections-parent .cw-main-collections-box:last-child .cw-main-collections-content {
    top: 20%;
}
.cw-main-collections-parent .cw-main-collections-box:last-child .cw-main-collections-title {
    width: 50%;
}
@media only screen and (max-width: 600px) {
section.cw-main-collections-section {
    padding-top: 40px;
}

.cw-main-collections-parent {
    flex-wrap: wrap;
}

.cw-main-collections-box {
    width: 100%;
}

.cw-main-collections-title {
    font-size: 32px;
    line-height: 90%;
}

.cw-main-collections-shop {
    font-size: var(--FONT-SIZE-BASE);
}

.cw-main-collections-heading {
    font-size: 34px;
}

.cw-main-collections-subheading {
    font-size: var(--FONT-SIZE-BASE);
    line-height: 135%;
    padding-top: 15px;
    padding-bottom: 30px;
}

.cw-main-collections-header {
    padding: 0 15px;
}


}
    </style>

<section
  class="cw-main-collections-section"
  {% if section.settings.bg_image != blank %}
    style="background-image: url('{{ section.settings.bg_image | img_url: 'master' }}');"
  {% endif %}
>
  <div class="page-width">
 <div class="cw-main-collections-header">
      {% if section.settings.title != blank %}
        <div class="cw-main-collections-heading">
          {{ section.settings.title }}
        </div>
      {% endif %}

      {% if section.settings.subtitle != blank %}
        <div class="cw-main-collections-subheading">
          {{ section.settings.subtitle }}
        </div>
      {% endif %}
    </div>
    {% if section.blocks.size > 0 %}
      <div class="cw-main-collections-parent">

        {% for block in section.blocks %}
          <div class="cw-main-collections-box" {{ block.shopify_attributes }}>
            <a
              href="{{ block.settings.link }}"
              class="cw-main-collections-link"
            >

             
                <div class="cw-main-collections-image">
                  <img
                    src="{{ block.settings.image_desktop | img_url: 'master' }}"
                    alt="{{ block.settings.title | escape }}" class="cw-desktop">
                      <img
                    src="{{ block.settings.image_mobile | img_url: 'master' }}"
                    alt="{{ block.settings.title | escape }}" class="cw-mobile">
                </div>
             
<div class="cw-main-collections-content">
              {% if block.settings.title != blank %}
                <div class="cw-main-collections-title">
                  {{ block.settings.title }}
                </div>
              {% endif %}

              {% if block.settings.shop_text != blank %}
                <div class="cw-main-collections-shop">
                  {{ block.settings.shop_text }} <svg width="17" height="12" viewBox="0 0 17 12" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M0.779541 4.96159C0.348967 4.96159 -8.18591e-05 5.31064 -8.18968e-05 5.74121C-8.19344e-05 6.17178 0.348967 6.52083 0.779541 6.52083L0.779541 5.74121L0.779541 4.96159ZM16.3308 6.29249C16.6353 5.98803 16.6353 5.4944 16.3308 5.18994L11.3693 0.228446C11.0649 -0.0760165 10.5712 -0.0760165 10.2668 0.228445C9.96231 0.532907 9.96231 1.02654 10.2668 1.331L14.677 5.74121L10.2668 10.1514C9.96231 10.4559 9.96231 10.9495 10.2668 11.254C10.5712 11.5584 11.0649 11.5584 11.3693 11.254L16.3308 6.29249ZM0.779541 5.74121L0.779541 6.52083L15.7795 6.52084L15.7795 5.74121L15.7795 4.96159L0.779541 4.96159L0.779541 5.74121Z" fill="#D34270"/>
</svg>

                </div>
              {% endif %}
            </div>
            </a>
          </div>
        {% endfor %}

      </div>
    {% endif %}

  </div>
</section>


{% schema %}
{
  "name": "[Custom] Coll. Banners",
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
     {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Shop by Collection"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Section Subtitle",
      "default": "Browse our collections and find your next favorite."
    }
  ],
  "blocks": [
    {
      "type": "collection_box",
      "name": "Collection Box",
      "settings": [
        {
          "type": "image_picker",
          "id": "image_desktop",
          "label": "Box Image Desktop"
        },
          {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Box Image Mobile"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Collection Name"
        },
        {
          "type": "text",
          "id": "shop_text",
          "label": "Shop Text",
          "default": "SHOP NOW"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "[Custom] Coll. Banners"
    }
  ]
}
{% endschema %}
