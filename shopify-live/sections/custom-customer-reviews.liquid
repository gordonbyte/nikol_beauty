<style>
.custom-customer-reviews {
    padding: 80px 0px;
}

.custom-customer-reviews__header {
    text-align: center;
}

.custom-customer-reviews__title {
    color: var(--COLOR-TEXT);
    font-size: 56px;
    line-height: 110%;
    font-family: var(--FONT-STACK-HEADING);
    letter-spacing: -3px;
    font-weight: 500;
    margin: 0;
    text-transform: capitalize;
}

.custom-customer-reviews__subtitle {
    color: var(--COLOR-TEXT);
    font-family: var(--FONT-STACK-BODY);
    font-size: var(--FONT-SIZE-BASE);
    margin: 0;
    padding-top: 20px;
    padding-bottom: 40px;
}

.custom-customer-reviews__slide {
    background: var(--COLOR-BG);
    padding: 20px;
    text-align: center;
    /* equal-height cards: slides stretch to the tallest, product strip pins to the bottom */
    height: auto;
    display: flex;
    flex-direction: column;
}

.custom-customer-reviews__product {
    margin-top: auto;
}

.custom-customer-reviews__stars {
    line-height: 0;
}

.custom-customer-reviews__stars-img {
    display: inline-block;
    position: relative;
    line-height: 0;
}

.custom-customer-reviews__stars-fill {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    overflow: hidden;
}

.custom-customer-reviews__stars-img svg {
    width: 125px;
    height: auto;
}

.custom-customer-reviews__sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
}

.custom-customer-reviews__quote-icon svg {
    width: 25px;
    height: auto;
}

.custom-customer-reviews__quote-icon {
    padding-top: 20px;
    padding-bottom: 10px;
}

.custom-customer-reviews__review-title {
    color: var(--COLOR-TEXT);
    line-height: 110%;
    font-weight: 500;
    font-family: var(--FONT-STACK-HEADING);
    text-transform: capitalize;
    min-height: 90px;
    margin: 0;
}

.custom-customer-reviews__review-text {
    font-family: var(--FONT-STACK-BODY);
    color: var(--COLOR-TEXT);
    font-weight: 400;
    font-size: var(--FONT-SIZE-BASE);
    line-height: 150%;
    margin: 0;
    padding: 0;
    border: 0;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: var(--cr-lines, 4);
    overflow: hidden;
}

.custom-customer-reviews__review-text.is-expanded {
    -webkit-line-clamp: unset;
    overflow: visible;
}

.custom-customer-reviews__toggle {
    display: inline-block;
    background: none;
    border: 0;
    padding: 0;
    margin: 4px 0 0;
    color: var(--COLOR-TEXT);
    font-family: var(--FONT-STACK-BODY);
    font-size: var(--FONT-SIZE-BASE);
    font-style: italic;
    text-decoration: underline;
    cursor: pointer;
}

.custom-customer-reviews__toggle:focus-visible {
    outline: 2px solid var(--COLOR-TEXT);
    outline-offset: 2px;
}

.custom-customer-reviews__author {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 15px;
    margin-bottom: 20px;
}

.custom-customer-reviews__buyer img {
    max-width: 110px;
}

.custom-customer-reviews__author-name {
    font-family: var(--FONT-STACK-BODY);
    font-weight: 400;
    font-style: normal;
    color: var(--COLOR-TEXT);
    font-size: var(--FONT-SIZE-BASE);
}

.custom-customer-reviews__buyer {
    display: flex;
}

.custom-customer-reviews__product-img img {
    width: 100%;
    height: 70px;
    object-fit: contain;
}

.custom-customer-reviews__product-link {
    display: flex;
    align-items: center;
    background: #F8F3EF;
    padding: 8px 15px;
    gap: 10px;
    justify-content: space-between;
    text-decoration: none;
}

.custom-customer-reviews__product-cart svg {
    width: 35px;
    height: auto;
}

.custom-customer-reviews__product-cart {
    flex-shrink: 0;
    line-height: 0;
}

.custom-customer-reviews__product-mid {
    text-align: left;
}

.custom-customer-reviews__product-title {
    color: var(--COLOR-TEXT);
    font-weight: 500;
    font-size: var(--FONT-SIZE-BASE);
    font-family: var(--FONT-STACK-HEADING);
    text-transform: capitalize;
}

.custom-customer-reviews__product-price {
    color: var(--COLOR-TEXT);
}

.custom-customer-reviews__swiper {
    padding: 0 !important;
}

.custom-customer-reviews__nav {
    background: none;
    border: 0;
    padding: 0;
    line-height: 0;
    position: absolute;
    top: 50%;
    z-index: 3;
    cursor: pointer;
}

.custom-customer-reviews__next {
    right: 40px;
}

.custom-customer-reviews__prev {
    left: 40px;
}

/* edge fades at the page ends — same treatment as the Best Sellers slider:
   solid section bg (layered over the page bg) dissolving inward; end cards
   slide under them, arrows float on the solid zone (desktop only) */
@media only screen and (min-width: 1200px) {
  .custom-customer-reviews__swiper::before,
  .custom-customer-reviews__swiper::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    width: 260px;
    z-index: 2;
    pointer-events: none;
  }

  .custom-customer-reviews__swiper::before {
    left: 0;
    background:
      linear-gradient(to right, var(--custom-reviews-bg) 30%, transparent),
      linear-gradient(to right, var(--COLOR-BG, #fff) 30%, transparent);
  }

  .custom-customer-reviews__swiper::after {
    right: 0;
    background:
      linear-gradient(to left, var(--custom-reviews-bg) 30%, transparent),
      linear-gradient(to left, var(--COLOR-BG, #fff) 30%, transparent);
  }
}

.custom-customer-reviews__pagination {
    margin-top: 60px;
    display: flex;
    justify-content: center;
}

.custom-customer-reviews__pagination .swiper-pagination-bullet {
    appearance: none;
    -webkit-appearance: none;
    padding: 0;
    border: 1.33px solid #45413B59;
    border-radius: 999px;
    background: transparent;
    opacity: 1;
    width: 11px;
    height: 11px;
    cursor: pointer;
    transition: background 0.45s cubic-bezier(0.4, 0, 0.2, 1), border-color 0.45s cubic-bezier(0.4, 0, 0.2, 1), width 0.45s cubic-bezier(0.4, 0, 0.2, 1), transform 0.45s cubic-bezier(0.4, 0, 0.2, 1);
}

.custom-customer-reviews__pagination .swiper-pagination-bullet.swiper-pagination-bullet-active {
    width: 26px;
    border-color: #45413B;
    background: #45413B;
}

.custom-customer-reviews__pagination .swiper-pagination-bullet:focus-visible {
    outline: 2px solid var(--COLOR-TEXT);
    outline-offset: 2px;
}

@media (hover: hover) {
  .custom-customer-reviews__pagination .swiper-pagination-bullet:not(.swiper-pagination-bullet-active):hover {
    border-color: #45413B;
    transform: scale(1.2);
  }
}

.custom-customer-reviews__nav:focus-visible,
.custom-customer-reviews__product-link:focus-visible {
    outline: 2px solid var(--COLOR-TEXT);
    outline-offset: 2px;
}

.custom-customer-reviews__nav svg {
    transition: transform 0.3s ease;
}

.custom-customer-reviews__product-link {
    transition: background 0.3s ease;
}

@media (hover: hover) {
  .custom-customer-reviews__nav:hover svg {
    transform: scale(1.08);
  }

  .custom-customer-reviews__product-link:hover {
    background: #F1E8DF;
  }
}

/* Scroll-in reveal: initial hidden states apply ONLY once JS adds anim-ready,
   so content stays visible without JS and under reduced motion. */
.custom-customer-reviews.anim-ready .custom-customer-reviews__title,
.custom-customer-reviews.anim-ready .custom-customer-reviews__subtitle,
.custom-customer-reviews.anim-ready .custom-customer-reviews__swiper {
    opacity: 0;
    transform: translateY(22px);
    transition: opacity 0.6s ease, transform 0.6s ease;
}

.custom-customer-reviews.anim-ready.is-inview .custom-customer-reviews__title,
.custom-customer-reviews.anim-ready.is-inview .custom-customer-reviews__subtitle,
.custom-customer-reviews.anim-ready.is-inview .custom-customer-reviews__swiper {
    opacity: 1;
    transform: none;
}

@media only screen and (max-width: 600px) {
.custom-customer-reviews__swiper {
    padding: 0 40px !important;
}
.custom-customer-reviews {
    padding: 40px 0px;
}

.custom-customer-reviews__title {
    font-size: 34px;
}

.custom-customer-reviews__header {
    padding: 0 15px;
}

.custom-customer-reviews__subtitle {
    line-height: 135%;
    padding-top: 15px;
    padding-bottom: 30px;
}

.custom-customer-reviews__prev svg {
    width: 30px;
    height: 30px;
}

.custom-customer-reviews__prev {
    top: auto;
    bottom: 10px;
}

.custom-customer-reviews__pagination {
    margin-top: 0px;
    position: absolute;
    /* arrows: 30px tall anchored at bottom 10px -> center 25px; 11px dots need bottom 19.5px to share it */
    bottom: 19.5px !important;
}

.custom-customer-reviews__swiper .swiper-wrapper {
    padding-bottom: 70px;
}

.custom-customer-reviews__next {
    top: auto;
    bottom: 10px;
}

.custom-customer-reviews__next svg {
    width: 30px;
    height: 30px;
}

.custom-customer-reviews__stars-img svg {
    width: 105px;
}

.custom-customer-reviews__review-title {
    min-height: auto;
    padding-bottom: 15px;
}

.custom-customer-reviews__buyer img {
    max-width: 95px;
}

.custom-customer-reviews__product-title {
    line-height: 110%;
}

.custom-customer-reviews__product-link {
    padding: 8px 8px;
}

.custom-customer-reviews__slide {
    padding: 20px 15px;
}
}

    </style>

{%- assign heading_id = 'CustomerReviews-' | append: section.id | append: '-title' -%}

<section
  class="custom-customer-reviews"
  id="CustomerReviews-{{ section.id }}"
  {% if section.settings.title != blank %}aria-labelledby="{{ heading_id }}"{% endif %}
  style="background: {{ section.settings.bg_color }}; --custom-reviews-bg: {{ section.settings.bg_color | default: '#F7F2ED' }}; --cr-lines: {{ section.settings.review_lines }};"
>
  <div class="page-width">
    <div class="custom-customer-reviews__header">
      {% if section.settings.title != blank %}
        <h2 id="{{ heading_id }}" class="custom-customer-reviews__title heading-size-11">
          {{ section.settings.title }}
        </h2>
      {% endif %}

      {% if section.settings.subtitle != blank %}
        <p class="custom-customer-reviews__subtitle">
          {{ section.settings.subtitle }}
        </p>
      {% endif %}
    </div>
  </div>

  {%- comment -%} Slider deliberately outside page-width: it runs edge-to-edge with the fade overlays at the page ends {%- endcomment -%}
  <div class="custom-customer-reviews__inner">

      <div class="swiper custom-customer-reviews__swiper">
        <div class="swiper-wrapper">

          {% for block in section.blocks %}
            <article class="swiper-slide custom-customer-reviews__slide" {{ block.shopify_attributes }}>

              {%- liquid
                assign star_rating = block.settings.star_rating | default: 5 | times: 1.0 | at_most: 5.0 | at_least: 0.0
                assign star_percent = star_rating | divided_by: 5.0 | times: 100.0 | round: 1
              -%}
              {% if star_rating > 0 %}
                <div class="custom-customer-reviews__stars">
                  <span class="custom-customer-reviews__stars-img">
                    <svg xmlns="http://www.w3.org/2000/svg" width="190" height="36" viewBox="0 0 190 36" fill="#DDD6CF" aria-hidden="true" focusable="false">
                      <defs>
                        <path id="ReviewStar-{{ section.id }}-{{ block.id }}" d="M 0 -18 L 4.04 -5.56 L 17.12 -5.56 L 6.53 2.12 L 10.58 14.56 L 0 6.88 L -10.58 14.56 L -6.53 2.12 L -17.12 -5.56 L -4.04 -5.56 Z"/>
                      </defs>
                      <use href="#ReviewStar-{{ section.id }}-{{ block.id }}" transform="translate(19 19.7)"/>
                      <use href="#ReviewStar-{{ section.id }}-{{ block.id }}" transform="translate(57 19.7)"/>
                      <use href="#ReviewStar-{{ section.id }}-{{ block.id }}" transform="translate(95 19.7)"/>
                      <use href="#ReviewStar-{{ section.id }}-{{ block.id }}" transform="translate(133 19.7)"/>
                      <use href="#ReviewStar-{{ section.id }}-{{ block.id }}" transform="translate(171 19.7)"/>
                    </svg>
                    <span class="custom-customer-reviews__stars-fill" style="width: {{ star_percent }}%">
                      <svg xmlns="http://www.w3.org/2000/svg" width="190" height="36" viewBox="0 0 190 36" fill="#FB6D00" aria-hidden="true" focusable="false">
                        <use href="#ReviewStar-{{ section.id }}-{{ block.id }}" transform="translate(19 19.7)"/>
                        <use href="#ReviewStar-{{ section.id }}-{{ block.id }}" transform="translate(57 19.7)"/>
                        <use href="#ReviewStar-{{ section.id }}-{{ block.id }}" transform="translate(95 19.7)"/>
                        <use href="#ReviewStar-{{ section.id }}-{{ block.id }}" transform="translate(133 19.7)"/>
                        <use href="#ReviewStar-{{ section.id }}-{{ block.id }}" transform="translate(171 19.7)"/>
                      </svg>
                    </span>
                  </span>
                  <span class="custom-customer-reviews__sr-only">Rated {{ star_rating }} out of 5 stars</span>
                </div>
              {% endif %}

              {% if block.settings.show_quote_icon %}
                <div class="custom-customer-reviews__quote-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 196 192" aria-hidden="true" focusable="false"><path fill="#2A2724" d="M 58.8 12 C 58 13.2, 56.4 14, 54.8 14 C 53.1 14, 51.5 14.8, 50.8 16 C 50.1 17.1, 48.4 18, 47 18 C 45.3 18, 42.8 19.8, 38.7 24 C 35.2 27.6, 32.1 30, 30.8 30 C 28 30, 22 35.9, 22 38.7 C 22 40.1, 19.8 43.1, 16 46.7 C 11.8 50.8, 10 53.3, 10 55 C 10 56.4, 9.1 58.1, 8 58.8 C 6.3 59.8, 6 61.1, 6 66.8 C 6 72.4, 5.7 73.7, 4 74.8 C 2.2 75.9, 2 77.1, 2 87 C 2 93.7, 1.6 98, 1 98 C -1.4 98, -0.2 173.7, 2.2 176.5 C 4.4 179, 4.4 179, 38.3 179 C 83.1 179, 79 182.9, 79 140.6 C 79 100.3, 79.9 102, 58.3 102 C 44.4 102, 44 101.9, 41.5 99.5 C 38.1 96, 37.7 84.3, 41 82.2 C 42.5 81.3, 43 79.9, 43 76.2 C 43 72.6, 43.5 71.2, 45 70.2 C 46.1 69.5, 47 67.9, 47 66.6 C 47 63.2, 63.2 47, 66.6 47 C 67.9 47, 69.5 46.1, 70.2 45 C 71 43.8, 72.6 43, 74 43 C 79.3 43, 81.7 29.7, 77 26.8 C 75.8 26, 75 24.4, 75 22.8 C 75 21.1, 74.2 19.5, 73 18.8 C 71.8 18, 71 16.4, 71 15 C 71 9.8, 61.6 7.5, 58.8 12 M 170.8 12 C 170 13.2, 168.4 14, 166.8 14 C 165.1 14, 163.5 14.8, 162.8 16 C 162 17.2, 160.4 18, 158.8 18 C 157.1 18, 155.5 18.8, 154.8 20 C 154.1 21.1, 152.4 22, 151.1 22 C 147.7 22, 122 47.7, 122 51.1 C 122 52.4, 121.1 54.1, 120 54.8 C 118.5 55.7, 118 57.1, 118 60.8 C 118 64.4, 117.5 65.8, 116 66.8 C 114.5 67.7, 114 69.1, 114 72.8 C 114 76.4, 113.5 77.8, 112 78.8 C 109.6 80.3, 108.8 175.4, 111.2 177.8 C 112.1 178.7, 121.3 179, 146.3 179 C 191.3 179, 187 183.3, 187 138.5 C 187 97.7, 189.2 102, 168.3 102 C 152.3 102, 152.1 102, 149.5 99.5 C 146.4 96.4, 146.2 92, 149 90.2 C 150.7 89.2, 151 87.9, 151 82.2 C 151 76.6, 151.3 75.3, 153 74.2 C 154.2 73.5, 155 71.9, 155 70.2 C 155 68.6, 155.8 67, 157 66.2 C 158.1 65.5, 159 63.9, 159 62.6 C 159 59.5, 167.3 51, 170.4 51 C 171.7 51, 174.1 49.4, 176.3 47 C 178.4 44.7, 180.9 43, 182.1 43 C 187.8 43, 193.2 33.4, 189 30.8 C 187.8 30, 187 28.4, 187 26.8 C 187 25.1, 186.2 23.5, 185 22.8 C 183.9 22.1, 183 20.4, 183 19.1 C 183 13.3, 173.4 7.7, 170.8 12"/></svg>
                </div>
              {% endif %}

              {% if block.settings.title != blank %}
                <h3 class="custom-customer-reviews__review-title heading-size-7">
                  {{ block.settings.title }}
                </h3>
              {% endif %}

              {% if block.settings.description != blank %}
                <blockquote class="custom-customer-reviews__review-text" id="CustomerReviews-{{ section.id }}-quote-{{ block.id }}">
                  {{ block.settings.description }}
                </blockquote>
                <button type="button" class="custom-customer-reviews__toggle" aria-expanded="false" aria-controls="CustomerReviews-{{ section.id }}-quote-{{ block.id }}" hidden>Show more</button>
              {% endif %}

              {% if block.settings.author != blank or block.settings.buyer_icon != blank %}
                <div class="custom-customer-reviews__author">
                  {% if block.settings.author != blank %}
                    <cite class="custom-customer-reviews__author-name">
                      {{ block.settings.author }}
                    </cite>
                  {% endif %}

                  {% if block.settings.buyer_icon != blank %}
                    <span class="custom-customer-reviews__buyer">
                      <img src="{{ block.settings.buyer_icon | img_url: '220x' }}" alt="Verified buyer" loading="lazy">
                    </span>
                  {% endif %}
                </div>
              {% endif %}

              {% if block.settings.product != blank %}
                {% assign product = all_products[block.settings.product] %}
                <div class="custom-customer-reviews__product">
                  <a href="{{ product.url }}" class="custom-customer-reviews__product-link">

                    <div class="custom-customer-reviews__product-img">
                      {% if product.featured_image != blank %}
                        <img src="{{ product.featured_image | img_url: '200x' }}" alt="" loading="lazy">
                      {% endif %}
                    </div>

                    <div class="custom-customer-reviews__product-mid">
                      <div class="custom-customer-reviews__product-title">
                        {{ product.title }}
                      </div>
                      <div class="custom-customer-reviews__product-price">
                        {{ product.price | money }}
                      </div>
                    </div>

                    {% if block.settings.show_cart_icon %}
                      <div class="custom-customer-reviews__product-cart">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 80 80" fill="none" aria-hidden="true" focusable="false"><circle cx="40" cy="40" r="40" fill="#D34270"/><path d="M21 25 H26.5 L32.5 48.5 H53.5 L57.5 31 H28" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/><circle cx="35.5" cy="55.5" r="2.3" fill="#fff"/><circle cx="51" cy="55.5" r="2.3" fill="#fff"/></svg>
                      </div>
                    {% endif %}

                  </a>
                </div>
              {% endif %}

            </article>
          {% endfor %}

        </div>

        <button type="button" class="custom-customer-reviews__nav custom-customer-reviews__prev" aria-label="Previous reviews">
          <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
            <rect width="48" height="48" rx="24" fill="#45413B"></rect>
            <path d="M28.8 30.8872C28.8 30.8294 28.7855 30.7618 28.7566 30.6847C28.7277 30.6075 28.6939 30.5496 28.6554 30.511L22.1493 24.0001L28.6554 17.518C28.6939 17.4601 28.7277 17.3974 28.7566 17.3299C28.7855 17.2624 28.8 17.1997 28.8 17.1418C28.8 17.0647 28.7855 16.9923 28.7566 16.9248C28.7277 16.8573 28.6939 16.7946 28.6554 16.7367L27.8168 15.9264C27.759 15.8686 27.6963 15.8252 27.6289 15.7962C27.5614 15.7673 27.4987 15.7528 27.4409 15.7528C27.3638 15.7528 27.2915 15.7673 27.224 15.7962C27.1566 15.8252 27.1036 15.8686 27.065 15.9264L19.3445 23.6239C19.306 23.6817 19.2722 23.7444 19.2433 23.812C19.2144 23.8795 19.2 23.9422 19.2 24.0001C19.2 24.0772 19.2144 24.1496 19.2433 24.2171C19.2722 24.2846 19.306 24.3377 19.3445 24.3762L27.065 32.1026C27.1036 32.1412 27.1566 32.175 27.224 32.2039C27.2915 32.2328 27.3638 32.2473 27.4409 32.2473C27.4987 32.2473 27.5614 32.2328 27.6289 32.2039C27.6963 32.175 27.759 32.1412 27.8168 32.1026L28.6554 31.2634C28.6939 31.2248 28.7277 31.1718 28.7566 31.1043C28.7855 31.0367 28.8 30.9644 28.8 30.8872Z" fill="white"></path>
          </svg>
        </button>
        <button type="button" class="custom-customer-reviews__nav custom-customer-reviews__next" aria-label="Next reviews">
          <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
            <rect width="48" height="48" rx="24" fill="#45413B"></rect>
            <path d="M19.2 17.1129C19.2 17.1708 19.2145 17.2383 19.2434 17.3155C19.2723 17.3926 19.3061 17.4505 19.3446 17.4891L25.8507 24.0001L19.3446 30.4821C19.3061 30.54 19.2723 30.6027 19.2434 30.6702C19.2145 30.7377 19.2 30.8004 19.2 30.8583C19.2 30.9355 19.2145 31.0078 19.2434 31.0753C19.2723 31.1429 19.3061 31.2056 19.3446 31.2634L20.1832 32.0737C20.241 32.1316 20.3037 32.175 20.3711 32.2039C20.4386 32.2328 20.5013 32.2473 20.5591 32.2473C20.6362 32.2473 20.7085 32.2328 20.776 32.2039C20.8434 32.175 20.8964 32.1316 20.935 32.0737L28.6555 24.3763C28.694 24.3184 28.7278 24.2557 28.7567 24.1882C28.7856 24.1206 28.8 24.0579 28.8 24.0001C28.8 23.9229 28.7856 23.8506 28.7567 23.783C28.7278 23.7155 28.694 23.6625 28.6555 23.6239L20.935 15.8975C20.8964 15.8589 20.8434 15.8252 20.776 15.7962C20.7085 15.7673 20.6362 15.7528 20.5591 15.7528C20.5013 15.7528 20.4386 15.7673 20.3711 15.7962C20.3037 15.8252 20.241 15.8589 20.1832 15.8975L19.3446 16.7367C19.3061 16.7753 19.2723 16.8283 19.2434 16.8959C19.2145 16.9634 19.2 17.0357 19.2 17.1129Z" fill="white"></path>
          </svg>
        </button>

        <div class="custom-customer-reviews__pagination"></div>
      </div>

  </div>
</section>


<script>
document.addEventListener("DOMContentLoaded", function () {
  // Lazy init: build the Swiper only when the section approaches the viewport,
  // keeping its layout work out of the page-load critical path.
  function initReviewsSwipers() {
    document.querySelectorAll("#CustomerReviews-{{ section.id }} .custom-customer-reviews__swiper").forEach(function (el) {
      if (el.swiper) return;
      new Swiper(el, {
      slidesPerView: 1,
      spaceBetween: 20,
      centeredSlides: false,
      loop: true,
      speed: {{ section.settings.scroll_speed }},
      {% if section.settings.autoplay %}autoplay: {
        delay: {{ section.settings.autoplay_delay | times: 1000 }},
        disableOnInteraction: false
      },{% endif %}
      navigation: {
        nextEl: el.querySelector(".custom-customer-reviews__next"),
        prevEl: el.querySelector(".custom-customer-reviews__prev")
      },
      pagination: {
        el: el.querySelector(".custom-customer-reviews__pagination"),
        clickable: true,
        bulletElement: "button"
      },
      breakpoints: {
        0: {
          slidesPerView: 1
        },
        768: {
          slidesPerView: 2
        },
        1024: {
          slidesPerView: 3
        },
        1200: {
          slidesPerView: 4
        },
        1441: {
          slidesPerView: {{ section.settings.slides_per_view }}
        }
      }
      });
    });
  }

  var lazyRoot = document.getElementById("CustomerReviews-{{ section.id }}");
  if (lazyRoot && 'IntersectionObserver' in window) {
    var lazyIo = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          lazyIo.disconnect();
          initReviewsSwipers();
        }
      });
    }, { rootMargin: '600px 0px' });
    lazyIo.observe(lazyRoot);
  } else {
    initReviewsSwipers();
  }

  var reviewsRoot = document.getElementById("CustomerReviews-{{ section.id }}");
  if (reviewsRoot) {
    // Reveal the "Show more" toggle only where the clamped review overflows
    // (runs after layout so it also covers Swiper's loop clones).
    requestAnimationFrame(function () {
      reviewsRoot.querySelectorAll(".custom-customer-reviews__review-text").forEach(function (q) {
        var btn = q.nextElementSibling;
        if (!btn || !btn.classList.contains("custom-customer-reviews__toggle")) return;
        if (q.scrollHeight - q.clientHeight > 1) btn.hidden = false;
      });
    });

    // Expand / collapse via delegation (works for cloned slides too).
    reviewsRoot.addEventListener("click", function (e) {
      var btn = e.target.closest(".custom-customer-reviews__toggle");
      if (!btn || !reviewsRoot.contains(btn)) return;
      var q = btn.previousElementSibling;
      if (!q) return;
      var expanded = q.classList.toggle("is-expanded");
      btn.setAttribute("aria-expanded", expanded ? "true" : "false");
      btn.textContent = expanded ? "Show less" : "Show more";
    });
  }
});
</script>

<script>
  (function () {
    var root = document.getElementById('CustomerReviews-{{ section.id }}');
    if (!root) return;
    if (!('IntersectionObserver' in window)) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (window.theme && window.theme.settings && window.theme.settings.enableAnimations === false) return;

    var targets = root.querySelectorAll('.custom-customer-reviews__title, .custom-customer-reviews__subtitle, .custom-customer-reviews__swiper');
    if (!targets.length) return;

    targets.forEach(function (el, i) {
      el.style.transitionDelay = (i * 0.12) + 's';
    });

    root.classList.add('anim-ready');

    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          root.classList.add('is-inview');
          observer.disconnect();
        }
      });
    }, { threshold: 0.15 });

    observer.observe(root);
  })();
</script>

{% schema %}
{
  "name": "[Custom] Customer Reviews",
    "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background",
      "default": "#F7F2ED"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "What Our Customers Say"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Section Subtitle",
      "default": "Real reviews from happy customers."
    },
    {
      "type": "range",
      "id": "review_lines",
      "label": "Max review lines",
      "info": "Longer reviews are truncated to this many lines with a Show more link.",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Carousel"
    },
    {
      "type": "range",
      "id": "slides_per_view",
      "label": "Reviews shown (desktop)",
      "info": "How many reviews are visible before the arrows. Tablet shows 2, mobile shows 1.",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "label": "Scroll speed",
      "min": 100,
      "max": 3000,
      "step": 100,
      "unit": "ms",
      "default": 600
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto scroll",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_delay",
      "label": "Auto scroll timer",
      "info": "Seconds each review stays before advancing (when Auto scroll is on).",
      "min": 1,
      "max": 15,
      "step": 1,
      "unit": "s",
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Customer Review",
      "settings": [
        {
  "type": "product",
  "id": "product",
  "label": "Select Product"
},
        {
          "type": "range",
          "id": "star_rating",
          "label": "Star rating",
          "info": "Controls how much of the stars are filled. 0 hides the stars.",
          "min": 0,
          "max": 5,
          "step": 0.1,
          "default": 5
        },
        {
          "type": "checkbox",
          "id": "show_quote_icon",
          "label": "Show quote icon",
          "default": true
        },
        {
          "type": "text",
          "id": "title",
          "label": "Review Title",
          "default": "Great product"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Review Text"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author Name",
          "default": "Customer Name"
        },
        {
          "type": "image_picker",
          "id": "buyer_icon",
          "label": "Verified Buyer Icon"
        },
        {
          "type": "checkbox",
          "id": "show_cart_icon",
          "label": "Show cart button icon",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "[Custom] Customer Reviews"
    }
  ]
}
{% endschema %}
