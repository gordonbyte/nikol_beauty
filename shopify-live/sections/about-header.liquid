<div class="about-header site-about-header-wrapper">
  <style>
    .about-header {
      background-image: url({{ 'about-header-bg.png' | asset_url }})
    }

    @media (max-width: 786px) {
      .about-header {
        background-image: url({{ 'about-header-bg-mobile.png' | asset_url }})
      }    
    }
  </style>
  <div class="about-header__inner">
    <div class="about-header__left">
      <figure class="about-header__image">  
        <img
          src="{{ section.settings.image | image_url }}"
          alt="{{ section.settings.image.alt | default: section.settings.title | default: shop.name | strip_html | escape }}"
          loading="eager"
          />
        </figure>
    </div>
    <div class="about-header__right">
      <h1 class="about-header__title mobile-only">
        {{ section.settings.title }}
      </h1>

    	<div class="about-header__copy">
        {{ section.settings.copy }} 
      </div>

      <h1 class="about-header__title desktop-only">
        {{ section.settings.title }}
      </h1>
    </div>
  </div>
</div>


<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Nikol Johnson",
  "jobTitle": "Licensed Esthetician",
  "description": "Licensed Esthetician with 16+ years of experience, founder of Nikol Beauty. YouTube creator with 1.1M subscribers and 233M+ views specializing in professional beauty tutorials.",
  "url": "https://nikolbeauty.com/pages/about",
  "image": "https://nikolbeauty.com/cdn/shop/files/Nikol_logo.png?v=1712979254&width=115",
  "sameAs": [
    "https://www.youtube.com/@NikolJohnson",
    "https://www.instagram.com/nikoljohnson",
    "https://www.tiktok.com/@nikoljohnson",
    "https://www.facebook.com/nikolbeauty",
    "https://www.pinterest.com/nikolbeauty"
  ],
  "worksFor": {
    "@type": "Organization",
    "name": "Nikol Beauty",
    "url": "https://nikolbeauty.com"
  },
  "knowsAbout": [
    "Skincare",
    "Mascara",
    "Professional Makeup Application",
    "Anti-Aging Skincare",
    "Beauty Tutorials",
    "Licensed Esthetics"
  ]
}
</script>

{% schema %}
{
  "name": "About Header",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "richtext",
      "id": "copy",
      "label": "Copy",
      "default": "<p>Lorem ipsum</p>"
    }
  ],
  "presets": [{
    "name": "About Header",
    "category": "Image"
  }]
}
{% endschema %}
