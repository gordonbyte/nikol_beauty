{%- comment -%}
  CW Best Sellers (Automatic)

  A store-wide best sellers section. It does NOT use a manually attached
  collection. Instead it asks Shopify for the built-in "all" collection sorted
  by best-selling and renders the top products in best-selling order.

  How it works:
    - On load, the section's JavaScript fetches
        /collections/all?sort_by=best-selling&view=cw-best-sellers
      The alternate template `templates/collection.cw-best-sellers.liquid`
      returns only bare product cards (best-selling order), which are injected
      into the grid below.
    - Best-selling order is recalculated by Shopify automatically, so this
      section keeps itself up to date with no manual maintenance.

  Why JavaScript is required:
    Liquid has no filter to sort an arbitrary product list by best-selling.
    Best-selling order only exists on a collection page requested with
    ?sort_by=best-selling, so we fetch it at runtime.
{%- endcomment -%}

{%- assign products_limit = section.settings.products_limit | default: 8 -%}

{%- style -%}
  #cw-best-sellers-{{ section.id }} {
    --cw-bs-columns: {{ section.settings.columns_desktop }};
    --cw-bs-columns-mobile: {{ section.settings.columns_mobile }};
    background: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  #cw-best-sellers-{{ section.id }} .cw-bs__inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  #cw-best-sellers-{{ section.id }} .cw-bs__header {
    text-align: center;
    margin-bottom: 50px;
  }

  #cw-best-sellers-{{ section.id }} .cw-bs__title {
    font-size: 56px;
    line-height: 110%;
    letter-spacing: -3px;
    font-weight: 500;
    text-transform: uppercase;
    margin: 0;
  }

  #cw-best-sellers-{{ section.id }} .cw-bs__subtitle {
    font-size: 20px;
    padding-top: 20px;
    margin: 0;
  }

  #cw-best-sellers-{{ section.id }} .cw-bs__grid {
    display: grid;
    grid-template-columns: repeat(var(--cw-bs-columns), 1fr);
    gap: 30px;
  }

  #cw-best-sellers-{{ section.id }} .cw-bs__card {
    display: flex;
    flex-direction: column;
  }

  #cw-best-sellers-{{ section.id }} .cw-bs__media {
    display: block;
    overflow: hidden;
  }

  #cw-best-sellers-{{ section.id }} .cw-bs__image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  #cw-best-sellers-{{ section.id }} .cw-bs__title {
    font-size: 26px;
    line-height: 120%;
    font-weight: 500;
    text-decoration: none;
    padding-top: 10px;
    padding-bottom: 8px;
  }

  #cw-best-sellers-{{ section.id }} .cw-bs__price {
    font-weight: 400;
    font-size: 18px;
  }

  #cw-best-sellers-{{ section.id }} .cw-bs__price-sale {
    color: #c0392b;
    margin-right: 8px;
  }

  #cw-best-sellers-{{ section.id }} .cw-bs__price-was {
    opacity: 0.6;
  }

  /* Skeleton placeholders shown while best sellers load */
  #cw-best-sellers-{{ section.id }} .cw-bs__card--skeleton .cw-bs__skeleton {
    background: #ece5dc;
    border-radius: 4px;
  }

  #cw-best-sellers-{{ section.id }} .cw-bs__card--skeleton .cw-bs__skeleton--image {
    width: 100%;
    aspect-ratio: 1 / 1;
  }

  #cw-best-sellers-{{ section.id }} .cw-bs__card--skeleton .cw-bs__skeleton--line {
    height: 18px;
    margin-top: 14px;
  }

  #cw-best-sellers-{{ section.id }} .cw-bs__card--skeleton .cw-bs__skeleton--line.short {
    width: 40%;
  }

  #cw-best-sellers-{{ section.id }} .cw-bs__empty {
    grid-column: 1 / -1;
    text-align: center;
  }

  #cw-best-sellers-{{ section.id }} .cw-bs__btn-wrap {
    text-align: center;
    padding-top: 50px;
  }

  #cw-best-sellers-{{ section.id }} .cw-bs__btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #45413B;
    color: #fff;
    text-decoration: none;
    padding: 16px 32px;
    border-radius: 40px;
  }

  @media only screen and (max-width: 749px) {
    #cw-best-sellers-{{ section.id }} {
      padding: 40px 0;
    }

    #cw-best-sellers-{{ section.id }} .cw-bs__title {
      font-size: 34px;
    }

    #cw-best-sellers-{{ section.id }} .cw-bs__subtitle {
      font-size: 16px;
      line-height: 135%;
      padding-top: 15px;
    }

    #cw-best-sellers-{{ section.id }} .cw-bs__header {
      margin-bottom: 30px;
    }

    #cw-best-sellers-{{ section.id }} .cw-bs__grid {
      grid-template-columns: repeat(var(--cw-bs-columns-mobile), 1fr);
      gap: 16px;
    }

    #cw-best-sellers-{{ section.id }} .cw-bs__title {
      font-size: 22px;
    }

    #cw-best-sellers-{{ section.id }} .cw-bs__price {
      font-size: 16px;
    }
  }
{%- endstyle -%}

<section
  id="cw-best-sellers-{{ section.id }}"
  class="cw-best-sellers-section"
  data-bs-limit="{{ products_limit }}">
  <div class="cw-bs__inner">
    <div class="cw-bs__header">
      {%- if section.settings.title != blank -%}
        <h2 class="cw-bs__title">{{ section.settings.title }}</h2>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <p class="cw-bs__subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>

    <div class="cw-bs__grid" data-bs-grid>
      {%- comment -%} Skeleton placeholders shown until best sellers are fetched {%- endcomment -%}
      {%- for i in (1..products_limit) -%}
        <div class="cw-bs__card cw-bs__card--skeleton">
          <div class="cw-bs__skeleton cw-bs__skeleton--image"></div>
          <div class="cw-bs__skeleton cw-bs__skeleton--line"></div>
          <div class="cw-bs__skeleton cw-bs__skeleton--line short"></div>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <div class="cw-bs__btn-wrap">
        <a class="cw-bs__btn" href="{{ section.settings.button_link }}">
          {{ section.settings.button_label }}
          <svg width="22" height="13" viewBox="0 0 22 13" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0.843262 5.36644C0.377534 5.36644 -1.22974e-05 5.74399 -1.23382e-05 6.20972C-1.23789e-05 6.67544 0.377534 7.05299 0.843262 7.05299L0.843262 6.20972L0.843262 5.36644ZM21.4395 6.806C21.7689 6.47668 21.7689 5.94275 21.4395 5.61343L16.073 0.24687C15.7437 -0.0824491 15.2097 -0.0824491 14.8804 0.24687C14.5511 0.576189 14.5511 1.11012 14.8804 1.43944L19.6507 6.20972L14.8804 10.98C14.5511 11.3093 14.5511 11.8432 14.8804 12.1726C15.2097 12.5019 15.7437 12.5019 16.073 12.1726L21.4395 6.806ZM0.843262 6.20972L0.843262 7.05299L20.8433 7.05299L20.8433 6.20972L20.8433 5.36644L0.843262 5.36644L0.843262 6.20972Z" fill="white"></path>
          </svg>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var SECTION_ID = {{ section.id | json }};

    function initBestSellers(scope) {
      var section = (scope && scope.id === 'cw-best-sellers-' + SECTION_ID)
        ? scope
        : document.getElementById('cw-best-sellers-' + SECTION_ID);
      if (!section) { return; }

      var grid = section.querySelector('[data-bs-grid]');
      if (!grid || grid.dataset.bsLoaded === 'true') { return; }
      grid.dataset.bsLoaded = 'true';

      var limit = parseInt(section.getAttribute('data-bs-limit'), 10) || 8;

      fetch('/collections/all?sort_by=best-selling&view=cw-best-sellers', {
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
      })
        .then(function (response) {
          if (!response.ok) { throw new Error('Network response was not ok'); }
          return response.text();
        })
        .then(function (html) {
          var doc = new DOMParser().parseFromString(html, 'text/html');
          var cards = doc.querySelectorAll('[data-bs-card]');

          grid.innerHTML = '';

          if (!cards.length) {
            grid.innerHTML = '<p class="cw-bs__empty">No best sellers to show yet.</p>';
            return;
          }

          for (var i = 0; i < cards.length && i < limit; i++) {
            grid.appendChild(document.importNode(cards[i], true));
          }
        })
        .catch(function () {
          // On failure, allow a future re-init (e.g. theme editor reload) to retry.
          grid.dataset.bsLoaded = '';
        });
    }

    if (document.readyState !== 'loading') {
      initBestSellers();
    } else {
      document.addEventListener('DOMContentLoaded', function () { initBestSellers(); });
    }

    // Re-run inside the theme editor when this section is reloaded.
    document.addEventListener('shopify:section:load', function (event) {
      if (event.detail && event.detail.sectionId === SECTION_ID) {
        initBestSellers(event.target.querySelector('#cw-best-sellers-' + SECTION_ID));
      }
    });
  })();
</script>

{% schema %}
{
  "name": "CW Best Sellers (Auto)",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Automatically shows your store's best-selling products in best-selling order. No collection needed — it updates itself as sales change."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "Best Sellers"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Section subtitle",
      "default": "Our most-loved makeup, ranked by what customers buy most."
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Number of products to show",
      "min": 4,
      "max": 24,
      "step": 1,
      "default": 8
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Products per row (desktop)",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Products per row (mobile)",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "View all best sellers"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Tip: link to /collections/all?sort_by=best-selling to show the full list."
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#F7F2ED"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "CW Best Sellers (Auto)"
    }
  ],
  "disabled_on": {
    "groups": ["header", "aside", "footer"]
  }
}
{% endschema %}
