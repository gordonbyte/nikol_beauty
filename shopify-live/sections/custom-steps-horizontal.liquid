{%- style -%}
  #StepsHorizontal-{{ section.id }} {
    background-image: url({% if section.settings.bg_image != blank %}{{ section.settings.bg_image | image_url: width: 3000 }}{% else %}https://cdn.shopify.com/s/files/1/0690/6347/5504/files/steps-bg.jpg?v=1770984877{% endif %});
  }
{%- endstyle -%}

<style>
.custom-steps-horizontal {
  padding: 80px 20px;
  text-align: center;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}

.custom-steps-horizontal__header h2 {
  margin: 0;
  color: var(--COLOR-TEXT);
  font-family: var(--FONT-STACK-HEADING);
  font-size: 56px;
  font-weight: 500;
  line-height: 110%;
  letter-spacing: -1px;
}

.custom-steps-horizontal__header p {
  margin: 0;
  padding-top: 10px;
  padding-bottom: 40px;
  color: var(--COLOR-TEXT);
  font-family: Inter;
  font-size: 20px;
  font-weight: 400;
  line-height: 140%;
}

.custom-steps-horizontal__container {
  display: flex;
  width: 100%;
}

.custom-steps-horizontal__card {
  position: relative;
  width: 33%;
  margin: 0 auto;
  padding-top: 20px;
}

.custom-steps-horizontal__image {
  width: 100%;
}

.custom-steps-horizontal__image img {
  width: 100%;
  max-width: 390px;
  object-fit: contain;
}

.custom-steps-horizontal__number {
  position: absolute;
  left: 50%;
  top: 285px;
  transform: translateX(-50%);
  width: 35px;
  height: 35px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #45413B;
  color: #fff;
  border: 2.23px solid #FCFAF8;
  font-family: 'Cormorant', sans-serif;
  font-size: 24px;
  font-weight: 600;
  line-height: 130%;
  padding-bottom: 7px;
  box-shadow: 0px 3.96px 29.71px 0px #34445E0D;
}

.custom-steps-horizontal__card:nth-child(3) .custom-steps-horizontal__number {
  padding-bottom: 13px;
}

.custom-steps-horizontal__card h3 {
  margin: 40px 0 12px;
  color: var(--COLOR-TEXT);
  font-family: 'Cormorant', sans-serif;
  font-size: 28px;
  line-height: 120%;
}

.custom-steps-horizontal__card p {
  padding: 0 10px;
  color: var(--COLOR-TEXT);
  font-family: Inter, sans-serif;
  font-size: var(--FONT-SIZE-BASE);
  font-weight: 400;
  line-height: 150%;
}

.custom-steps-horizontal__btn-wrap {
  margin-top: 40px;
}

.custom-steps-horizontal__btn-wrap a {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  max-width: 400px;
  height: 60px;
  margin: 0 auto;
  background: var(--BTN-PRIMARY-BG-COLOR);
  color: var(--BTN-PRIMARY-TEXT-COLOR);
  font-family: var(--BTN-FONT-STACK);
  font-size: var(--BTN-FONT-SIZE);
  font-weight: 700;
  line-height: 26px;
  letter-spacing: 0;
  text-decoration: none;
  cursor: pointer;
}

@media only screen and (max-width: 600px) {
  .custom-steps-horizontal {
    padding: 50px 0;
  }

  .custom-steps-horizontal__header h2 {
    font-size: 34px;
  }

  .custom-steps-horizontal__header p {
    padding-bottom: 20px;
    font-size: var(--FONT-SIZE-BASE);
  }

  .custom-steps-horizontal__container {
    flex-wrap: wrap;
  }

  .custom-steps-horizontal__card {
    width: 100%;
  }

  .custom-steps-horizontal__card h3 {
    font-size: 23px;
  }

  .custom-steps-horizontal__card p {
    font-size: var(--FONT-SIZE-BASE);
    line-height: 135%;
  }

  .custom-steps-horizontal__btn-wrap {
    margin-top: 20px;
  }

  .custom-steps-horizontal__btn-wrap a {
    height: 50px;
    font-size: var(--BTN-FONT-SIZE);
  }

  .custom-steps-horizontal__number {
    top: 250px;
  }
}
</style>

<section class="custom-steps-horizontal" id="StepsHorizontal-{{ section.id }}">
  <div class="page-width">

    <div class="custom-steps-horizontal__header">
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p>{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="custom-steps-horizontal__container">
      {%- for block in section.blocks -%}
        <div class="custom-steps-horizontal__card" {{ block.shopify_attributes }}>

          <div class="custom-steps-horizontal__image">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 780 | image_tag: widths: '300, 390, 600, 780', sizes: '390px', loading: 'lazy', alt: '' }}
            {%- endif -%}
          </div>

          <div class="custom-steps-horizontal__number">{{ forloop.index }}</div>

          {%- if block.settings.title != blank -%}
            <h3>{{ block.settings.title }}</h3>
          {%- endif -%}

          {%- if block.settings.description != blank -%}
            <p>{{ block.settings.description }}</p>
          {%- endif -%}

        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.button_text != blank and section.settings.button_link != blank -%}
      <div class="custom-steps-horizontal__btn-wrap">
        <a href="{{ section.settings.button_link }}">
          {{ section.settings.button_text }}
        </a>
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "[Custom] Steps Horizontal",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image",
      "info": "Falls back to the default steps background if left blank."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "How It Works In 3 Simple Steps"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Sub Heading",
      "default": "Three simple steps to get started."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop Now →"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Step Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Step Title",
          "default": "Step title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Step Description",
          "default": "Step description here"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "[Custom] Steps Horizontal",
      "blocks": [
        { "type": "step" },
        { "type": "step" },
        { "type": "step" }
      ]
    }
  ]
}
{% endschema %}
