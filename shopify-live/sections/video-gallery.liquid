/* Show More Button - Temporarily Hidden */

.video-gallery-show-more-container {
  text-align: center;
  margin-top: 60px;
  margin-bottom: 20px;
  padding: 40px 0;
  display: none;
}

.video-gallery-show-more-btn {
  background: #FCD0CD;
  color: #46413C;
  border: none;
  padding: 12px 30px;
  border-radius: 0;
  font-size: 16px;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.3s ease;
}

.video-gallery-show-more-btn:hover {
  background: #f8bbd9;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {

  // Show More functionality for both tabs
  function loadMoreVideos(tabType) {
    let videosArray, totalCount, currentDisplayed, gridId, buttonId;
    
    if (tabType === 'tutorials') {
      videosArray = window.tutorialsVideos;
      totalCount = window.tutorialsTotalCount;
      currentDisplayed = window.tutorialsDisplayedCount;
      gridId = 'makeup-tutorials-videos-grid';
      buttonId = 'tutorials-show-more-btn';
    } else if (tabType === 'fierceaging') {
      videosArray = window.fierceagingVideos;
      totalCount = window.fierceagingTotalCount;
      currentDisplayed = window.fierceagingDisplayedCount;
      gridId = 'fierceaging-series-videos-grid';
      buttonId = 'fierceaging-show-more-btn';
    }
    
    const grid = document.getElementById(gridId);
    const button = document.getElementById(buttonId);
    
    if (!grid || !button || !videosArray) return;
    
    // Calculate how many videos to load (6 at a time)
    const videosToLoad = Math.min(6, videosArray.length);
    const startIndex = currentDisplayed - 6; // Videos already displayed
    
    // Load videos
    for (let i = 0; i < videosToLoad; i++) {
      const videoData = videosArray[startIndex + i];
      if (videoData) {
        const videoCard = createVideoCard(videoData);
        grid.appendChild(videoCard);
      }
    }
    
    // Update counters
    if (tabType === 'tutorials') {
      window.tutorialsDisplayedCount += videosToLoad;
    } else if (tabType === 'fierceaging') {
      window.fierceagingDisplayedCount += videosToLoad;
    }
    
    // Remove videos from array
    videosArray.splice(0, videosToLoad);
    
    // Hide button if no more videos
    if (videosArray.length === 0) {
      button.style.display = 'none';
    }
  }
  
  function createVideoCard(videoData) {
    const link = document.createElement('a');
    link.href = videoData.linkUrl;
    link.className = 'video-gallery-video-card';
    link.setAttribute('data-video-url', videoData.videoUrl);
    if (videoData.useYouTubeLinks) {
      link.setAttribute('target', '_blank');
    }
    
    link.innerHTML = `
      <div class="video-gallery-video-thumbnail">
        <img src="${videoData.thumbnailUrl}" alt="${videoData.title}" loading="lazy">
        <div class="video-gallery-video-overlay">
          <svg class="video-gallery-play-icon" width="48" height="48" viewBox="0 0 24 24" fill="white">
            <path d="M8 5v14l11-7z"/>
          </svg>
        </div>
      </div>
      <div class="video-gallery-video-info">
        <h3 class="video-gallery-video-title">${videoData.title}</h3>
      </div>
    `;
    
    return link;
  }
  
  // Add click handlers for Show More buttons for both tabs
  const showMoreButtons = document.querySelectorAll('.video-gallery-show-more-btn');
  showMoreButtons.forEach(button => {
    button.addEventListener('click', function() {
      const tabType = this.getAttribute('data-tab');
      loadMoreVideos(tabType);
    });
  });
  
  // Hide Show More buttons if no videos to load
  if (window.tutorialsVideos && window.tutorialsVideos.length === 0) {
    const tutorialsButton = document.getElementById('tutorials-show-more-btn');
    if (tutorialsButton) tutorialsButton.style.display = 'none';
  }
  
  if (window.fierceagingVideos && window.fierceagingVideos.length === 0) {
    const fierceagingButton = document.getElementById('fierceaging-show-more-btn');
    if (fierceagingButton) fierceagingButton.style.display = 'none';
  }
  

});
</script>






