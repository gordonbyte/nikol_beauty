}

.video-gallery-placeholder-image {
  margin-bottom: -6px;
}

.video-gallery-placeholder-image-bottom {
  margin-bottom: -7px;
}

/* Videos Grid Section */

.video-gallery-videos-grid-section {
  padding: 40px 0;
  background: #F7F2ED;
  width: 100%;
}

.video-gallery-videos-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  row-gap: 48px;
  column-gap: 30px;
  margin-top: 40px;
}

/* Video Cards */

.video-gallery-video-card {
  background: none;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: none;
  transition: none;
  cursor: pointer;
  text-decoration: none;
  display: block;
}

.video-gallery-video-card:hover {
  transform: none;
  box-shadow: none;
}

.video-gallery-video-thumbnail {
  position: relative;
  width: 100%;
  overflow: hidden;
  border-radius: 12px;
}

.video-gallery-video-thumbnail img {
  width: 100%;
  height: auto;
  display: block;
  vertical-align: middle;
}

.video-gallery-video-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 1;
  transition: opacity 0.3s ease;
}

.video-gallery-video-card:hover .video-gallery-video-overlay {
  opacity: 1;
}

.video-gallery-play-icon {
  width: 48px;
  height: 48px;
}

.video-gallery-video-info {
  padding: 15px 0;
}

.video-gallery-video-title {
  font-size: 19px;
  font-weight: 600;
  color: #333;
  margin-bottom: 8px;
  line-height: 1.4;
