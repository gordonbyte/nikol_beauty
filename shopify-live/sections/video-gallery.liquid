                         alt="{{ section.settings.hero_image.alt | default: 'Nikol Beauty Expert' | escape }}">
                  {%- else -%}
                    <img src="https://cdn.shopify.com/s/files/1/0690/6347/5504/files/ff0702c8a19189bf469459f0bc045d95ba3f13b6.png?v=1753989319"
                         alt="Nikol Beauty Expert">
                  {%- endif -%}
                </div>

            </div>
          </div>
        </div>
      </div>

      

      <!-- Videos Grid Section -->
      <div class="video-gallery-videos-grid-section">
        <div class="video-gallery-container">
          <div class="video-gallery-videos-grid" id="makeup-tutorials-videos-grid">
            <!-- Video Grid Content -->
            
                        {% if videos %}
                {% comment %} Count total videos for tutorials category {% endcomment %}
                {% assign tutorials_count = 0 %}
                {% for video in videos.values %}
                  {% if video.category == 'tutorials' %}
                    {% assign tutorials_count = tutorials_count | plus: 1 %}
                  {% endif %}
                {% endfor %}

                {% comment %} Display all videos {% endcomment %}
                {% for video in videos.values %}
                  {% comment %} Filter videos by category "tutorials" {% endcomment %}
                  {% if video.category == 'tutorials' %}
                      {% comment %} Extract YouTube video ID from URL {% endcomment %}
                      {% assign video_url = video.video_url %}
                      {% assign youtube_id = '' %}
                      
                      {% comment %} Extract YouTube ID using a more reliable method {% endcomment %}
                      {% if video_url contains 'youtube.com/watch?v=' %}
                        {% assign url_parts = video_url | split: 'v=' %}
                        {% assign youtube_id = url_parts[1] | split: '&' | first %}
                      {% elsif video_url contains 'youtu.be/' %}
                        {% assign url_parts = video_url | split: 'youtu.be/' %}
                        {% assign youtube_id = url_parts[1] | split: '?' | first %}
                      {% endif %}
                      
                      {% comment %} Fallback extraction method {% endcomment %}
                      {% if youtube_id == blank %}
                        {% assign video_id_part = video_url | split: 'v=' | last %}
                        {% assign youtube_id = video_id_part | split: '&' | first %}
                      {% endif %}
                      
                      {% comment %} Create thumbnail URL: prefer metafield thumbnail, fallback to YouTube {% endcomment %}
                      {% assign thumbnail_url = 'https://img.youtube.com/vi/' | append: youtube_id | append: '/0.jpg' %}
                      {% if video.thumbnail != blank %}
                        {% assign custom_thumb = video.thumbnail | image_url %}
                        {% if custom_thumb != blank %}
                          {% assign thumbnail_url = custom_thumb %}
                        {% else %}
                          {% assign thumbnail_url = video.thumbnail %}
                        {% endif %}
                      {% endif %}
                      
                      {% comment %} Create the video page URL when "Publish entries as web pages" is active {% endcomment %}
                      {% assign video_page_url = '/pages/beauty-tutorial-videos/' | append: video.handle %}
                      
                      {% comment %} If handle is empty, create a fallback URL using the title {% endcomment %}
                      {% if video.handle == blank %}
                        {% assign fallback_handle = video.title | handleize %}
                        {% assign video_page_url = '/pages/beauty-tutorial-videos/' | append: fallback_handle %}
                      {% endif %}
                      
                      {% comment %} Choose between video page URL or YouTube URL based on settings {% endcomment %}
                      {% assign link_url = video_page_url %}
                      {% if section.settings.use_youtube_links %}
                        {% assign link_url = video.video_url %}
                      {% endif %}
                      
                      <a href="{{ link_url }}" class="video-gallery-video-card" data-video-url="{{ video.video_url }}" {% if section.settings.use_youtube_links %}target="_blank"{% endif %}>
                        <div class="video-gallery-video-thumbnail">
                          <img src="{{ thumbnail_url }}" alt="{{ video.title }}" loading="lazy">
                          <div class="video-gallery-video-overlay">
                            <svg class="video-gallery-play-icon" width="48" height="48" viewBox="0 0 24 24" fill="white">
                              <path d="M8 5v14l11-7z"/>
                            </svg>
                          </div>
                        </div>
                        <div class="video-gallery-video-info">
                          <h3 class="video-gallery-video-title">{{ video.title }}</h3>
                        </div>
                      </a>
                  {% endif %}
                {% endfor %}
                
                <script>
                  window.tutorialsVideos = [];
                  window.tutorialsTotalCount = {{ tutorials_count }};
                  window.tutorialsDisplayedCount = {{ tutorials_count }};
                </script>
            {% endif %}


          </div>
