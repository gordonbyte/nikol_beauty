  font-weight: 500;
  font-style: Medium;
  font-size: 29px;
  color: #333;
  margin-bottom: 25px;
  line-height: 100%;
  letter-spacing: 0%;
  display: inline-block;
  text-align: center;
  width: 100%;
}

.video-gallery-hero-description {
  font-weight: 300;
  font-style: Light;
  text-align: center;
  margin-bottom: 25px;
}

.video-gallery-hero-buttons {
  display: flex;
  gap: 20px;
  flex-wrap: wrap;
  justify-content: center;
  margin-top: 0;
}

.video-gallery-hero-image {
  text-align: center;
}

.video-gallery-hero-image img {
  max-width: 100%;
