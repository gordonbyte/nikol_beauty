    margin-bottom: 40px; /* Add space below buttons on mobile */
  }

  .video-gallery-videos-grid {
    grid-template-columns: 1fr;
    row-gap: 48px;
    column-gap: 30px;
  }

  .video-gallery-video-card {
    margin-bottom: 0;
  }

  .videos-desc {
    display: flex;
    max-width: 800px;
    flex-direction: column;
    align-items: center;
    margin: 0 auto;
    padding: 3rem;
    text-align: center; /* Center the text content */
  }

  .video-gallery-videos-grid-section {
    padding-top: 20px;
  }

  .videos-desc {
    padding-top: 1.5rem;
