}
.cs-addons__viewport {
  position: relative;
}
.cs-addons__list {
  display: grid;
  gap: var(--cs-addon-gap);
  margin: 0;
  padding: 0;
}
.cs-addon {
  position: relative;
  display: grid;
  grid-template-columns: 28px 108px minmax(0, 1fr);
  gap: 16px;
  align-items: center;
  padding: 16px 18px;
