  gap: 10px;
  font-family: Inter, sans-serif;
  font-size: 11px;
  line-height: 1;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--cs-pink);
}
.cs-addons__eyebrow:before {
  content: "";
  width: 22px;
  height: 2px;
  background: var(--cs-pink);
}
.cs-addons__title {
  font-family: Cormorant, serif;
  font-size: clamp(22px, 0.7vw + 17px, 27px);
  line-height: 1.15;
  font-weight: 600;
