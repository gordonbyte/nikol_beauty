  --cs-pink: #d34270;
  --cs-ink: #2A2724;
  --cs-muted: #6d655f;
  --cs-line: #ccc;
  --cs-blush: #faf6f3;
  --cs-blush-strong: #fbe9e7;
}
/* Included products (bundles) — bordered grid, heading breaks the top border */
.cs-included {
  position: relative;
  margin: 34px 0 0;
  padding: 30px 18px 20px;
  border: 2px solid var(--cs-inc-line, #000);
  border-radius: 14px;
}
.cs-included__title {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translate(-50%, -50%);
  margin: 0;
  padding: 0 12px;
  max-width: calc(100% - 36px);
  background: var(--bg, #fff);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 15px;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: .04em;
  text-transform: uppercase;
  color: var(--cs-ink, #2A2724);
}
.cs-included__grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 18px 12px;
  margin: 0;
  padding: 0;
  list-style: none;
}
.cs-included__item {
  flex: 0 0 auto;
  width: calc((100% - 36px) / 4);
  margin: 0;
  padding: 0;
  list-style: none;
}
.cs-included__link {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  padding: 6px 4px;
  border-radius: 10px;
  text-align: center;
  text-decoration: none;
  color: inherit;
  transition: transform .18s ease, background-color .18s ease;
}
.cs-included__link:hover,
.cs-included__link:focus-visible {
  transform: translateY(-2px);
  background: var(--cs-blush, #faf6f3);
  text-decoration: none;
}
.cs-included__media {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72px;
  max-width: 100%;
  aspect-ratio: 1 / 1;
  overflow: hidden;
  border-radius: 8px;
}
.cs-included__media img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
}
.cs-included__label {
  position: relative;
  display: block;
  width: 100%;
  perspective: 600px;
}
.cs-included__name,
.cs-included__price {
  font-size: 13px;
  line-height: 1.3;
  backface-visibility: hidden;
  transition: transform .32s ease, opacity .22s ease;
}
.cs-included__name {
  display: block;
  font-weight: 700;
  color: var(--cs-ink, #2A2724);
  transform: rotateX(0deg);
  opacity: 1;
}
.cs-included__price {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  color: var(--cs-ink, #2A2724);
  transform: rotateX(-90deg);
  opacity: 0;
}
.cs-included__link:hover .cs-included__name,
.cs-included__link:focus-visible .cs-included__name {
  transform: rotateX(90deg);
  opacity: 0;
}
.cs-included__link:hover .cs-included__price,
.cs-included__link:focus-visible .cs-included__price {
  transform: rotateX(0deg);
  opacity: 1;
}
@media (prefers-reduced-motion: reduce) {
  .cs-included__link { transition: none; }
  .cs-included__link:hover,
  .cs-included__link:focus-visible { transform: none; }
  .cs-included__name,
  .cs-included__price { transition: opacity .15s ease; transform: none !important; }
}
/* No hover available (phones, touch tablets): show the price permanently instead of flipping */
@media (hover: none), (max-width: 749px) {
  .cs-included__label { perspective: none; }
  .cs-included__name {
    transform: none !important;
    opacity: 1 !important;
  }
  .cs-included__price {
    position: static;
    inset: auto;
    display: block;
    margin-top: 2px;
    font-weight: 400;
    color: var(--cs-muted, #6d655f);
    transform: none !important;
    opacity: 1 !important;
  }
}
@media (max-width: 749px) {
  .cs-included { padding: 28px 14px 18px; }
  .cs-included__title { font-size: 14px; }
  .cs-included__media { width: 64px; }
  .cs-included__grid { gap: 16px 10px; }
  .cs-included__item { width: calc((100% - 10px) / 2); }
}
.cs-addons__head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12px;
  margin: 0 0 14px;
}
.cs-addons__heading {
  display: flex;
  flex-direction: column;
  gap: 4px;
  min-width: 0;
}
.cs-addons__eyebrow {
  display: inline-flex;
