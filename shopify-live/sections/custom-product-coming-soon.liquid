  box-shadow: none;
}
@media (hover: hover) {
  .cs-addon:not(.is-soldout):hover {
    box-shadow: none;
  }
}
@media only screen and (max-width: 600px) {
  .cs-addon__badge {
    right: 10px;
    font-size: 9px;
    padding: 3px 8px;
  }
}
.cs-addon.is-featured {
  border-color: #e0c39b;
  box-shadow: 0 8px 22px rgba(201, 168, 106, 0.2);
}
.cs-addon__badge {
  position: absolute;
  top: -9px;
  right: 14px;
  z-index: 2;
  padding: 3px 9px;
  border-radius: 999px;
  background: var(--cs-ink);
  color: #fff;
  font-family: Inter, sans-serif;
  font-size: 10px;
  line-height: 1.2;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  white-space: nowrap;
  box-shadow: 0 2px 6px rgba(42, 39, 36, 0.18);
  pointer-events: none;
}
.cs-addons__list {
  padding-top: 8px;
}
.cs-addon.is-selected,
.cs-addon.is-selected:hover {
  border-color: var(--cs-pink);
  box-shadow: inset 0 0 0 1px var(--cs-pink), 0 8px 22px rgba(211, 66, 112, 0.12);
  background: #fff8f7;
}
.cs-addon.is-soldout {
  opacity: 0.55;
  cursor: default;
}
.cs-addon__check {
  position: absolute;
  opacity: 0;
  width: 0;
  height: 0;
  margin: 0;
  pointer-events: none;
}
.cs-addon__circle {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  margin: 0;
  border-radius: 50%;
  border: 1.5px solid var(--cs-ink);
  background: #fff;
  color: #fff;
  cursor: pointer;
  transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
}
.cs-addon__plus {
  position: absolute;
  width: 12px;
  height: 12px;
  transition: opacity 0.15s ease, transform 0.2s ease;
}
.cs-addon__plus:before,
.cs-addon__plus:after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 12px;
  height: 1.5px;
  background: var(--cs-ink);
  transform: translate(-50%, -50%);
}
.cs-addon__plus:after {
  transform: translate(-50%, -50%) rotate(90deg);
}
.cs-addon__tick {
  position: absolute;
  width: 15px;
  height: 15px;
  opacity: 0;
  transform: scale(0.5);
  transition: opacity 0.15s ease, transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.cs-addon__check:checked ~ .cs-addon__circle {
  background: var(--cs-pink);
  border-color: var(--cs-pink);
}
.cs-addon__check:checked ~ .cs-addon__circle .cs-addon__plus {
  opacity: 0;
  transform: rotate(90deg) scale(0.5);
}
.cs-addon__check:checked ~ .cs-addon__circle .cs-addon__tick {
  opacity: 1;
  transform: scale(1);
}
.cs-addon__check:focus-visible ~ .cs-addon__circle {
  outline: 2px solid var(--cs-pink);
  outline-offset: 3px;
}
.cs-addon__check:disabled ~ .cs-addon__circle {
  cursor: default;
  border-style: dashed;
  border-color: #9a928c;
}
.cs-addon__check:disabled ~ .cs-addon__circle .cs-addon__plus:before,
.cs-addon__check:disabled ~ .cs-addon__circle .cs-addon__plus:after {
  background: #9a928c;
}
.cs-addon__media {
  width: 108px;
  aspect-ratio: 1 / 1;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: var(--cs-blush);
}
.cs-addon__media img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
  transition: transform 0.35s ease;
}
@media (hover: hover) {
