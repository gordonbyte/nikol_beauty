{%- comment -%} Review-card styles (self-contained; previously inherited from the alternating-rows section) {%- endcomment -%}
{%- comment -%} The theme loads the heading font (Cormorant) at 500/600 only; the review title uses true bold. {%- endcomment -%}
{%- assign cs_heading_font_700 = settings.type_heading_font | font_modify: 'weight', '700' -%}
<style>
{%- if cs_heading_font_700 -%}{{ cs_heading_font_700 | font_face: font_display: 'swap' }}{%- endif -%}
.mp-review-box {
    display: flex;
    flex-direction: column;
    margin-top: 20px;
    padding: 20px 30px;
    background: #f7f2ed;
}
/* Quiz call-out (under "Complete the look") */
.cs-addons {
