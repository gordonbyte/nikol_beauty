}
.cs-addon__hint {
  margin-left: auto;
  font-family: Inter, sans-serif;
  font-size: 12px;
  line-height: 1;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--cs-ink);
  padding: 0;
  border: 0;
