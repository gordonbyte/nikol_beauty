    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.3s ease;
}
.cw-bb-quiz__btn:hover,
.cw-bb-quiz__btn:focus-visible {
    background: var(--BTN-PRIMARY-BG-COLOR-BRIGHTER, #cc2f61);
    color: var(--BTN-PRIMARY-TEXT-COLOR, #fff);
    text-decoration: none;
}
@media only screen and (max-width: 600px) {
    .cw-bb-quiz {
        flex-direction: column;
        align-items: stretch;
        gap: 14px;
        padding: 18px 20px;
    }
    .cw-bb-quiz__btn {
        width: 100%;
    }
}
.cw-bb-installments {
    margin-top: -24px;
    text-align: center;
}
.cw-bb-installments .installment {
    margin: 0;
    text-align: center;
}
.cw-bb-installments shopify-payment-terms {
    display: block;
    text-align: center;
}
.mp-review-stars {
    display: inline-block;
    position: relative;
    line-height: 0;
}
.mp-review-stars-fill {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    overflow: hidden;
}
.mp-review-stars svg {
    width: 95px;
    height: auto;
}
.mp-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
}
.mp-review-text {
    font-size: var(--FONT-SIZE-BASE);
    line-height: 150%;
    font-weight: 400;
    color: #2A2724;
    font-family: 'Inter', sans-serif;
}
.mp-author-box {
    display: flex;
    align-items: center;
    gap: 5px;
}
.mp-author-name {
    font-size: 14px;
    line-height: 150%;
    font-weight: 400;
    color: #2A2724;
    font-family: 'Inter',sans-serif;
}
.mp-verified {
    display: flex;
    align-items: center;
    gap: 4px;
}
.mp-verified img {
    max-width: 14px;
    object-fit: contain;
}
.mp-verified-text {
    font-size: 14px;
    line-height: 150%;
    font-weight: 400;
    color: #2A2724;
    font-family: 'Inter', sans-serif;
}
.mp-review-title {
    display: block;
    font-family: 'Cormorant', sans-serif;
    font-weight: 700;
    line-height: 1.2;
    text-transform: uppercase;
    margin-bottom: 4px;
}
.mp-review-text p {
    margin: 0;
    font-style: italic;
}
.mp-review-nav {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 0;
}
.mp-review-nav[hidden] {
    display: none;
}
.mp-review-stars {
    margin-bottom: 10px;
}
.mp-review-stars-fill {
    transition: width 0.45s ease;
}
.mp-review-slide {
    display: flex;
    align-items: center;
    gap: 16px;
    transition: transform 0.45s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.45s cubic-bezier(0.4, 0, 0.2, 1);
}
.mp-review-main {
    flex: 1 1 auto;
    min-width: 0;
}
/* Square photo box, sized against the review box width (container units):
   scales down with the layout and stops at 170px. */
.mp-review-photo {
    display: none;
    position: relative;
    flex: 0 0 auto;
    width: clamp(104px, 47cqw - 37px, 170px);
    aspect-ratio: 1 / 1;
    border: 1px solid #ccc;
}
.mp-review-slide--has-photo .mp-review-photo {
    display: block;
}
@supports not (width: 1cqw) {
    .mp-review-photo { width: clamp(104px, 13vw, 170px); }
}
.mp-review-photo img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
}
/* Junip mode: the block stays hidden until qualifying reviews load; a product
   with no 4–5★ titled reviews (or no Junip) never shows the box. */
.product__block[data-junip-pending],
.product__block[data-junip-empty] {
    display: none !important;
}
@media only screen and (max-width: 600px) {
    .mp-review-slide {
        gap: 12px;
    }
}
.mp-review-slide.mp-slide-out-left { transform: translateX(-18px); opacity: 0; }
.mp-review-slide.mp-slide-out-right { transform: translateX(18px); opacity: 0; }
.mp-review-slide.mp-slide-in-right { transform: translateX(18px); opacity: 0; transition: none; }
.mp-review-slide.mp-slide-in-left { transform: translateX(-18px); opacity: 0; transition: none; }
@media (prefers-reduced-motion: reduce) {
    .mp-review-slide, .mp-review-stars-fill { transition: none; }
}
/* Junip mode: clamp bodies to 3 lines and reserve space (1 title line +
   3 body lines + author row) so every review renders the same height. */
.mp-review-box--junip .mp-review-text p {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
}
.mp-review-box--junip .mp-author-box {
    min-height: 21px;
    margin-top: 8px;
}
/* Fixed box size lives on the slide, not the text — the author row sits
   right under the body and the spare space falls below it. */
.mp-review-box--junip .mp-review-slide {
    min-height: 170px;
}
@media only screen and (max-width: 600px) {
    .mp-review-box--junip .mp-review-slide {
        min-height: 120px;
    }
}
.mp-review-box--junip {
    position: relative;
}
.mp-review-more {
    display: inline;
    margin-left: 2px;
    padding: 0;
    font-style: normal;
    vertical-align: baseline;
    border: 0;
    background: none;
    font-family: Inter, sans-serif;
    font-size: 12px;
    line-height: 1;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #d34270;
    cursor: pointer;
    white-space: nowrap;
}
.mp-review-more[hidden] {
    display: none;
}

.mp-review-more:hover,
.mp-review-more:focus-visible {
    text-decoration: underline;
    text-underline-offset: 3px;
    outline: none;
}
.mp-review-expand {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 20px 30px;
    background: #f7f2ed;
}
.mp-review-expand[hidden] {
    display: none;
}
.mp-review-expand__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    padding-right: 0;
}
.mp-review-expand__title {
    font-family: Cormorant, serif;
    font-size: clamp(15px, 2.8cqw + 6.6px, 20px);
    line-height: 1.2;
    font-weight: 700;
    text-transform: uppercase;
    color: #2A2724;
}
.mp-review-expand__close {
    flex: 0 0 auto;
    width: 28px;
    height: 28px;
    margin: -6px -8px 0 0;
    padding: 0;
    border: 0;
    background: none;
    color: #2A2724;
    font-size: 26px;
    line-height: 1;
    cursor: pointer;
}
.mp-review-expand__close:hover,
.mp-review-expand__close:focus-visible {
    color: #d34270;
    outline: none;
}
.mp-review-expand__body {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    padding-right: 10px;
    font-family: Inter, sans-serif;
    font-size: clamp(14px, 1.43cqw + 9.7px, 16px);
    line-height: 160%;
    font-style: italic;
    color: #2A2724;
    scrollbar-width: thin;
    scrollbar-color: #d34270 #eadfd8;
}
.mp-review-expand__body::-webkit-scrollbar {
    width: 6px;
}
.mp-review-expand__body::-webkit-scrollbar-thumb {
    background: #d34270;
    border-radius: 3px;
}
.mp-review-expand__body::-webkit-scrollbar-track {
    background: #eadfd8;
}
.mp-review-expand__body:focus-visible {
    outline: 2px solid #d34270;
    outline-offset: 2px;
}
.mp-review-expand__foot {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
}
.mp-review-expand__author {
    display: flex;
    align-items: center;
    gap: 5px;
    min-width: 0;
}
.mp-review-expand__nav {
    display: flex;
    align-items: center;
    gap: 8px;
}
.mp-review-expand .mp-review-more--less {
    margin-left: auto;
}
.mp-review-box.is-expanded .mp-review-viewall {
    visibility: hidden;
}
@media only screen and (max-width: 600px) {
    .mp-review-expand {
        padding: 16px 18px;
        gap: 8px;
    }
    .mp-review-expand__foot {
        gap: 8px 10px;
    }
}
.mp-review-viewall {
    position: absolute;
    top: 20px;
    right: 30px;
    background: none;
    border: none;
    padding: 0;
    font-size: 13px;
    font-family: 'Inter', sans-serif;
    color: #2A2724;
    text-decoration: underline;
    text-underline-offset: 2px;
    cursor: pointer;
}
.mp-review-viewall[hidden] {
    display: none;
}
@media only screen and (max-width: 600px) {
    .mp-review-viewall {
        top: 15px;
        right: 20px;
    }
}
.mp-review-slide--link {
    cursor: pointer;
}
.mp-review-slide--link:focus-visible {
    outline: 2px solid #45413B;
    outline-offset: 4px;
}
.mp-review-nav-btn {
    width: 28px;
    height: 28px;
    border-radius: 0;
    border: none;
    background: #d34270;
    color: #fff;
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 0 2px;
}
.mp-review-nav-btn:disabled {
    opacity: 0.35;
    cursor: default;
}
.mp-review-nav-count {
    font-size: 13px;
    color: #2A2724;
    font-family: 'Inter', sans-serif;
}
@media only screen and (max-width: 600px) {
.mp-review-box {
    padding: 15px 20px;
    margin-top: 15px;
}
.mp-review-text {
    font-size: var(--FONT-SIZE-BASE);
}
.mp-review-stars svg {
    width: 85px;
}
.mp-review-nav {
    justify-content: center;
    margin-top: 10px;
}
.mp-review-stars {
    margin-bottom: 6px;
}
/* Phone: title on one line (ellipsis), body clamped to two lines. */
.mp-review-box--junip .mp-review-title {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.mp-review-box--junip .mp-review-text p {
    -webkit-line-clamp: 2;
}
.mp-review-box--junip .mp-author-box {
    margin-top: 3px;
}
}
/* Fluid type + spacing for the review box, measured against its own width
   (the buy column narrows long before the phone breakpoint). Desktop values
   are the caps; the floors apply from roughly 335px box width down. */
.mp-review-box {
    container-type: inline-size;
}
.mp-review-slide {
    gap: clamp(10px, 4.3cqw - 3px, 16px);
}
.mp-review-text {
    font-size: clamp(14px, 1.43cqw + 9.7px, 16px);
}
.mp-review-title {
    font-size: clamp(15px, 2.8cqw + 6.6px, 20px);
}
.mp-author-name,
.mp-verified-text {
    font-size: clamp(12px, 1.43cqw + 7.7px, 14px);
}
.mp-review-stars svg {
    width: clamp(80px, 10.7cqw + 47.9px, 95px);
}
@media only screen and (max-width: 600px) {
    .mp-review-photo {
        width: clamp(84px, 32cqw - 12px, 130px);
    }
}
@supports not (width: 1cqw) {
    .mp-review-slide { gap: clamp(10px, 1.3vw, 16px); }
    .mp-review-text { font-size: clamp(14px, 1.25vw, 16px); }
    .mp-review-title { font-size: clamp(15px, 1.6vw, 20px); }
    .mp-author-name, .mp-verified-text { font-size: clamp(12px, 1.1vw, 14px); }
    .mp-review-stars svg { width: clamp(80px, 7.5vw, 95px); }
}
</style>

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  # Per-product content from the Coming Soon Page metaobject (top Tolstoy + accordions)
  assign cs_main = false
  if section.settings.use_metaobject and product
    assign cs = product.metafields.custom.coming_soon.value
    if cs
      assign cs_main = true
    endif
  endif
  # Does the custom colour picker have at least one swatch image for this product? If not, the theme's own variant picker stays visible.
  assign cs_has_swatches = false
  for cs_pick_block in section.blocks
    if cs_pick_block.type == 'color_picker'
      assign cs_pick_option_name = cs_pick_block.settings.option_name | default: 'Color'
      assign cs_pick_option = product.options_with_values | where: 'name', cs_pick_option_name | first
      if cs_pick_option
        for cs_pick_value in cs_pick_option.values
          for cs_sw in section.blocks
            if cs_sw.type == 'color_swatch_item' and cs_sw.settings.option_value == cs_pick_value
              assign cs_sw_scope = cs_sw.settings.product_handle | strip | downcase
              if cs_sw_scope == blank or cs_sw_scope == product.handle
                if cs_sw.settings.image != blank or cs_sw.settings.image_url != blank
                  assign cs_has_swatches = true
                  break
                endif
              endif
            endif
          endfor
          if cs_has_swatches
            break
          endif
        endfor
      endif
    endif
  endfor
  assign enable_video_looping = section.settings.enable_video_looping
  assign image_size = section.settings.image_size
  assign image_layout = section.settings.image_layout
  assign mobile_image_style = section.settings.mobile_image_style
  assign featured_media = current_variant.featured_media | default: product.featured_media
  assign featured_media_aspect_ratio = featured_media.aspect_ratio | default: 1
  assign is_title_linked = true
  if template.name == 'product'
    assign is_title_linked = false
  endif

  assign show_thumbnails = false
  assign enable_thumbs = false
  assign enable_thumbs_mobile = false

  if image_layout == 'thumbnails' or image_layout == 'thumbnails-left'
    assign enable_thumbs = true
    assign show_thumbnails = true
  endif

  if mobile_image_style == 'thumbs'
    assign show_thumbnails = true
    assign enable_thumbs_mobile = true
  endif

  assign modifier = image_layout | default: 'thumbnails'
  assign product_wrapper_modifier = 'product__wrapper--' | append: modifier

  assign show_buy_buttons = false
  assign buy_buttons = section.blocks | where: 'type', 'buttons'

  if buy_buttons.size > 0
    assign show_buy_buttons = true
  endif

  assign image_width = 770

  if image_size == 'small'
    assign product_wrapper_modifier = product_wrapper_modifier | append: ' product__wrapper--small'
    assign image_width = 525
  endif

  if image_size == 'stretch'
    assign product_wrapper_modifier = product_wrapper_modifier | append: ' product__wrapper--stretch'
    assign image_width = 970
  endif

  assign product_form_id = 'ProductForm--' | append: section.id | append: '-' | append: product.id
  assign show_cart_bar = false
  assign unique = section.id

  assign sibling_color = product.metafields.theme.sibling_color.value | default: product.metafields.theme.sibling_colour.value | default: product.metafields.theme.siblings_color.value | default: product.metafields.theme.siblings_colour.value | default: product.metafields.theme.siblings_colors.value | default: product.metafields.theme.siblings_colours.value

  if section.settings.show_cart_bar
    assign show_cart_bar = true
  endif

  capture product_images_classlist
    echo 'product__images'

    if enable_thumbs
      echo ' product__images--thumbs'
    else
      echo ' product__images--no-thumbs'
    endif

    if enable_thumbs_mobile
      echo ' product__images--mobile-thumbs'
    else
      echo ' product__images--mobile-slider'
    endif
  endcapture

  assign preorder = false
  if current_variant.available and product.metafields.theme.preorder.type == 'boolean' and product.metafields.theme.preorder.value == true
    assign preorder = true
  endif

  assign sold_out = false
  unless product.available
    assign sold_out = true
  endunless

  assign product_tags = product.tags | join: ','
  if current_variant.available and product_tags contains '_preorder'
    assign preorder = true
  endif

  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
  endif

  assign badge = ''
  if badge == '' and product_tags contains '_badge_'
    assign badge = product_tags | split: '_badge_'
    assign badge = badge[1] | split: ',' | first | replace: '_', ' '
  endif
-%}

