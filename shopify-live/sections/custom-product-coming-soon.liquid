    transform: scale(1.04);
  }
}
.cs-addon__body {
  display: flex;
  flex-direction: column;
  gap: 10px;
  min-width: 0;
}
.cs-addon__top {
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.cs-addon__name {
  font-family: Inter, sans-serif;
  font-size: 17px;
  line-height: 1.3;
  font-weight: 600;
  color: var(--cs-ink);
  text-decoration: none;
}
.cs-addon__note {
  margin: 0;
  font-family: Inter, sans-serif;
  font-size: 14px;
  line-height: 1.45;
  color: var(--cs-muted);
