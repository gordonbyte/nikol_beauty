                        assign cs_addon_count = cs_addon_products.size
                        assign cs_addon_layout = 'single'
                        if cs_addon_count > 3
                          assign cs_addon_layout = 'slider'
                        elsif cs_addon_count > 1
                          assign cs_addon_layout = 'grid'
                        endif
                      -%}
                      {%- capture cs_main_prices -%}
                        {
                        {%- for cs_mv in product.variants -%}
                          {%- capture cs_mv_sale -%}{%- render 'custom-promo-cents', product: product, variant: cs_mv -%}{%- endcapture -%}
                          {%- assign cs_mv_sale = cs_mv_sale | strip -%}
                          {%- if cs_mv_sale == blank -%}{%- assign cs_mv_sale = cs_mv.price -%}{%- endif -%}
                          "{{ cs_mv.id }}": { "orig": {{ cs_mv.price }}, "sale": {{ cs_mv_sale }} }{%- unless forloop.last -%},{%- endunless -%}
                        {%- endfor -%}
                        }
                      {%- endcapture -%}
                      {%- capture cs_main_sale -%}{%- render 'custom-promo-cents', product: product, variant: current_variant -%}{%- endcapture -%}
                      {%- assign cs_main_sale = cs_main_sale | strip -%}
                      {%- if cs_main_sale == blank -%}{%- assign cs_main_sale = current_variant.price -%}{%- endif -%}
                      <div class="product__block block-padding" {{ block_style }} {{ block.shopify_attributes }}>
                        <div class="cs-addons cs-addons--{{ cs_addon_layout }}" style="--cs-addon-count: {{ cs_addon_count }};" data-cs-addons data-cs-addon-count="{{ cs_addon_count }}" data-cs-form="{{ product_form_id }}" data-cs-main-price="{{ cs_main_sale }}" data-cs-main-prices='{{ cs_main_prices | strip | strip_newlines }}' data-cs-main-title="{{ product.title | escape }}">
                          <div class="cs-addons__head">
                            <div class="cs-addons__heading">
                              {%- if block.settings.eyebrow != blank -%}
                                <span class="cs-addons__eyebrow">{{ block.settings.eyebrow }}</span>
                              {%- endif -%}
                              {%- if cs_addon_title != blank -%}
                                <p class="cs-addons__title">{{ cs_addon_title | replace: '[product]', product.title }}</p>
                              {%- endif -%}
                            </div>
                            {%- if cs_addon_layout == 'slider' -%}
                              <div class="cs-addons__nav">
                                <button type="button" class="cs-addons__arrow cs-addons__arrow--prev" data-cs-addons-prev aria-label="Previous products">&#8249;</button>
                                <button type="button" class="cs-addons__arrow cs-addons__arrow--next" data-cs-addons-next aria-label="Next products">&#8250;</button>
                              </div>
                            {%- endif -%}
                          </div>
                          <div class="cs-addons__viewport">
                            <div class="cs-addons__list" data-cs-addons-list>
                              {%- for cs_ap in cs_addon_products -%}
                                {%- liquid
                                  assign cs_av = cs_ap.selected_or_first_available_variant | default: cs_ap.variants.first
                                  capture cs_av_sale
                                    render 'custom-promo-cents', product: cs_ap, variant: cs_av
                                  endcapture
                                  assign cs_av_sale = cs_av_sale | strip
                                  assign cs_av_orig = cs_av.price
                                  if cs_av_sale == blank
                                    assign cs_av_sale = cs_av.price
                                    if cs_av.compare_at_price > cs_av.price
                                      assign cs_av_orig = cs_av.compare_at_price
                                    endif
                                  else
                                    assign cs_av_sale = cs_av_sale | plus: 0
                                  endif
                                  assign cs_ap_img = cs_av.featured_image | default: cs_ap.featured_image
                                  assign cs_ap_rating = cs_ap.metafields.junip.rating_average | times: 1.0
                                  assign cs_ap_count = cs_ap.metafields.junip.rating_count | times: 1
                                  assign cs_ap_id = unique | append: '-addon-' | append: cs_ap.id
                                  assign cs_ap_note = ''
                                  if block.settings.show_note
                                    assign cs_ap_note = cs_ap.description | replace: '<strong>', '[[b]]' | replace: '</strong>', '[[/b]]' | replace: '<b>', '[[b]]' | replace: '</b>', '[[/b]]' | strip_html | strip_newlines | replace: '  ', ' ' | strip | split: '. ' | first | strip
                                    if cs_ap_note contains '? '
                                      assign cs_ap_note = cs_ap_note | split: '? ' | first | append: '?'
                                    endif
                                    if cs_ap_note contains '! '
                                      assign cs_ap_note = cs_ap_note | split: '! ' | first | append: '!'
                                    endif
                                    if cs_ap_note.size > 132
                                      assign cs_ap_note = cs_ap_note | truncate: 132
                                    endif
                                    assign cs_ap_note = cs_ap_note | replace: '[[b]]', '<strong>' | replace: '[[/b]]', '</strong>'
                                    assign cs_ap_note_open = cs_ap_note | split: '<strong>' | size
                                    assign cs_ap_note_close = cs_ap_note | split: '</strong>' | size
                                    if cs_ap_note_open > cs_ap_note_close
                                      assign cs_ap_note = cs_ap_note | append: '</strong>'
                                    endif
                                  endif
                                -%}
                                <div class="cs-addon{% unless cs_ap.available %} is-soldout{% endunless %}{% if cs_ap.id == cs_addon_featured_id %} is-featured{% endif %}" data-cs-addon data-cs-addon-handle="{{ cs_ap.handle }}" data-cs-addon-title="{{ cs_ap.title | escape }}">
                                  {%- if cs_ap.id == cs_addon_featured_id -%}
                                    <span class="cs-addon__badge">{{ cs_addon_featured_label }}</span>
                                  {%- endif -%}
                                  <input type="checkbox" id="{{ cs_ap_id }}" class="cs-addon__check" data-cs-addon-check{% unless cs_ap.available %} disabled{% endunless %}>
                                  <label for="{{ cs_ap_id }}" class="cs-addon__circle" aria-label="Add {{ cs_ap.title | escape }} to cart with this product">
                                    <span class="cs-addon__plus" aria-hidden="true"></span>
                                    <svg class="cs-addon__tick" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3 8.5l3.2 3L13 4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                  </label>
                                  <div class="cs-addon__media">
                                    {%- if cs_ap_img -%}
                                      {{ cs_ap_img | image_url: width: 400 | image_tag: alt: cs_ap.title, loading: 'lazy', widths: '200, 400' }}
                                    {%- endif -%}
                                  </div>
                                  <div class="cs-addon__body">
                                    <div class="cs-addon__top">
                                      <span class="cs-addon__name">{{ cs_ap.title }}</span>
                                      {%- if block.settings.show_rating and cs_ap_rating > 0 and cs_ap_count > 0 -%}
                                        <div class="cs-addon__rating" aria-label="Rated {{ cs_ap_rating | round: 1 }} out of 5 from {{ cs_ap_count }} reviews">
                                          <span class="cs-addon__stars" style="--rating: {{ cs_ap_rating | at_most: 5.0 | at_least: 0.0 }};" aria-hidden="true"></span>
                                          <span class="cs-addon__rating-text">{{ cs_ap_rating | round: 1 }} ({{ cs_ap_count }})</span>
                                        </div>
                                      {%- endif -%}
                                      {%- if cs_ap_note != blank -%}
                                        {%- assign cs_ap_note_last = cs_ap_note | slice: -1 -%}<p class="cs-addon__note">{{ cs_ap_note }}{% unless cs_ap_note_last == '.' or cs_ap_note_last == '?' or cs_ap_note_last == '!' or cs_ap_note_last == '…' %}.{% endunless %}</p>
                                      {%- endif -%}
                                    </div>
                                    <div class="cs-addon__bottom">
                                      <div class="cs-addon__price">
                                        <span class="cs-addon__price-current" data-cs-addon-price data-cs-addon-cents="{{ cs_av_sale }}">{{ cs_av_sale | money }}</span>
                                        <s class="cs-addon__price-compare" data-cs-addon-compare{% unless cs_av_orig > cs_av_sale %} hidden{% endunless %}>{{ cs_av_orig | money }}</s>
                                      </div>
                                      <input type="hidden" data-cs-addon-variant value="{{ cs_av.id }}" data-cents="{{ cs_av_sale }}" data-orig="{{ cs_av_orig }}">
                                      {%- unless cs_ap.has_only_default_variant -%}
                                        <div class="cs-addon__options" data-cs-addon-options>
                                          {%- for cs_opt in cs_ap.options_with_values -%}
                                            {%- assign cs_opt_idx = forloop.index0 -%}
                                            <div class="cs-addon__opt">
                                              <span class="cs-addon__opt-label">{{ cs_opt.name }}</span>
                                              <select class="cs-addon__variant" data-cs-addon-opt data-cs-opt-index="{{ cs_opt_idx }}" aria-label="{{ cs_ap.title | escape }} {{ cs_opt.name | escape }}">
                                                {%- for cs_val in cs_opt.values -%}
                                                  <option value="{{ cs_val | escape }}"{% if cs_val == cs_av.options[cs_opt_idx] %} selected{% endif %}>{{ cs_val }}</option>
                                                {%- endfor -%}
                                              </select>
                                            </div>
                                          {%- endfor -%}
                                        </div>
                                        <script type="application/json" data-cs-addon-variants>[
                                          {%- for cs_v in cs_ap.variants -%}
                                            {%- capture cs_v_sale -%}{%- render 'custom-promo-cents', product: cs_ap, variant: cs_v -%}{%- endcapture -%}
                                            {%- assign cs_v_sale = cs_v_sale | strip -%}
                                            {%- assign cs_v_orig = cs_v.price -%}
                                            {%- if cs_v_sale == blank -%}
                                              {%- assign cs_v_sale = cs_v.price -%}
                                              {%- if cs_v.compare_at_price > cs_v.price -%}{%- assign cs_v_orig = cs_v.compare_at_price -%}{%- endif -%}
                                            {%- else -%}
                                              {%- assign cs_v_sale = cs_v_sale | plus: 0 -%}
                                            {%- endif -%}
                                            {"id": {{ cs_v.id }}, "options": {{ cs_v.options | json }}, "available": {{ cs_v.available | json }}, "cents": {{ cs_v_sale }}, "orig": {{ cs_v_orig }}, "price": {{ cs_v_sale | money | json }}, "origPrice": {{ cs_v_orig | money | json }}, "image": {% if cs_v.featured_image %}{{ cs_v.featured_image | image_url: width: 400 | json }}{% else %}null{% endif %}}{%- unless forloop.last -%},{%- endunless -%}
                                          {%- endfor -%}
                                        ]</script>
                                      {%- endunless -%}
                                      {%- if cs_ap.available -%}
                                        <span class="cs-addon__hint" data-cs-addon-hint data-hint-add="{{ block.settings.hint_add | default: 'Tap to add' | escape }}" data-hint-added="{{ block.settings.hint_added | default: 'Added' | escape }}">{{ block.settings.hint_add | default: 'Tap to add' }}</span>
                                      {%- else -%}
                                        <span class="cs-addon__soldout">Sold out</span>
                                      {%- endif -%}
                                    </div>
                                  </div>
                                </div>
                              {%- endfor -%}
                            </div>
                          </div>
                          <p class="cs-addons__summary" data-cs-addons-summary hidden></p>
                        </div>
                      </div>
                    {%- endif -%}

                  {%- when 'quiz_callout' -%}
                    {%- liquid
                      assign q_title = block.settings.title | replace: '[product]', product.title
                      assign q_text = block.settings.text | replace: '[product]', product.title
                      # Hidden until "Show quiz call-out" is ticked in the section settings.
                      assign q_show = false
                      if section.settings.show_quiz
                        if q_title != blank or q_text != blank
                          assign q_show = true
                        endif
                      endif
                    -%}
                    {%- if q_show -%}
                      <div class="product__block block-padding" {{ block_style }} {{ block.shopify_attributes }}>
                        <div class="cw-bb-quiz"{% if block.settings.bg_color != blank %} style="background: {{ block.settings.bg_color }};"{% endif %}>
                          <div class="cw-bb-quiz__text">
                            {%- if q_title != blank -%}
                              <p class="cw-bb-quiz__title">{{ q_title }}</p>
                            {%- endif -%}
                            {%- if q_text != blank -%}
                              <p class="cw-bb-quiz__copy">{{ q_text }}</p>
                            {%- endif -%}
                          </div>
                          {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}
                            <a class="cw-bb-quiz__btn" href="{{ block.settings.button_link }}">{{ block.settings.button_label }}</a>
                          {%- endif -%}
                        </div>
                      </div>
                    {%- endif -%}

                  {%- when 'pickup' -%}
                    <pickup-availability class="product__block product__pickup block-padding" data-store-availability-container="{{ current_variant.id }}" {{ block.shopify_attributes }} {{ block_style }}></pickup-availability>

                  {%- when 'rating_summary' -%}
                    {%- liquid
                      assign junip_rating = product.metafields.junip.rating_average | times: 1.0
                      assign junip_count = product.metafields.junip.rating_count | times: 1
                    -%}
                    {%- if junip_rating > 0 and junip_count > 0 -%}
                      <div class="product__block block-padding" {{ block_style }} {{ block.shopify_attributes }}>
                        <div class="cw-bb-rating-box" {% if block.settings.anchor_id != blank %}id="{{ block.settings.anchor_id }}"{% endif %}>
                          {% if block.settings.link_url != blank %}<a href="{{ block.settings.link_url }}">{% endif %}
                            {%- liquid
                              assign star_rating = junip_rating | at_most: 5.0 | at_least: 0.0
                              assign star_percent = star_rating | divided_by: 5.0 | times: 100.0 | round: 1
                              assign rating_display = junip_rating | round: 2
                              assign count_display = junip_count
                              if junip_count >= 1000
                                assign count_thousands = junip_count | divided_by: 1000
                                assign count_remainder = junip_count | modulo: 1000 | prepend: '00' | slice: -3, 3
                                assign count_display = count_thousands | append: ',' | append: count_remainder
                              endif
                            -%}
                            {%- if star_rating > 0 -%}
                              <div class="cw-bb-rating-image">
                                <svg xmlns="http://www.w3.org/2000/svg" width="190" height="36" viewBox="0 0 190 36" fill="#DDD6CF" aria-hidden="true" focusable="false">
                                  <defs>
                                    <path id="CwBbRatingStar-{{ block.id }}" d="M 0 -18 L 4.04 -5.56 L 17.12 -5.56 L 6.53 2.12 L 10.58 14.56 L 0 6.88 L -10.58 14.56 L -6.53 2.12 L -17.12 -5.56 L -4.04 -5.56 Z"/>
                                  </defs>
                                  <use href="#CwBbRatingStar-{{ block.id }}" transform="translate(19 19.7)"/>
                                  <use href="#CwBbRatingStar-{{ block.id }}" transform="translate(57 19.7)"/>
                                  <use href="#CwBbRatingStar-{{ block.id }}" transform="translate(95 19.7)"/>
                                  <use href="#CwBbRatingStar-{{ block.id }}" transform="translate(133 19.7)"/>
                                  <use href="#CwBbRatingStar-{{ block.id }}" transform="translate(171 19.7)"/>
                                </svg>
                                <span class="cw-bb-rating-fill" style="width: {{ star_percent }}%">
                                  <svg xmlns="http://www.w3.org/2000/svg" width="190" height="36" viewBox="0 0 190 36" fill="#FB6D00" aria-hidden="true" focusable="false">
                                    <use href="#CwBbRatingStar-{{ block.id }}" transform="translate(19 19.7)"/>
                                    <use href="#CwBbRatingStar-{{ block.id }}" transform="translate(57 19.7)"/>
                                    <use href="#CwBbRatingStar-{{ block.id }}" transform="translate(95 19.7)"/>
                                    <use href="#CwBbRatingStar-{{ block.id }}" transform="translate(133 19.7)"/>
                                    <use href="#CwBbRatingStar-{{ block.id }}" transform="translate(171 19.7)"/>
                                  </svg>
                                </span>
                              </div>
                            {%- endif -%}

                            <div class="cw-bb-rating-text">
                              <strong>{{ rating_display }}/5</strong> stars | <strong>{{ count_display }}</strong>
                              {%- if block.settings.summary_suffix != blank %} {{ block.settings.summary_suffix }}{%- endif -%}
                            </div>
                          {% if block.settings.link_url != blank %}</a>{% endif %}
                        </div>
                      </div>
                    {%- endif -%}

                  {%- when 'payment_details' -%}
                    <div class="product__block block-padding" {{ block_style }} {{ block.shopify_attributes }}>
                      <div class="cw-bb-color-main-container">
                        {%- liquid
                          assign cs_product_description = product.description | strip
                          assign cs_check_open = '<p class="cw-bb-check-item">'
                          assign cs_product_description = cs_product_description | replace: '<p>- ', cs_check_open | replace: '<p> - ', cs_check_open | replace: '<p>&nbsp;- ', cs_check_open | replace: '<p> - ', cs_check_open | replace: '<p class="MsoPlainText"> - ', cs_check_open | replace: '<p class="MsoPlainText">&nbsp;- ', cs_check_open | replace: '<p class="MsoPlainText"> - ', cs_check_open | replace: '<p class="MsoPlainText">- ', cs_check_open | replace: '<p>-', cs_check_open | replace: '<p class="MsoPlainText">-', cs_check_open
                        -%}
                        {%- liquid
                          assign cs_quick_facts = blank
                          if section.settings.use_metaobject and cs != blank
                            assign cs_quick_facts = cs.quick_facts.value
                          endif
                        -%}
                        {%- liquid
                          # Quick facts: "Made in <not USA>" moves to the end of the description; everything else (incl. Made in the USA) stays in the row above READ MORE.
                          assign cs_row_facts = ''
                          assign cs_origin_html = ''
                          if cs_quick_facts != blank and cs_quick_facts.size > 0
                            for cs_fact in cs_quick_facts
                              assign cs_fact_l = cs_fact | downcase
                              assign cs_fact_is_origin = false
                              if cs_fact_l contains 'made in'
                                assign cs_fact_is_origin = true
                                if cs_fact_l contains 'usa' or cs_fact_l contains 'u.s.' or cs_fact_l contains 'united states' or cs_fact_l contains 'america'
                                  assign cs_fact_is_origin = false
                                endif
                              endif
                              if cs_fact_is_origin
                                assign cs_origin_html = cs_origin_html | append: '<p class="cs-desc__meta cs-desc__origin">' | append: cs_fact | append: '</p>'
                              else
                                assign cs_row_facts = cs_row_facts | append: '<span class="cs-desc__meta">' | append: cs_fact | append: '</span>'
                              endif
                            endfor
                          endif
                          assign cs_quick_facts_html = ''
                          if cs_row_facts != ''
                            assign cs_quick_facts_html = '<p class="cs-desc__meta-row">' | append: cs_row_facts | append: '</p>'
                          endif
                        -%}
                        {%- if cs_product_description != blank -%}
                          <div class="cw-bb-color-description rte{% if cs_quick_facts_html != blank %} has-quick-facts{% endif %}">
                            <toggle-ellipsis data-height="430">
                              <div class="toggle-ellipsis__content" data-content>
                                {{ cs_product_description }}{{ cs_origin_html }}
                              </div>

                              <div class="toggle-ellipsis__actions" data-actions>
                                {{ cs_quick_facts_html }}
                                <button type="button" class="caps--link" data-button>
                                  <span>{{ 'products.general.read_more' | t }}</span>
                                </button>
                                <button type="button" class="caps--link cs-desc-less" data-cs-desc-less>
                                  <span>Show less</span>
                                </button>
                              </div>
                            </toggle-ellipsis>
                          </div>
                        {%- elsif cs_quick_facts_html != blank or cs_origin_html != blank -%}
                          <div class="cw-bb-color-description rte">
                            {{ cs_origin_html }}{{ cs_quick_facts_html }}
                          </div>
                        {%- endif -%}

                      </div>
                    </div>

                  {%- when 'color_picker' -%}
                    {%- liquid
                      assign option_name = block.settings.option_name | default: 'Color'
                      assign color_option = product.options_with_values | where: 'name', option_name | first
                    -%}
                    {%- capture cs_swatches_html -%}
                    {%- if color_option -%}
                        <div class="cw-bb-color-chooser-title">
                          {{ block.settings.label | default: 'Choose Color:' }}
                          <span class="cw-bb-color-selected">
                            {{ color_option.selected_value }}
                          </span>
                        </div>

                        <div class="cw-bb-color-image-wrapper">
                          {%- for value in color_option.values -%}
                            {%- assign matching_swatch = blank -%}
                            {%- assign value_index = forloop.index -%}
                            {%- assign swatch_count = 0 -%}
                            {%- for swatch_block in section.blocks -%}
                              {%- if swatch_block.type == 'color_swatch_item' -%}
                                {%- assign swatch_count = swatch_count | plus: 1 -%}
                                {%- assign swatch_scope = swatch_block.settings.product_handle | strip | downcase -%}
                                {%- if swatch_block.settings.option_value == value and swatch_scope == blank or swatch_block.settings.option_value == value and swatch_scope == product.handle -%}
                                  {%- assign matching_swatch = swatch_block -%}
                                  {%- break -%}
                                {%- endif -%}
                              {%- endif -%}
                            {%- endfor -%}

                            {%- assign matching_swatch_has_image = false -%}
                            {%- if matching_swatch != blank -%}
                              {%- if matching_swatch.settings.image != blank or matching_swatch.settings.image_url != blank -%}
                                {%- assign matching_swatch_has_image = true -%}
                              {%- endif -%}
                            {%- endif -%}

                            {%- if matching_swatch_has_image -%}
                              <div class="cw-bb-color-swatch {% if value == color_option.selected_value %}is-active{% endif %}" data-value="{{ value }}">
                                {%- if matching_swatch.settings.image != blank -%}
                                  {{ matching_swatch.settings.image | image_url: width: 160 | image_tag: class: 'cw-color', alt: matching_swatch.settings.image_alt, loading: 'lazy' }}
                                {%- else -%}
                                  <img src="{{ matching_swatch.settings.image_url }}" alt="{{ matching_swatch.settings.image_alt }}" class="cw-color" loading="lazy">
                                {%- endif -%}
                              </div>
                            {%- endif -%}
                          {%- endfor -%}
                        </div>
                    {%- endif -%}
                    {%- endcapture -%}
                    {%- if cs_swatches_html contains 'cw-bb-color-swatch' -%}
                      <div class="product__block block-padding" {{ block_style }} {{ block.shopify_attributes }}>{{ cs_swatches_html }}</div>
                    {%- endif -%}

                  {%- when 'color_swatch_item' -%}
                    {% comment %} Rendered by the color picker block. {% endcomment %}

                  {%- when 'included_products' -%}
                    {%- liquid
                      assign cs_inc_products = blank
                      assign cs_inc_title = block.settings.fallback_title | default: 'Included products'
                      if section.settings.use_metaobject and cs != blank
                        assign cs_inc_products = cs.included_products.value
                        if cs.included_title != blank
                          assign cs_inc_title = cs.included_title.value
                        endif
                      endif
                    -%}
                    {%- if cs_inc_products != blank and cs_inc_products.size > 0 -%}
                      <div class="product__block block-padding" {{ block_style }} {{ block.shopify_attributes }}>
                        <div class="cs-included">
                          {%- if cs_inc_title != blank -%}
                            <p class="cs-included__title">{{ cs_inc_title }}</p>
                          {%- endif -%}
                          <ul class="cs-included__grid">
                            {%- for cs_inc in cs_inc_products -%}
                              {%- liquid
                                assign cs_inc_alt = cs_inc.title
                                if cs_inc.featured_image.alt != blank
                                  assign cs_inc_alt = cs_inc.featured_image.alt
                                endif
                              -%}
                              <li class="cs-included__item">
                                <a class="cs-included__link" href="{{ cs_inc.url }}">
                                  <span class="cs-included__media">
                                    {%- if cs_inc.featured_image != blank -%}
                                      {{ cs_inc.featured_image | image_url: width: 400 | image_tag: alt: cs_inc_alt, loading: 'lazy', widths: '150,220,300,400', sizes: '(max-width: 749px) 45vw, 190px' }}
                                    {%- endif -%}
                                  </span>
                                  <span class="cs-included__label">
                                    <span class="cs-included__name">{{ cs_inc.title }}</span>
                                    {%- if block.settings.show_price and cs_inc.price > 0 -%}
                                      <span class="cs-included__price" aria-hidden="true">{{ cs_inc.price | money }}</span>
                                      <span class="mp-sr-only">{{ cs_inc.price | money }}</span>
                                    {%- endif -%}
                                  </span>
                                </a>
                              </li>
                            {%- endfor -%}
                          </ul>
                        </div>
                      </div>
                    {%- endif -%}

                  {%- when 'bundle_item' -%}
                    {%- liquid
                      # Legacy hard-coded bundle rows. Suppressed automatically once the product's
                      # Coming Soon Page entry has "Included — products in this bundle" filled in,
                      # so the new included_products grid replaces them with no template edit.
                      assign cs_legacy_bundle_ok = true
                      if section.settings.use_metaobject and cs != blank and cs.included_products != blank
                        assign cs_legacy_bundle_ok = false
                      endif
                    -%}
                    {%- liquid
                      assign product_title_downcase = product.title | downcase
                      assign show_bundle_item = false
                      if block.settings.show_for_product_titles == blank
                        assign show_bundle_item = true
                      else
                        assign allowed_titles = block.settings.show_for_product_titles | downcase | split: ','
                        for allowed_title in allowed_titles
                          assign normalized_allowed_title = allowed_title | strip
                          if normalized_allowed_title == product_title_downcase
                            assign show_bundle_item = true
                            break
                          endif
                        endfor
                      endif

                      assign prev_bundle_visible = false
                      if forloop.index0 > 0
                        assign prev_index = forloop.index0 | minus: 1
                        assign prev_block = section.blocks[prev_index]
                        if prev_block.type == 'bundle_item'
                          if prev_block.settings.show_for_product_titles == blank
                            assign prev_bundle_visible = true
                          else
                            assign prev_allowed_titles = prev_block.settings.show_for_product_titles | downcase | split: ','
                            for prev_allowed_title in prev_allowed_titles
                              assign normalized_prev_allowed_title = prev_allowed_title | strip
                              if normalized_prev_allowed_title == product_title_downcase
                                assign prev_bundle_visible = true
                                break
                              endif
                            endfor
                          endif
                        endif
                      endif

                      assign next_bundle_visible = false
                      if forloop.index < section.blocks.size
                        assign next_index = forloop.index0 | plus: 1
                        assign next_block = section.blocks[next_index]
                        if next_block.type == 'bundle_item'
                          if next_block.settings.show_for_product_titles == blank
                            assign next_bundle_visible = true
                          else
                            assign next_allowed_titles = next_block.settings.show_for_product_titles | downcase | split: ','
                            for next_allowed_title in next_allowed_titles
                              assign normalized_next_allowed_title = next_allowed_title | strip
                              if normalized_next_allowed_title == product_title_downcase
                                assign next_bundle_visible = true
                                break
                              endif
                            endfor
                          endif
                        endif
                      endif
                    -%}
                    {%- if show_bundle_item and cs_legacy_bundle_ok -%}
                      {%- unless prev_bundle_visible -%}
                        <div class="product__block block-padding" {{ block_style }} {{ block.shopify_attributes }}>
                          <div style="display:flex; flex-direction:column; margin-top:30px;">
                            {%- if block.settings.heading != blank -%}
                              <p><b>{{ block.settings.heading }}</b></p>
                            {%- endif -%}
                      {%- endunless -%}

                      <div style="display:flex; flex-direction:row; align-items:center; margin-bottom:12px;">
                        {%- if block.settings.item_url != blank -%}<a href="{{ block.settings.item_url }}">{%- endif -%}
                          {%- if block.settings.item_image != blank or block.settings.item_image_url != blank -%}
                            {%- if block.settings.item_image != blank -%}
                              {{ block.settings.item_image | image_url: width: 100 | image_tag: alt: block.settings.image_alt, loading: 'lazy', style: 'width:50px;height:50px;object-fit:contain;' }}
                            {%- else -%}
                              <img src="{{ block.settings.item_image_url }}" alt="{{ block.settings.image_alt }}" loading="lazy" style="width:50px;height:50px;object-fit:contain;">
                            {%- endif -%}
                          {%- endif -%}
                        {%- if block.settings.item_url != blank -%}</a>{%- endif -%}

                        <p style="margin-left:8px;">
                          {{ block.settings.item_title }}
                          {%- if block.settings.item_price != blank -%} {{ block.settings.item_price }}{%- endif -%}
                        </p>
                      </div>

                      {%- unless next_bundle_visible -%}
                          </div>
                        </div>
                      {%- endunless -%}
                    {%- endif -%}

                  {%- when 'testimonial_card' -%}
                    {%- if block.settings.quote != blank -%}
                      <div class="product__block block-padding" {{ block_style }} {{ block.shopify_attributes }}{% if block.settings.load_junip_reviews and request.design_mode != true %} data-junip-pending{% endif %}>
                        {%- liquid
                          assign cs_review_tags = block.settings.curated_tag | strip | downcase
                          if section.settings.use_metaobject and cs != blank and cs.review_tag != blank
                            assign cs_review_tags = cs.review_tag.value | strip | downcase
                          endif
                        -%}
                        <div class="mp-review-box main-product-box"{% if block.settings.load_junip_reviews %} data-junip-reviews data-junip-product-id="{{ product.id }}" data-junip-handle="{{ product.handle }}"{% if cs_review_tags != blank %} data-junip-tag="{{ cs_review_tags }}"{% endif %}{% if block.settings.junip_store_key != blank %} data-junip-key="{{ block.settings.junip_store_key | strip }}"{% endif %}{% endif %}>
                          {%- liquid
                            assign star_rating = block.settings.star_rating | default: 5 | times: 1.0 | at_most: 5.0 | at_least: 0.0
                            assign star_percent = star_rating | divided_by: 5.0 | times: 100.0 | round: 1
                          -%}
                          <div class="mp-review-slide">
                          <div class="mp-review-photo"><img alt="" width="96" height="96" loading="lazy" data-junip-photo></div>
                          <div class="mp-review-main">
                          {%- if star_rating > 0 -%}
                            <div class="mp-review-stars">
                              <svg xmlns="http://www.w3.org/2000/svg" width="190" height="36" viewBox="0 0 190 36" fill="#DDD6CF" aria-hidden="true" focusable="false">
                                <defs>
                                  <path id="MpReviewStar-{{ block.id }}" d="M 0 -18 L 4.04 -5.56 L 17.12 -5.56 L 6.53 2.12 L 10.58 14.56 L 0 6.88 L -10.58 14.56 L -6.53 2.12 L -17.12 -5.56 L -4.04 -5.56 Z"/>
                                </defs>
                                <use href="#MpReviewStar-{{ block.id }}" transform="translate(19 19.7)"/>
                                <use href="#MpReviewStar-{{ block.id }}" transform="translate(57 19.7)"/>
                                <use href="#MpReviewStar-{{ block.id }}" transform="translate(95 19.7)"/>
                                <use href="#MpReviewStar-{{ block.id }}" transform="translate(133 19.7)"/>
                                <use href="#MpReviewStar-{{ block.id }}" transform="translate(171 19.7)"/>
                              </svg>
                              <span class="mp-review-stars-fill" style="width: {{ star_percent }}%">
                                <svg xmlns="http://www.w3.org/2000/svg" width="190" height="36" viewBox="0 0 190 36" fill="#FB6D00" aria-hidden="true" focusable="false">
                                  <use href="#MpReviewStar-{{ block.id }}" transform="translate(19 19.7)"/>
                                  <use href="#MpReviewStar-{{ block.id }}" transform="translate(57 19.7)"/>
                                  <use href="#MpReviewStar-{{ block.id }}" transform="translate(95 19.7)"/>
                                  <use href="#MpReviewStar-{{ block.id }}" transform="translate(133 19.7)"/>
                                  <use href="#MpReviewStar-{{ block.id }}" transform="translate(171 19.7)"/>
                                </svg>
                              </span>
                              <span class="mp-sr-only">Rated {{ star_rating }} out of 5 stars</span>
                            </div>
                          {%- endif -%}

                          <div class="mp-review-text">
                            {{ block.settings.quote }}
                          </div>

                          {%- if block.settings.author_name != blank or block.settings.show_verified -%}
                            <div class="mp-author-box">
                              {%- if block.settings.author_name != blank -%}
                                <div class="mp-author-name">
                                  {{ block.settings.author_name }}
                                </div>
                              {%- endif -%}

                              {%- if block.settings.show_verified -%}
                                <div class="mp-verified">
                                  {%- if block.settings.verified_icon != blank or block.settings.verified_icon_url != blank -%}
                                    {%- if block.settings.verified_icon != blank -%}
                                      {{ block.settings.verified_icon | image_url: width: 48 | image_tag: alt: block.settings.verified_icon_alt, loading: 'lazy' }}
                                    {%- else -%}
                                      <img src="{{ block.settings.verified_icon_url }}" alt="{{ block.settings.verified_icon_alt }}" loading="lazy">
                                    {%- endif -%}
                                  {%- endif -%}
                                  <div class="mp-verified-text">
                                    {{ block.settings.verified_text }}
                                  </div>
                                </div>
                              {%- endif -%}
                            </div>
                          {%- endif -%}
                          </div>
                          </div>

                          {%- if block.settings.load_junip_reviews -%}
                            <div class="mp-review-nav" hidden>
                              <button type="button" class="mp-review-nav-btn" data-junip-prev aria-label="Previous review">&#8249;</button>
                              <span class="mp-review-nav-count" data-junip-count aria-live="polite"></span>
                              <button type="button" class="mp-review-nav-btn" data-junip-next aria-label="Next review">&#8250;</button>
                            </div>
                          {%- endif -%}
                        </div>
                      </div>
                    {%- endif -%}

                  {%- when 'code' -%}
                    <div class="product__block product__custom-code block-padding" {{ block_style }} {{ block.shopify_attributes }}>
                      {{ block.settings.code }}
                    </div>

                  {%- when 'siblings' -%}
                    {%- render 'product-siblings' product: product, product_form_id: product_form_id, block: block, block_style: block_style, quick_add_product: false -%}

                  {%- when 'text' -%}
                    {% comment %} Text block for product {% endcomment %}
{%- if block.settings.title != blank or block.settings.text != blank -%}
  <div class="product__block product__text{% if block.settings.layout == "inline" %} product__text--inline{% endif %} block-padding" {{ block.shopify_attributes }} {{ block_style }}>
    {%- if block.settings.title != blank -%}
      <p class="product__heading strong">
        {{- block.settings.title -}}
      </p>
    {%- endif -%}

    {%- if block.settings.text != blank -%}
      <div class="product__subheading">
        {{- block.settings.text -}}
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

                  {%- when 'icon' -%}

                    {% comment %} Icon block for Product {% endcomment %}
{%- liquid
  assign prev_index = forloop.index0 | minus: 1
  assign next_index = forloop.index0 | plus: 1
  assign prev_block = section.blocks[prev_index]
  assign next_block = section.blocks[next_index]
  assign image = block.settings.image
  assign icon_color = block.settings.icon_color
  assign width = block.settings.width

  capture block_style
    echo 'style="'
    if icon_color != blank and icon_color != 'rgba(0,0,0,0)'
      echo '--text: ' | append: icon_color | append: ';'
    endif
    echo '--block-padding-bottom: ' | append: block.settings.padding_bottom | append: 'px;'
    echo '"'
  endcapture
-%}

{%- if forloop.index0 == 0 or prev_block.type != 'icon' -%}
  <div class="product__icon__row">
{%- endif -%}

<div class="product__block product__icon__container product__icon__container--{{ width }} block-padding"
  {{ block.shopify_attributes }}
  {{ block_style }}
>
  {%- liquid
    assign icon_size = block.settings.icon_size
    assign icon_color = block.settings.icon_color
    capture icon_style
      echo 'style="'
      echo '--icon-size: ' | append: icon_size | append: 'px;'
      if icon_color != blank and icon_color != 'rgba(0,0,0,0)'
        echo ' --text: ' | append: icon_color | append: ';'
      endif
      echo '"'
    endcapture
  -%}
  <div class="product__icon" data-aos="img-in" {{ icon_style }}>
    {%- liquid
      if image
        assign icon_width = icon_size
        assign icon_width_retina = icon_width | times: 2
        assign icon_sizes = icon_width | append: 'px'
        assign icon_widths = icon_width | append: ', ' | append: icon_width_retina

        render 'image' image: image, width: icon_width_retina, sizes: icon_sizes, widths: icon_widths, show_backfill: false
      else
        render 'animated-icon', filename: block.settings.icon_name
      endif
    -%}
  </div>

  {%- if block.settings.title != blank -%}
    {%- assign font_size_class = block.settings.text_size | prepend: 'body-size-' -%}
    <div class="product__icon__text {{ font_size_class }}" data-aos="fade" data-aos-duration="500">
      <p>{{ block.settings.title }}</p>
    </div>
  {%- endif -%}
</div>

{%- if forloop.index == section.blocks.size or next_block.type != 'icon' -%}
</div>
{%- endif -%}

                  {%- when 'sharing' -%}
                    <div class="product__block block-padding" {{ block.shopify_attributes }} {{ block_style }}>
                      {%- assign share_url = current_variant.url | prepend: request.origin -%}
                      {%- render 'share-button' share_url: share_url -%}
                    </div>

                  {%- when 'divider' -%}
                    {%- render 'divider' block: block, modifier: 'product__block product__block--divider' -%}

                  {%- when 'line-item' -%}
                    <div class="product__block{% if settings.show_lines %} product__block--lines{% endif %} select__fieldset block-padding" {{ block.shopify_attributes }} {{ block_style }}>
  {%- if block.settings.label != blank -%}
    {%- assign input_id = unique | append: '-' | append: block.id | append: '-' | append: forloop.index -%}
    {%- assign required = block.settings.required -%}
    {%- case block.settings.type -%}
      {%- when 'text' -%}
        <label for="{{ input_id }}" class="select__label">{{ block.settings.label | escape_once }}</label>

        <input
          type="text" class="properties__input"
          id="{{ input_id }}"
          form="{{ product_form_id }}"
          {% if required %} required {% endif %}
          name="properties[{{ block.settings.label | escape_once }}]">

      {%- when 'checkbox' -%}
        {%- if block.settings.unchecked_value != blank and block.settings.checked_value != blank -%}
          <div class="properties__checkbox checkbox">
            <input
              type="hidden"
              name="properties[{{ block.settings.label | escape_once }}]"
              form="{{ product_form_id }}"
              value="{{ block.settings.unchecked_value }}">

            <input
              type="checkbox"
              name="properties[{{ block.settings.label | escape_once }}]"
              id="{{ input_id }}"
              form="{{ product_form_id }}"
              value="{{ block.settings.checked_value }}">

            <label
              class="radio__fieldset__label"
              for="{{ input_id }}">{{ block.settings.label | escape_once }}</label>
          </div>
        {%- endif -%}

    {%- when 'dropdown' -%}
      {%- capture line_item_options -%}
        <ul id="{{ unique }}-select-{{ option.name | handle }}" class="select-popout__list" data-popout-list data-scroll-lock-scrollable>
          {%- assign has_selected = false -%}
          {%- assign selected_value = '' -%}

          {%- for i in (1..3) -%}
            {%- assign value = 'option_' | append: forloop.index -%}
            {%- assign value = block.settings[value] -%}

            {%- if value != blank -%}
              <li class="select-popout__item{% unless has_selected %} is-active{% endunless %}">
                <a class="select-popout__option"
                  href="#"
                  {% unless has_selected %}aria-current="true"{% endunless %}
                  data-value="{{ value | escape_once }}"
                  data-popout-option>
                  <span>
                    {{ value | escape_once }}
                  </span>
                </a>
              </li>

              {%- unless has_selected -%}
                {%- assign selected_value = value -%}
              {%- endunless -%}
              {%- assign has_selected = true -%}
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endcapture -%}

      {%- if has_selected -%}
        <span class="radio__legend">
          <span class="radio__legend__label">{{ block.settings.label | escape_once }}</span>
        </span>

        <popout-select class="select-popout">
          <button type="button"
            class="select-popout__toggle"
            aria-expanded="false"
            aria-controls="{{ unique }}-select-{{ option.name | handle }}"
            aria-labelledby="{{ unique }}-select-{{ option.name | handle }}-label"
            data-popout-toggle>
            <span data-popout-toggle-text>{{ selected_value }}</span>
            {%- render 'icon-nav-arrow-down' -%}
          </button>

          {{ line_item_options }}

          <input
            type="hidden"
            name="properties[{{ block.settings.label | escape_once }}]"
            id="{{ input_id }}"
            value="{{ selected_value | escape_once }}"
            form="{{ product_form_id }}"
            data-popout-input
            data-single-option-selector>
        </popout-select>
      {%- endif -%}
    {%- endcase -%}
  {%- endif -%}


                  {%- when 'features' -%}
                    {% comment %} Features block for Product {% endcomment %}

                    {%- liquid
                      assign block_id = block.id
                      assign text = block.settings.text
                      assign title = block.settings.title
                      assign prev_index = forloop.index0 | minus: 1
                      assign next_index = forloop.index0 | plus: 1
                      assign prev_block = section.blocks[prev_index]
                      assign next_block = section.blocks[next_index]
                      assign image = block.settings.icon_alt
                      assign bg_color = block.settings.bg_color
                      assign text_color = block.settings.color

                      comment
                        Always force dots style to be "line" except if "Circle" is chosen from the global settings
                      endcomment
                      assign dots_style = 'line'
                      if settings.dots_style == 'circle'
                        assign dots_style = 'circle'
                      endif

                      capture style
                        if bg_color != 'rgba(0,0,0,0)' and bg_color != blank
                          echo '--bg: ' | append: bg_color | append: ';'
                        endif

                        if text_color != 'rgba(0,0,0,0)' and text_color != blank
                          echo '--text: ' | append: text_color | append: ';'
                        endif
                      endcapture
                    -%}

                    {%- if forloop.index0 == 0 or prev_block.type != 'features' -%}
                      {%- assign slide_index = 0 -%}
                      <div class="product__block product__features block-padding"
                        {{ block_style }}
                        data-slider
                        data-slider-fullwidth
                        data-dots="{{ dots_style }}"
                        data-options='{"pageDots": true, "adaptiveHeight": true, "autoPlay": false, "prevNextButtons": false, "fade": false, "draggable": ">1"}'
                      >
                    {%- endif -%}

                    <div class="product__feature"
                      data-slide="{{ block_id }}"
                      data-slide-index="{{ slide_index }}"
                      data-block-id="{{ block_id }}"
                      {% if style != blank %}
                        style="{{ style }}"
                      {% endif %}
                      {{ block.shopify_attributes }}>

                      <div class="product__feature__content">
                        <div class="product__icon__container product__feature__heading">
                          {%- assign icon_size = block.settings.icon_size -%}
                          <div class="product__icon" style="--icon-size: {{ icon_size }}px;">
                            {%- liquid
                              if image
                                assign icon_width = icon_size
                                assign icon_width_retina = icon_width | times: 2
                                assign icon_sizes = icon_width | append: 'px'
                                assign icon_widths = icon_width | append: ', ' | append: icon_width_retina
                                render 'image' image: image, width: icon_width_retina, sizes: icon_sizes, widths: icon_widths, show_backfill: false
                              else
                                render 'animated-icon', filename: block.settings.icon_name
                              endif
                            -%}
                          </div>

                          {%- if title != blank -%}
                            {%- assign font_size_class = block.settings.text_size | prepend: 'body-size-' -%}
                            <div class="product__icon__text {{ font_size_class }}">
                              <p>{{ title }}</p>
                            </div>
                          {%- endif -%}
                        </div>

                        {%- if text != blank -%}
                          <div class="rte">
                            {{ text }}
                          </div>
                        {%- endif -%}
                      </div>
                    </div>

                    {%- if forloop.index == section.blocks.size or next_block.type != 'features' -%}
                      </div>
                    {%- endif -%}

                    {%- assign slide_index = slide_index | plus: 1 -%}

                  {%- when 'popup' -%}
                    {%- liquid
  assign link_text = block.settings.title
  assign popup_content = block.settings.page.content | default: block.settings.text
  assign image = block.settings.image
  assign icon_size = block.settings.icon_size
  assign icon_color = block.settings.icon_color

  capture block_style
    echo 'style="'
    echo '--block-padding-bottom: ' | append: block.settings.padding_bottom | append: 'px;'
    echo '"'
  endcapture

  capture icon_style
    echo 'style="'
    echo '--icon-size: ' | append: icon_size | append: 'px;'
    if icon_color != blank and icon_color != 'rgba(0,0,0,0)'
      echo '--text: ' | append: icon_color | append: ';'
    endif
    echo '"'
  endcapture
-%}

<product-modal class="product__block block-padding" {{ block_style }}>
  <div class="product__icon__container product__icon__container--full">
    <div class="product__icon" data-aos="img-in" {{ icon_style }}>
      {%- liquid
        if image
          assign icon_width = icon_size
          assign icon_width_retina = icon_width | times: 2
          assign icon_sizes = icon_width | append: 'px'
          assign icon_widths = icon_width | append: ', ' | append: icon_width_retina

          render 'image' image: image, width: icon_width_retina, sizes: icon_sizes, widths: icon_widths, show_backfill: false
        else
          render 'animated-icon', filename: block.settings.icon_name
        endif
      -%}
    </div>

    <a class="radio__legend__link text-link" href="{{ block.settings.page.url }}" data-popup-open {{ block.shopify_attributes }}>
      {{ link_text | escape }}
    </a>
  </div>

  <dialog class="product-modal" aria-hidden="true" inert data-scroll-lock-required>
    <form method="dialog">
      <button class="visually-hidden no-js" aria-label="{{ 'general.accessibility.close' | t }}"></button>
    </form>

    <div class="product-modal__outer">
      <div class="product-modal__content small" data-scroll-lock-scrollable>
        <button type="button" class="product-modal__close" data-popup-close autofocus aria-label="{{ 'general.accessibility.close' | t }}">
          {%- render 'icon-cancel' -%}
        </button>

        {{ popup_content }}
      </div>
    </div>
  </dialog>
</product-modal>

                  {%- when 'complementary-products' -%}
                    <div class="product__block product__complementary block-padding" {{ block.shopify_attributes }} {{ block_style }}>
                      <complementary-products class="complementary-products"
                        data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=10&intent=complementary" >
                        {%- if recommendations.performed and recommendations.products_count > 0 -%}
                          {%- assign complementary_products_title = 'products.general.complementary_products_title' | t -%}
                          {%- if complementary_products_title != blank -%}
                            <p class="complementary-products__title">{{ complementary_products_title }}</p>
                          {%- endif -%}

                          {%- for product in recommendations.products limit: block.settings.complementary_limit-%}
                            {%- render 'upsell-product', upsell_product: product -%}
                          {%- endfor -%}
                        {%- endif -%}
                      </complementary-products>
                    </div>

                  {%- when 'badges' -%}
                    <div class="product__block product__badges block-padding"
                      {{ block.shopify_attributes }}
                      {{ block_style }}>

                      {%- if badge != '' and block.settings.product_badges -%}
                        <span class="badge-box">{{ badge }}</span>
                      {%- endif -%}

                      {%- if preorder and sold_out == false and block.settings.product_badges-%}
                        <span class="preorder-box">{{ 'products.product.pre_order' | t }}</span>
                      {%- endif -%}

                      {%- if on_sale and sold_out == false and block.settings.sale_badge -%}
                        <span class="sale-box">{{ 'products.product.on_sale' | t }}</span>
                      {%- endif -%}
                    </div>

                {%- endcase -%}
              {%- endfor -%}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  {% unless product == empty %}
    <script type="application/json" data-product-json>
      {{ product | json }}
    </script>
    <script type="application/json" id="ModelJSON-{{ unique }}">
      {{ product.media | where: 'media_type', 'model' | json }}
    </script>
  {% endunless %}


  {% comment %} Google wants to know when to check your price again {% endcomment %}

  {%- liquid
    assign days_price_is_valid = 1
    assign seconds_in_a_day = 86400
    assign seconds_price_valid = days_price_is_valid | times: seconds_in_a_day

    if product.selected_or_first_available_variant.featured_media
      assign seo_media = product.selected_or_first_available_variant.featured_media
    else
      assign seo_media = product.featured_media
    endif
  -%}

  <script type="application/ld+json">
  {
    "@context": "http://schema.org/",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ request.origin | append: product.url | json }},
    {% if seo_media -%}
      "image": [
        {{ seo_media | image_url: width: 1920 | prepend: "https:" | json }}
      ],
    {%- endif %}
    "description": {{ product.description | strip_html | json }},
    {%- render 'product-jsonld-rating', product: product -%}
    {%- if current_variant.sku != blank -%}
      "sku": {{ current_variant.sku | json }},
    {%- endif -%}
    "brand": {
      "@type": "Organization",
      "name": {{ product.vendor | json }}
    },
    "offers": [
      {%- for variant in product.variants -%}
        {
          "@type" : "Offer",
          {%- if variant.sku != blank -%}
            "sku": {{ variant.sku | json }},
          {%- endif -%}
          {%- if variant.barcode.size == 12 -%}
            "gtin12": {{ variant.barcode }},
          {%- endif -%}
          {%- if variant.barcode.size == 13 -%}
            "gtin13": {{ variant.barcode }},
          {%- endif -%}
          {%- if variant.barcode.size == 14 -%}
            "gtin14": {{ variant.barcode }},
          {%- endif -%}
          "availability" : "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "price" : {{ variant.price | divided_by: 100.00 | json }},
          "priceCurrency" : {{ cart.currency.iso_code | json }},
          "priceValidUntil": "{{ 'now' | date: '%s' | plus: seconds_price_valid | date: '%Y-%m-%d' }}",
          "url" : {{ request.origin | append: variant.url | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
  </script>

  {%- if show_cart_bar -%}
    {% render 'cart-bar', product: product, form_blocks: section.blocks %}

  {%- endif -%}
  {%- render 'custom-cs-staging', product: product -%}
</div>





<script>
  document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll(".complete-look-slider").forEach(function (sliderEl) {
      // Scope the nav buttons to this slider's own container so they don't
      // collide with other ".swiper-button-next/prev" elements on the page.
      var navScope = sliderEl.closest(".complete-look-slider-main") || sliderEl.parentElement;
      new Swiper(sliderEl, {
        slidesPerView: 1,
        spaceBetween: 16,
        navigation: {
          nextEl: navScope.querySelector(".swiper-button-next"),
          prevEl: navScope.querySelector(".swiper-button-prev")
        }
      });
    });
  });
</script>

<script>
document.addEventListener("DOMContentLoaded", function () {

  const thumbSwiper = new Swiper(".cw-new-popup-thumb-slider", {
    spaceBetween: 15,
    slidesPerView: 2,
    breakpoints: {
      421: { slidesPerView: 3 },
      1024: { slidesPerView: 4 }
    },
    threshold: 12,
    watchSlidesProgress: true,
    navigation: {
      nextEl: ".swiper-button-nextpt",
      prevEl: ".swiper-button-prevpt",
    },
  });

  const mainSwiper = new Swiper(".cw-new-popup-main-slider", {
    spaceBetween: 10,
    thumbs: { swiper: thumbSwiper },

  });

  // Variant change → show that variant's featured image (event bubbles up
  // from Broadcast's product form; slides carry data-media-id).
  document.addEventListener("theme:variant:change", function (e) {
    var variant = e.detail && e.detail.variant;
    if (!variant || !variant.featured_media) return;
    var slides = mainSwiper.slides || [];
    for (var i = 0; i < slides.length; i++) {
      if (slides[i].getAttribute("data-media-id") === String(variant.featured_media.id)) {
        mainSwiper.slideTo(i);
        break;
      }
    }
  });

});
</script>

<script>
document.addEventListener("DOMContentLoaded", function () {

  const customSwatches = document.querySelectorAll(".cw-bb-color-swatch");
  const selectedText = document.querySelector(".cw-bb-color-selected");

  customSwatches.forEach(swatch => {

    swatch.addEventListener("click", function () {

      const value = this.dataset.value;

      /* Update custom UI */
      customSwatches.forEach(s => s.classList.remove("is-active"));
      this.classList.add("is-active");

      if (selectedText) {
        selectedText.textContent = value;
      }

      /* 🔥 FIND MATCHING SHOPIFY LABEL */
      const shopifyLabel = document.querySelector(
        `.radio__fieldset label[data-swatch="${value}"]`
      );

      if (shopifyLabel) {
        shopifyLabel.click(); // ✅ THIS IS THE KEY
      } else {
        console.warn("Shopify swatch not found for:", value);
      }

      /* Bring the main image into view so the variant's photo is visible
         (matters on phones/tablets where the swatches sit below the gallery). */
      const gallery = document.querySelector(".cw-new-popup-main-slider");
      if (gallery) {
        const rect = gallery.getBoundingClientRect();
        const headerOffset = 110;
        const fullyVisible = rect.top >= headerOffset && rect.bottom <= window.innerHeight;
        if (!fullyVisible) {
          const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          window.scrollTo({ top: rect.top + window.pageYOffset - headerOffset, behavior: reduced ? "auto" : "smooth" });
        }
      }

    });

  });

});
</script>

<script>
/* Buy-button row: stamp data-buttons="1|2|many" from the visible children so
   the CSS can cap a lone add-to-cart, split two buttons, wrap three or more.
   Re-runs when apps inject buttons (Notify Me) or a variant change toggles them. */
document.addEventListener("DOMContentLoaded", function () {
  /* Second installments form (under the buy button): Broadcast only syncs the
     first [data-product-form-installment] form, so keep this one's variant in
     step ourselves. */
  document.addEventListener("theme:variant:change", function (e) {
    var variant = e.detail && e.detail.variant;
    if (!variant) return;
    document.querySelectorAll('[data-cs-installment-below] input[name="id"]').forEach(function (input) {
      input.value = variant.id;
      input.dispatchEvent(new Event("change", { bubbles: true }));
    });
  });

  document.querySelectorAll(".product__buttons-row").forEach(function (row) {
    var update = function () {
      var n = Array.prototype.filter.call(row.children, function (el) {
        var cs = getComputedStyle(el);
        return cs.display !== "none" && cs.visibility !== "hidden" && el.getClientRects().length > 0;
      }).length;
      var v = n <= 1 ? "1" : (n === 2 ? "2" : "many");
      if (row.getAttribute("data-buttons") !== v) row.setAttribute("data-buttons", v);
    };
    update();
    if (window.MutationObserver) {
      new MutationObserver(update).observe(row, { childList: true, subtree: true, attributes: true, attributeFilter: ["style", "class", "hidden"] });
    }
    document.addEventListener("theme:variant:change", update);
    window.addEventListener("load", update);
  });
});
</script>

<script>
/* Mini Junip review carousel: fills the testimonial box with the product's
   real reviews (Junip storefront API, public store key). If the product has
   no reviews or the fetch fails, the static editor content stays untouched. */
document.addEventListener("DOMContentLoaded", function () {
  document.querySelectorAll("[data-junip-reviews]").forEach(function (box) {
    var productId = box.getAttribute("data-junip-product-id");
    var keyEl = document.querySelector("[data-store-key]");
    var key = box.getAttribute("data-junip-key") || (keyEl && keyEl.getAttribute("data-store-key"));
    var textEl = box.querySelector(".mp-review-text");
    if (!productId || !key || !textEl) return;

    var fillEl = box.querySelector(".mp-review-stars-fill");
    var srEl = box.querySelector(".mp-sr-only");
    var authorEl = box.querySelector(".mp-author-name");
    var verifiedEl = box.querySelector(".mp-verified");
    var nav = box.querySelector(".mp-review-nav");
    var prevBtn = box.querySelector("[data-junip-prev]");
    var nextBtn = box.querySelector("[data-junip-next]");
    var countEl = box.querySelector("[data-junip-count]");

    var reviews = [];
    var idx = 0;
    var MAX_REVIEWS = 8;
    var PAGE_SIZE = 100;
    var MAX_PAGES = 6;
    var MAX_PAGES_CURATED = 14;
    var curatedTags = [];
    if (box.getAttribute("data-junip-tag")) box.getAttribute("data-junip-tag").toLowerCase().split(",").forEach(function (t) { t = t.trim(); if (t && curatedTags.indexOf(t) === -1) curatedTags.push(t); });
    if (box.getAttribute("data-junip-handle")) curatedTags.push(box.getAttribute("data-junip-handle").toLowerCase());
    var CACHE_KEY = "cs-junip-reviews-v4-" + productId + "-" + curatedTags.join("|");
    var CACHE_TTL = 60 * 60 * 1000;

    var formatName = function (c) {
      if (!c || !c.first_name) return "";
      var first = c.first_name.toLowerCase().replace(/(^|[\s'-])\S/g, function (ch) { return ch.toUpperCase(); });
      var last = (c.last_name || "").charAt(0).toUpperCase();
      return first + (last ? " " + last + "." : "");
    };

    var slideEl = box.querySelector(".mp-review-slide");
    var photoEl = box.querySelector("[data-junip-photo]");
    var animating = false;

    var applyReview = function () {
      var r = reviews[idx];
      if (!r) return;
      if (fillEl) {
        var pct = Math.max(0, Math.min(100, (r.rating / 5) * 100));
        fillEl.style.width = pct + "%";
      }
      if (srEl) srEl.textContent = "Rated " + r.rating + " out of 5 stars";
      textEl.textContent = "";
      if (r.title) {
        var t = document.createElement("strong");
        t.className = "mp-review-title";
        t.textContent = r.title;
        textEl.appendChild(t);
      }
      var p = document.createElement("p");
      p.textContent = "“" + (r.body || "").trim() + "”";
      textEl.appendChild(p);
      if (authorEl) authorEl.textContent = formatName(r.customer);
      if (verifiedEl) verifiedEl.style.display = r.verified_buyer ? "" : "none";
      if (photoEl) {
        var photo = r.photo_urls && r.photo_urls[0];
        var src = photo && (photo.large || photo.thumbnail);
        if (src) {
          photoEl.src = src;
          photoEl.alt = "Photo from " + (formatName(r.customer) || "a customer") + "'s review";
          slideEl.classList.add("mp-review-slide--has-photo");
        } else {
          photoEl.removeAttribute("src");
          photoEl.alt = "";
          slideEl.classList.remove("mp-review-slide--has-photo");
        }
      }
      if (countEl) countEl.textContent = (idx + 1) + " / " + reviews.length;
      if (prevBtn) prevBtn.disabled = idx === 0;
      if (nextBtn) nextBtn.disabled = idx >= reviews.length - 1;
      if (nav) nav.hidden = reviews.length < 2;
      box.dispatchEvent(new CustomEvent("mp:review:applied"));
    };

    /* dir: 1 = next (new review slides in from the right), -1 = prev,
       0/undefined = no animation (first paint). */
    var render = function (dir) {
      if (!dir || !slideEl) { applyReview(); return; }
      if (animating) return;
      animating = true;
      var out = dir > 0 ? "mp-slide-out-left" : "mp-slide-out-right";
      var inn = dir > 0 ? "mp-slide-in-right" : "mp-slide-in-left";
      slideEl.classList.add(out);
      setTimeout(function () {
        applyReview();
        slideEl.classList.remove(out);
        slideEl.classList.add(inn);
        void slideEl.offsetWidth;
        slideEl.classList.remove(inn);
        setTimeout(function () { animating = false; }, 480);
      }, 450);
    };

    /* Selection: hand-picked reviews only. A review shows if it carries the
       block's curated tag (or the product handle) and is rated 4★ or better.
       Nothing else is ever shown: a product with no tag, or a tag that matches
       no review, leaves the list empty and the block hides itself. Order is
       random on every load, with no preference for reviews that have photos. */
    var hasPhoto = function (r) { return !!(r.photo_urls && r.photo_urls[0] && (r.photo_urls[0].large || r.photo_urls[0].thumbnail)); };
    var qualifies = function (r) { return r.rating >= 4 && r.title && String(r.title).trim(); };
    var rank = function (r) { return (hasPhoto(r) ? 0 : 10) + (5 - Math.round(r.rating)); };
    /* Hand-picked: a review tagged in Junip with the block's tag (or the
       product handle). Rating floor still applies; a title is not required. */
    var isCurated = function (r) {
      if (!curatedTags.length || !r.tags || !r.tags.length || r.rating < 4) return false;
      return r.tags.some(function (t) { var name = String(t && t.name !== undefined ? t.name : t).toLowerCase(); return curatedTags.indexOf(name) !== -1; });
    };
    var shuffle = function (list) {
      for (var i = list.length - 1; i > 0; i--) { var j = Math.floor(Math.random() * (i + 1)); var tmp = list[i]; list[i] = list[j]; list[j] = tmp; }
      return list;
    };
    var pick = function (pool) {
      var seen = {}; var curated = [];
      pool.forEach(function (r) {
        if (seen[r.id]) return; seen[r.id] = true;
        if (isCurated(r)) curated.push(r);
      });
      return curated;
    };
    var slim = function (r) {
      return { id: r.id, rating: r.rating, title: r.title, body: r.body, created_at: r.created_at, verified_buyer: r.verified_buyer, curated: isCurated(r),
        customer: r.customer ? { first_name: r.customer.first_name, last_name: r.customer.last_name } : null,
        photo_urls: hasPhoto(r) ? [{ large: r.photo_urls[0].large, thumbnail: r.photo_urls[0].thumbnail }] : [] };
    };
    /* Fresh random order on every load (cached or not). Reviews with a photo are
       not favoured; every curated review has an equal chance of showing first. */
    var arrange = function (list) {
      return shuffle(list.slice());
    };
    var readCache = function () {
      try { var c = JSON.parse(sessionStorage.getItem(CACHE_KEY)); return c && Date.now() - c.t < CACHE_TTL ? c.r : null; } catch (e) { return null; }
    };
    var writeCache = function (list) { try { sessionStorage.setItem(CACHE_KEY, JSON.stringify({ t: Date.now(), r: list })); } catch (e) {} };
    /* Curated review ids are remembered across sessions (localStorage, 24h) so
       returning visitors fetch just those reviews, in parallel; the list is
       re-scanned in the background once it is over an hour old. */
    var IDS_KEY = "cs-junip-curated-ids-v2-" + productId + "-" + curatedTags.join("|");
    var IDS_TTL = 24 * 60 * 60 * 1000;
    var IDS_REVALIDATE = 60 * 60 * 1000;
    var readIds = function () {
      try { var c = JSON.parse(localStorage.getItem(IDS_KEY)); return c && Date.now() - c.t < IDS_TTL ? c : null; } catch (e) { return null; }
    };
    var writeIds = function (ids) { try { localStorage.setItem(IDS_KEY, JSON.stringify({ t: Date.now(), ids: ids })); } catch (e) {} };
    var headers = { headers: { "Junip-Store-Key": key } };
    var API = "https://api.juniphq.com/v1/product_reviews";
    var makeCursor = function (id) { return btoa(JSON.stringify({ id: id })); };
    var fetchPage = function (cursor) {
      var url = API +
        "?filter[product_remote_id]=" + encodeURIComponent(productId) +
        "&filter[rating][]=4&filter[rating][]=5" +
        "&page[size]=" + PAGE_SIZE + "&include=customer" + (curatedTags.length ? ",tags" : "") +
        (cursor ? "&page[after]=" + encodeURIComponent(cursor) : "");
      return fetch(url, headers).then(function (res) { return res.ok ? res.json() : null; });
    };
    var pageList = function (data) { return (data && data.product_reviews) || []; };
    var fetchOne = function (id) {
      return fetch(API + "/" + encodeURIComponent(id) + "?include=customer", headers)
        .then(function (res) { return res.ok ? res.json() : null; })
        .then(function (data) { return data && data.product_review; })
        .catch(function () { return null; });
    };

    /* Automatic picks: sequential pages, stop once eight 5★ photo reviews exist. */
    var scanAuto = function (done) {
      var pool = []; var pages = 0;
      var enough = function () {
        return pool.filter(function (r) { return qualifies(r) && hasPhoto(r) && r.rating >= 5; }).length >= MAX_REVIEWS;
      };
      var step = function (cursor) {
        fetchPage(cursor).then(function (data) {
          var list = pageList(data);
          if (list.length) { pool = pool.concat(list); pages++; }
          var next = data && data.meta && data.meta.page && data.meta.page.after;
          if (list.length === PAGE_SIZE && next && pages < MAX_PAGES && !enough()) { step(next); return; }
          done(pool);
        }).catch(function () { done(pool); });
      };
      step(null);
    };

    /* Curated: the whole 4–5★ list is needed (tagged reviews can be old).
       Junip's cursor is just {"id": lastId}, so after page 1 the remaining
       pages are requested in parallel at estimated id steps, then any gap
       between neighbouring pages is filled sequentially. */
    var scanAll = function (done) {
      var pool = []; var requests = 0; var MAX_REQUESTS = 40;
      var lowestOf = function (list) { return list[list.length - 1].id; };
      var fillFrom = function (fromId, untilId) {
        if (requests >= MAX_REQUESTS) return Promise.resolve();
        requests++;
        return fetchPage(makeCursor(fromId)).then(function (data) {
          var list = pageList(data);
          pool = pool.concat(list);
          if (list.length < PAGE_SIZE) return;
          var lowest = lowestOf(list);
          if (untilId !== null && lowest <= untilId) return;
          return fillFrom(lowest, untilId);
        }).catch(function () {});
      };
      // Pages 1 and 2 go sequentially: the newest reviews are sparse in id
      // space, so page 2's id span is the usable density estimate.
      requests++;
      fetchPage(null).then(function (first) {
        var list1 = pageList(first);
        pool = pool.concat(list1);
        if (list1.length < PAGE_SIZE) { done(pool); return; }
        requests++;
        return fetchPage(makeCursor(lowestOf(list1))).then(function (second) {
          var list2 = pageList(second);
          pool = pool.concat(list2);
          if (list2.length < PAGE_SIZE) { done(pool); return; }
          var start = lowestOf(list2);
          var span = Math.max(50, list2[0].id - start);
          var cursors = [];
          for (var k = 0; k < MAX_PAGES_CURATED - 2; k++) cursors.push(Math.floor(start - k * span * 0.9));
          requests += cursors.length;
          return Promise.all(cursors.map(function (c) {
            return fetchPage(makeCursor(c)).then(function (d) { return { cursor: c, list: pageList(d) }; }).catch(function () { return { cursor: c, list: [] }; });
          })).then(function (results) {
            var fills = [];
            results.forEach(function (r, i) {
              pool = pool.concat(r.list);
              if (r.list.length < PAGE_SIZE) return;
              var lowest = lowestOf(r.list);
              var next = results[i + 1] ? results[i + 1].cursor : null;
              if (next === null || lowest > next) fills.push(fillFrom(lowest, next));
            });
            return Promise.all(fills);
          }).then(function () { done(pool); });
        });
      }).catch(function () { done(pool); });
    };

    var finish = function (pool, cb) {
      reviews = pick(pool).map(slim);
      writeCache(reviews);
      if (curatedTags.length) writeIds(reviews.length && reviews[0].curated ? reviews.map(function (r) { return r.id; }) : []);
      reviews = arrange(reviews);
      cb();
    };

    var load = function (cb) {
      var cached = readCache();
      if (cached) { reviews = arrange(cached); cb(); return; }
      if (!curatedTags.length) { scanAuto(function (pool) { finish(pool, cb); }); return; }
      var known = readIds();
      if (known && known.ids.length) {
        Promise.all(known.ids.map(fetchOne)).then(function (found) {
          var list = found.filter(function (r) { return r && r.rating >= 4; });
          if (!list.length) { scanAll(function (pool) { finish(pool, cb); }); return; }
          reviews = list.map(function (r) { var s = slim(r); s.curated = true; return s; });
          writeCache(reviews);
          reviews = arrange(reviews);
          cb();
          if (Date.now() - known.t > IDS_REVALIDATE) {
            scanAll(function (pool) {
              var fresh = pick(pool).map(slim);
              writeIds(fresh.length && fresh[0].curated ? fresh.map(function (r) { return r.id; }) : []);
              writeCache(fresh);
            });
          }
        });
        return;
      }
      scanAll(function (pool) { finish(pool, cb); });
    };

    /* Autoplay: advances every 5s with the same slide animation, wrapping to
       the first review. Paused while hovered/focused, off-screen, in a hidden
       tab, or under prefers-reduced-motion; a manual click restarts the clock. */
    var AUTOPLAY_MS = 5000;
    var autoTimer = null;
    var autoHover = false;
    var expanded = false;
    var autoFocus = false;
    var autoInView = true;
    var reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var stopAuto = function () { if (autoTimer) { clearInterval(autoTimer); autoTimer = null; } };
    var startAuto = function () {
      stopAuto();
      if (reducedMotion || reviews.length < 2 || autoHover || autoFocus || !autoInView || document.hidden || expanded) return;
      autoTimer = setInterval(function () {
        if (animating) return;
        idx = (idx + 1) % reviews.length;
        render(1);
      }, AUTOPLAY_MS);
    };
    box.addEventListener("mouseenter", function () { autoHover = true; stopAuto(); });
    box.addEventListener("mouseleave", function () { autoHover = false; startAuto(); });
    box.addEventListener("focusin", function () { autoFocus = true; stopAuto(); });
    box.addEventListener("focusout", function (e) { if (!box.contains(e.relatedTarget)) { autoFocus = false; startAuto(); } });
    document.addEventListener("visibilitychange", startAuto);

    /* "Show all": the clamped body gets a small link (only when the text is
       actually clipped) that opens a panel laid exactly over the box — same
       size — with the full review scrolling inside, its own prev/next and a
       Show less close. Autoplay pauses while it is open. */
    (function () {
      var authorBox = box.querySelector(".mp-author-box");
      var moreBtn = document.createElement("button");
      moreBtn.type = "button";
      moreBtn.className = "mp-review-more";
      moreBtn.textContent = "Show more";
      moreBtn.hidden = true;
      moreBtn.setAttribute("aria-expanded", "false");


      var panel = document.createElement("div");
      panel.className = "mp-review-expand";
      panel.hidden = true;
      panel.setAttribute("role", "dialog");
      panel.setAttribute("aria-modal", "false");
      panel.setAttribute("aria-label", "Full review");
      panel.innerHTML =
        '<div class="mp-review-expand__head"><strong class="mp-review-expand__title" data-x-title></strong>' +
        '<button type="button" class="mp-review-expand__close" data-x-close aria-label="Close full review">&times;</button></div>' +
        '<div class="mp-review-expand__body" data-x-body tabindex="0"></div>' +
        '<div class="mp-review-expand__foot"><span class="mp-review-expand__author" data-x-author></span>' +
        '<button type="button" class="mp-review-more mp-review-more--less" data-x-less>Show less</button>' +
        '<span class="mp-review-expand__nav"><button type="button" class="mp-review-nav-btn" data-x-prev aria-label="Previous review">&#8249;</button>' +
        '<span class="mp-review-nav-count" data-x-count></span>' +
        '<button type="button" class="mp-review-nav-btn" data-x-next aria-label="Next review">&#8250;</button></span></div>';
      box.appendChild(panel);
      var xTitle = panel.querySelector("[data-x-title]");
      var xBody = panel.querySelector("[data-x-body]");
      var xAuthor = panel.querySelector("[data-x-author]");
      var xCount = panel.querySelector("[data-x-count]");
      var xPrev = panel.querySelector("[data-x-prev]");
      var xNext = panel.querySelector("[data-x-next]");
      var xClose = panel.querySelector("[data-x-close]");
      var xLess = panel.querySelector("[data-x-less]");

      var fill = function () {
        var r = reviews[idx];
        if (!r) return;
        xTitle.textContent = r.title || "";
        xBody.textContent = "“" + (r.body || "").trim() + "”";
        xAuthor.textContent = "";
        var xName = document.createElement("span");
        xName.className = "mp-author-name";
        xName.textContent = formatName(r.customer);
        xAuthor.appendChild(xName);
        if (r.verified_buyer && verifiedEl) {
          var xBadge = verifiedEl.cloneNode(true);
          xBadge.style.display = "";
          xAuthor.appendChild(xBadge);
        }
        xCount.textContent = (idx + 1) + " / " + reviews.length;
        xPrev.disabled = idx === 0;
        xNext.disabled = idx >= reviews.length - 1;
        xBody.scrollTop = 0;
      };
      /* Fit the quote to the clamped height with "… Show more" inline at the end
         of the last visible line. Binary-search the cut so text + link fill the
         clamp exactly; the full body stays in `reviews` for the panel. */
      var OPEN_Q = "\u201C", CLOSE_Q = "\u201D", ELLIPSIS = "\u2026";
      var fitText = function () {
        var pEl = textEl.querySelector("p");
        var r = reviews[idx];
        if (!pEl || !r) { moreBtn.hidden = true; return; }
        var full = (r.body || "").trim();
        if (moreBtn.parentNode) moreBtn.parentNode.removeChild(moreBtn);
        pEl.textContent = OPEN_Q + full + CLOSE_Q;
        if (!(pEl.scrollHeight > pEl.clientHeight + 1)) { moreBtn.hidden = true; return; }
        moreBtn.hidden = false;
        var fits = function (n) {
          var cut = full.slice(0, n).replace(/[\s,.;:!?\-\u2014]+$/, "");
          pEl.textContent = OPEN_Q + cut + ELLIPSIS + CLOSE_Q + " ";
          pEl.appendChild(moreBtn);
          return !(pEl.scrollHeight > pEl.clientHeight + 1);
        };
        var lo = 0, hi = full.length;
        while (lo < hi) {
          var mid = Math.ceil((lo + hi) / 2);
          if (fits(mid)) lo = mid; else hi = mid - 1;
        }
        fits(lo);
      };
      var checkClip = fitText;
      var open = function () {
        expanded = true;
        stopAuto();
        fill();
        panel.hidden = false;
        box.classList.add("is-expanded");
        moreBtn.setAttribute("aria-expanded", "true");
        xClose.focus({ preventScroll: true });
      };
      var close = function () {
        expanded = false;
        panel.hidden = true;
        box.classList.remove("is-expanded");
        moreBtn.setAttribute("aria-expanded", "false");
        moreBtn.focus({ preventScroll: true });
        startAuto();
      };
      var swallow = function (e) { e.preventDefault(); e.stopPropagation(); };

      moreBtn.addEventListener("click", function (e) { swallow(e); open(); });
      moreBtn.addEventListener("keydown", function (e) { if (e.key === "Enter" || e.key === " ") { swallow(e); open(); } });
      xClose.addEventListener("click", function (e) { swallow(e); close(); });
      xLess.addEventListener("click", function (e) { swallow(e); close(); });
      xPrev.addEventListener("click", function (e) { swallow(e); if (idx > 0) { idx--; render(0); } });
      xNext.addEventListener("click", function (e) { swallow(e); if (idx < reviews.length - 1) { idx++; render(0); } });
      panel.addEventListener("click", function (e) { e.stopPropagation(); });
      panel.addEventListener("keydown", function (e) { if (e.key === "Escape") { swallow(e); close(); } });

      box.addEventListener("mp:review:applied", function () {
        requestAnimationFrame(checkClip);
        if (expanded) fill();
      });
      window.addEventListener("resize", function () { requestAnimationFrame(checkClip); });
    })();
    if (window.IntersectionObserver) {
      new IntersectionObserver(function (entries) {
        autoInView = entries[0].isIntersecting;
        startAuto();
      }, { threshold: 0.3 }).observe(box);
    }

    if (prevBtn) prevBtn.addEventListener("click", function () {
      if (animating) return;
      if (idx > 0) { idx--; render(-1); startAuto(); }
    });
    if (nextBtn) nextBtn.addEventListener("click", function () {
      if (animating) return;
      if (idx < reviews.length - 1) { idx++; render(1); startAuto(); }
    });

    var block = box.closest(".product__block") || box;
    load(function () {
      if (!reviews.length) { block.setAttribute("data-junip-empty", ""); return; }
      block.removeAttribute("data-junip-pending");
      box.classList.add("mp-review-box--junip");
      render();
      startAuto();
      // Clicking the review jumps to the full Junip reviews section, when the
      // page has one. (Junip's widget has no API to open a specific review.)
      var reviewsTarget = document.querySelector(".junip-product-review");
      if (reviewsTarget) {
        var goToReviews = function () {
          var top = reviewsTarget.getBoundingClientRect().top + window.pageYOffset - 110;
          var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          window.scrollTo({ top: top, behavior: reduced ? "auto" : "smooth" });
        };
        slideEl.classList.add("mp-review-slide--link");
        slideEl.setAttribute("role", "button");
        slideEl.setAttribute("tabindex", "0");
        slideEl.setAttribute("aria-label", "Read all reviews");
        slideEl.setAttribute("title", "Read all reviews");
        slideEl.addEventListener("click", goToReviews);
        slideEl.addEventListener("keydown", function (e) {
          if (e.key === "Enter" || e.key === " ") { e.preventDefault(); goToReviews(); }
        });
        var viewAllBtn = box.querySelector("[data-junip-viewall]");
        if (viewAllBtn) {
          viewAllBtn.hidden = false;
          viewAllBtn.addEventListener("click", goToReviews);
        }
      }
    });
  });
});
</script>

<style>
/* Product-wrapper reveal (same system as the homepage-style-2 sections):
   hidden start states apply ONLY once JS adds cs-anim-ready, so content stays
   visible without JS, under reduced motion, and with theme animations off.
   The gallery animates opacity only — it can be sticky, and transforms fight
   sticky positioning. */
.cs-anim-ready .cw-new-popup-main-slider,
.cs-anim-ready .cw-new-popup-thumb-slider-vt {
  opacity: 0;
  transition: opacity 0.7s ease;
}

.cs-anim-ready .product__content .product__block {
  opacity: 0;
  transform: translateY(18px);
  transition: opacity 0.6s ease, transform 0.6s ease;
}

.cs-anim-ready .cw-new-popup-main-slider.is-inview,
.cs-anim-ready .cw-new-popup-thumb-slider-vt.is-inview {
  opacity: 1;
}

.cs-anim-ready .product__content .product__block.is-inview {
  opacity: 1;
  transform: none;
}
</style>

<script>
  (function () {
    var root = document.getElementById('Product--{{ unique }}');
    if (!root) return;
    if (!('IntersectionObserver' in window)) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (window.theme && window.theme.settings && window.theme.settings.enableAnimations === false) return;

    var targets = [];
    var revealNow = [];
    root.querySelectorAll('.cw-new-popup-main-slider, .cw-new-popup-thumb-slider-vt').forEach(function (g) { targets.push(g); });
    root.querySelectorAll('.product__content .product__block').forEach(function (b) {
      /* Blocks without layout (display:none bundle items, empty upsell) never
         intersect — pre-reveal them so they're visible if the theme ever
         shows them later. */
      if (b.offsetParent === null) revealNow.push(b);
      else targets.push(b);
    });
    if (!targets.length && !revealNow.length) return;

    root.classList.add('cs-anim-ready');
    revealNow.forEach(function (b) { b.classList.add('is-inview'); });

    /* The section parses (and hides) long before first paint; starting the
       observers immediately lets the whole cascade finish invisibly during
       page load. Begin revealing only after the first painted frame. */
    var start = function () {
      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          targets.forEach(function (t) { observer.observe(t); });
        });
      });
    };

    /* Items entering the viewport together stagger 70ms apart (load-in burst
       above the fold, scroll reveals below); the batch counter resets between
       bursts so later reveals start immediately. */
    var batch = 0;
    var lastHit = 0;
    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting) return;
        var el = entry.target;
        var now = performance.now();
        if (now - lastHit > 400) batch = 0;
        lastHit = now;
        el.style.transitionDelay = Math.min(batch * 70, 560) + 'ms';
        batch++;
        el.classList.add('is-inview');
        el.addEventListener('transitionend', function clear() {
          el.style.transitionDelay = '';
          el.removeEventListener('transitionend', clear);
        });
        observer.unobserve(el);
      });
    }, { threshold: 0.12 });

    if (document.readyState !== 'loading') {
      start();
    } else {
      document.addEventListener('DOMContentLoaded', start);
    }
  })();
</script>

<script>
  (function () {
    var root = document.getElementById('Product--{{ unique }}');
    if (!root) return;
    root.querySelectorAll('.cw-bb-color-description').forEach(function (wrap) {
      var box = wrap.querySelector('toggle-ellipsis');
      var less = wrap.querySelector('[data-cs-desc-less]');
      var more = box && box.querySelector('[data-button]');
      if (!box || !less || !more) return;
      var target = parseInt(box.getAttribute('data-height'), 10) || 175;
      var collapsedHeight = target + 'px';
      var actions = box.querySelector('[data-actions]');
      var content = box.querySelector('[data-content]');

      function blockBottoms() {
        var out = [];
        if (!content) return out;
        content.querySelectorAll('p, li, .cs-desc__callout, .cs-desc__shade').forEach(function (el) {
          if (el.classList.contains('cs-desc__label')) return;
          if (el.tagName === 'P' && el.closest('.cs-desc__callout')) return;
          if (el.tagName === 'LI' && el.closest('.cs-desc__shade')) return;
          if (!el.offsetHeight) return;
          var top = el.getBoundingClientRect().top - box.getBoundingClientRect().top;
          out.push(top + el.offsetHeight);
        });
        return out;
      }

      function openHeight() {
        if (!box.classList.contains('is-open') || !content) return;
        var h = content.offsetHeight + (actions ? actions.offsetHeight : 0);
        if (typeof box.setHeight === 'function') box.setHeight(h); else box.style.setProperty('--height', h + 'px');
      }

      function fit() {
        if (box.classList.contains('is-open')) { openHeight(); return; }
        var bottoms = blockBottoms();
        if (!bottoms.length) return;
        var pad = (actions ? actions.offsetHeight : 44) + 14;
        var pick = null;
        bottoms.forEach(function (b) {
          if (b + pad <= target && (pick === null || b > pick)) pick = b;
        });
        if (pick === null || pick < target * 0.6) {
          var next = null;
          bottoms.forEach(function (b) {
            if (b + pad > target && (next === null || b < next)) next = b;
          });
          pick = next !== null ? next : Math.max.apply(null, bottoms);
        }
        var h = Math.round(pick + pad);
        if (h < 120) return;
        collapsedHeight = h + 'px';
        box.initialHeight = h;
        if (typeof box.setHeight === 'function') box.setHeight(h); else box.style.setProperty('--height', collapsedHeight);
        if (typeof box.toggleActions === 'function') box.toggleActions();
      }

      fit();
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(fit);
      window.addEventListener('load', fit);
      window.addEventListener('resize', fit);

      more.addEventListener('click', function () {
        requestAnimationFrame(openHeight);
        setTimeout(openHeight, 60);
      });

      less.addEventListener('click', function () {
        box.style.setProperty('--height', collapsedHeight);
        box.classList.remove('is-open');
        var top = wrap.getBoundingClientRect().top + window.pageYOffset - 120;
        if (window.pageYOffset > top) window.scrollTo({ top: top, behavior: 'smooth' });
      });
    });
  })();
</script>

<script>
  (function () {
    var root = document.getElementById('Product--{{ unique }}');
    if (!root) return;
    var wrap = root.querySelector('[data-cs-addons]');
    if (!wrap) return;
    var formId = wrap.getAttribute('data-cs-form');
    var mainTitle = wrap.getAttribute('data-cs-main-title') || 'this product';
    var mainCents = parseInt(wrap.getAttribute('data-cs-main-price'), 10) || 0;
    var mainPrices = {};
    try { mainPrices = JSON.parse(wrap.getAttribute('data-cs-main-prices') || '{}'); } catch (err) { mainPrices = {}; }
    var cards = Array.prototype.slice.call(wrap.querySelectorAll('[data-cs-addon]'));
    var summary = wrap.querySelector('[data-cs-addons-summary]');
    var pending = false;
    var originalText = null;

    function formatMoney(cents) {
      var fmt = (window.theme && (theme.moneyFormat || theme.money_format)) || '${{amount}}';
      var amount = (cents / 100).toFixed(2);
      var parts = amount.split('.');
      parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
      var noDec = parts[0];
      return fmt.replace(/\{\{\s*amount_no_decimals\s*\}\}/, noDec).replace(/\{\{\s*amount(_with_comma_separator)?\s*\}\}/, parts.join('.')).replace(/<[^>]+>/g, '');
    }

    function selectedCards() {
      return cards.filter(function (c) {
        var i = c.querySelector('[data-cs-addon-check]');
        return i && i.checked && !i.disabled;
      });
    }

    function variantOf(card) {
      var v = card.querySelector('[data-cs-addon-variant]');
      return v ? v.value : null;
    }

    function centsOf(card) {
      var h = card.querySelector('input[data-cs-addon-variant]');
      return h ? parseInt(h.getAttribute('data-cents'), 10) || 0 : 0;
    }

    function productForm() {
      return (formId && document.getElementById(formId)) || root.querySelector('form[data-product-form]');
    }

    function atcTextEl() {
      var f = productForm();
      if (!f) return null;
      var b = f.querySelector('[data-add-to-cart]') || f.querySelector('.product__submit__add');
      if (!b) return null;
      return b.querySelector('[data-add-to-cart-text]') || b;
    }

    function update() {
      var sel = selectedCards();
      cards.forEach(function (card) {
        var check = card.querySelector('[data-cs-addon-check]');
        var hint = card.querySelector('[data-cs-addon-hint]');
        var on = !!(check && check.checked);
        card.classList.toggle('is-selected', on);
        if (hint) {
          if (card.classList.contains('is-unavailable')) hint.textContent = 'Unavailable';
          else hint.textContent = on ? hint.getAttribute('data-hint-added') : hint.getAttribute('data-hint-add');
        }
      });
      if (summary) {
        if (sel.length) {
          var total = mainCents;
          var names = sel.map(function (c) { total += centsOf(c); return c.getAttribute('data-cs-addon-title'); });
          summary.innerHTML = '<strong>' + mainTitle + '</strong> + <strong>' + names.join('</strong> + <strong>') + '</strong> \u00b7 ' + formatMoney(total) + ' together';
          summary.hidden = false;
        } else {
          summary.hidden = true;
        }
      }
      var t = atcTextEl();
      if (!t) return;
      var btn = t.closest('button');
      if (btn && (btn.disabled || btn.classList.contains('disabled'))) return;
      if (originalText === null || !t.hasAttribute('data-cs-addon-label')) originalText = t.textContent;
      if (!sel.length) {
        if (t.hasAttribute('data-cs-addon-label')) {
          t.textContent = originalText;
          t.removeAttribute('data-cs-addon-label');
        }
        return;
      }
      t.textContent = sel.length === 1 ? 'Add both to cart' : 'Add all to cart';
      t.setAttribute('data-cs-addon-label', '1');
    }

    cards.forEach(function (card) {
      var check = card.querySelector('[data-cs-addon-check]');
      if (!check) return;
      var optSelects = Array.prototype.slice.call(card.querySelectorAll('[data-cs-addon-opt]'));
      var variantsEl = card.querySelector('[data-cs-addon-variants]');
      var variants = [];
      if (variantsEl) { try { variants = JSON.parse(variantsEl.textContent); } catch (err) { variants = []; } }
      function resolveVariant() {
        if (!optSelects.length || !variants.length) return;
        var chosen = optSelects.map(function (o) { return o.value; });
        var match = null;
        variants.forEach(function (v) {
          if (!match && v.options.length === chosen.length && v.options.every(function (o, i) { return o === chosen[i]; })) match = v;
        });
        var hidden = card.querySelector('input[data-cs-addon-variant]');
        var priceEl = card.querySelector('[data-cs-addon-price]');
        var cmp = card.querySelector('[data-cs-addon-compare]');
        if (match && match.available) {
          if (hidden) { hidden.value = match.id; hidden.setAttribute('data-cents', match.cents); hidden.setAttribute('data-orig', match.orig); }
          var img = card.querySelector('.cs-addon__media img');
          if (img && match.image && img.getAttribute('src') !== match.image) { img.removeAttribute('srcset'); img.src = match.image; }
          if (priceEl) priceEl.textContent = match.price;
          if (cmp) { if (match.orig > match.cents) { cmp.textContent = match.origPrice; cmp.hidden = false; } else { cmp.hidden = true; } }
          card.classList.remove('is-unavailable');
          check.disabled = false;
        } else {
          card.classList.add('is-unavailable');
          check.checked = false;
          check.disabled = true;
        }
        update();
      }
      optSelects.forEach(function (o) { o.addEventListener('change', resolveVariant); });
      check.addEventListener('change', update);
      card.addEventListener('click', function (e) {
        if (check.disabled) return;
        if (e.target.closest('select, option, input, button, .cs-addon__circle')) return;
        check.checked = !check.checked;
        check.dispatchEvent(new Event('change', { bubbles: true }));
      });
    });

    document.addEventListener('theme:variant:change', function (e) {
      if (e.detail && e.detail.variant) {
        var mp = mainPrices[String(e.detail.variant.id)];
        if (mp && typeof mp.sale === 'number') mainCents = mp.sale;
        else if (typeof e.detail.variant.price === 'number') mainCents = e.detail.variant.price;
      }
      setTimeout(function () {
        var t = atcTextEl();
        if (t && !t.hasAttribute('data-cs-addon-label')) originalText = t.textContent;
        update();
      }, 60);
    });

    document.addEventListener('theme:cart:add', function (e) {
      if (pending || !e.detail || !e.detail.button) return;
      var f = e.detail.button.closest('form');
      if (!f || f !== productForm()) return;
      var ids = selectedCards().map(variantOf).filter(Boolean);
      if (!ids.length) return;
      e.stopImmediatePropagation();
      e.preventDefault();
      pending = true;
      var body = new FormData();
      ids.forEach(function (id, i) {
        body.append('items[' + i + '][id]', id);
        body.append('items[' + i + '][quantity]', '1');
      });
      var routes = (window.theme && window.theme.routes) || {};
      fetch(routes.cart_add_url || '/cart/add', {
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest', Accept: 'application/javascript' },
        body: body
      }).then(function (r) { return r.json(); }).catch(function () { return {}; }).then(function () {
        e.detail.button.dispatchEvent(new CustomEvent('theme:cart:add', { bubbles: true, detail: e.detail }));
        setTimeout(function () { pending = false; }, 400);
      });
    }, true);

    var list = wrap.querySelector('[data-cs-addons-list]');
    var prev = wrap.querySelector('[data-cs-addons-prev]');
    var next = wrap.querySelector('[data-cs-addons-next]');
    if (list && prev && next) {
      var step = function () {
        var c = list.querySelector('[data-cs-addon]');
        return c ? c.getBoundingClientRect().width + 12 : list.clientWidth;
      };
      var sync = function () {
        prev.disabled = list.scrollLeft <= 2;
        next.disabled = list.scrollLeft + list.clientWidth >= list.scrollWidth - 2;
      };
      prev.addEventListener('click', function () { list.scrollBy({ left: -step(), behavior: 'smooth' }); });
      next.addEventListener('click', function () { list.scrollBy({ left: step(), behavior: 'smooth' }); });
      list.addEventListener('scroll', sync, { passive: true });
      window.addEventListener('resize', sync);
      sync();
    }
  })();
</script>

