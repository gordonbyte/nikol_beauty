  background-color: var(--cs-blush);
}
.cs-addon__variant:focus,
.cs-addon__variant:focus-visible {
  outline: none;
  border: 1px solid var(--cs-pink);
  box-shadow: 0 0 0 3px rgba(211, 66, 112, 0.15);
}
.cs-addon.is-selected .cs-addon__variant {
