  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.cs-addon__note strong {
  font-weight: 600;
  color: var(--cs-ink);
}
.cs-addon__rating {
  display: flex;
  align-items: center;
  gap: 6px;
  font-family: Inter, sans-serif;
  font-size: 13px;
  color: var(--cs-muted);
}
.cs-addon__stars {
  font-size: 18px;
  line-height: 1;
  letter-spacing: 1px;
}
.cs-addon__stars:before {
  content: "\2605\2605\2605\2605\2605";
  background: linear-gradient(90deg, var(--cs-pink) calc(var(--rating, 0) / 5 * 100%), #d9d2cc calc(var(--rating, 0) / 5 * 100%));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}
.cs-addon__bottom {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px 14px;
}
.cs-addon__price {
  display: flex;
  align-items: baseline;
