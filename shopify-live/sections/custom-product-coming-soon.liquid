      <script>
        (function () {
          var wrap = document.querySelector('.cw-bb-pvideo-tolstoy');
          if (!wrap) return;
          var carousel = wrap.querySelector('.tolstoy-carousel');
          var nativeArrow = function (dir) {
            var sel = dir < 0 ? '.tolstoy-previous-button' : '.tolstoy-next-button';
            return carousel.querySelector(sel) || wrap.querySelector(sel);
          };
          var forward = function (dir) {
            var target = nativeArrow(dir);
            if (!target) return;
            ['pointerdown', 'mousedown', 'pointerup', 'mouseup', 'click'].forEach(function (type) {
              try {
                target.dispatchEvent(new MouseEvent(type, { bubbles: true, cancelable: true, view: window }));
              } catch (e) {}
            });
          };
          wrap.querySelector('.cw-bb-pvideo-nav--prev').addEventListener('click', function () { forward(-1); });
          wrap.querySelector('.cw-bb-pvideo-nav--next').addEventListener('click', function () { forward(1); });

          /* Hide our arrows when the carousel has nothing to scroll: after tiles load, keep them
             only while Tolstoy shows a native prev/next button or the tiles overflow the track. */
          var navSettled = false;
          var navSync = function () {
            var tiles = carousel.querySelectorAll(".tolstoy-carousel-tile-container");
            /* Wait for Tolstoy to inject something (or for the settle timer) so arrows never flash off pre-load. */
            if (!tiles.length && !carousel.children.length && !navSettled) return;
            var track = carousel.querySelector(".tolstoy-carousel-videos-container") || carousel;
            var overflow = false;
            if (tiles.length) {
              var total = 0;
              tiles.forEach(function (t) { total += t.getBoundingClientRect().width; });
              var cs = window.getComputedStyle(track);
              var gap = parseFloat(cs.columnGap) || parseFloat(cs.gap) || 0;
              total += gap * (tiles.length - 1);
              var trackW = track.getBoundingClientRect().width;
              overflow = total > trackW + 2 || track.scrollWidth > track.clientWidth + 2;
            }
            var nativeVisible = function (el) { return !!el && el.offsetParent !== null && window.getComputedStyle(el).display !== "none"; };
            var hasNative = nativeVisible(nativeArrow(-1)) || nativeVisible(nativeArrow(1));
            wrap.classList.toggle("nav-hidden", !(hasNative || (window.innerWidth <= 450 && overflow)));
          };
          var navSyncQueued = false;
          var queueNavSync = function () {
            if (navSyncQueued) return;
            navSyncQueued = true;
            requestAnimationFrame(function () { navSyncQueued = false; navSync(); });
          };
          if ("MutationObserver" in window) {
            new MutationObserver(queueNavSync).observe(carousel, { childList: true, subtree: true, attributes: true, attributeFilter: ["class", "style", "hidden", "disabled"] });
          }
          window.addEventListener("resize", queueNavSync);
          window.addEventListener("load", queueNavSync);
          setTimeout(function () { navSettled = true; queueNavSync(); }, 6000);
          queueNavSync();
        })();
      </script>
