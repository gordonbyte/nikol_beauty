<div class="prefooter site-prefooter-wrapper">
  <div class="prefooter__inner">
    <div class="prefooter__left">
    	{{ section.settings.title }}
    </div>
    <div class="prefooter__right">
    	{%- for block in section.blocks -%}
    		<div class="prefooter__item">
    			<img 
	                src="{{ block.settings.icon | image_url }}"
	                alt="{{ block.settings.icon | default: shop.name }}"
	                loading="eager"
	                />

	            <div class="prefooter__item-title">
	            	{{ block.settings.title }}
	            </div>
    		</div>
    	{%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Prefooter",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    }
  ],
  "blocks": [
  	{
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Lorem ipsum"
        }
      ]
    }
  ],
  "presets": [{
    "name": "Prefooter",
    "category": "Image",
    "blocks": [
      {
        "type": "item"
      }
    ]
  }]
}
{% endschema %}
