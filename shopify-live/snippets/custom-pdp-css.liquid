/* Match Broadcast's solid buttons (ATC + cart bar) to the page's custom-button
   hover: a plain background fade to the brighter token with the text color
   held, instead of the theme's skewed ::after wipe + grey hover text. */
.product__submit__buttons .btn--solid,
.cart-bar__submit .btn--solid {
    transition: background-color 0.3s ease;
}

/* Sticky cart bar: no "•" before the price, title + price left-aligned. */
.cart-bar__product__price::before {
  content: none;
  padding-right: 0;
}
.cart-bar__product__title,
.cart-bar__product__price {
  display: block;
  padding: 0;
  text-align: left;
}
.cart-bar__product__price {
  display: flex;
  justify-content: flex-start;
}

.product__submit__buttons .btn--solid:after,
.cart-bar__submit .btn--solid:after {
    content: none;
}

@media (hover: hover) {
  .product__submit__buttons .btn--solid:hover,
  .cart-bar__submit .btn--solid:hover {
    background-color: var(--BTN-PRIMARY-BG-COLOR-BRIGHTER);
    border-color: var(--BTN-PRIMARY-BG-COLOR-BRIGHTER);
    color: var(--BTN-PRIMARY-TEXT-COLOR);
  }
}

