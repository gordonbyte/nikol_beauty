{%- comment -%}
  Sticky "add to cart" bar shown on product pages.
  Single source of truth — edit here, not inline in the product sections.
  Usage: {% render 'cart-bar', product: product, form_blocks: section.blocks %}
{%- endcomment -%}
{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign selling_plan_hide = true
  assign button_add = false
  assign blocks_form = form_blocks | where: 'type', 'form'

  if settings.currency_code_enable
    assign current_variant_price = current_variant.price | money_with_currency
    assign current_variant_compare_at_price = current_variant.compare_at_price | money_with_currency
  else
    assign current_variant_price = current_variant.price | money
    assign current_variant_compare_at_price = current_variant.compare_at_price | money
  endif

  # Promo sale price — mirrors product-price.liquid so the cart bar matches the main price.
  #  - 1 variant  -> percent: 'promo-<n>' / 'promo-up-to-<n>' tag;
  #                  amount:  'promo-amt-<x>' / 'promo-amt-up-to-<x>' tag (dollars off).
  #  - >1 variant -> per-variant metafields; custom.promo_amount (exact dollars off)
  #    takes precedence over custom.promo_percent.
  # On variant change, the script in product-price.liquid updates every [data-promo-new]
  # in the section (the cart bar included), so no extra JS is needed here.
  assign promo_percent = ''
  assign promo_amount = ''
  assign promo_sale_price_display = ''
  assign promo_original_display = ''
  assign promo_multi = false
  assign has_any_promo = false

  if settings.promo_badge_enable and product.available
    if product.variants.size == 1
      assign promo_tags = product.tags | join: ',' | append: ','
      if promo_tags contains 'promo-amt-up-to-'
        assign promo_parts = promo_tags | split: 'promo-amt-up-to-'
        assign promo_amount = promo_parts[1] | split: ',' | first | strip
      elsif promo_tags contains 'promo-amt-'
        assign promo_parts = promo_tags | split: 'promo-amt-'
        assign promo_amount = promo_parts[1] | split: ',' | first | strip
      elsif promo_tags contains 'promo-up-to-'
        assign promo_parts = promo_tags | split: 'promo-up-to-'
        assign promo_percent = promo_parts[1] | split: ',' | first | strip
      elsif promo_tags contains 'promo-'
        assign promo_parts = promo_tags | split: 'promo-'
        assign promo_percent = promo_parts[1] | split: ',' | first | strip
      endif
    else
      assign promo_multi = true
      assign promo_amount = current_variant.metafields.custom.promo_amount.value
      assign promo_percent = current_variant.metafields.custom.promo_percent.value
      for v in product.variants
        assign va = v.metafields.custom.promo_amount.value
        assign vp = v.metafields.custom.promo_percent.value
        if va != blank and va > 0
          assign has_any_promo = true
          break
        elsif vp != blank and vp > 0
          assign has_any_promo = true
          break
        endif
      endfor
    endif

    if promo_amount != blank and current_variant.price > 0
      assign promo_amount_cents = promo_amount | times: 100.0 | round
      assign promo_sale_price = current_variant.price | minus: promo_amount_cents
      if promo_sale_price < 0
        assign promo_sale_price = 0
      endif
      if settings.currency_code_enable
        assign promo_sale_price_display = promo_sale_price | money_with_currency
        assign promo_original_display = current_variant.price | money_with_currency
      else
        assign promo_sale_price_display = promo_sale_price | money
        assign promo_original_display = current_variant.price | money
      endif
    elsif promo_percent != blank and current_variant.price > 0
      assign promo_discount_amount = current_variant.price | times: promo_percent | divided_by: 100
      assign promo_sale_price = current_variant.price | minus: promo_discount_amount
      if settings.currency_code_enable
        assign promo_sale_price_display = promo_sale_price | money_with_currency
        assign promo_original_display = current_variant.price | money_with_currency
      else
        assign promo_sale_price_display = promo_sale_price | money
        assign promo_original_display = current_variant.price | money
      endif
    endif

    # Per-discount styling written by the Discount Sync app; fall back to global settings.
    assign promo_badge_bg = product.metafields.custom.promo_badge_bg.value | default: settings.promo_badge_bg_color
    assign promo_price_color = product.metafields.custom.promo_price_color.value | default: settings.promo_badge_bg_color
  endif

  assign show_promo_markup = false
  if promo_sale_price_display != blank
    assign show_promo_markup = true
  elsif promo_multi and has_any_promo
    assign show_promo_markup = true
  endif
-%}

{% if product.selling_plan_groups.size > 0 and blocks_form.size > 0 and blocks_form[0].settings.subscriptions_enable_selectors %}
  {%- assign selling_plan_hide = false -%}
{% endif %}

{%- if product.has_only_default_variant and selling_plan_hide -%}
  {%- assign button_add = true -%}
{%- endif -%}

<div id="cart-bar" class="cart-bar">
  <div class="cart-bar__form__wrapper form__wrapper{% if button_add and current_variant.available != true %} variant--soldout{% endif %}" data-form-wrapper>
    <div class="cart-bar__info">
      {%- if product.featured_image -%}
        <div class="cart-bar__image">
          <img
            src="{{ product.featured_image | image_url: width: 160, height: 160, crop: 'center' }}"
            srcset="{{ product.featured_image | image_url: width: 88, height: 88, crop: 'center' }} 88w,
                    {{ product.featured_image | image_url: width: 112, height: 112, crop: 'center' }} 112w,
                    {{ product.featured_image | image_url: width: 160, height: 160, crop: 'center' }} 160w"
            sizes="56px"
            width="56"
            height="56"
            loading="lazy"
            alt="{{ product.title | strip_html | escape }}">
        </div>
      {%- endif -%}

      <div class="cart-bar__info__text">
        <p class="cart-bar__product__title">{{ product.title | strip_html }}</p>

        <div class="h5--body cart-bar__product__price product__price{% if promo_sale_price_display != blank %} product__price--promo{% endif %}" data-price-wrapper>
          {%- if show_promo_markup -%}
            <span class="promo-old-price" data-promo-old>{{ promo_original_display }}</span>
            <span class="promo-new-price" data-promo-new style="color: {{ promo_price_color }};">{{ promo_sale_price_display }}</span>
            <span class="promo-on-sale-pill" data-promo-pill style="background: {{ promo_badge_bg }};">On Sale</span>
          {%- endif -%}
          <span data-product-price {% if current_variant.compare_at_price > current_variant.price %} class="product__price--sale"{% endif %}>
            {%- if current_variant.price == 0 -%}
              {{ 'general.money.free' | t }}
            {%- else -%}
              {{ current_variant_price }}
            {%- endif -%}
          </span>

          {% if product.compare_at_price_max > product.price %}
            <span class="visually-hidden" data-compare-text>{{ 'products.product.regular_price' | t }}</span>
            <s class="product__price--strike" data-compare-price>
              {% if current_variant.compare_at_price > current_variant.price %}
                {{ current_variant_compare_at_price }}
              {% endif %}
            </s>
          {% endif %}
        </div>
      </div>
    </div>

    <div class="cart-bar__form">
      <div class="cart-bar__submit product__submit product__submit--spb">
        <button type="button"
          class="btn btn--primary btn--solid product__submit__add{% unless button_add %} product__submit__add--default{% endunless %}"
          {% if button_add %} data-add-to-cart-bar{% else %} data-cart-bar-scroll{% endif %}
          {% if button_add and current_variant.available != true %} disabled="disabled"{% endif %}>
          <span class="btn__text"{% if button_add %} data-add-to-cart-text{% endif %}>
            {%- if button_add -%}
              {%- assign preorder_check = false -%}

              {%- if product.tags contains '_preorder' or product.metafields.theme.preorder.value -%}
                {%- assign preorder_check = true -%}
              {%- endif -%}

              {%- if current_variant.available and preorder_check -%}
                {{ 'products.product.pre_order' | t }}
              {%- elsif current_variant.available -%}
                {{ 'products.product.add_to_cart' | t }}
              {%- else -%}
                {{ 'products.product.sold_out' | t }}
              {%- endif -%}
            {%- else -%}
              {{ 'products.product.configure' | t }}
            {%- endif -%}
          </span>

          <span class="btn__loader">
            <svg height="18" width="18" class="svg-loader">
              <circle r="7" cx="9" cy="9" />
              <circle stroke-dasharray="87.96459430051421 87.96459430051421" r="7" cx="9" cy="9" />
            </svg>
          </span>

          <span class="btn__added">&nbsp;</span>

          {%- unless button_add -%}
            {%- render 'icon-nav-arrow-up' -%}
          {%- endunless -%}
        </button>
      </div>
    </div>
  </div>
</div>
