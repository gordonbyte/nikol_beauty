<dialog class="video-lightbox" id="VideoLightbox">
  <button type="button" class="video-lightbox__close" data-video-lightbox-close aria-label="Close video">
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true" focusable="false">
      <path d="M1 1l16 16M17 1L1 17" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>
  </button>
  <div class="video-lightbox__frame">
    <iframe class="video-lightbox__iframe" src="" title="YouTube video player" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>
  </div>
</dialog>

<style>
  .video-lightbox {
    position: fixed;
    inset: 0;
    margin: auto;
    width: min(90vw, 960px);
    height: min(50.625vw, 540px);
    max-width: none;
    max-height: none;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: visible;
  }

  .video-lightbox::backdrop {
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .video-lightbox__frame {
    width: 100%;
    height: 100%;
    background: #000;
  }

  .video-lightbox__iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .video-lightbox__close {
    position: fixed;
    top: 20px;
    right: 20px;
    min-width: 44px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.4);
    border: 0;
    border-radius: 50%;
    padding: 0;
    color: #fff;
    cursor: pointer;
    -webkit-appearance: none;
    appearance: none;
  }

  .video-lightbox__close:hover {
    background: rgba(0, 0, 0, 0.7);
  }

  .video-lightbox__close:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }
</style>

<script>
  (function () {
    var box = document.getElementById('VideoLightbox');
    if (!box || typeof box.showModal !== 'function') return;
    var iframe = box.querySelector('.video-lightbox__iframe');

    function videoId(url) {
      var m = url.match(/(?:youtube\.com\/(?:watch\?(?:.*&)?v=|shorts\/|embed\/)|youtu\.be\/)([A-Za-z0-9_-]{6,})/);
      return m ? m[1] : null;
    }

    document.addEventListener('click', function (e) {
      var closer = e.target.closest('[data-video-lightbox-close]');
      if (closer) { box.close(); return; }

      if (box.open && e.target === box) { box.close(); return; }

      var link = e.target.closest('a[data-fancybox]');
      if (!link) return;
      var id = videoId(link.href);
      if (!id) return;

      e.preventDefault();
      iframe.title = (link.getAttribute('aria-label') || link.textContent.trim() || 'YouTube video player').replace(/^Play video:?\s*/i, '') || 'YouTube video player';
      iframe.src = 'https://www.youtube.com/embed/' + id + '?autoplay=1&rel=0';
      box.showModal();
    });

    box.addEventListener('close', function () {
      iframe.src = '';
    });
  })();
</script>
